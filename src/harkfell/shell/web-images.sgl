;;; (harkfell shell web-images) - (harkfell images)'s fetcher on the web.
;;;
;;; The page has no filesystem: the gles3 bridge fetches the file (relative
;;; to the page, so "assets/type/..." is served beside it), the wasm decodes
;;; it (stb_image, load-image-from-memory) and makes a texture. Crash's web
;;; shell's route (its ensure-texture!), for any number of paths at once. A
;;; fetch that has not landed is asked for again (below); nothing here ever
;;; answers failed but an image that does not decode.
;;;
;;; When to fetch, measured 2026-09-24 in headless Chrome (a CDP probe
;;; logging Page.frame*, lifecycle and Network.loadingFailed):
;;;   - there is no navigation and no reload during boot;
;;;   - the start screen's three requests went out at 2.3 s, and all three
;;;     were cancelled (net::ERR_ABORTED, canceled: true) at 5.51 s, the
;;;     moment a ~3.2 s block of the main thread ended (the game's first
;;;     frames: the atlas and the backdrop baked), just before the first
;;;     contentful paint;
;;;   - requests issued just after such a block were cancelled the same way,
;;;     and ones 0.2 s later landed;
;;;   - the gles3 bridge logs each cancel as a console error and never marks
;;;     its slot ready.
;;; Why Chrome cancels in-flight requests across a long block is not known
;;; (hypothesis: the blocked renderer cannot take the responses).
;;; So:
;;;   - no fetch starts until asks have come at a steady frame rate: none
;;;     more than GAP-MS apart for STEADY-MS. A long frame restarts the
;;;     count, however slow the device;
;;;   - a fetch that has not landed after RETRY-MS is issued again,
;;;     doubling the wait each time up to RETRY-CAP-MS;
;;;   - it is never given up: (harkfell images) goes on answering #f until
;;;     the image lands.

(define-library (harkfell shell web-images)
  (import (sigil core)
          (sigil time)
          (sigil graphics)
          (sigil graphics image)
          (sigil list)
          (sigil browser gles3))

  (export web-fetcher)

  (begin
    (define GAP-MS 250.0)
    (define STEADY-MS 300.0)
    (define RETRY-MS 3000.0)
    (define RETRY-CAP-MS 24000.0)
    (define *pending* '())      ; ((path handle issued-ms . wait-ms) ...)
    (define *last-ask* #f)      ; ms of the last ask
    (define *steady-since* #f)  ; ms since when asks have come steadily

    (define (now-ms) (/ (* 1000.0 (current-jiffy)) (jiffies-per-second)))

    (define (drop! path)
      (set! *pending* (filter (lambda (e) (not (string=? (car e) path))) *pending*)))

    (define (issue! path wait)
      (drop! path)
      (set! *pending* (cons (cons path (cons (gles3-fetch-image path) (cons (now-ms) wait))) *pending*)))

    ;; Called once per ask: is the page steady (no long frame lately)?
    (define (steady! now)
      (when (or (not *last-ask*) (> (- now *last-ask*) GAP-MS))
        (set! *steady-since* now))
      (set! *last-ask* now)
      (> (- now *steady-since*) STEADY-MS))

    (define (web-fetcher path)
      (let* ((now (now-ms))
             (steady (steady! now))
             (e (assoc path *pending*)))
        (cond ((not e)
               (when steady (issue! path RETRY-MS))
               #f)
              ((gles3-image-ready? (cadr e))
               (drop! path)
               (let ((img (load-image-from-memory (gles3-image-ptr (cadr e)) (gles3-image-size (cadr e)))))
                 (if img
                     (let ((tex (load-texture img)))
                       (image-free! img)
                       (or tex 'failed))
                     'failed)))
              ;; not landed in its wait: again, when steady, waiting twice as long
              ((and steady (> (- now (caddr e)) (cdddr e)))
               (issue! path (min RETRY-CAP-MS (* 2.0 (cdddr e))))
               #f)
              (else #f))))))
