;;; (harkfell shell web) - The browser shell.
;;;
;;; Shaped after Crash The Stack's (crash shell web) at master e737d21: the
;;; generic loader (sigil-web-app.js) forwards DOM keydown and keyup by
;;; key name, the gles3 app shell dispatches ("frame", ms) once per
;;; requestAnimationFrame, and the page adds its own dispatches; all of
;;; them arrive through (harkfell main)'s sigil-web-dispatch-event. One
;;; frame per "frame" dispatch: the frame's dt into the fixed clock, the
;;; ticks, the present.
;;;
;;; The page's dispatches:
;;;   ("stick", "DX,DY,T")   the touch stick's offset in ring radii (DY
;;;                          down), stamped with the event's timeStamp
;;;   ("jump", "1,T"|"0,T")  the touch jump button down or up, stamped
;;;   ("stick-form", "float"|"fixed")  ?stick= (stored); "?" answers
;;;                          1 for float, 0 for fixed (the stored form)
;;;   ("ms", "on")           the readout
;;;   ("trace", "on")        the harkfell: lines below
;;;   ("replay", "")         print the replay trace (the gate's web leg)
;;;   ("envelope", "")       print the measured envelope
;;;   ("visibility", ...)    the tab hidden or shown: keys up, clock restarts
;;;   ("reset", "")          back to the entry
;;;   ("where", "")          print "harkfell: at X Y MODE" (the arm's probe)
;;;   ("latency", "")        print the latency lines of the ?ms readout
;;;   ("world-file", "PATH\nTEXT")  one file of the world, baked into the page
;;;                          at build time (A1)
;;;   ("world-done", "")     every file handed over: load the world and enter
;;;                          its start (answers 1 if it loaded clean)
;;;   ("goto", "REGION:X,Y[@C,R]") ?room= (and &at=C,R): enter that room at its
;;;                          door, or standing in cell (C, R) (1 if it can)
;;;   ("view", "atlas"|"sheet:REGION"|"play")  ?atlas, ?sheet=
;;;   ("still", "on")        ?still: no ticks (a screenshot's room holds still)
;;;   ("tap", "X,Y")         a click or tap in canvas pixels (the atlas and the
;;;                          sheet enter the room under it)
;;;   ("test-room", "")      ?test-room: A0's grey room
;;;   ("gesture", NAME)      a user gesture: resume the audio context (A2)
;;;   ("bench", "")          ?bench: the phone measurement ((harkfell bench))
;;;   ("carry", "2,3")       ?carry=: the harmonics carried (their drone voices sound)
;;;   ("tone", "X,Y")        ?tone=: the room H2's finding tone sounds from
;;;   ("tune-chunk", TEXT)   part of a tune's text, then
;;;   ("tune-done", NAME)    the text is complete (the answer to a fetch line)
;;;
;;; Trace lines (with ?trace, on the console):
;;;   harkfell: boot stick FORM          the stick form in force
;;;   harkfell: replay LINE              one per tick of the replay
;;;   harkfell: replay-done N            after the last
;;;   harkfell: envelope NAME VALUE      one per figure
;;;   harkfell: envelope-done
;;;   harkfell: returns N                a soft return happened (N so far)
;;;   harkfell: stick SECTOR             the stick's direction changed (none e ne n ...)
;;;   harkfell: jump down|up             the touch jump button
;;;   harkfell: world N files, M problems  the world loaded (printed always)
;;;   harkfell: problem FILE:LINE: ...   one per problem (printed always)
;;;   harkfell: room REGION:X,Y          the body entered a room (with ?trace,
;;;                                      and always after a goto or a tap)
;;;   harkfell: audio RATE STATE         the mixer opened (always)
;;;   harkfell: fetch NAME               a tune is wanted: the page fetches
;;;                                      assets/tunes/NAME.cts (always)
;;;   harkfell: bench ...                the measurement's lines (always; see
;;;                                      (harkfell bench))
;;; The replay and envelope lines print whether or not ?trace is on:
;;; they are asked for.

(define-library (harkfell shell web)
  (import (sigil io)
          (sigil list)
          (sigil string)
          (sigil graphics)
          (sigil browser gles3)
          (engine body)
          (harkfell world)
          (harkfell shell)
          (harkfell replay)
          (harkfell envelope)
          (harkfell feel)
          (harkfell tunes)
          (harkfell audio))

  (export web-main web-dispatch)

  (begin
    (define *last-ms* #f)
    (define *trace* #f)
    (define *returns* 0)
    (define *world-files* '())      ; the page's files, until world-done
    (define *room* #f)              ; the last room label traced
    (define *work-ms* 0.0)          ; A2: the last frame's work (the bench reads it)

    (define (say . parts)
      (println "~a" (apply string-append "harkfell:" (map (lambda (p) (string-append " " p)) parts))))

    ;; DOM key names -> the symbols (harkfell input) reads.
    (define (dom-key->sym k)
      (cond ((string=? k "ArrowLeft") 'left)
            ((string=? k "ArrowRight") 'right)
            ((string=? k "ArrowUp") 'up)
            ((string=? k "ArrowDown") 'down)
            ((string=? k " ") 'space)
            ((or (string=? k "a") (string=? k "A")) 'a)
            ((or (string=? k "d") (string=? k "D")) 'd)
            ((or (string=? k "w") (string=? k "W")) 'w)
            ((or (string=? k "s") (string=? k "S")) 's)
            ((or (string=? k "z") (string=? k "Z")) 'z)
            ((or (string=? k "r") (string=? k "R")) 'r)
            (else #f)))

    (define (frame-dt payload)
      (let* ((ms (string->number payload))
             (dt (if (and ms *last-ms*) (/ (- ms *last-ms*) 1000.0) 0.0)))
        (when ms (set! *last-ms* ms))
        dt))

    (define (web-tick payload)
      (let* ((dt (frame-dt payload))
             (ms (string->number payload))
             (w0 (now-ms)))
        (shell-set-frame-stamp! ms)
        (let ((ticks (shell-frame! dt)))
          (audio-frame! (* 1000.0 dt) *work-ms*)
          (when (and *trace* (not (= (world-returns (shell-world)) *returns*)))
            (set! *returns* (world-returns (shell-world)))
            (say "returns" (number->string *returns*)))
          (when (and *trace* (not (equal? (shell-room-label) *room*)))
            (set! *room* (shell-room-label))
            (say "room" *room*))
          (gles3-resize-to-display)
          (shell-present! (gles3-canvas-width) (gles3-canvas-height) ticks)
          (set! *work-ms* (- (now-ms) w0)))))

    ;; "A,B,C" -> a list of numbers (#f for a field that is not one).
    (define (fields payload)
      (map string->number (string-split payload ",")))

    (define (web-main)
      (unless (gles3-use-canvas "#stage")
        (error "harkfell web: no WebGL2 context for #stage"))
      (gles3-resize-to-display)
      (gfx-setup)
      (set-viewport #f)
      (set-letterbox-color 0.0 0.0 0.0)
      (shell-boot!)
      ;; A2: the sound. A tune the wasm lacks is asked of the page
      ;; ("harkfell: fetch NAME"; it answers with tune-chunk and tune-done).
      (tunes-set-want! (lambda (name) (say "fetch" name)))
      (audio-boot! say)
      (gles3-start-loop "harkfell-web-tick")
      0)

    (define (web-dispatch type payload)
      (cond ((string=? type "frame") (web-tick payload) 0)
            ((string=? type "keydown")
             (let ((k (dom-key->sym payload)))
               (cond ((eq? k 'r) (shell-reset-world!))
                     (k (shell-key-down! k))))
             0)
            ((string=? type "keyup")
             (let ((k (dom-key->sym payload)))
               (when k (shell-key-up! k)))
             0)
            ((string=? type "stick")
             (let ((f (fields payload))
                   (before (shell-sector)))
               (when (and (= (length f) 3) (car f) (cadr f))
                 (shell-stick! (car f) (cadr f) (caddr f)))
               (when (and *trace* (not (eq? before (shell-sector))))
                 (say "stick" (symbol->string (shell-sector)))))
             0)
            ((string=? type "jump")
             (let ((f (fields payload)))
               (when (and (= (length f) 2) (car f))
                 (shell-jump! (= (car f) 1) (cadr f))
                 (when *trace* (say "jump" (if (= (car f) 1) "down" "up")))))
             0)
            ((string=? type "stick-form")
             (cond ((string=? payload "float") (shell-set-stick-form! 'float) 1)
                   ((string=? payload "fixed") (shell-set-stick-form! 'fixed) 0)
                   (else (if (eq? (shell-stick-form) 'float) 1 0))))
            ((string=? type "ms") (shell-set-ms! (string=? payload "on")) 0)
            ((string=? type "trace")
             (set! *trace* (string=? payload "on"))
             (say "boot" "stick" (symbol->string (shell-stick-form)))
             0)
            ((string=? type "replay")
             (let ((lines (replay-lines)))
               (for-each (lambda (l) (say "replay" l)) lines)
               (say "replay-done" (number->string (length lines))))
             0)
            ((string=? type "envelope")
             (for-each (lambda (p)
                         (say "envelope" (symbol->string (car p)) (number->string (cdr p))))
                       (envelope-report HARKFELL-FEEL))
             (say "envelope-done")
             0)
            ((string=? type "visibility")
             (set! *last-ms* #f)
             (shell-keys-clear!)
             0)
            ;; the arm's probes: where the body is, and the latency lines
            ;;   harkfell: at X Y MODE
            ;;   harkfell: latency in ... move ... jump ...
            ((string=? type "where")
             (let ((b (world-body (shell-world))))
               (say "at" (number->string (body-x b)) (number->string (body-y b)) (symbol->string (body-mode b))))
             0)
            ((string=? type "latency")
             (apply say "latency" (shell-latency-lines))
             0)
            ((string=? type "reset") (shell-reset-world!) 0)
            ((string=? type "world-file")
             (let ((nl (let find ((i 0))
                         (cond ((>= i (string-length payload)) #f)
                               ((char=? (string-ref payload i) #\newline) i)
                               (else (find (+ i 1)))))))
               (when nl
                 (set! *world-files* (cons (cons (substring payload 0 nl)
                                                 (substring payload (+ nl 1) (string-length payload)))
                                           *world-files*)))
               0))
            ((string=? type "world-done")
             (let ((ps (shell-load-content! (reverse *world-files*))))
               (say "world" (number->string (length *world-files*)) "files," (number->string (length ps)) "problems")
               (for-each (lambda (p) (say "problem" p)) ps)
               (set! *world-files* '())
               (shell-goto-start!)
               (audio-world! (shell-content))
               (if (null? ps) 1 0)))
            ((string=? type "goto")
             (if (let* ((parts (string-split payload "@"))
                        (at (and (= (length parts) 2)
                                 (let ((cr (map string->number (string-split (cadr parts) ","))))
                                   (and (= (length cr) 2) (car cr) (cadr cr) (cons (car cr) (cadr cr)))))))
                   (if (and (= (length parts) 2) (not at))
                       #f
                       (if at (shell-goto! (car parts) at) (shell-goto! (car parts)))))
                 (begin (set! *room* (shell-room-label)) (say "room" *room*) 1)
                 (begin (say "no-room" payload) 0)))
            ((string=? type "view")
             (cond ((string=? payload "atlas") (shell-set-mode! 'atlas))
                   ((and (> (string-length payload) 6) (string=? (substring payload 0 6) "sheet:"))
                    (shell-set-mode! 'sheet (string->symbol (substring payload 6 (string-length payload)))))
                   (else (shell-set-mode! 'play)))
             (let ((sz (shell-view-size)))
               (say "view" payload (number->string (car sz)) (number->string (cadr sz))))
             0)
            ((string=? type "still") (shell-set-still! (string=? payload "on")) 0)
            ((string=? type "tap")
             (let* ((f (fields payload))
                    (r (and (= (length f) 2) (car f) (cadr f) (shell-tap! (car f) (cadr f)))))
               (when r (set! *room* r) (say "room" r))
               (if r 1 0)))
            ((string=? type "test-room") (shell-test-room!) 0)
            ;; A2
            ((string=? type "gesture") (audio-gesture!) 0)
            ((string=? type "bench") (audio-bench!) 0)
            ((string=? type "carry") (audio-carry! payload) 0)
            ((string=? type "tone") (audio-tone-room! payload) 0)
            ((string=? type "tune-chunk") (tunes-chunk! payload) 0)
            ((string=? type "tune-done") (tunes-done! payload) 0)
            (else 0)))))
