;;; (harkfell shell native) - The native shell: a sigil-desktop window.
;;;
;;; Shaped after Crash The Stack's (crash shell native) at master e737d21
;;; (a window at a whole multiple of the view, wait-frame's dt into the
;;; fixed clock, the keys polled each frame), cut down to what the game
;;; needs.
;;;
;;;   harkfell                  play from the world's start (world/ under the
;;;                             current directory; arrows or WASD, Space or Z
;;;                             to jump, R back to the room's entry, Escape to
;;;                             quit)
;;;   harkfell --room REGION:X,Y   play from that room's door
;;;   harkfell --room REGION:X,Y --at C,R   ... standing in cell (C, R) of it
;;;   harkfell --world DIR      another world directory (a fixture's)
;;;   harkfell --test-room      A0's grey test room
;;;   harkfell --ms             with the frame readout
;;;   harkfell --new            (A4) a new game: the save is not read (it is
;;;                             written over as you play)
;;;   harkfell --no-frame       (A4) straight into the world: no start screen,
;;;                             card or opening (a door skips them anyway)
;;;
;;; (A4) Played from the start (no --room), the game runs the frame first
;;; ((harkfell frame): the start screen for about 4 s, the Flux Harmonic
;;; card, the opening) and continues from the save if there is one; it
;;; writes the save as you go, and once more on Escape.
;;;   harkfell --room-check [REGION:X,Y ...]   no window: the content gates
;;;                             ((harkfell cli))
;;;   harkfell --reach-fixtures no window: the reach checker's own fixtures
;;;                             ((harkfell fixtures))
;;;   harkfell --replay         no window: run the replay script and print its
;;;                             trace (the replay gate, (harkfell replay))
;;;   harkfell --envelope       no window: print the measured movement envelope
;;;
;;; Live reload (section 8, "You edit a room and see it"): twice a second
;;; the shell compares the modification times of the world's files with
;;; the last ones it saw; a changed file is read again and, if the world is
;;; still clean, the room changes under the character. A file with problems
;;; is not taken: the shell prints them (FILE:LINE: message) and keeps
;;; playing the last good world, so a half-typed edit never breaks the game.
;;; Every reload prints one line:
;;;
;;;   harkfell: reloaded world/rooms/reedfen/x9y3.room
;;;   harkfell: NOT reloaded world/rooms/reedfen/x9y3.room (N problems):
;;;
;;; No gamepad: sigil-desktop 0.10.2 has GLFW's joystick code compiled in
;;; but exposes none of it (harkfell-design section 9).

(define-library (harkfell shell native)
  (import (sigil io)
          (sigil list)
          (sigil string)
          (sigil fs)
          (sigil process)
          (sigil desktop)
          (sigil graphics)
          (harkfell shell)
          (harkfell replay)
          (harkfell envelope)
          (harkfell feel)
          (harkfell source)
          (harkfell cli)
          (harkfell fixtures)
          (harkfell audio)
          (harkfell save)
          (harkfell check)
          (engine store)
          (harkfell images)
          (harkfell settings)
          (engine view)
          (sigil math))

  (export native-main)

  (begin
    ;; D37 (David, 2026-09-24): a Knytt-style small window. It opens at the
    ;; remembered whole scale of the view (the settings' scale row, stored as
    ;; x2 .. x8; x2, 800x352, the first time), and the view is always drawn
    ;; at the largest whole scale that fits the window, centred, black around
    ;; it ((engine view)'s integer-only fit), whatever size the window manager
    ;; gives it. A resize remembers the whole scale it now fits, never below
    ;; x2 (David on a HiDPI screen, 2026-09-25: 1x, 400x176 in screen units,
    ;; "is very small").
    (define (stored-scale)
      (let* ((st (setting-ref (quote scale)))
             (d (store-read-datum (setting-key st)))
             (v (if (and d (setting-value? st d)) d (setting-default st))))
        (when (eq? v (quote fullscreen)) (set! *fullscreen-asked* #t))
        (case v ((x3) 3) ((x4) 4) ((x5) 5) ((x6) 6) ((x7) 7) ((x8) 8) (else 2))))

    (define *opened-k* 2)           ; the whole scale the window was opened at
    (define *stored-k* #f)          ; the whole scale last remembered
    (define *placed-ok* #f)         ; the window, once it first settled, was the size asked for
    (define *placed-known* #f)      ; ... and it has settled once
    (define *last-size* #f)         ; (w . h), the window last seen, in screen units
    (define *stable* 0)             ; frames the window has held that size
    (define *snapped-from* '())     ; sizes a snap has been asked from (never asked again)
    (define *fullscreen-asked* #f)  ; the stored scale is fullscreen: go there on the first frame
    (define SETTLE-FRAMES 20)       ; a resize settles before it snaps (a drag is not fought)
    (define MIN-SCALE 2)            ; the smallest window scale, in screen units (D37)

    (define (scale-symbol k) (string->symbol (string-append "x" (number->string k))))
    (define (fit-k w h) (max 1 (exact (floor (min (/ w (* 1.0 VIEW-W)) (/ h (* 1.0 VIEW-H)))))))

    ;; The window's size in screen units, the units window-open and
    ;; window-set-size! take. The framebuffer (frame-width, what the view is
    ;; drawn into) is the device pixel ratio times that: 2x on a HiDPI output,
    ;; 1.25x or 1.5x under fractional scaling. So a scale here is screen
    ;; units per view pixel, as the window manager counts them, and x2 is the
    ;; same size on the screen at any ratio; the view is drawn at the largest
    ;; whole scale that fits the framebuffer (x4 at a ratio of 2).
    (define (window-size)
      (let ((w (window-width)) (h (window-height)))
        (if (and w h (> w 0) (> h 0))
            (cons w h)
            (cons (frame-width) (frame-height)))))

    ;; Once a frame. F11 or Alt+Enter: fullscreen (the largest whole scale
    ;; that fits the monitor, black around it: (engine view)'s integer-only
    ;; fit does the placing) and back, remembered.
    ;;
    ;; A window resized by hand, once the size has settled for SETTLE-FRAMES,
    ;; snaps to the whole scale it fits, x2 at the least (MIN-SCALE: a
    ;; window dragged smaller than 800x352 comes back up to it), and
    ;; remembers it, all in screen units. The view itself is re-fitted every
    ;; frame from the framebuffer (shell-present!), whatever the size; the
    ;; guards are on the snap, because on Wayland a snap the compositor
    ;; refuses is worse than none: GLFW takes the asked size as the window's
    ;; at once, the compositor sends no new size back, and the game draws a
    ;; small picture in the corner of a fullscreen window until the next
    ;; size change (David on sway, 2026-09-25: the first compositor
    ;; fullscreen drew at the old size in the top-left; a headless sway at
    ;; scale 2 showed the framebuffer called back at the snapped 1600x704
    ;; in a 1920x1080 window). So a snap only when:
    ;;   - the window, once it first settled, was the size asked for.
    ;;     Otherwise the window manager chose the size (sway's tiling, whose
    ;;     size can come a few frames after the first) and a snap would
    ;;     fight it.
    ;;   - the framebuffer does not fill the monitor's width or height: the
    ;;     compositor has it fullscreen or maximized (sway's own toggle, not
    ;;     the game's F11). Nothing is remembered from such a size either.
    ;;   - never twice from the same size, so a refusing manager or a
    ;;     compositor that sends its own size back is not fought.
    (define (fills-monitor?)
      (let ((m (monitor-size)))
        (and (pair? m)
             (or (>= (frame-width) (car m)) (>= (frame-height) (cadr m))))))

    (define (window-frame!)
      (when (or (key-pressed? (quote f11))
                (and (key-pressed? (quote return)) (or (key-down? (quote alt)) (key-down? (quote right-alt)))))
        (let ((on (not (fullscreen?))))
          (set-fullscreen! on)
          (cond (on (store-write-datum! "scale" (quote fullscreen)))
                (*stored-k* (store-write-datum! "scale" (scale-symbol *stored-k*)))
                (else (store-write-datum! "scale" (scale-symbol *opened-k*))))))
      (let* ((size (window-size)) (w (car size)) (h (cdr size)))
        (if (and *last-size* (= w (car *last-size*)) (= h (cdr *last-size*)))
            (set! *stable* (+ *stable* 1))
            (begin (set! *last-size* (cons w h)) (set! *stable* 0)))
        (when (and (not *placed-known*) (= *stable* SETTLE-FRAMES))
          (set! *placed-known* #t)
          (set! *placed-ok* (and (= w (* *opened-k* VIEW-W)) (= h (* *opened-k* VIEW-H)))))
        (when *fullscreen-asked*
          (set! *fullscreen-asked* #f)
          (set-fullscreen! #t))
        (when (and *placed-ok* (= *stable* SETTLE-FRAMES) (not (fullscreen?)) (not (fills-monitor?)))
          (let ((k (max MIN-SCALE (fit-k w h))))
            (when (and (<= k 8) (not (eqv? k *stored-k*)))
              (store-write-datum! "scale" (scale-symbol k))
              (set! *stored-k* k))
            (unless (or (and (= w (* k VIEW-W)) (= h (* k VIEW-H))) (member (cons w h) *snapped-from*))
              (set! *snapped-from* (cons (cons w h) *snapped-from*))
              (window-set-size! (* k VIEW-W) (* k VIEW-H)))))))

    (define RELOAD-EVERY 30)         ; frames between looks at the files

    ;; Every key the game listens to, as sigil-desktop names them.
    (define KEYS (list 'left 'right 'up 'down 'a 'd 'w 's 'space 'z))

    (define (say . parts) (display (apply string-append parts)) (newline))

    (define (poll-keys!)
      (for-each (lambda (k)
                  (when (key-pressed? k) (shell-key-down! k))
                  (when (key-released? k) (shell-key-up! k)))
                KEYS))

    (define (print-replay!)
      (for-each (lambda (l) (display l) (newline)) (replay-lines)))

    (define (print-envelope!)
      (for-each (lambda (p)
                  (display (car p)) (display " ") (display (cdr p)) (newline))
                (envelope-report HARKFELL-FEEL)))

    ;; --- live reload ------------------------------------------------------------

    (define *world-dir* "world")
    (define *mtimes* '())

    ;; Every file new, changed or gone since the last look, applied together
    ;; (a new room needs its map line, a seam opened needs both rooms). If the
    ;; world with all of them is not clean, none is taken, and the next change
    ;; is judged against the last good world plus everything changed since.
    (define *pending* '())          ; changes not yet taken: ((path . text-or-#f) ...)

    (define (check-reload!)
      (let* ((now (source-mtimes *world-dir*))
             (changed (filter (lambda (e)
                                (let ((old (assoc (car e) *mtimes*)))
                                  (or (not old) (not (= (cdr old) (cdr e))))))
                              now))
             (gone (filter (lambda (e) (not (assoc (car e) now))) *mtimes*))
             ;; a file that cannot be read now (mid-save, a dangling link) waits
             ;; for the next look: it is left out of *mtimes* below
             (read (map (lambda (e)
                          (cons (car e)
                                (guard (x (#t (say "harkfell: cannot read " (car e) " yet") 'unreadable))
                                  (read-file-string (room-file-path *world-dir* (car e))))))
                        changed))
             (unread (filter (lambda (p) (eq? (cdr p) 'unreadable)) read))
             (now (filter (lambda (e) (not (assoc (car e) unread))) now))
             (fresh (append (filter (lambda (p) (not (eq? (cdr p) 'unreadable))) read)
                            (map (lambda (e) (cons (car e) #f)) gone))))
        (set! *mtimes* now)
        (unless (null? fresh)
          (set! *pending* (append fresh (filter (lambda (p) (not (assoc (car p) fresh))) *pending*)))
          (let ((ps (shell-replace-files! *pending*))
                (names (string-join (map (lambda (p) (string-append (car p) (if (cdr p) "" " (gone)"))) *pending*) " ")))
            (if (null? ps)
                (begin (say "harkfell: reloaded " names) (set! *pending* '()))
                (begin
                  (say "harkfell: NOT reloaded " names " (" (number->string (length ps)) " problems):")
                  (for-each (lambda (p) (say "  " p)) ps)))))))

    (define (loop)
      (lambda ()
        (gfx-setup)
        (set-viewport #f)
        (set-letterbox-color 0.0 0.0 0.0)
        (let frame ((n 0))
          (let* ((dt (wait-frame)))
            (poll-keys!)
            (window-frame!)
            ;; the mouse, for the start screen's moths (drawn toward the pointer, D32)
            (shell-pointer! (mouse-x) (mouse-y))
            (when (key-pressed? 'r) (shell-reset-world!))
            (when (key-pressed? 'escape) (shell-save-now!) (request-quit))
            ;; nothing a reload meets may take the frame down: an error is
            ;; reported and the game plays on with the last good world
            (when (and (shell-content) (= (modulo n RELOAD-EVERY) 0))
              (guard (x (#t (say "harkfell: live reload skipped a look: "
                                 (if (error-object? x) (error-object-message x) "an error"))))
                (check-reload!)))
            (let* ((w0 (now-ms))
                   (ticks (shell-frame! dt)))
              (audio-frame! (* 1000.0 dt) *work-ms*)
              (shell-present! (frame-width) (frame-height) ticks)
              (set! *work-ms* (- (now-ms) w0)))
            (unless (quit-requested?) (frame (+ n 1)))))))

    (define *work-ms* 0.0)     ; A2: the last frame's work (the bench reads it)

    ;; Loads the world; enters --room's door or the start. #f (after saying
    ;; why) when there is nothing to play.
    (define (enter-world! args)
      (let ((dir (or (arg-value args "--world") "world")))
        (set! *world-dir* dir)
        (if (not (file-exists? (string-append dir "/world.sgl")))
            (begin (say "harkfell: no " dir "/world.sgl; playing A0's test room") #t)
            (let ((ps (shell-load-content! (read-world-source dir)))
                  (key (arg-value args "--room")))
              (for-each (lambda (p) (say "harkfell: " p)) ps)
              (set! *mtimes* (source-mtimes dir))
              (audio-world! (shell-content))
              (cond ((and key (let* ((a (arg-value args "--at"))
                                     (cr (and a (map string->number (string-split a ","))))
                                     (at (and cr (= (length cr) 2) (car cr) (cadr cr) (cons (car cr) (cadr cr)))))
                                (cond ((and a (not at)) #f)
                                      (at (shell-goto! key at))
                                      (else (shell-goto! key)))))
                     (say "harkfell: room " key) #t)
                    (key (say "harkfell: no room " key (if (arg-value args "--at") (string-append " or no open cell " (arg-value args "--at")) "")) #f)
                    ;; doors: another world (a fixture's), a carry to listen with, --look
                    ;; (the start screen or card alone, like ?look=), or no frame asked:
                    ;; straight in, and never the player's save
                    ((or (member "--no-frame" args) (arg-value args "--carry") (arg-value args "--look") (not (string=? dir "world")))
                     (if (shell-goto-start!)
                         (begin (say "harkfell: start " (shell-room-label)) #t)
                         (begin (say "harkfell: the world has no start to enter") #f)))
                    ((not (start-cell (shell-content)))
                     (say "harkfell: the world has no start to enter") #f)
                    (else
                     ;; A4: the frame, then the save's place or the start
                     (let* ((fresh (member "--new" args))
                            (d (and (not fresh) (store-read-datum SAVE-KEY)))
                            (notes (shell-begin! #f d)))
                       (cond ((not d) (say "harkfell: save " (if fresh "new-game" "none")))
                             ((not notes) (say "harkfell: save unreadable, a new game"))
                             (else (say "harkfell: save continue " (shell-room-label))
                                   (for-each (lambda (n) (say "harkfell: save forgave: " n)) notes)))
                       (say "harkfell: start " (shell-room-label))
                       #t)))))))

    (define (native-main . _args)
      (let ((args (cdr (command-line))))
        (cond ((member "--replay" args) (print-replay!) 0)
              ;; the gates exit with their verdict (main's return value is not
              ;; the process status: measured, a FAIL exited 0 before this)
              ((member "--room-check" args) (exit (room-check-main args)))
              ((member "--reach-fixtures" args) (exit (reach-fixtures-main args)))
              ((member "--envelope" args) (print-envelope!) 0)
              (else
               (shell-boot!)
               (shell-add-frame-listener! (lambda (ev) (say "harkfell: frame " (symbol->string ev))))
               ;; A4: images by path ((harkfell images)), read from the repository root
               (set-image-fetcher! native-fetcher)
               (shell-set-ms! (and (member "--ms" args) #t))
               ;; A2: the sound; --bench runs the phone measurement natively
               (audio-boot! (lambda parts (say (apply string-append "harkfell:" (map (lambda (p) (string-append " " p)) parts)))))
               ;; A4: --sound a,b (the sound's listening doors), before --bench reads them
               (let ((s (arg-value args "--sound"))) (when s (audio-sound-door! s)))
               (when (member "--bench" args) (audio-bench!))
               (let ((c (arg-value args "--carry")) (t (arg-value args "--tone")))
                 (when c (audio-carry! c))
                 (when t (audio-tone-room! t)))
               (if (or (member "--test-room" args) (enter-world! args))
                   (begin
                     ;; A4 look: --look start|card [--kind keys|touch|both]
                     (let ((lk (arg-value args "--look")))
                       (when lk
                         (shell-set-look! (string->symbol lk) (string->symbol (or (arg-value args "--kind") "keys")))
                         (let ((a (arg-value args "--look-alpha"))) (when a (shell-set-look-alpha! (string->number a))))))
                     (view-set-integer-only! #t)
                     (let ((k (stored-scale)))
                       (set! *opened-k* k)
                       (set! *stored-k* k)
                       (run-game "Harkfell" (* k VIEW-W) (* k VIEW-H) (loop)))
                     0)
                   1)))))))
