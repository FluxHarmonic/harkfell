;;; (harkfell credits) - The ending's credits: the cards, and when each shows.
;;; Pure; LOOK draws them over the world in IM Fell (D34, D35: no pause, no
;;; letterbox, input never stops).
;;;
;;; The text is the bible's option B, "How it was made" (recommended;
;;; harkfell-underhum-bible, "The credits: three options for David"). David's
;;; rulings do not choose among A, B and C, and the wording choices listed
;;; there are his; A and C are in tasks/harkfell-underhum-sound for him.
;;;
;;; WHEN (the bible: "They begin as you start to climb, with the first verse,
;;; and run through home and close"). The cards are on a clock that starts
;;; when the climb's music does: the first of rise or home HEARD
;;; ((harkfell sound) sound-finale-section), so a fast climber whose piece
;;; jumps straight to home still gets every card. Card k shows from
;;; k x CARD-EVERY-S for CARD-S, fading in and out over CARD-FADE-S. The last
;;; card ("Thanks for playing!") waits for the dawn if the clock gets there
;;; first, so it is the last thing over the brightening Hollow.
;;;
;;;   CREDITS                         the cards: lists of lines
;;;   (credits-at t dawn)             t seconds since the clock started (or #f),
;;;                                   dawn seconds since it started that the dawn
;;;                                   began (or #f): (index . alpha) or #f

(define-library (harkfell credits)
  (import (sigil core) (sigil list))
  (export CREDITS CARD-EVERY-S CARD-S CARD-FADE-S credits-at credits-last-start)
  (begin
    (define CREDITS
      '(("Harkfell")
        ("A game by David Wilson")
        ("I made it with two AI models." "Claude wrote the rooms, the art, the music" "and the first code with me.")
        ("Codex built many of the later systems.")
        ("I played every room, listened to every sound," "and decided what stayed.")
        ("Built in Sigil and motif, which I make")
        ("Inspired by Knytt, by Nifflas")
        ("IM Fell types by Igino Marini")
        ("Thanks for playing!")))

    (define CARD-EVERY-S 16.0)     ; nine cards over about two and a half minutes
    (define CARD-S 10.0)           ; each held long enough to read twice
    (define CARD-FADE-S 1.5)

    ;; When the last card starts: its turn on the clock, or the dawn if later.
    (define (credits-last-start dawn)
      (let ((turn (* CARD-EVERY-S (- (length CREDITS) 1))))
        (if dawn (max turn dawn) turn)))

    (define (alpha u)
      (cond ((or (< u 0.0) (> u CARD-S)) 0.0)
            ((< u CARD-FADE-S) (/ u CARD-FADE-S))
            ((> u (- CARD-S CARD-FADE-S)) (/ (- CARD-S u) CARD-FADE-S))
            (else 1.0)))

    (define (credits-at t dawn)
      (and t
           (let* ((n (length CREDITS))
                  (last-at (credits-last-start dawn))
                  (k (min (- n 2) (exact (floor (/ t CARD-EVERY-S)))))
                  (u (- t (* k CARD-EVERY-S))))
             (cond ((>= t last-at)
                    (let ((a (alpha (- t last-at)))) (and (> a 0.0) (cons (- n 1) a))))
                   ((> (alpha u) 0.0) (cons k (alpha u)))
                   (else #f)))))))
