;;; (harkfell settings) - The settings, and where they live.
;;;
;;; Harkfell's rows as a (substratic store settings) table. The verbs keep
;;; the names and arities Harkfell's shell and tests already use (no table
;;; argument: this module closes over Harkfell's table); the code behind
;;; them is Substratic's.
;;;
;;; STICK: the touch joystick's form (ruling D25, both built so David picks
;;; by feel): float (the hybrid: the ring rests at its home spot and
;;; re-centres under a thumb that lands anywhere in the lower-left quarter)
;;; or fixed (the ring stays where it is drawn). The page's ?stick=fixed|float
;;; sets it and the store keeps it. David chose fixed after playing both
;;; (2026-09-24), so fixed is the default.
;;;
;;; SCALE (D37): the native window's whole scale of the 400x176 view (x2 is
;;; 800x352, Knytt's small window), or fullscreen at the largest whole scale
;;; that fits; remembered between runs. Native only: the web fits its canvas.
;;;
;;; The table has NO schema version (version: #f): Harkfell's players have
;;; these keys in their stores already and no version key, and a versioned
;;; table would reset their settings once on the update that adopted it.
;;;
;;; Every setting is its own store key holding a symbol (a missing key reads
;;; as #f, which a boolean could not be told from). Pure: the shell does the
;;; store reads and writes.

(define-library (harkfell settings)
  (import (rename (substratic store settings)
                  (setting-ref table-setting-ref)
                  (settings-defaults table-settings-defaults)
                  (settings-value table-settings-value)
                  (settings-with table-settings-with)
                  (settings-step table-settings-step)))

  (export setting setting? setting-id setting-name setting-values setting-default setting-key
          SETTINGS SETTINGS-TABLE SETTING-IDS setting-ref setting-value?
          settings-defaults settings-value settings-with settings-step)

  (begin
    ;; Built with list, not quoted (Crash's wasm literal hazard).
    (define SETTINGS
      (list (setting id: 'stick name: "STICK" values: (list 'fixed 'float) default: 'fixed key: "stick")
            (setting id: 'scale name: "SCALE" values: (list 'x2 'x3 'x4 'x5 'x6 'x7 'x8 'fullscreen)
                     default: 'x2 key: "scale")))

    (define SETTINGS-TABLE (make-settings-table SETTINGS version: #f))

    (define SETTING-IDS (map setting-id SETTINGS))

    (define (setting-ref id) (table-setting-ref SETTINGS-TABLE id))
    (define (settings-defaults) (table-settings-defaults SETTINGS-TABLE))
    (define (settings-value s id) (table-settings-value SETTINGS-TABLE s id))
    (define (settings-with s id v) (table-settings-with SETTINGS-TABLE s id v))
    (define (settings-step s id delta) (table-settings-step SETTINGS-TABLE s id delta))))
