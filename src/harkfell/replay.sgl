;;; (harkfell replay) - A scripted input sequence and the positions it
;;; produces, for the replay gate.
;;;
;;; The script is REPLAY-TICKS intents: a route through the whole room
;;; (OPENING, below), then segments of 4 to 90 ticks with a pseudo-random
;;; direction and jump hold from a fixed seed, so the run falls in the pits
;;; (soft returns), jumps, slides on walls and swims wherever it wanders. The
;;; generator is the ZX81 LCG with a residue test (the onboarding's idiom:
;;; modulo only), so the script is the same on every target.
;;;
;;; The trace is one line per tick of the world ((harkfell world)) in the
;;; test room:
;;;   TICK X Y VX VY MODE RETURNS
;;; floats as number->string prints them, which round-trips exactly
;;; (measured: 0.33333333333333331), so two traces that are equal as text
;;; hold the same bits. The gate compares a run with the recording made on
;;; the same target (test/fixtures/replay-native.txt, replay-web.txt);
;;; whether the native and web recordings agree is recorded in the task
;;; note, not assumed.

(define-library (harkfell replay)
  (import (sigil list)
          (sigil math)
          (sigil string)
          (engine body)
          (harkfell world)
          (harkfell rooms))

  (export REPLAY-TICKS REPLAY-SEED
          replay-script replay-script-from replay-lines replay-lines-of replay-trace-text
          trace-line)

  (begin
    (define REPLAY-TICKS 1800)     ; 30 seconds
    (define REPLAY-SEED 14)     ; chosen for the wander: four soft returns in all

    ;; The ZX81 generator: every product stays under 2^23, so no target can
    ;; overflow a fixnum on it (the wasm build included).
    (define (lcg-next s) (modulo (+ (* s 75) 74) 65537))

    ;; (ticks h v jump) segments. The opening is a route through the whole
    ;; room and back, found by driving it with reactive policies
    ;; (tools/find-route.sgl) and baked here as the intents they gave, so
    ;; the script is fixed input, not a controller: 994 ticks that walk into
    ;; the first pit (a soft return), climb the chimney by wall kicks, drop
    ;; off the shelf, jump the 3-tile gap from a run, swim the pool and leap
    ;; out, jump the 3-tile ledge, climb the post, drop into the well, climb
    ;; the rough wall to its top; then back: drop into the well, climb the
    ;; post out of it, down the ledge, swim the pool leftward, and a try at
    ;; the 3-tile gap with no run-up that falls in (the second soft return).
    ;; The pseudo-random segments after it wander from the entry.
    (define OPENING
      (list (list 60 1 0 #f) (list 40 0 0 #f) (list 1 -1 0 #t) (list 7 -1 0 #f)
            (list 1 -1 0 #t) (list 16 1 0 #f) (list 1 1 0 #t) (list 2 -1 0 #f)
            (list 12 1 0 #f) (list 4 -1 0 #f) (list 1 -1 0 #t) (list 83 1 0 #f)
            (list 37 1 0 #t) (list 29 1 0 #f) (list 30 0 1 #f) (list 43 1 -1 #f)
            (list 35 1 -1 #t) (list 1 1 0 #f) (list 25 1 0 #t) (list 33 1 -1 #f)
            (list 32 1 0 #f) (list 111 1 -1 #f) (list 34 -1 0 #f) (list 89 -1 -1 #f)
            (list 57 -1 0 #f) (list 20 0 1 #f) (list 55 -1 -1 #f) (list 35 -1 -1 #t)
            (list 1 -1 0 #f) (list 99 -1 0 #t)))

    (define (segments-from seed total)
      (let loop ((s (lcg-next seed)) (left total) (acc '()))
        (if (<= left 0)
            (reverse acc)
            (let* ((s1 (lcg-next s))
                   (s2 (lcg-next s1))
                   (s3 (lcg-next s2))
                   (s4 (lcg-next s3))
                   (n (min left (+ 4 (modulo s1 87))))
                   (h (- (modulo s2 3) 1))
                   (v (- (modulo s3 3) 1))
                   (jump (< (modulo s4 100) 35)))
              (loop s4 (- left n) (cons (list n h v jump) acc))))))

    (define (opening-ticks)
      (apply + (map car OPENING)))

    ;; The script as a list of intents, one per tick, presses marked on
    ;; each rising edge of jump.
    (define (replay-script) (replay-script-from REPLAY-SEED))

    (define (replay-script-from seed)
      (let ((segs (append OPENING (segments-from seed (- REPLAY-TICKS (opening-ticks))))))
        (let loop ((segs segs) (was #f) (acc '()))
          (if (null? segs)
              (reverse acc)
              (let* ((seg (car segs))
                     (n (car seg))
                     (h (cadr seg))
                     (v (caddr seg))
                     (jump (cadddr seg)))
                (let ticks ((i 0) (was was) (acc acc))
                  (if (= i n)
                      (loop (cdr segs) was acc)
                      (ticks (+ i 1)
                             jump
                             (cons (intent h: h v: v jump: jump press: (and jump (not was)))
                                   acc)))))))))

    (define (trace-line tick w)
      (let ((b (world-body w)))
        (string-append (number->string tick) " "
                       (number->string (body-x b)) " "
                       (number->string (body-y b)) " "
                       (number->string (body-vx b)) " "
                       (number->string (body-vy b)) " "
                       (symbol->string (body-mode b)) " "
                       (number->string (world-returns w)))))

    ;; The trace of a script (a list of intents), one string per tick; and
    ;; the trace of the replay script.
    (define (replay-lines-of script)
      (let loop ((w (world-new (load-test-room)))
                 (script script)
                 (tick 1)
                 (acc '()))
        (if (null? script)
            (reverse acc)
            (let ((w (world-tick w (car script))))
              (loop w (cdr script) (+ tick 1) (cons (trace-line tick w) acc))))))

    (define (replay-lines)
      (replay-lines-of (replay-script)))

    (define (replay-trace-text)
      (apply string-append
             (map (lambda (l) (string-append l "\n")) (replay-lines))))))
