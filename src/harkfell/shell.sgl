;;; (harkfell shell) - What the native and web shells share: the fixed
;;; clock, the input state, the world, the present, the ?ms readout.
;;;
;;; Shaped after Crash The Stack's (crash shell) at master e737d21 (the
;;; fixed clock fed by each frame's wall dt, the readout drawn over the
;;; frame), written fresh for one room and one body: Crash's shell is a
;;; menu, two tables and a hub, none of which A0 has.
;;;
;;; Each frame the shell (native or web) calls shell-frame! with the
;;; frame's wall dt. The clock ((engine tween)) turns it into whole 1/60 s
;;; ticks (at most MAX-STEPS-PER-FRAME, the rest dropped and counted) and
;;; the world steps once per tick with the intent of that tick
;;; ((harkfell input)). Then shell-present! draws the room into its
;;; 400x176 target and puts the target on the window at a whole scale
;;; ((engine view)).
;;;
;;; Touch latency (the web page's ?ms). The page stamps every stick move
;;; and jump press with the event's timeStamp (the performance.now()
;;; clock, which is also the clock of the requestAnimationFrame timestamp
;;; each frame arrives with). A new stick direction (not rest) starts a MOVE
;;; measurement and a jump press a JUMP one; each records, in ms, over the
;;; last LAT-KEEP samples:
;;;   IN     touch to the end of the first frame whose simulation used it
;;;   MOVE   touch to the end of the first frame that draws the body a pixel
;;;          along the asked direction (from rest it includes the run's
;;;          acceleration, ACCEL-TICKS long)
;;;   JUMP   touch to the end of the first frame in which a jump or a wall
;;;          kick launched
;;; A measurement replaced before it settled, or not settled within
;;; LAT-GIVE-UP ms (a push into a wall, a press that launched nothing), is
;;; dropped and counted ("drop N" on the jump line), so the kept samples are
;;; not silently biased. "The end of a frame" is the frame's rAF timestamp
;;; plus the frame's own work: a LOWER bound on the glass (the gap between
;;; the rAF timestamp and the callback, and the compositor's vsync after the
;;; frame, are not in it).

(define-library (harkfell shell)
  (import (sigil struct)
          (sigil math)
          (sigil list)
          (sigil string)
          (sigil time)
          (sigil graphics)
          (engine tween)
          (engine view)
          (engine body)
          (engine stick)
          (engine store)
          (harkfell world)
          (harkfell rooms)
          (harkfell input)
          (harkfell draw)
          (harkfell settings)
          (harkfell feel)
          (engine worldmap)
          (engine roomfile)
          (harkfell content)
          (harkfell check)
          (harkfell legend)
          (harkfell sound)
          (harkfell ears)
          (harkfell gates)
          (harkfell save)
          (harkfell frame)
          (harkfell reveal)
          (harkfell title)
          (harkfell render))

  (export shell-begin! shell-gesture! shell-pointer! shell-frame-phase shell-waking?
          shell-add-frame-listener! shell-set-save-extras! shell-set-input-kind!
          shell-save-now! shell-saving? shell-reveal-alpha shell-revealed? shell-set-moment-clock! shell-set-look! shell-set-look-alpha!
          shell-boot! shell-frame! shell-present! shell-reset-world!
          shell-key-down! shell-key-up! shell-keys-clear!
          shell-stick! shell-jump! shell-sector
          shell-set-ms! shell-set-stick-form! shell-stick-form
          shell-world shell-clock shell-set-frame-stamp!
          shell-latency-lines now-ms
          shell-load-content! shell-content shell-goto! shell-goto-start!
          shell-test-room! shell-set-mode! shell-mode shell-set-still!
          shell-tap! shell-replace-file! shell-replace-files! shell-room-label shell-view-size
          shell-set-extra-lines! shell-set-carry! shell-take-news! shell-take-body-events!
          VIEW-W VIEW-H)

  (begin
    (define LAT-KEEP 16)
    (define LAT-GIVE-UP 1000.0)   ; ms: a measurement not settled by then is dropped

    (define *world* #f)
    (define *clock* #f)
    (define *keys* '())            ; key symbols held
    (define *press* #f)            ; a jump press not yet used by a tick
    (define *sector* 'none)        ; the stick's direction
    (define *touch-jump* #f)       ; the jump button is down
    (define *ms* #f)               ; the readout is on
    (define *settings* #f)
    (define *room-rt* #f)
    (define *sharp-rt* #f)
    (define *sharp-up* 0)
    (define *frame-ms* 0.0)
    (define *step-ms* 0.0)
    (define *draw-ms* 0.0)
    (define *frame-start* 0.0)     ; now-ms at the frame's start
    (define *frame-stamp* #f)      ; the frame's rAF timestamp (web), else #f

    ;; pending touch measurements: #f or (list t0 draw-x draw-y applied?)
    (define *pending-move* #f)
    (define *pending-jump* #f)
    (define *lat-in* '())
    (define *lat-move* '())
    (define *lat-jump* '())
    (define *lat-dropped* 0)       ; measurements replaced or given up, not kept
    (define *launched* #f)         ; a tick of this frame launched a jump or a kick

    ;; A1: the written world
    (define *content* #f)          ; (harkfell content), once loaded
    (define *mode* 'play)          ; play, sheet (one region's rooms at 1:1), atlas (all at 1/4)
    (define *sheet-region* #f)     ; the region the sheet shows
    (define *still* #f)            ; no ticks: the room holds still for a screenshot
    (define *view-rt* #f)          ; the sheet's or the atlas's target
    (define *view-w* 0)
    (define *view-h* 0)
    (define *last-fit* #f)         ; the last frame's fit (a tap maps through it)

    ;; A4: the frame before the world ((harkfell frame)), and the save
    ;; ((harkfell save)). Both belong to a game begun from the start
    ;; (shell-begin!); a door (?room=, --room, the atlas, the test room) has
    ;; neither: it is for looking, and it must not overwrite a player's save.
    (define *frame* #f)              ; #f, or the frame until it plays
    (define *frame-listeners* '())   ; each is called with every phase entered
    (define *key-edge* #f)           ; a key went down since the last frame
    (define *gesture* #f)            ; a key or a touch since the last frame (the web's gesture)
    (define *pointer* #f)            ; (x . y) in window pixels, for the start screen's moths
    (define *wall* 0.0)              ; seconds since the frame began: its drawing clock
    (define *input-kind* 'keys)      ; keys, touch or both: which words the start screen says
    (define *saving* #f)             ; this game writes its save
    (define *save-sig* #f)           ; what the last save held (a new one is written on a change)
    (define *waking* #f)             ; the creature has not been moved yet (D15)
    ;; D35: the wordmark's one showing, at the first homecoming
    (define *revealed* #f)           ; it has had its showing (this save)
    (define *reveal-t* #f)           ; seconds since the home stone rang, while it shows
    (define *reveal-sch* #f)         ; its schedule ((harkfell reveal))
    ;; The playing moment's time as heard, for D35's timing: a procedure giving
    ;; (name . seconds) or #f ((harkfell audio) wires the sound's).
    (define *moment-clock* (lambda () #f))
    (define (shell-set-moment-clock! f) (set! *moment-clock* f))
    (define *home-stone* #f)         ; the start room's H2 stone, as (overtone x y) its ring news carries
    ;; The sound's part of a save: a getter giving (moments played), and a
    ;; setter taking them on a continue ((harkfell audio) wires the sound).
    (define *save-get* (lambda () (list '() 0.0)))
    (define *save-set* (lambda (moments played) #f))

    (define (shell-add-frame-listener! f) (set! *frame-listeners* (append *frame-listeners* (list f))))
    (define (shell-set-save-extras! get set) (set! *save-get* get) (set! *save-set* set))
    (define (shell-set-input-kind! k) (set! *input-kind* k))
    (define (shell-gesture!) (set! *gesture* #t))
    (define (shell-pointer! x y) (set! *pointer* (cons x y)))
    (define (shell-frame-phase) (if *frame* (frame-phase *frame*) 'play))
    (define (shell-waking?) *waking*)
    (define (shell-revealed?) *revealed*)
    ;; How much of the wordmark shows now, 0..1 (0 when it is not showing).
    (define (shell-reveal-alpha) (if *reveal-t* (reveal-alpha *reveal-sch* *reveal-t*) 0.0))

    ;; The start room's stone keyed to H2 (the bowl's), as the ring news
    ;; names it: (2 x y), x y its centre in the world map's pixels; #f if the
    ;; start room has none.
    (define (home-stone ct)
      (let* ((s (start-cell ct))
             (wm (content-map ct))
             (room-of (lambda (cell) (cons (exact (floor (/ (car cell) ROOM-COLS)))
                                           (exact (floor (/ (cdr cell) ROOM-ROWS)))))))
        (and s
             (let ((st (find (lambda (st) (and (= (stone-overtone st) 2)
                                                (equal? (room-of (stone-cell st)) (room-of s))))
                             (content-stones ct))))
               (and st (let ((c (cell-centre (worldmap-tiles wm) (stone-cell st))))
                         (list 2 (car c) (cdr c))))))))
    (define (shell-saving?) *saving*)

    (define (now-ms) (/ (* 1000.0 (current-jiffy)) (jiffies-per-second)))

    ;; A2: more readout lines (the sound's), from whoever sets them
    (define *extra-lines* (lambda () '()))
    (define (shell-set-extra-lines! proc) (set! *extra-lines* proc))

    (define (shell-world) *world*)
    (define (shell-clock) *clock*)

    ;; --- boot ------------------------------------------------------------------

    (define (shell-boot!)
      (set-store-app! "harkfell")
      (set! *settings* (map (lambda (st)
                              (let* ((d (store-read-datum (setting-key st))))
                                (cons (setting-id st)
                                      (if (and d (setting-value? st d)) d (setting-default st)))))
                            SETTINGS))
      (shell-test-room!)
      (set! *clock* (clock-new)))

    ;; A0's test room (the replay's and the envelope's room; ?test-room).
    (define (shell-test-room!)
      (end-game!)
      (set! *world* (world-new (load-test-room))))

    ;; R: back to the current room's entry (A0's room: its @).
    (define (shell-reset-world!)
      (set! *world* (if *content* (world-reset *world*) (world-new (load-test-room)))))

    ;; --- the written world ---------------------------------------------------------

    (define (shell-content) *content*)

    ;; source: ((path . text) ...). Loads it; returns the problems (a list of
    ;; strings, empty when the world is clean). The world is not entered
    ;; here: shell-goto! or shell-goto-start! does that.
    (define (shell-load-content! source)
      (let ((ct (load-content source)))
        (set! *content* ct)
        (set-draw-content! ct)
        (title-set-content! ct)
        (map problem->string (content-problems ct))))

    ;; A3: what the body carries at a door (?carry=, --carry): a
    ;; listening and testing door, like ?room=.
    (define *carry0* '())

    ;; A world entered anew (a door, the start, a reload) keeps what the
    ;; session has done: the harmonics carried and the stones opened (by cell
    ;; and overtone). The pickups are the content's, less what is carried.
    (define (kept-stones old)
      (let ((old-stones (if old (world-stones old) '())))
        (map (lambda (s)
               (let ((o (find (lambda (o) (and (equal? (stone-cell o) (stone-cell s))
                                               (= (stone-overtone o) (stone-overtone s))
                                               (stone-open? o)))
                              old-stones)))
                 (if o (stone s state: 'open) s)))
             (content-stones *content*))))

    (define (populate w old carry)
      (world-populate w (kept-stones old) (content-pickups *content*)
                      (append carry (if old (world-carry old) '()))))

    ;; ?carry=: from now on the body carries hs (and whatever it has found).
    (define (shell-set-carry! hs)
      (set! *carry0* hs)
      (when (and *world* *content* (world-gates *world*))
        (set! *world* (populate *world* *world* hs))))

    ;; The news of this frame's ticks, taken off the world by shell-frame!
    ;; (the sound plays it, the draw flashes it).
    (define *frame-news* '())
    (define (shell-take-news!) *frame-news*)
    ;; A4 sound: every tick's body events since the last take, oldest first, each
    ;; (event . vy-before): the sound reads jumps and landings once a frame
    (define *body-events* (quote ()))
    (define (shell-take-body-events!) (let ((l (reverse *body-events*))) (set! *body-events* (quote ())) l))

    (define (body-in-cell cell)
      (cell-body (worldmap-tiles (content-map *content*)) HARKFELL-FEEL (car cell) (cdr cell)))

    ;; Into the room at "region:x,y" (at its door cell); #f if there is none.
    ;; at: optionally (c . r), a cell of that room to stand in instead of its
    ;; door (?room=...&at=C,R, --at C,R: any entrance, for testing). A cell in
    ;; rock or a hazard, or outside the grid, is refused (#f).
    (define (shell-goto! key . at)
      (let* ((k (and *content* (parse-room-key key)))
             (rm (and k (content-room *content* (cadr k) (caddr k))))
             (at (and (pair? at) (car at)))
             (cell (and rm (eq? (room-region rm) (car k))
                        (if at
                            (and (< -1 (car at) ROOM-COLS) (< -1 (cdr at) ROOM-ROWS)
                                 (let ((ch (room-char rm (car at) (cdr at))))
                                   (not (memq (char-kind ch) (list 'solid 'climbable 'ledge 'hazard))))
                                 (local->global *content* rm (car at) (cdr at)))
                            (room-start-cell *content* rm)))))
        (and cell
             (begin
               (set! *world* (populate (world-at (content-map *content*) (body-in-cell cell)) *world* *carry0*))
               (set! *mode* 'play)
               (end-game!)
               #t))))

    ;; A door ends a begun game's frame and its saving (A4): a door is for
    ;; looking, and must not overwrite the player's save.
    (define (end-game!)
      (set! *frame* #f)
      (set! *saving* #f)
      (set! *waking* #f))

    ;; Into the world's start; #f without one.
    (define (shell-goto-start!)
      (let ((cell (and *content* (start-cell *content*))))
        (and cell
             (begin
               (set! *world* (populate (world-at (content-map *content*) (body-in-cell cell)) *world* *carry0*))
               (set! *mode* 'play)
               #t))))

    ;; A4: the game begins from the start (no door). web?: the start screen
    ;; waits for a gesture. d: the save read from the store, or #f (none, or
    ;; a new game asked for). Enters the save's place (its carry, its opened
    ;; stones, its moments heard) or the world's start, behind the frame.
    ;; Returns what the restore forgave (strings), or #f for a new game.
    (define (shell-begin! web? d)
      (set! *frame* (frame-new web?))
      (set! *wall* 0.0)
      (set! *saving* #t)
      (set! *save-sig* #f)
      (set! *waking* #t)
      (set! *reveal-t* #f)
      (set! *home-stone* (and *content* (home-stone *content*)))
      (let ((r (and d *content* (save-restore *content* d))))
        (set! *revealed* (and r (restored-revealed r)))
        (cond (r
               (let* ((open (restored-stones r))
                      (stones (map (lambda (s)
                                     (if (member (cons (stone-cell s) (stone-overtone s)) open)
                                         (stone s state: 'open)
                                         s))
                                   (content-stones *content*)))
                      (w (world-at (content-map *content*) (body-in-cell (restored-cell r)))))
                 (set! *world* (world-populate w stones (content-pickups *content*) (restored-carry r)))
                 (set! *mode* 'play)
                 (*save-set* (restored-moments r) (restored-played r))
                 (restored-notes r)))
              (else (shell-goto-start!) #f))))

    ;; The save of the world now, or #f outside the written world.
    (define (current-save)
      (and *content* *world* (world-gates *world*)
           (let ((x (*save-get*)))
             (save-datum *content* (world-entry *world*) (world-carry *world*) (world-stones *world*)
                         (car x) (cadr x) *revealed*))))

    ;; Write the save when what it holds has changed: the entry (a room
    ;; entered), the carry, the stones opened, the moments heard. Not the
    ;; time played, which changes every frame; it rides along.
    (define (save-if-changed!)
      (let* ((e (world-entry *world*))
             (sig (list (body-x e) (body-y e) (world-carry *world*)
                        (length (filter stone-open? (world-stones *world*)))
                        (car (*save-get*))
                        *revealed*)))
        (unless (equal? sig *save-sig*)
          (let ((d (current-save)))
            (when d
              (store-write-datum! SAVE-KEY d)
              (set! *save-sig* sig))))))

    ;; Write the save now (a hidden tab, a quit): #t if written.
    (define (shell-save-now!)
      (and *saving* (let ((d (current-save))) (and d (store-write-datum! SAVE-KEY d) #t))))

    ;; "region:x,y" of the room the body is in, or "test-room".
    (define (shell-room-label)
      (let ((p (and *world* (world-room *world*))))
        (if (and p (placed-data p)) (room-label (placed-data p)) "test-room")))

    ;; mode: 'play, 'atlas, or 'sheet with the region.
    (define (shell-set-mode! mode . region)
      (unless (eq? mode 'play) (end-game!))
      (set! *mode* mode)
      (set! *sheet-region* (and (pair? region) (car region))))

    (define (shell-mode) *mode*)
    (define (shell-set-still! on) (set! *still* on))

    ;; The rooms the overview shows, its scale and gap.
    (define (overview-rooms)
      (if (eq? *mode* 'sheet)
          (region-rooms *content* *sheet-region*)
          (map placed-data (content-rooms *content*))))
    (define (overview-k) (if (eq? *mode* 'sheet) 1 0.25))

    ;; The size of what is drawn now, in view pixels: (w h).
    (define (shell-view-size)
      (if (and *content* (not (eq? *mode* 'play)))
          (let ((sz (overview-size (overview-rooms) (overview-k) (overview-gap))))
            (list (car sz) (cadr sz)))
          (list VIEW-W VIEW-H)))
    (define (overview-gap) (if (eq? *mode* 'sheet) 4 2))

    ;; A tap (or click) at window pixel (x, y). In the atlas or the sheet it
    ;; enters the room under it; returns its label, or #f.
    (define (shell-tap! x y)
      (and *content* *last-fit* (not (eq? *mode* 'play))
           (let* ((f *last-fit*)
                  (px (* (- x (fit-x f)) (/ *view-w* (* 1.0 (fit-w f)))))
                  (py (* (- y (fit-y f)) (/ *view-h* (* 1.0 (fit-h f)))))
                  (rm (overview-room-at (overview-rooms) (overview-k) (overview-gap) px py)))
             (and rm
                  (shell-goto! (room-label rm))
                  (room-label rm)))))

    ;; One file changed (live reload); see shell-replace-files!.
    (define (shell-replace-file! path text)
      (shell-replace-files! (list (cons path text))))

    ;; Files of the world changed (live reload): changes is ((path . text)
    ;; ...), text #f for a file that is gone. All of them are applied to the
    ;; source together (a new room and its map line arrive in one poll and are
    ;; checked as one world), the source is loaded again, and if it is clean
    ;; the world moves onto the new map with the body where it was. Returns
    ;; the problems (strings); with problems nothing changes.
    (define (shell-replace-files! changes)
      (if (not *content*)
          (list "no world loaded")
          (let* ((paths (map car changes))
                 (kept (filter (lambda (e) (not (member (car e) paths))) (content-source *content*)))
                 (source (append (filter cdr changes) kept))
                 (ct (load-content source))
                 (ps (map problem->string (content-problems ct))))
            (when (null? ps)
              (set! *content* ct)
              (set-draw-content! ct)
              (title-set-content! ct)
              (when (and *world* (world-room *world*) (placed-data (world-room *world*)))
                (let* ((p (world-room *world*))
                       (rm (content-room ct (placed-x p) (placed-y p)))
                       (cell (and rm (room-start-cell ct rm)))
                       (fallback (if cell
                                     (cell-body (worldmap-tiles (content-map ct)) HARKFELL-FEEL (car cell) (cdr cell))
                                     (world-entry *world*))))
                  ;; the stones opened so far are opened in the new map BEFORE the
                  ;; reload looks for rock under the body (review, A3: standing
                  ;; in an opened stone's cell, a reload sent you to the entry)
                  (let* ((wm (content-map ct))
                         (wm (worldmap wm tiles: (open-stone-tiles (worldmap-tiles wm) (kept-stones *world*)))))
                    (set! *world* (populate (world-reload *world* wm fallback) *world* *carry0*))))))
            ps)))

    (define (shell-stick-form) (settings-value *settings* 'stick))

    ;; form: 'float or 'fixed; stored for the next boot.
    (define (shell-set-stick-form! form)
      (set! *settings* (settings-with *settings* 'stick form))
      (store-write-datum! "stick" (settings-value *settings* 'stick)))

    (define (shell-set-ms! on) (set! *ms* on))

    ;; --- input ------------------------------------------------------------------

    (define (shell-key-down! k)
      ;; a fresh press only (review: a key held through the start screen's fade
      ;; autorepeats on the web and would skip the card)
      (unless (memq k *keys*) (set! *key-edge* #t))
      (set! *gesture* #t)
      (unless (memq k *keys*)
        (set! *keys* (cons k *keys*))
        (when (jump-key? k) (set! *press* #t))))

    (define (shell-key-up! k)
      (set! *keys* (filter (lambda (x) (not (eq? x k))) *keys*)))

    ;; A hidden tab or a lost focus: every key up (a keyup missed while
    ;; hidden would hold the key forever), the stick at rest.
    (define (shell-keys-clear!)
      (set! *keys* '())
      (set! *sector* 'none)
      (set! *touch-jump* #f)
      (set! *press* #f))

    (define (drawn-pos)
      (let ((b (world-body *world*)))
        (cons (exact (floor (body-x b))) (exact (floor (body-y b))))))

    ;; A pending measurement: (list t0 x y applied h v), where t0 is the
    ;; input's stamp, x y the body's drawn pixel then, applied whether a tick
    ;; has used it (IN recorded), h v the direction asked for (MOVE settles on
    ;; motion that way; JUMP ignores them).
    (define (pending-new t h v)
      (let ((p (drawn-pos)))
        (list t (car p) (cdr p) #f h v)))

    ;; A measurement replaced or abandoned before it settled is counted, not
    ;; recorded, so the readout says how many samples it did not keep.
    (define (drop-pending! pending)
      (when pending (set! *lat-dropped* (+ *lat-dropped* 1))))

    ;; The stick at (dx, dy) in ring radii, stamped t (ms, or #f). A new
    ;; direction starts a MOVE measurement (the last one, if unsettled, is
    ;; dropped); rest drops it.
    (define (shell-stick! dx dy t)
      (let ((s (stick-sector dx dy *sector*)))
        (unless (eq? s *sector*)
          (set! *sector* s)
          (drop-pending! *pending-move*)
          (set! *pending-move*
                (and t
                     (not (eq? s 'none))
                     (let ((hv (sector->hv s)))
                       (pending-new t (car hv) (cdr hv))))))))

    ;; The touch jump button down (#t) or up (#f), stamped t.
    (define (shell-jump! down t)
      (when (and down (not *touch-jump*))
        (set! *press* #t)
        (when t
          (drop-pending! *pending-jump*)
          (set! *pending-jump* (pending-new t 0 0))))
      (set! *touch-jump* down))

    (define (shell-set-frame-stamp! ms) (set! *frame-stamp* ms))

    ;; The stick's direction in force (the web shell traces its changes).
    (define (shell-sector) *sector*)

    ;; --- one frame ----------------------------------------------------------------

    ;; dt: the frame's wall seconds. Returns the ticks run. Notes whether any
    ;; tick launched a jump or a wall kick (JUMP settles on that).
    ;; A4 look: ?look=start|card, --look start|card: the start screen (D32)
    ;; or the Flux Harmonic card (D33) alone, to look at, drawn by (harkfell
    ;; title) as the frame draws them; the card comes round every 5.5 s. A
    ;; look begins no game: the frame and the save stay the plain boot's.
    (define *look* #f)            ; #f, start or card
    (define *look-s* 0.0)         ; seconds since the look began
    (define *look-alpha* #f)      ; a pinned alpha for the card or the reveal (review shots)
    (define (shell-set-look-alpha! a) (set! *look-alpha* a))

    (define (shell-set-look! look kind)
      (set! *look* look)
      (set! *look-s* 0.0)
      (set! *input-kind* kind))

    (define (present-look! win-w win-h)
      (begin-frame)
      (set-blend-mode (quote normal))
      (if (eq? *look* (quote card))
          (let ((s (- *look-s* (* 5.5 (floor (/ *look-s* 5.5))))))
            (draw-card! win-w win-h (or *look-alpha* (card-fade s)) *look-s*))
          (draw-start! win-w win-h (min 1.0 (/ *look-s* 1.5)) *look-s*
                       (and *pointer* (car *pointer*)) (and *pointer* (cdr *pointer*))
                       #t *input-kind*))
      (end-frame))

    (define (shell-frame! dt)
      (set! *frame-start* (now-ms))
      (set! *frame-ms* (* 1000.0 dt))
      (set! *clock* (clock-advance *clock* dt))
      (set! *launched* #f)
      (when *look* (set! *look-s* (+ *look-s* dt)))
      ;; A4: the frame steps in wall time until it plays; each phase entered
      ;; goes to the listeners (the sound, the page's trace)
      (when *frame*
        (unless (frame-playing? *frame*)
          (set! *frame* (frame-step *frame* dt *key-edge* *gesture*))
          (set! *wall* (+ *wall* dt)))
        (let ((p (frame-take-events *frame*)))
          (set! *frame* (cdr p))
          (for-each (lambda (ev)
                      ;; review: a jump pressed (or a key still held) to leave the start
                      ;; screen or skip the card must not move the creature on the
                      ;; dawn's first tick (D15: the first input in the world is yours)
                      (when (eq? ev 'dawn) (shell-keys-clear!))
                      (for-each (lambda (f) (f ev)) *frame-listeners*))
                    (car p))))
      (set! *key-edge* #f)
      (set! *gesture* #f)
      (let loop ((i 0))
        (when (and (< i (clock-steps *clock*)) (eq? *mode* 'play) (not *still*) (not (memq *look* (list (quote start) (quote card))))
                   (or (not *frame*) (frame-world-steps? *frame*)))
          (let ((in (tick-intent *keys* *sector* *touch-jump* *press*)))
            (set! *press* #f)
            ;; the creature wakes on the first input (D15: the first input is yours)
            (when (and *waking* (or (not (= (intent-h in) 0)) (not (= (intent-v in) 0)) (intent-jump in)))
              (set! *waking* #f))
            (let ((vy0 (body-vy (world-body *world*))))   ; A4 sound: the fall speed before the tick
              (set! *world* (world-tick *world* in))
              (for-each (lambda (e) (set! *body-events* (cons (cons e vy0) *body-events*)))
                        (body-events (world-body *world*))))
            (let ((ev (body-events (world-body *world*))))
              (when (or (memq 'jump ev) (memq 'wall-jump ev))
                (set! *launched* #t))))
          (loop (+ i 1))))
      (let ((p (world-take-news *world*)))
        (set! *world* (cdr p))
        (set! *frame-news* (car p))
        (draw-news! (car p) (world-ticks *world*))
        ;; D35: the first homecoming. The home stone rings, the save has had no
        ;; showing: the wordmark begins (and the save says so at once below)
        (when (and *saving* *home-stone* (not *revealed*)
                   (find (lambda (n) (and (eq? (car n) 'ring)
                                          (= (cadr n) (car *home-stone*))
                                          (< (abs (- (caddr n) (cadr *home-stone*))) 1.0)
                                          (< (abs (- (cadddr n) (caddr *home-stone*))) 1.0)))
                         (car p)))
          (set! *revealed* #t)
          (set! *reveal-t* 0.0)
          (set! *reveal-sch* (reveal-schedule (let ((m (*moment-clock*)))
                                                (and (pair? m) (equal? (car m) "hollow-answers") (cdr m)))))
          (for-each (lambda (f) (f 'reveal)) *frame-listeners*)))
      (when *reveal-t*
        (set! *reveal-t* (+ *reveal-t* dt))
        (when (reveal-done? *reveal-sch* *reveal-t*) (set! *reveal-t* #f)))
      (when (and *saving* (or (not *frame*) (frame-world-steps? *frame*)) (world-gates *world*))
        (save-if-changed!))
      (set! *step-ms* (- (now-ms) *frame-start*))
      (clock-steps *clock*))

    ;; --- the latency record ---------------------------------------------------------

    (define (keep l x)
      (let ((l (cons x l)))
        (if (> (length l) LAT-KEEP) (list-head l LAT-KEEP) l)))

    (define (list-head l n)
      (if (or (= n 0) (null? l)) '() (cons (car l) (list-head (cdr l) (- n 1)))))

    (define (sign n) (cond ((> n 0) 1) ((< n 0) -1) (else 0)))

    ;; After the frame's draw: settle the pending measurements. end: the
    ;; frame's end on the stamp clock (a lower bound on the glass: the time
    ;; from the rAF timestamp to the callback's start is not in it, nor the
    ;; compositor's vsync after it).
    ;;   IN     the first frame whose ticks used the input
    ;;   MOVE   the first frame that draws the body a pixel along the asked
    ;;          direction (h or v); motion any other way does not settle it
    ;;   JUMP   the first frame in which a tick launched a jump or a kick
    ;; A measurement older than LAT-GIVE-UP ms (a push into a wall, a press
    ;; that launched nothing) is dropped and counted.
    (define (settle-latency! ticks end)
      (let ((p (drawn-pos)))
        (define (settle pending done? into!)
          (cond ((not pending) #f)
                ((> (- end (car pending)) LAT-GIVE-UP) (drop-pending! pending) #f)
                (else
                 (let* ((t0 (car pending))
                        (applied (or (cadddr pending)
                                     (and (> ticks 0)
                                          (begin (set! *lat-in* (keep *lat-in* (- end t0))) #t)))))
                   (if (done? pending)
                       (begin (into! (- end t0)) #f)
                       (list t0 (cadr pending) (caddr pending) applied
                             (list-ref pending 4) (list-ref pending 5)))))))
        (set! *pending-move*
              (settle *pending-move*
                      (lambda (pd)
                        (let ((h (list-ref pd 4))
                              (v (list-ref pd 5)))
                          (or (and (not (= h 0)) (= (sign (- (car p) (cadr pd))) h))
                              (and (not (= v 0)) (= (sign (- (cdr p) (caddr pd))) v)))))
                      (lambda (ms) (set! *lat-move* (keep *lat-move* ms)))))
        (set! *pending-jump*
              (settle *pending-jump*
                      (lambda (pd) *launched*)
                      (lambda (ms) (set! *lat-jump* (keep *lat-jump* ms)))))))

    (define (ms-str x) (number->string (exact (round x))))

    (define (tenths x)
      (let* ((t (exact (round (* 10 x)))))
        (string-append (number->string (quotient t 10)) "." (number->string (modulo t 10)))))

    (define (stat-line name l)
      (if (null? l)
          (string-append name " -")
          (string-append name " " (ms-str (car l))
                         " avg " (ms-str (/ (apply + l) (length l)))
                         " max " (ms-str (apply max l)))))

    (define (shell-latency-lines)
      (list (stat-line "in" *lat-in*)
            (stat-line "move" *lat-move*)
            (string-append (stat-line "jump" *lat-jump*)
                           " drop " (number->string *lat-dropped*))))

    ;; --- the present ------------------------------------------------------------------

    (define (ensure-targets! f)
      (unless *room-rt*
        (set! *room-rt* #t))
      (when (and (eq? (fit-mode f) 'sharp) (not (= (fit-up f) *sharp-up*)))
        (when *sharp-rt* (render-target-free! *sharp-rt*))
        (set! *sharp-up* (fit-up f))
        (set! *sharp-rt* (make-render-target (* VIEW-W *sharp-up*) (* VIEW-H *sharp-up*) 'linear))))

    ;; Draw the frame onto a window of win-w x win-h pixels. ticks: what
    ;; shell-frame! ran (for the latency record).
    (define (shell-present! win-w win-h ticks)
      (cond ((memq *look* (list (quote start) (quote card))) (present-look! win-w win-h))
            ((and *frame* (not (frame-world-visible? *frame*))) (present-front! win-w win-h))
            ((and *content* (not (eq? *mode* 'play))) (present-overview! win-w win-h))
            (else (present-room! win-w win-h ticks))))

    ;; A4: the start screen, the card, the black between: drawn in window
    ;; pixels ((harkfell title): the start screen and the card each draw their
    ;; own pixel view through the palette pass, and IM Fell over it).
    (define (present-front! win-w win-h)
      (begin-frame)
      (set-blend-mode 'normal)
      (case (frame-phase *frame*)
        ((start-in start start-out)
         (draw-start! win-w win-h (frame-words-alpha *frame*) *wall*
                       (and *pointer* (car *pointer*)) (and *pointer* (cdr *pointer*))
                       (frame-web? *frame*) *input-kind*))
        ((card) (draw-card! win-w win-h (frame-card-alpha *frame*) *wall*))
        (else (set-color 0.0 0.0 0.0 1.0) (draw-filled-rect 0 0 win-w win-h)))
      (end-frame))

    ;; The sheet or the atlas: one target the size of the overview, fitted
    ;; to the window (at a whole scale when one fits).
    (define (present-overview! win-w win-h)
      (let* ((rooms (overview-rooms))
             (sz (overview-size rooms (overview-k) (overview-gap))))
        (unless (and *view-rt* (= *view-w* (car sz)) (= *view-h* (cadr sz)))
          (when *view-rt* (render-target-free! *view-rt*))
          (set! *view-w* (car sz))
          (set! *view-h* (cadr sz))
          (set! *view-rt* (make-render-target *view-w* *view-h* 'nearest)))
        (let ((f (view-fit win-w win-h *view-w* *view-h*)))
          (set! *last-fit* f)
          (begin-frame)
          (set-blend-mode 'normal)
          ;; each room drawn and resolved in the palette pass, once ((harkfell draw))
          (prepare-overview! rooms)
          (with-render-target *view-rt*
            (set-blend-mode 'normal)
            (draw-overview rooms (overview-k) (overview-gap) #t))
          (with-blend-mode 'none (draw-render-target *view-rt* (fit-x f) (fit-y f) (fit-w f) (fit-h f)))
          (end-frame))))

    (define (present-room! win-w win-h ticks)
      (let ((t1 (now-ms))
            (f (view-fit win-w win-h VIEW-W VIEW-H)))
        (ensure-targets! f)
        (set! *last-fit* f)
        (begin-frame)
        (set-blend-mode 'normal)
        ;; the room as palette slots, resolved into (harkfell render)'s colour
        ;; target ((harkfell draw)'s present-play!); the ears in the same pass,
        ;; in the fur-1 slot
        ;; the look follows the sound: the bed's wind bends the reeds, a
        ;; moment pulls the focus
        (set-look-sound! (sound-moment-playing)
                         (let ((e (assq 'wind (sound-bed-levels)))) (and e (cdr e))))
        ;; D15: the creature curled asleep until the first input
        (set-look-waking! *waking*)
        ;; the dawn (D15), the world coming in from black by the dither, in
        ;; the palette pass: the frame's black joins the world's own dim
        (present-play! *world*
                       (lambda ()
                         (when (and (world-room *world*) (sound-ears) (not (sound-ears-flick)))
                           (let ((o (world-origin *world*)))
                             (draw-ears (world-body *world*) (car o) (cdr o) (sound-ears)
                                        (lambda () (paint-slot! (slot (quote fur-1))))))))
                       (if *frame* (frame-black-alpha *frame*) 0.0))
        ;; The room's target is copied OPAQUE (blend none): a translucent draw
        ;; into it (water, A3's light) lowers the target's own alpha, and
        ;; blended over the black window those pixels came out dark (seen in
        ;; A3's first native shots: every glow a dark disc; the water had it
        ;; since A1).
        (with-blend-mode 'none
          (if (eq? (fit-mode f) 'integer)
              (draw-render-target (room-color-rt) (fit-x f) (fit-y f) (fit-w f) (fit-h f))
              (begin
                (with-render-target *sharp-rt*
                  (draw-render-target (room-color-rt) 0 0 (* VIEW-W *sharp-up*) (* VIEW-H *sharp-up*)))
                (draw-render-target *sharp-rt* (fit-x f) (fit-y f) (fit-w f) (fit-h f)))))
        ;; D35: the wordmark over the live world, at the first homecoming
        ;; ((harkfell title)'s draw-reveal!, on (harkfell reveal)'s schedule)
        (when (> (shell-reveal-alpha) 0.0)
          (draw-reveal! win-w win-h (shell-reveal-alpha) (reveal-shown-t *reveal-sch* *reveal-t*)))
        ;; A4 look: ?look=reveal plays the room with D35's reveal over it, on a
        ;; loop (2 s in, 4 s hold, 2 s out, CONTENT's defaults, then 2 s gone)
        (when (eq? *look* (quote reveal))
          (let ((s (- *look-s* (* 10.0 (floor (/ *look-s* 10.0))))))
            (draw-reveal! win-w win-h
                          (cond (*look-alpha* *look-alpha*) ((< s 2.0) (/ s 2.0)) ((< s 6.0) 1.0) ((< s 8.0) (- 1.0 (/ (- s 6.0) 2.0))) (else 0.0))
                          s)))
        (when *ms*
          (draw-readout (append (list (string-append "frame " (tenths *frame-ms*)
                                                     " step " (tenths *step-ms*)
                                                     " draw " (tenths *draw-ms*))
                                      (string-append (symbol->string (fit-mode f))
                                                     " x" (if (eq? (fit-mode f) 'integer)
                                                              (number->string (fit-scale f))
                                                              (tenths (fit-scale f)))
                                                     " stick " (symbol->string (shell-stick-form))))
                                (shell-latency-lines)
                                (*extra-lines*))
                        (fit-x f) (fit-y f) (fit-w f)
                        (max 1 (exact (floor (/ (fit-scale f) 2))))))
        (end-frame)
        (set! *draw-ms* (- (now-ms) t1))
        (when *frame-stamp*
          (settle-latency! ticks (+ *frame-stamp* (- (now-ms) *frame-start*))))))))
