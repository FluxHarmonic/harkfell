;;; (harkfell haze) - D51's haze step as numbers: how far a music moment has
;;; stepped the sky into the haze, and what a sky slot becomes. No drawing:
;;; (harkfell draw) feeds it the clock and the sound and hands haze-slot's
;;; answers for sky-1..3 to (harkfell render)'s HAZE-FRAGMENT (the rule
;;; lives here alone), and the tests drive it alone.
;;;
;;; While a moment's music sounds (sound-moment-sounding: its tune's rows
;;; still playing), the focus eases from 0 to 1 over HAZE-IN-S; once it
;;; stops, back to 0 over HAZE-OUT-S, by the clock, not by frames drawn (a
;;; slow frame rate must not hold the sky in the haze). The focus picks how
;;; many sky bands stand one step toward the haze, from the horizon up: 1
;;; past 0.25 (sky-3), 2 past 0.5 (sky-2 too), 3 past 0.75 (sky-1 too). A
;;; slot steps at most once, from the base backdrop, so a second moment can
;;; never stack another step: the sky is the base palette plus at most one.
;;;
;;;   (haze-focus-next focus on? dt)  the focus dt seconds on
;;;   (haze-bands focus)              how many bands stand stepped, 0..3
;;;   (haze-slot s bands)             base slot s as drawn: s, or s+1 for a
;;;                                   stepped sky band (s 0..2)
;;;   HAZE-IN-S HAZE-OUT-S            the ease, seconds each way

(define-library (harkfell haze)
  (export haze-focus-next haze-bands haze-slot HAZE-IN-S HAZE-OUT-S)

  (begin
    ;; D16's ease in (about a second), and out within D16's 0.35 s: the last
    ;; band is back at 0.75 of it (0.26 s), the plain backdrop at 0.35 s.
    (define HAZE-IN-S 0.9)
    (define HAZE-OUT-S 0.35)

    (define (haze-focus-next focus on? dt)
      (let ((d (max 0.0 (* 1.0 dt))))
        (if on?
            (min 1.0 (+ focus (/ d HAZE-IN-S)))
            (max 0.0 (- focus (/ d HAZE-OUT-S))))))

    (define (haze-bands focus)
      (cond ((> focus 0.75) 3)
            ((> focus 0.5) 2)
            ((> focus 0.25) 1)
            (else 0)))

    ;; sky-3 (slot 2) steps with the first band, sky-2 with the second,
    ;; sky-1 with the third; every other slot is left as it is
    (define (haze-slot s bands)
      (if (and (<= 0 s 2) (<= (- 3 s) bands)) (+ s 1) s))))
