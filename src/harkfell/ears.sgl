;;; (harkfell ears) - The listening ears (harkfell-design section 3, "The
;;; loop" 2): standing still, the creature's ears rise and point toward the
;;; strongest finding tone, the cue for a mono speaker and for a player who
;;; cannot hear.
;;;
;;; Drawn over the body (A0's pale block with ears, (harkfell draw)'s
;;; draw-body-at) in the room's target, after the room: the resting ears
;;; are two 1x3 strokes at the box's top; listening they grow two pixels and
;;; lean toward the tone (left, right), stand straight (up), or lie out flat
;;; (below). In the colour of the world palette's fur-1 (A1's placeholder
;;; #e8e0cf), so they read as the same ears grown, not a marker.
;;;
;;;   (draw-ears b ox oy dir [paint])   b: the body; ox oy: the room's origin in world
;;;                             pixels; dir: up | left | right | below | #f
;;;                             paint: a thunk that sets the colour (the palette
;;;                             pass sets the fur-1 slot); by default fur-1's colour

(define-library (harkfell ears)
  (import (sigil core)
          (sigil math)
          (sigil graphics)
          (engine body))

  (export draw-ears)

  (begin
    (define (px x y) (draw-filled-rect x y 1 1))

    (define (draw-ears b ox oy dir . paint)
      (when dir
        (let ((x (- (exact (floor (- (body-x b) ox))) 1))
              (y (exact (floor (- (body-y b) oy)))))
          (if (pair? paint) ((car paint)) (set-color 0.910 0.878 0.812 1.0))
          (case dir
            ((up)
             (draw-filled-rect (+ x 2) (- y 2) 1 5)
             (draw-filled-rect (+ x 7) (- y 2) 1 5))
            ((left right)
             (let ((s (if (eq? dir 'left) -1 1)))
               (for-each (lambda (ex)
                           (draw-filled-rect ex y 1 3)
                           (px (+ ex s) (- y 1))
                           (px (+ ex s s) (- y 2)))
                         (list (+ x 2) (+ x 7)))))
            ((below)
             (draw-filled-rect (- x 1) (+ y 3) 3 1)
             (draw-filled-rect (+ x 8) (+ y 3) 3 1))
            (else #f)))))))
