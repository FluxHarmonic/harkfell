;;; (harkfell world) - The rooms, one body, room changes and the soft return.
;;;
;;; The world steps at the fixed 60 Hz tick: the shells feed it one INTENT
;;; per tick ((engine body)), whatever device the intent came from.
;;;
;;; The body lives in global pixels on the world map's one tilemap ((engine
;;; worldmap)), so it walks, falls and jumps across a seam with no special
;;; case. The ROOM it is in is the slot its center is in; the tick its
;;; center crosses into another room, that room becomes the current one.
;;;
;;; The ENTRY, where a soft return puts you, is always a body standing on
;;; ground. Crossing a seam on foot, the body at the crossing is the entry
;;; ("where you entered", A0's note). Crossing it in the air (falling through
;;; a hole, jumping up through a gap), the entry is PROVISIONAL: it stays the
;;; last grounded body (in the room you came from) until the body first
;;; stands in the new room, and that becomes the entry. Without this, a hole
;;; that drops into a hazard returned you to the fall itself, over and over
;;; (a softlock; found by the A1 review with a two-room world).
;;;
;;; The soft return (ruling D4): touching a hazard dims the screen for half
;;; a second and puts you back at the current room's entry. No lives, no
;;; death animation. DIM-TICKS going dark (input ignored, the body holds
;;; still), the body back at the entry, DIM-TICKS coming back. RETURNS
;;; counts them (the tests and the ?trace line read it). The low tone of
;;; section 3 is A2's (sound).
;;;
;;; A0's single room still works as it did: world-new takes an (engine room)
;;; and makes a one-room map of it at (0, 0), its entry the @ marker. The
;;; replay gate's trace is unchanged by the room machinery (it never leaves
;;; that room).
;;;
;;; Live reload (native): world-reload swaps in a new map; the body stays
;;; where it is unless the new rooms put it inside rock, when it goes back
;;; to the entry (or, if that is rock too, to the room's start).

(define-library (harkfell world)
  (import (sigil struct)
          (sigil math)
          (engine tilemap)
          (engine collide)
          (engine room)
          (engine body)
          (engine worldmap)
          (engine reach)
          (engine tween)
          (harkfell feel)
          (harkfell gates)
          (harkfell creatures))

  (export world world? world-new world-at
          world-room world-body world-entry world-phase world-timer
          world-ticks world-returns world-tiles world-map world-entered
          world-tick world-dim DIM-TICKS world-reload world-reset
          world-origin
          entry-body cell-body
          world-gates world-carry world-news world-still world-take-news world-populate
          world-stones world-pickups world-critters)

  (begin
    (define DIM-TICKS 15)

    ;; wm: the world map. room: the placed room the body is in. phase:
    ;; play, dark (dimming out), light (coming back). timer: ticks left in
    ;; the phase. ticks: every tick stepped. entered: rooms entered (a room
    ;; change counts; the first room does not).
    (define-struct world
      (wm default: #f)
      (room default: #f)
      (body default: #f)
      (entry default: #f)
      (phase default: 'play)
      (timer default: 0)
      (ticks default: 0)
      (returns default: 0)
      (entered default: 0)
      (ground default: #f)          ; the last body that stood on ground
      (provisional default: #f)     ; the entry is waiting for the first standing tick
      ;; A3: the harmonics carried, the pickups left, the ring-stones ((harkfell
      ;; gates)); #f in A0's room. still: ticks the body has stood at rest.
      ;; news: what happened since the shell last took it (the sound's cues).
      (gates default: #f)
      (critters default: #f)        ; the current room's creatures ((harkfell creatures)), with gates
      (still default: 0)
      (news default: '()))

    (define (world-carry w) (if (world-gates w) (gstate-carry (world-gates w)) '()))
    (define (world-stones w) (if (world-gates w) (gstate-stones (world-gates w)) '()))
    (define (world-pickups w) (if (world-gates w) (gstate-pickups (world-gates w)) '()))

    ;; The world with its gates: stones and pickups (global cells) and the
    ;; carry. Pickups of a harmonic already carried are gone, and open stones
    ;; open the tilemap.
    (define (world-populate w stones pickups carry)
      (let* ((carry (carry-normal carry))
             (tm (open-stone-tiles (world-tiles w) stones)))
        (world w
               wm: (worldmap (world-wm w) tiles: tm)
               critters: (room-critters (world-wm w) (world-room w))
               gates: (gstate stones: stones
                              pickups: (filter (lambda (p) (not (memv (pickup-overtone p) carry))) pickups)
                              carry: carry
                              tiles: tm))))

    ;; The news, and the world without it.
    (define (world-take-news w) (cons (world-news w) (world w news: '())))

    (define (world-map w) (world-wm w))
    (define (world-tiles w) (worldmap-tiles (world-wm w)))

    ;; The current room's top-left in global pixels.
    (define (world-origin w)
      (if (world-room w)
          (worldmap-origin (world-wm w) (world-room w))
          (cons 0 0)))

    ;; The body standing in cell (c, r) of a tilemap, centered (A0's entry).
    (define (cell-body tm f c r)
      (stand-body tm f c r))

    ;; The body standing in the room's @ cell (A0).
    (define (entry-body r f)
      (let ((cell (or (room-marker r 'entry) (cons 1 1))))
        (cell-body (room-tiles r) f (car cell) (cdr cell))))

    ;; A0: one room, alone.
    (define (world-new r)
      (let* ((p (placed x: 0 y: 0 tiles: (room-tiles r)))
             (wm (make-worldmap (list p) (tilemap-cols (room-tiles r)) (tilemap-rows (room-tiles r))
                                (tilemap-size (room-tiles r))))
             (b (entry-body r HARKFELL-FEEL)))
        (world wm: wm room: (worldmap-room wm 0 0) body: b entry: b ground: b)))

    ;; A world on map wm with the body b (global pixels) as the entry.
    (define (world-at wm b)
      (let ((c (body-center b HARKFELL-FEEL)))
        (world wm: wm room: (worldmap-room-at-px wm (car c) (cdr c)) body: b entry: b ground: b)))

    (define (same-room? a b)
      (and a b (= (placed-x a) (placed-x b)) (= (placed-y a) (placed-y b))))

    (define (grounded? b) (eq? (body-mode b) 'ground))

    ;; A body kept to return to is kept at rest (A0's entry always was): a
    ;; return to a lip while still running would carry the body straight
    ;; back over it.
    (define (at-rest b)
      (body b vx: 0.0 vy: 0.0 jumping: #f cut: #f coyote: 0 buffer: 0 lock: 0 events: '()))

    ;; After a play tick: a room change sets the new room's entry (the body,
    ;; on foot; else the last grounded body, provisionally), and a standing
    ;; tick settles a provisional entry and is remembered.
    (define (follow-room w)
      (let* ((b (world-body w))
             (c (body-center b HARKFELL-FEEL))
             (p (worldmap-room-at-px (world-wm w) (car c) (cdr c)))
             (w (if (and p (not (same-room? p (world-room w))))
                    (if (grounded? b)
                        (world w room: p entry: (at-rest b) provisional: #f entered: (+ (world-entered w) 1))
                        (world w room: p entry: (or (world-ground w) (world-entry w)) provisional: #t
                               entered: (+ (world-entered w) 1)))
                    w)))
        (if (grounded? b)
            (let ((r (at-rest b)))
              (world w ground: r
                     entry: (if (world-provisional w) r (world-entry w))
                     provisional: #f))
            w)))

    ;; The gates after a tick: the pickups the body touched, the stones it
    ;; came near; an opened stone opens the world's tilemap.
    (define (gates-tick w)
      (let ((g (world-gates w)))
        (if (not g)
            w
            (let* ((b (world-body w))
                   (f HARKFELL-FEEL)
                   (g2 (gates-step (gstate g tiles: (world-tiles w) news: '())
                                   (body-center b f)
                                   (list (body-x b) (body-y b) (feel-box-w f) (feel-box-h f))
                                   (eq? (world-phase w) 'play)))
                   (tm (gstate-tiles g2)))
              (world w
                     wm: (if (eq? tm (world-tiles w)) (world-wm w) (worldmap (world-wm w) tiles: tm))
                     gates: (gstate g2 news: '())
                     news: (append (world-news w) (gstate-news g2)))))))

    (define (still-tick w)
      (let ((b (world-body w)))
        (world w still: (if (and (eq? (world-phase w) 'play) (eq? (body-mode b) 'ground)
                                 (< (abs (body-vx b)) 0.01) (< (abs (body-vy b)) 0.01))
                            (+ (world-still w) 1)
                            0))))

    ;; The creatures of the room p (a placed room whose data is a content
    ;; room), or #f outside the written world.
    (define (room-critters wm p)
      (and p (placed-data p)
           (let ((o (worldmap-origin wm p)))
             (critters-new (placed-data p) (car o) (cdr o)))))

    ;; The creatures after a tick; the room changed: the new room's.
    (define (critters-tick w before)
      (if (not (world-gates w))
          w
          (let* ((cs (if (eq? (world-room w) (world-room before))
                         (world-critters w)
                         (room-critters (world-wm w) (world-room w)))))
            (if (not cs)
                (world w critters: #f)
                (let* ((c (body-center (world-body w) HARKFELL-FEEL))
                       (b (world-body w))
                       (cs2 (critters-step cs (car c) (cdr c) (world-still w) (world-carry w)
                                           (eq? (world-phase w) 'play)
                                           (sqrt (+ (* (body-vx b) (body-vx b)) (* (body-vy b) (body-vy b)))))))
                  (world w critters: (critters cs2 news: '())
                         news: (append (world-news w) (critters-news cs2))))))))

    (define (world-tick w in)
      (critters-tick (still-tick (gates-tick (world-tick-body w in))) w))

    (define (world-tick-body w in)
      (let ((w (world w ticks: (+ (world-ticks w) 1))))
        (case (world-phase w)
          ((play)
           (let ((b (body-step (world-body w) in (world-tiles w) HARKFELL-FEEL)))
             (if (memq 'hazard (body-events b))
                 (world w body: b phase: 'dark timer: DIM-TICKS)
                 (follow-room (world w body: b)))))
          ((dark)
           (if (<= (world-timer w) 1)
               (world w
                      body: (world-entry w)
                      phase: 'light
                      timer: DIM-TICKS
                      returns: (+ (world-returns w) 1))
               (world w timer: (- (world-timer w) 1))))
          (else
           (if (<= (world-timer w) 1)
               (world w phase: 'play timer: 0)
               (world w timer: (- (world-timer w) 1)))))))

    ;; Back to the current room's entry at once (the R key).
    (define (world-reset w)
      (world w body: (world-entry w) phase: 'play timer: 0))

    ;; In rock or in a hazard: not a place to leave a body after a reload.
    (define (inside-rock? tm b)
      (box-any? tm (body-x b) (body-y b) (feel-box-w HARKFELL-FEEL) (feel-box-h HARKFELL-FEEL)
                (lambda (k) (or (kind-solid? k) (kind-hazard? k)))))

    ;; The world on a new map (a room file changed). fallback: a body to use
    ;; when both the body and the entry are inside rock now.
    (define (world-reload w wm fallback)
      (let* ((tm (worldmap-tiles wm))
             (room (and (world-room w)
                        (worldmap-room wm (placed-x (world-room w)) (placed-y (world-room w)))))
             (entry (if (inside-rock? tm (world-entry w)) fallback (world-entry w)))
             (b (if (inside-rock? tm (world-body w)) entry (world-body w))))
        (world w wm: wm room: (or room (world-room w)) body: b entry: entry gates: #f
               ground: (if (inside-rock? tm (or (world-ground w) entry)) entry (world-ground w)))))

    ;; How dark the screen is, 0 (clear) to 1 (black), eased.
    (define (world-dim w)
      (let ((p (/ (* 1.0 (world-timer w)) DIM-TICKS)))
        (case (world-phase w)
          ((dark) (ease 'in-out-quad (- 1.0 p)))
          ((light) (ease 'in-out-quad p))
          (else 0.0))))))
