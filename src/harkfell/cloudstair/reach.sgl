;;; Cloudstair's exact replay adapter. Engine owns movement/time; Harkfell
;;; owns harmonic pickup and Cattails acquisition. A larger carry starts at
;;; actual contact and keeps that body's phase, including during a flight.
(define-library (harkfell cloudstair reach)
  (import (sigil list)
          (sigil math)
          (engine body)
          (engine air)
          (engine tilemap)
          (engine worldmap)
          (engine reach)
          (engine reach timed)
          (engine reach waits)
          (harkfell content)
          (harkfell feel)
          (harkfell check)
          (harkfell down))

  (export cloudstair-stepper cloudstair-tile-provider cloudstair-entry-phases
          cloudstair-shelter? cloudstair-shelter-checker
          cloudstair-waiter
          cloudstair-window cloudstair-diagnostic-profiles
          cloudstair-search cloudstair-progress)

  (begin
    (define (cloudstair-tiles ct)
      (let ((tiles '()))
        (lambda (carry)
          (let ((prior (assoc carry tiles)))
            (if prior
                (cdr prior)
                (let ((tm (tiles-carrying ct carry)))
                  (set! tiles (cons (cons carry tm) tiles))
                  tm))))))

    (define (cloudstair-tile-provider ct) (cloudstair-tiles ct))

    (define (cloudstair-stepper ct)
      (cloudstair-advance ct (cloudstair-tiles ct)))

    (define (cloudstair-advance ct tiles-for)
      (let ((wm (content-map ct))
            (pickups (content-pickup-cells ct)))
        (lambda (node in)
          (let* ((carry (timed-node-data node))
                 (tm (tiles-for carry))
                 (b (body-step (timed-node-body node) in tm HARKFELL-FEEL))
                 (center (body-center b HARKFELL-FEEL))
                 (p (worldmap-room-at-px wm (car center) (cdr center)))
                 (rm (and p (placed-data p))))
            (and p (not (memq 'hazard (body-events b)))
                 (let* ((carry (carry-union carry
                                 (map car (filter (lambda (pickup)
                                                    (body-touches? tm b (cdr pickup)))
                                                  pickups))))
                        (down (or (body-down b)
                                  (down-touched? rm (worldmap-origin wm p) b HARKFELL-FEEL carry))))
                   (timed-node body: (body b down: down) data: carry)))))))

    ;; Artificial diagnostic seeds cover all phases independently. The
    ;; progression search uses its actual acquisition/arrival nodes instead.
    (define (cloudstair-entry-phases ct cell carry down)
      (let ((tm (tiles-carrying ct carry)))
        (map (lambda (tau)
               (timed-node body: (body (stand-body tm HARKFELL-FEEL (car cell) (cdr cell))
                                       down: down tau: tau)
                           data: carry))
             (iota AIR-PERIOD))))

    ;; Sixteen harmonic subsets, each with and without down. Diagnostic seeds
    ;; never stand in for the actual contact transitions in progression.
    (define (cloudstair-diagnostic-profiles)
      (apply append
        (map (lambda (mask)
               (let ((carry (filter (lambda (harmonic)
                                      (odd? (quotient mask (expt 2 (- harmonic 2)))))
                                    '(2 3 4 5))))
                 (list (cons carry #f) (cons carry #t))))
             (iota 16))))

    ;; Region policies must include physical routes and aerial recoveries.
    ;; The returned graph is evidence, not a whole-world acceptance verdict:
    ;; authors must also check required cells, windows and sabotage controls.
    (define (cloudstair-search ct starts policies home? bound . prior)
      (let* ((tiles-for (cloudstair-tiles ct))
             (advance (cloudstair-advance ct tiles-for)))
        (timed-search starts advance policies
                      (lambda (node)
                        (timed-shelter? (tiles-for (timed-node-data node))
                                        HARKFELL-FEEL advance node))
                      home? bound
                      (if (pair? prior) (car prior) '())
                      (lambda (node)
                        (timed-memo-key (tiles-for (timed-node-data node))
                                        HARKFELL-FEEL node)))))

    ;; The only progression seed is the real world start, with neither gift
    ;; nor harmonic and phase zero. Larger states arise only inside advance.
    (define (cloudstair-progress ct policies bound)
      (let* ((cell (start-cell ct))
             (tm (tiles-carrying ct '()))
             (b (and cell (real-stand-body tm HARKFELL-FEEL (car cell) (cdr cell)))))
        (and b
             (cloudstair-search ct (list (timed-node body: b)) policies
               (lambda (node)
                 (let ((b (timed-node-body node)))
                   (and (eq? (body-mode b) 'ground)
                        (= (body-vx b) 0) (= (body-vy b) 0)
                        (equal? cell (rest-cell (tiles-carrying ct (timed-node-data node))
                                               HARKFELL-FEEL b)))))
               bound))))

    (define (cloudstair-shelter? ct advance node)
      (timed-shelter? (tiles-carrying ct (timed-node-data node))
                      HARKFELL-FEEL advance node))

    (define (cloudstair-waiter ct advance)
      (let ((tiles-for (cloudstair-tiles ct)) (waiters '()))
        (lambda (node target)
          (let* ((carry (timed-node-data node)) (prior (assoc carry waiters))
                 (waiter (if prior (cdr prior)
                             (timed-waiter (tiles-for carry) HARKFELL-FEEL advance))))
            (unless prior (set! waiters (cons (cons carry waiter) waiters)))
            (waiter node target)))))

    ;; A full-cycle stillness certificate covers every cyclic rotation of
    ;; that same actual rest. Remove tau only from this certificate's key;
    ;; movement, arrivals and route memo keys retain the actual phase.
    (define (cloudstair-shelter-checker ct advance)
      (let ((tiles-for (cloudstair-tiles ct)) (certificates #{}))
        (lambda (node)
          (let ((key (timed-key
                       (timed-node node body: (body (timed-node-body node) tau: 0)))))
            (if (dict-contains? certificates key)
                (dict-ref certificates key)
                (let ((safe (timed-shelter? (tiles-for (timed-node-data node))
                                           HARKFELL-FEEL advance node)))
                  (set! certificates (dict-set certificates key safe))
                  safe))))))

    (define (cloudstair-window ct advance start family arrives? phase)
      (and (cloudstair-shelter? ct advance start)
           (timed-window advance start family arrives?
                         (if (eq? phase 'gust) 360 0)
                         (if (eq? phase 'gust) 479 239)
                         120)))))
