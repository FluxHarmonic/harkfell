;;; Constructive regional reach: frozen geometry supplies candidate scripts
;;; only. Every accepted route starts at an actual body, retains acquisitions
;;; and phase, and has an independently replayed physical route back out.
(define-library (harkfell cloudstair region)
  (import (sigil list) (only (sigil process) getenv) (only (sigil gc) gc-stats)
          (engine body) (engine air) (engine tilemap) (engine worldmap)
          (engine reach) (engine reach timed) (engine reach routes) (engine reach prof)
          (engine reach geopool) (only (engine reach pool) pool-verify!)
          (harkfell content) (harkfell check) (harkfell feel)
          (harkfell cloudstair reach) (harkfell cloudstair routes))

  (export cloudstair-region-content cloudstair-region-check cloudstair-region-worker
          cloudstair-region-waypoints cloudstair-carry-guides cloudstair-guide-server cloudstair-guide-seeds
          cloudstair-fingerprint
          cloudstair-reached-rooms cloudstair-entrance-probe)

  (begin
    (define (cloudstair-region-content ct)
      (let ((rooms (filter (lambda (p)
                             (or (eq? (room-region (placed-data p)) 'cloudstair)
                                 (member (cons (placed-x p) (placed-y p))
                                         '((6 . 2) (7 . 2) (7 . 3)))))
                           (content-rooms ct))))
        (content ct rooms: rooms wmap: (make-worldmap rooms 25 11 16)
                    start: '(hollow (7 2) (4 3)))))

    ;; Rest states remembered per process by route-rest-memo (about 600 bytes
    ;; each); a bound on memory, not on the search.
    ;; HARKFELL_REGION_LANDING_BOUND=N: a measurement knob, never a gate.
    ;; The check gives up (incomplete, so FAIL) once its retained landings
    ;; reach bound; this raises only that limit, to measure where the
    ;; region would finish. The search bound is unchanged, and a run with it
    ;; set logs (landing-bound-override ...) and is not a gate verdict.
    ;; The return drain's proven-return memo (HARKFELL_REGION_RETURN_MEMO=0
    ;; turns it off, for measuring what it changes).
    (define RETURN-MEMO
      (not (equal? (getenv "HARKFELL_REGION_RETURN_MEMO") "0")))

    (define LANDING-BOUND-OVERRIDE
      (let ((v (getenv "HARKFELL_REGION_LANDING_BOUND")))
        (and v (string->number v))))

    (define REST-MEMO-CAP 120000)
    ;; A worker proves each pose pinned to it once, so it needs fewer.
    (define WORKER-REST-CAP 60000)

    (define (still? node)
      (and node
           (let ((b (timed-node-body node)))
             (and (eq? (body-mode b) 'ground)
                  (= (body-vx b) 0) (= (body-vy b) 0)))))

    (define (last-node trace) (and (pair? trace) (car (reverse trace))))

    ;; Check every reachable cell and the intermediate bodies of its accepted
    ;; witnesses. Entering a room counts even when the flight lands back out
    ;; of it or never touches the room's designated resting place.
    (define (cloudstair-reached-rooms ct graph starts f)
      (let ((wm (content-map ct))
            (tm (graph-tm graph))
            (forward (reach-forward graph starts))
            (reached '()))
        (define (visit px py)
          (let ((p (worldmap-room-at-px wm px py)))
            (when (and p (eq? (room-region (placed-data p)) 'cloudstair))
              (let ((key (cons (placed-x p) (placed-y p))))
                (unless (member key reached)
                  (set! reached (cons key reached)))))))
        (for-each
          (lambda (cell)
            (when (vector-ref forward (cell-index tm (car cell) (cdr cell)))
              (visit (* (tilemap-size tm) (+ (car cell) 0.5))
                     (* (tilemap-size tm) (+ (cdr cell) 0.5)))
              (for-each
                (lambda (edge)
                  (for-each
                    (lambda (b)
                      (let ((center (body-center b f)))
                        (visit (car center) (cdr center))))
                    (witness-trace tm f (cdr edge))))
                (graph-edges-from graph cell))))
          (graph-cells graph))
        (reverse reached)))

    (define (cloudstair-entrance-probe source)
      (let* ((ct (cloudstair-region-content source))
             (rooms (filter (lambda (p)
                              (or (not (eq? (room-region (placed-data p)) 'cloudstair))
                                  (and (= (placed-x p) 7) (= (placed-y p) 1))))
                            (content-rooms ct)))
             (probe (content ct rooms: rooms wmap: (make-worldmap rooms 25 11 16)))
             (cache #{}))
        ;; The isolate proves all-room exclusion only while A is the sole
        ;; outside border. Refuse a changed map instead of omitting an entry.
        (for-each
          (lambda (a)
            (when (eq? (room-region (placed-data a)) 'cloudstair)
              (for-each
                (lambda (b)
                  (when (and (not (eq? (room-region (placed-data b)) 'cloudstair))
                             (= (+ (abs (- (placed-x a) (placed-x b)))
                                   (abs (- (placed-y a) (placed-y b)))) 1)
                             (not (and (= (placed-x a) 7) (= (placed-y a) 1)
                                       (= (placed-x b) 7) (= (placed-y b) 2))))
                    (error "Cloudstair entrance isolate omits an outside border")))
                (content-rooms source))))
          (content-rooms source))
        (lambda (carry down)
          (let* ((tiles (tiles-carrying probe carry))
                 ;; Cache only identical physical contexts, rather than
                 ;; assuming that harmonics other than H4 cannot matter.
                 (key (list down (tilemap-cells tiles) (tilemap-air tiles))))
            (if (dict-contains? cache key)
                (dict-ref cache key)
                (let* ((start (start-cell probe))
                       (graph (reach-search-down tiles HARKFELL-FEEL
                                                 (list start) witness-lands? down))
                       (reached (cloudstair-reached-rooms probe graph (list start) HARKFELL-FEEL)))
                  ;; No phase-dependent field lies before A in this isolate.
                  ;; The identical negative searched policies therefore hold
                  ;; for all actual clock rotations, without a frozen pulse.
                  ;; A is the sole Hollow/Cloudstair entrance: no visit to any
                  ;; part of A implies no visit to any of the 22 rooms.
                  (set! cache (dict-set cache key reached))
                  reached))))))

    ;; A hash of what a check is built from (tiles with every stone shut and
    ;; every stone open, air fields, start, pickups, rooms): a pool worker must
    ;; report the same one as the check before any of its answers is used.
    (define (cloudstair-fingerprint ct)
      (let ((shut (tiles-carrying ct (quote ()))) (open (tiles-carrying ct (quote (2 3 4 5)))))
        (number->string
          (route-set-digest
            (list (list (tilemap-cols shut) (tilemap-rows shut) (tilemap-size shut)
                        (vector->list (tilemap-cells shut)) (vector->list (tilemap-cells open))
                        (map (lambda (f) (list (air-field-x f) (air-field-y f) (air-field-w f)
                                               (air-field-h f) (air-field-lift f) (air-field-east f)
                                               (air-field-west f) (air-field-pulsed f)
                                               (air-field-gate f)))
                             (tilemap-air shut))
                        (start-cell ct) (content-pickup-cells ct) (content-stone-cells ct)
                        (length (content-rooms ct))))))))

    ;; The spatial guide's tilemap: every stone open, pulsed lifts steady
    ;; (candidates only; every accepted route is replayed on actual fields).
    (define (region-candidate-tm ct)
      (let ((tm (tiles-carrying ct '(2 3 4 5))))
        (tilemap tm air:
          (filter-map (lambda (field)
                        (and (> (air-field-lift field) 0)
                             (air-field field pulsed: #f)))
                      (tilemap-air tm)))))

    ;; A worker for cloudstair-region-check's pool: the same content, advance,
    ;; shelter certificates and waiter as the check builds, answering
    ;; (engine reach routes)' wait and replay requests; and the same spatial
    ;; guide search, answering (engine reach geopool)'s anchor expansions.
    (define (cloudstair-region-worker source)
      (let* ((ct (cloudstair-region-content source))
             (advance (route-rest-memo (cloudstair-stepper ct) WORKER-REST-CAP))
             (routes (route-task-handler advance
                                         (cloudstair-shelter-checker ct advance)
                                         (cloudstair-waiter ct advance)
                                         (cloudstair-fingerprint ct)))
             (geometry #f) (guides #f))
        (lambda (line)
          (cond
            ;; per-(carry, down) guides: cloudstair-guide-builder's requests
            ((and (> (string-length line) 1) (char=? (string-ref line 0) #\S))
             (unless guides (set! guides (cloudstair-guide-server ct)))
             (guides line))
            ((and (> (string-length line) 1) (memv (string-ref line 0) (list #\X #\L #\G)))
              (begin
                (unless geometry
                  (set! geometry
                    (geometry-task-handler
                      (reach-search-down (region-candidate-tm ct) HARKFELL-FEEL
                                         (list (start-cell ct)) witness-lands? #t #f 'serve))))
                (geometry line)))
            (else (routes line))))))

    ;; A guide's tilemap: carry's tiles with every lifting field steady.
    (define (cloudstair-guide-tm tiles-for carry)
      (let ((tm (tiles-for carry)))
        (tilemap tm air:
          (filter-map
            (lambda (field)
              (and (> (air-field-lift field) 0)
                   (air-field field pulsed: #f)))
            (tilemap-air tm)))))

    ;; A worker's side of the builder's pool: it answers "S" geometry
    ;; requests by building the named (carry down starts) search itself.
    (define (cloudstair-guide-server ct)
      (let ((tiles-for (cloudstair-tile-provider ct)))
        (geometry-spec-handler
          (lambda (spec)
            (reach-search-down* (cloudstair-guide-tm tiles-for (car spec)) HARKFELL-FEEL
                                (caddr spec) witness-lands? (cadr spec) #f (quote ()) #f (quote serve))))))

    ;; The global cells of the rooms' things of kind (for example 'down).
    (define (content-thing-cells ct kind)
      (apply append
        (map (lambda (p)
               (let ((rm (placed-data p)))
                 (filter-map (lambda (t)
                               (let ((a (thing-at t)))
                                 (and a (local->global ct rm (car a) (cdr a)))))
                             (room-things-of rm kind))))
             (content-rooms ct))))

    ;; Where a (carry, down) state can begin, from the content alone: home;
    ;; the pickup of each stone carried (touching one acquires it); and, with
    ;; down, every down-touch cell. A guide seeded here depends on (carry,
    ;; down) only, never on which search state first asks for it, so the
    ;; moves it supplies are a function of the state and a different search
    ;; order explores the same states when a search exhausts.
    (define (cloudstair-guide-seeds ct)
      (let ((home (start-cell ct))
            (pickups (content-pickup-cells ct))
            (downs (content-thing-cells ct (quote down))))
        (lambda (carry down)
          (let add ((cells (append (filter-map (lambda (p) (and (memv (car p) carry) (cdr p))) pickups)
                                   (if down downs (quote ()))))
                    (acc (list home)))
            (cond ((null? cells) (reverse acc))
                  ((member (car cells) acc) (add (cdr cells) acc))
                  (else (add (cdr cells) (cons (car cells) acc))))))))

    ;; Spatial guides per (carry, down): carry's tiles with every lifting
    ;; field steady (suggestions only; an accepted edge replays the actual
    ;; pulsed field), searched from (seeds carry down), REUSING the memo of
    ;; the latest guide with the same down. (build carry down) returns the
    ;; guide, building it once per (carry, down); tag names its log lines.
    ;; Until 2026-10-13 the world seeded a guide from home and the cell of the
    ;; first search state that asked, so its moves depended on search order.
    (define (cloudstair-guide-builder tiles-for seeds log tag . pool)
      ;; guides: ((carry . down) . graph), each graph without its REUSE memo and
      ;; one object for its whole life (callers key caches by identity).
      ;; bases: (down . (tm . memo)), the latest guide's memo per down, the only
      ;; memo REUSE ever reads; an older one is dropped when replaced.
      (let ((guides '()) (bases '()))
        (lambda (carry down)
          (let* ((key (cons carry down)) (prior (assoc key guides)))
            (if prior (cdr prior)
                (let* ((tm (cloudstair-guide-tm tiles-for carry))
                       (base (let ((b (assq down bases))) (and b (cdr b))))
                       (starts (seeds carry down)))
                  (log (list tag 'carry carry 'down down 'starting))
                  (let* ((full
                           (reach-search-down* tm HARKFELL-FEEL starts witness-lands? down
                             (and base (cdr base))
                             (if base (tilemap-changes (car base) tm) '())
                             (lambda (anchors steps kind cell)
                               (when (= (modulo anchors 100) 0)
                                 (log (list tag 'carry carry 'down down
                                            'anchors anchors 'steps steps))))
                             ;; with a pool, its workers expand the anchors and walk
                             ;; the candidates REUSE cannot supply
                             (and ROUTE-MEMO (pair? pool) (car pool)
                                  (make-geometry-remote (car pool) (list carry down starts)))))
                         (graph (reach-graph full memo: #f)))
                    (set! bases (cons (cons down (cons tm (graph-memo full)))
                                      (filter (lambda (b) (not (eq? (car b) down))) bases)))
                    (set! guides (cons (cons key graph) guides))
                    (log (list tag 'carry carry 'down down
                               'complete 'stats (graph-stats graph)))
                    ;; HARKFELL_ROUTE_DIGEST: the guide's edges as a hash, so two
                    ;; runs' guides compare exactly. Observation only.
                    (when ROUTE-DIGEST
                      (log (list tag 'carry carry 'down down 'digest (graph-digest graph))))
                    ;; HARKFELL_ROUTE_CHECK: a guide built with REUSE must be the
                    ;; guide a fresh search builds: the same edges and the same
                    ;; counts (work counters aside: steps, repairs, reuse). Slow: a check leg.
                    (when (and ROUTE-CHECK base)
                      (let* ((fresh (reach-search-down* tm HARKFELL-FEEL starts witness-lands? down #f '()))
                             (strip (lambda (stats)
                                      (filter (lambda (e) (not (memq (car e) (quote (steps repairs reused reused-walks)))))
                                              stats))))
                        (unless (and (eq? #t (graph-same-edges? graph fresh))
                                     (equal? (strip (graph-stats graph)) (strip (graph-stats fresh))))
                          (error "route check: a guide built with REUSE differs from a fresh one" carry down))
                        (log (list tag 'carry carry 'down down 'reuse-checked))))
                    graph)))))))

    ;; (lambda (node) guide): the guide for the node's own (carry, down),
    ;; seeded by cloudstair-guide-seeds. The world check's guides.
    (define (cloudstair-carry-guides tiles-for seeds log tag . pool)
      (let ((build (apply cloudstair-guide-builder tiles-for seeds log tag pool)))
        (lambda (node)
          (build (timed-node-data node) (body-down (timed-node-body node))))))

    ;; The region check's guided-queue score, (rank node target): guide hops
    ;; from the node's cell to target in the guide for the node's own
    ;; (carry, down). When that guide has no path (a door this carry cannot
    ;; open), the least over the pickups of a stone the carry lacks of: hops
    ;; to the pickup in this guide, plus hops from the pickup to the target
    ;; in the guide for carry plus that stone. #f when neither has a path.
    ;; It only orders the search (see timed-route-finder's rank).
    (define (cloudstair-carry-rank build pickups cell-of)
      (let ((dists #{}) (last-target #f))
        (define (hops graph key from target)
          ;; key names graph (its carry and down) for the distance cache
          (let* ((k (cons key target))
                 (d (or (dict-ref dists k #f)
                        (let ((d (guide-distances graph target)))
                          (set! dists (dict-set dists k d))
                          d)))
                 (tm (graph-tm graph)))
            (vector-ref d (cell-index tm (car from) (cdr from)))))
        (lambda (node target)
          ;; distances for one target at a time: the region seeks its targets
          ;; in turn, and a vector per (guide, target) would add up
          (unless (equal? target last-target)
            (set! dists #{})
            (set! last-target target))
          (let* ((cell (cell-of node))
                 (carry (timed-node-data node))
                 (down (body-down (timed-node-body node))))
            (and cell
                 (let ((g (build carry down)))
                   (or (hops g (cons carry down) cell target)
                       (let loop ((ps pickups) (best #f))
                         (if (null? ps)
                             best
                             (let* ((stone (car (car ps))) (pc (cdr (car ps)))
                                    (total
                                      (and (not (memv stone carry))
                                           (let ((to-pickup (hops g (cons carry down) cell pc)))
                                             (and to-pickup
                                                  (let* ((more (carry-union carry (list stone)))
                                                         (g2 (build more down))
                                                         (on (hops g2 (cons more down) pc target)))
                                                    (and on (+ to-pickup on))))))))
                               (loop (cdr ps)
                                     (if (and total (or (not best) (< total best))) total best))))))))))))

    ;; A diagnostic, never a verdict: from the profile's actual root, search
    ;; to each waypoint cell in turn, each search starting at the previous
    ;; search's actual arrival (body, phase and carry). The finder, guide,
    ;; certificates and bound are cloudstair-region-check's. Arrivals prove
    ;; a physical route through every waypoint; a failed leg names the gap.
    ;; Logs (waypoint i cell from ... arrival ... expanded-bound? ...).
    (define (cloudstair-region-waypoints source carry down bound waypoints log . pool)
      (let* ((ct (cloudstair-region-content source))
             (verified (and (pair? pool) (car pool)
                            (pool-verify! (car pool) "I" (string-append "I " (cloudstair-fingerprint ct)))))
             (home (start-cell ct))
             (candidate
               (reach-graph
                (reach-search-down (region-candidate-tm ct) HARKFELL-FEEL
                 (list home) witness-lands? #t
                 (lambda (anchors steps kind cell) #t)
                 (and ROUTE-MEMO (pair? pool) (car pool) (make-geometry-remote (car pool))))
                memo: #f))
             (advance (route-rest-memo (cloudstair-stepper ct) REST-MEMO-CAP))
             (tiles-for (cloudstair-tile-provider ct))
             (certs (route-certificate-cache (cloudstair-shelter-checker ct advance)
                                             (cloudstair-waiter ct advance)
                                             (and (pair? pool) (car pool) #t) REST-MEMO-CAP))
             (shelter? (vector-ref certs 0))
             (wait (vector-ref certs 1))
             (incomplete #f))
        (define (cell-of node)
          (and (still? node) (rest-cell (tiles-for (timed-node-data node))
                                     HARKFELL-FEEL (timed-node-body node))))
        ;; Guide hops scored per (carry, down); moves from the region's guide.
        (define rank (cloudstair-carry-rank (cloudstair-guide-builder tiles-for (cloudstair-guide-seeds ct) log (quote rank-candidates)
                                                                     (and (pair? pool) (car pool)))
                                            (content-pickup-cells ct) cell-of))
        (define (summary node)
          (let ((b (timed-node-body node)))
            (list 'cell (cell-of node) 'tau (body-tau b) 'carry (timed-node-data node)
                  'down (body-down b))))
        (log (list 'waypoints 'carry carry 'down down 'bound bound 'cells waypoints))
        (let* ((entries (cloudstair-entry-phases ct home carry down))
               (root (let ((proof (wait (car entries) 0))) (and proof (car proof))))
               (route (timed-route-finder advance tiles-for HARKFELL-FEEL
                        (lambda (node) candidate) shelter? wait bound
                        (lambda (node) #t) (lambda () (set! incomplete #t))
                        (lambda (node target expanded pending depth)
                          (log (list 'waypoint-search 'target target 'expanded expanded
                                     'pending pending 'depth depth 'at (cell-of node)
                                     'tau (body-tau (timed-node-body node)))))
                        (cloudstair-route-proposals ct) (and (pair? pool) (car pool))
                        (vector-ref certs 2) rank)))
          (if (not root)
              (begin (log '(waypoints no-root)) 1)
              (let next-leg ((at root) (cells waypoints) (i 0))
                (cond
                  ((null? cells) (log (list 'waypoints 'all-reached i)) 0)
                  (else
                   (set! incomplete #f)
                   (let ((arrival (route at (car cells))))
                     (log (list 'waypoint i 'cell (car cells) 'from (summary at)
                                'arrival (and arrival (summary arrival))
                                'bound-hit incomplete))
                     (if arrival
                         (next-leg arrival (cdr cells) (+ i 1))
                         (begin (log (list 'waypoints 'failed-at i (car cells))) 1))))))))))

    ;; pool (optional): an (engine reach pool) of cloudstair-region-worker
    ;; processes. It changes how long the searches take, not what they find.
    (define (cloudstair-region-check source profiles bound log . pool)
      (log '(candidate-geometry starting actual-replay-required))
      (let* ((ct (cloudstair-region-content source))
             ;; a pool's workers must have built exactly this content
             (verified (and (pair? pool) (car pool)
                            (pool-verify! (car pool) "I" (string-append "I " (cloudstair-fingerprint ct)))))
             (home (start-cell ct))
             (tm (tiles-carrying ct '(2 3 4 5)))
             (candidate-tm (region-candidate-tm ct))
             ;; The guide graph without its REUSE memo (every anchor's notes and
             ;; walk, which this check never reads): a smaller live heap makes
             ;; every later collection, and so every physics tick, cheaper.
             (candidate
               (reach-graph
                (reach-search-down candidate-tm HARKFELL-FEEL
                 (list home) witness-lands? #t
                 (lambda (anchors steps kind cell)
                   (when (= (modulo anchors 100) 0)
                     (log (list 'candidate-geometry 'anchors anchors 'steps steps))))
                 ;; with a pool, anchors are expanded on its workers
                 (and ROUTE-MEMO (pair? pool) (car pool) (make-geometry-remote (car pool))))
                memo: #f))
             (advance (route-rest-memo (cloudstair-stepper ct) REST-MEMO-CAP))
             (tiles-for (cloudstair-tile-provider ct))
             (wait0 (cloudstair-waiter ct (prof-advance (quote tick-waiter) advance)))
             (shelter0? (cloudstair-shelter-checker ct (prof-advance (quote tick-shelter) advance)))
             ;; With a pool: shelter? and wait answer first from certificates
             ;; its workers computed ((engine reach routes) route-certificate-cache).
             (certs (route-certificate-cache shelter0? wait0
                                             (and (pair? pool) (car pool) #t) REST-MEMO-CAP))
             (shelter? (vector-ref certs 0))
             (wait (vector-ref certs 1))
             (learn! (vector-ref certs 2))
             (proposals (cloudstair-route-proposals ct))
             (targets (apply append
                        (map (lambda (p)
                               (room-standable-cells ct (placed-data p) tm))
                             (filter (lambda (p)
                                       (eq? (room-region (placed-data p)) 'cloudstair))
                                     (content-rooms ct)))))
             (route-cache '()) (entry-rooms (cloudstair-entrance-probe source)) (failures 0)
             (search-incomplete #f)
             (landing-bound (or LANDING-BOUND-OVERRIDE bound))
             ;; States proven to return home this profile, by exact timed key
             ;; (the key memo-key gives; also by timed-key, for the exact-key check).
             (return-proven #{}) (return-proven-exact #{}) (memo-stops 0) (n-checked 0) (plain-bound #f))
        (when LANDING-BOUND-OVERRIDE
          (log (list (quote landing-bound-override) landing-bound (quote gate-bound) bound
                     (quote not-a-gate-verdict))))
        (log (list 'candidate-geometry 'complete 'stats (graph-stats candidate)))
        (prof-report 'candidate-geometry-complete)
        (define (cell-of node)
          (and (still? node) (rest-cell (tiles-for (timed-node-data node))
                                     HARKFELL-FEEL (timed-node-body node))))
        ;; The drain proves landings nearest home first (guide hops to home in
        ;; the candidate guide; ties keep the landings' own order), so a later
        ;; return finds proven states near it to stop at. Order only: the same
        ;; landings are checked; which proven states exist when is what changes.
        (define home-hops (guide-distances candidate home))
        (define (home-first entries)
          (let ((hops (lambda (e)
                        (let ((c (cell-of (cdr e))))
                          (or (and c (vector-ref home-hops (cell-index (graph-tm candidate) (car c) (cdr c))))
                              100000)))))
            (map caddr
                 (list-sort (lambda (a b) (or (< (car a) (car b))
                                              (and (= (car a) (car b)) (< (cadr a) (cadr b)))))
                            (let number ((es entries) (i 0) (acc (quote ())))
                              (if (null? es) (reverse acc)
                                  (number (cdr es) (+ i 1) (cons (list (hops (car es)) i (car es)) acc))))))))
        ;; The guided queue scores guide hops left in a guide for the node's
        ;; own (carry, down), so a door the carry cannot open scores as shut,
        ;; and a target behind it scores by way of the pickup that opens it.
        ;; Moves still come from candidate (the guide below), so this orders
        ;; the search and never changes what it can reach on exhaustion.
        (define rank (cloudstair-carry-rank (cloudstair-guide-builder tiles-for (cloudstair-guide-seeds ct) log (quote rank-candidates)
                                                                     (and (pair? pool) (car pool)))
                                            (content-pickup-cells ct) cell-of))
        ;; Normalize TIME only by real no-input ticks from a certified rest.
        ;; The arrival's position, momentum, ability and carry are never set.
        (define (align node tau)
          (let ((proof (wait node tau)))
            (and proof (car proof))))
        ;; --- The return drain's proven-return memo ---------------------------
        ;; A landing whose return search reaches home is proven to return, at
        ;; its exact timed key. A later return search stops at a still state
        ;; whose own key, or the key of its certified wait to phase 0 (real
        ;; no-input ticks), is proven: the route is the actual replay to it plus
        ;; its proven return. A landing returns iff it reaches some proven
        ;; state, so trap verdicts from exhaustion are unchanged.
        (define (memo-key node) (timed-key node))
        (define (proven-key node)
          ;; the proven key node itself or its aligned rest holds, or #f
          (and (still? node)
               (if (dict-contains? return-proven (memo-key node))
                   node
                   (let ((rest (align node 0)))
                     (and rest (dict-contains? return-proven (memo-key rest)) rest)))))
        (define (proven-return? node target)
          (and RETURN-MEMO (equal? target home)
               (let ((hit (proven-key node)))
                 (and hit
                      (begin
                        ;; Always checked (one lookup per hit, never true in honest code,
                        ;; where memo-key is the exact key): the hit must be proven at its
                        ;; exact timed key.
                        (when (not (dict-contains? return-proven-exact (timed-key hit)))
                          (error "return memo: a proven-return hit is not proven at its exact key"
                                 (timed-key hit)))
                        #t)))))
        ;; ROUTE_CHECK's end-to-end check of a memo stop: the same landing, searched
        ;; again without the memo (recording nothing), must reach home itself.
        (define plain-return
          (timed-route-finder advance tiles-for HARKFELL-FEEL
            (lambda (node) candidate) shelter? wait bound (lambda (node) #t) (lambda () (set! plain-bound #t))
            #f proposals (and (pair? pool) (car pool)) learn! rank))
        (define (seek start target record!)
          (prof-inc! 'seek)
          (let ((prior (find (lambda (entry) (eq? (car entry) record!)) route-cache)))
            (let ((route
                    (if prior (cdr prior)
                        (timed-route-finder advance tiles-for HARKFELL-FEEL
                          (lambda (node) candidate) shelter? wait bound record!
                          (lambda () (set! search-incomplete #t))
                          (lambda (node target expanded pending depth)
                            (log (list 'regional-search 'target target
                                       'expanded expanded 'pending pending 'depth depth
                                       'at (cell-of node) 'carry (timed-node-data node)
                                       'tau (body-tau (timed-node-body node)))))
                          proposals (and (pair? pool) (car pool)) learn! rank proven-return?))))
              (unless prior (set! route-cache (cons (cons record! route) route-cache)))
              (route start target))))
        (for-each
          (lambda (profile)
            (let* ((carry (car profile)) (down (cdr profile))
                   (entries (cloudstair-entry-phases ct home carry down))
                   (root (align (car entries) 0))
                   (entry-fails 0) (unreached '()) (traps '())
                   (landings #{}) (rotations #{}) (landing-count 0) (complete (and root #t))
                   (covered #{})
                   (target-count 0))
              (define (record! node)
                (prof-inc! 'record-call)
                (prof-time 'time-record (lambda () (record*! node))))
              (define (record*! node)
                (let ((cell (cell-of node)))
                  (when cell (set! covered (dict-set covered cell #t))))
                (let ((rotation (and (shelter? node)
                                     (timed-key (timed-node node body:
                                                  (body (timed-node-body node) tau: 0))))))
                  (unless (and rotation (dict-contains? rotations rotation))
                    (let* ((rest (or (align node 0) node)) (key (timed-key rest)))
                      (when rotation (set! rotations (dict-set rotations rotation #t)))
                      (unless (dict-contains? landings key)
                        (set! landings (dict-set landings key rest))
                        (set! landing-count (+ landing-count 1)))))))
              (set! search-incomplete #f)
              (set! return-proven #{}) (set! return-proven-exact #{}) (set! memo-stops 0) (set! n-checked 0)
              (for-each
                (lambda (entry)
                  (let ((rest (align entry 0)))
                    (unless (and rest root (equal? (timed-key rest) (timed-key root)))
                      (set! entry-fails (+ entry-fails 1)))))
                entries)
              (if (and down (memv 4 carry))
                  (begin
                    (for-each
                      (lambda (target)
                        (set! target-count (+ target-count 1))
                        (when (= (modulo target-count 20) 0)
                          (log (list 'coverage 'carry carry 'targets target-count
                                     'landings landing-count 'unreached (length unreached))))
                        ;; HARKFELL_ROUTE_REPORT: the process's resident memory here
                        (when ROUTE-REPORT
                          (log (list (quote region-memory) (quote targets) target-count
                                     (quote rss) (cdr (or (assq (quote rss-bytes) (gc-stats)) (cons 0 0))))))
                        (if (or (>= landing-count landing-bound) (not complete))
                            (set! complete #f)
                            (begin
                              (unless (or (dict-contains? covered target)
                                          (seek root target record!))
                                (set! unreached (cons target unreached)))
                              (when search-incomplete
                                (set! complete #f)
                                (log (list 'RED 'regional-route-bound 'carry carry
                                           'target target 'bound bound))))))
                      targets)
                    ;; Directed return from each genuine retained landing.
                    ;; New landings from return trials also create obligations.
                    (let ((checked #{}))
                      (let drain ()
                        (let ((pending (home-first
                                        (filter (lambda (entry)
                                                  (not (dict-contains? checked (car entry))))
                                                (dict-entries landings)))))
                          (cond ((not complete) #f)
                                ((>= landing-count landing-bound) (set! complete #f))
                                ((null? pending) #t)
                                (else
                                 (for-each
                                   (lambda (entry)
                                     (when complete
                                       (set! checked (dict-set checked (car entry) #t))
                                       (set! n-checked (+ n-checked 1))
                                       (let ((back (seek (cdr entry) home record!)))
                                         (cond
                                           ((not back)
                                            (set! traps (cons (timed-key (cdr entry)) traps)))
                                           (else
                                            (unless (equal? (cell-of back) home)
                                              (set! memo-stops (+ memo-stops 1))
                                              (when ROUTE-CHECK
                                                (set! plain-bound #f)
                                                (unless (plain-return (cdr entry) home)
                                                  (error (if plain-bound
                                                             "route check: a proven-return stop could not be re-verified (bound)"
                                                             "route check: a proven-return stop is not a real return")
                                                         (timed-key (cdr entry))))))
                                            (set! return-proven (dict-set return-proven (memo-key (cdr entry)) #t))
                                            (set! return-proven-exact
                                                  (dict-set return-proven-exact (timed-key (cdr entry)) #t)))))
                                       ;; HARKFELL_ROUTE_REPORT: what the drain holds, after every
                                       ;; return search (memory diagnosis; observation only)
                                       (when ROUTE-REPORT
                                         (let ((finder (find (lambda (e) (eq? (car e) record!)) route-cache)))
                                           (log (list (quote region-sizes) (quote checked) n-checked
                                                      (quote landings) (length (dict-keys landings))
                                                      (quote rotations) (length (dict-keys rotations))
                                                      (quote covered) (length (dict-keys covered))
                                                      (quote proven) (length (dict-keys return-proven))
                                                      (quote finder) (and finder ((cdr finder) (quote sizes) #f))
                                                      (quote rss) (cdr (or (assq (quote rss-bytes) (gc-stats)) (cons 0 0)))))))
                                       (when (= 0 (modulo n-checked 50))
                                         (log (list (quote region-drain) (quote checked) n-checked
                                                    (quote landings) landing-count (quote proven) (length (dict-keys return-proven))
                                                    (quote memo-stops) memo-stops (quote traps) (length traps)
                                                    (quote rss) (cdr (or (assq (quote rss-bytes) (gc-stats)) (cons 0 0))))))
                                       (when search-incomplete
                                         (set! complete #f)
                                         (log (list 'RED 'regional-return-bound 'carry carry
                                                    'bound bound)))))
                                   pending)
                                 (drain)))))))
                  ;; Artificial negative profiles must fail at the legal
                  ;; entrance, rather than being spawned past its seal.
                  (let ((reached (entry-rooms carry down)))
                    (unless down
                      (log (list 'no-down-cloudstair 'carry carry
                                 'entry-phases AIR-PERIOD 'reachable-rooms reached
                                 'pass (null? reached))))
                    (unless (null? reached)
                      (set! failures (+ failures 1))
                      (log (list 'RED 'entry-bypass 'carry carry 'down down
                                 'reachable-rooms reached)))))
              (when search-incomplete (set! complete #f))
              (prof-report (list 'profile-complete carry down))
              ;; HARKFELL_ROUTE_DIGEST=1: the full reached-state sets, as
              ;; order-free hashes of their exact encodings, for comparing builds.
              (when ROUTE-DIGEST
                (log (list 'region-sets 'carry carry 'down down
                           'landings (length (dict-keys landings))
                           (route-set-digest (dict-keys landings))
                           'covered (length (dict-keys covered))
                           (route-set-digest (dict-keys covered))
                           'traps (length traps) (route-set-digest traps))))
              ;; HARKFELL_ROUTE_REPORT: what the retained landings are, for
              ;; the landing bound: distinct cells, (cell, carry) pairs, poses
              ;; with tau removed, and the cells holding the most. Observation.
              (when ROUTE-REPORT
                (let* ((rests (map cdr (dict-entries landings)))
                       (tally (lambda (xs)
                                (let count ((xs xs) (d #{}))
                                  (if (null? xs) d
                                      (count (cdr xs) (dict-set d (car xs) (+ 1 (dict-ref d (car xs) 0))))))))
                       (by-cell (list-sort (lambda (a b) (> (cdr a) (cdr b)))
                                           (dict-entries (tally (map cell-of rests)))))
                       (cell-carry (dict-keys (tally (map (lambda (n) (cons (cell-of n) (timed-node-data n)))
                                                          rests))))
                       (poses (dict-keys (tally (map (lambda (n)
                                                       (timed-key (timed-node n body: (body (timed-node-body n) tau: 0))))
                                                     rests)))))
                  (log (list 'region-landings 'carry carry 'down down
                             'landings (length rests)
                             'distinct-cells (length by-cell)
                             'distinct-cell-carry (length cell-carry)
                             'distinct-poses-without-tau (length poses)
                             'at-phase-0 (length (filter (lambda (n) (= 0 (body-tau (timed-node-body n)))) rests))
                             'sheltered-rotations (length (dict-keys rotations))
                             'top-cells (let first ((xs by-cell) (n 12) (acc '()))
                                          (if (or (null? xs) (= n 0)) (reverse acc)
                                              (first (cdr xs) (- n 1) (cons (car xs) acc))))))))
              (set! failures (+ failures entry-fails (length unreached) (length traps)
                                (if complete 0 1)))
              (log (list 'region 'carry carry 'down down 'entry-phases AIR-PERIOD
                         'entry-failures entry-fails 'required-cells (length targets)
                         'unreached (reverse unreached) 'traps (length traps)
                         'actual-landings landing-count 'complete complete))))
          profiles)
        failures))))
