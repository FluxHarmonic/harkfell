;;; Actual authored timing families and directed physical returns.
(define-library (harkfell cloudstair timing)
  (import (sigil list)
          (engine body) (engine air) (engine tilemap) (engine worldmap)
          (engine reach) (engine reach timed)
          (harkfell content) (harkfell check)
          (harkfell feel) (harkfell cloudstair reach)
          (harkfell cloudstair probes) (harkfell cloudstair inputs))

  (export cloudstair-authored-timing cloudstair-timing-rooms)

  (begin
    ;; Shared by the actual isolate and its persisted verdict dependencies.
    (define (cloudstair-timing-rooms ct name)
      (let ((places
              (case name
                ((F-L) '((8 . 0) (8 . -1)))
                ((M-S) '((9 . -1) (9 . -2)))
                ((I-east I-west) '((11 . 0)))
                ((P-west-gap-east P-west-gap-west P-east-gap-east P-east-gap-west)
                 '((12 . -1) (11 . -1) (12 . 0)))
                (else (error "unknown authored timing leg" name)))))
        (filter (lambda (p)
                  (member (cons (placed-x p) (placed-y p)) places))
                (content-rooms ct))))

    (define (cloudstair-authored-timing CT profiles log . selected)
      (define WM (content-map CT))
      (define F HARKFELL-FEEL)
      (define STEP (cloudstair-stepper CT))
      (define wait (cloudstair-waiter CT STEP))
      (define shelter? (cloudstair-shelter-checker CT STEP))
      (define (gcol x c) (+ c (* 25 (- x (worldmap-x0 WM)))))
      (define (grow y r) (+ r (* 11 (- y (worldmap-y0 WM)))))
      (define (last-node trace) (and (pair? trace) (car (reverse trace))))
      (define (still? node)
        (and node
             (let ((b (timed-node-body node)))
               (and (eq? (body-mode b) 'ground)
                    (= (body-vx b) 0) (= (body-vy b) 0)))))
      (define (rests-in x y lo hi)
        (lambda (node)
          (and (still? node)
               (let* ((b (timed-node-body node)) (center (body-center b F)))
                 (and (<= (* 16 (gcol x lo)) (car center))
                      (< (car center) (* 16 (+ 1 (gcol x hi))))
                      (<= (* 16 (grow y 0)) (cdr center))
                      (< (cdr center) (* 16 (grow y 11))))))))
      ;; The gaps since David's playtest (ROOMS+LOOK, test/test-cloudstair-
      ;; takeoff.sgl): three tiles, each east bank a tile higher. Every start
      ;; stands four cells from its gap, where the measured standing take-off
      ;; windows (gust eastward, calm westward) span run-ups 38-52; the family
      ;; runs 45, the middle, and never leaves in coyote time.
      (define GAP-WIDTH 3)
      (define GAP-RUN 45)
      (define (gap-script h)
        (lambda (node)
          (cloudstair-gap-inputs h node)))

      ;; name, lower/start room, start cell, family, arrival, timing windows,
      ;; kind, gap's left column, direction. All coordinates are authored cells.
      ;; Eastward legs are timed in the gust, westward ones (the returns) in
      ;; calm: eastward in calm is the deliberately harder way. A westward
      ;; family (120 ticks) must finish before the gust: it departs by
      ;; AIR-GUST - 120 (the 600-tick cycle's 0-239 kept the same rule).
      (define LEGS
        (list
          (list 'F-L 8 0 10 7 cloudstair-lift-inputs (rests-in 8 -1 14 24)
                (list (list AIR-GUST (+ AIR-GUST 89))) 'lift 11 1)
          (list 'M-S 9 -1 10 7 cloudstair-lift-inputs (rests-in 9 -2 14 24)
                (list (list AIR-GUST (+ AIR-GUST 89))) 'lift 11 1)
          (list 'I-east 11 0 6 7 (gap-script 1) (rests-in 11 0 13 21)
                (list (list AIR-GUST (+ AIR-GUST 89))) 'gap 10 1)
          (list 'I-west 11 0 16 6 (gap-script -1) (rests-in 11 0 0 9)
                (list (list 0 (- AIR-GUST 120))) 'gap 10 -1)
          (list 'P-west-gap-east 12 -1 1 7 (gap-script 1) (rests-in 12 -1 8 13)
                (list (list AIR-GUST (+ AIR-GUST 89))) 'gap 5 1)
          (list 'P-west-gap-west 12 -1 11 6 (gap-script -1)
                (lambda (n) (or ((rests-in 12 -1 0 4) n) ((rests-in 11 -1 0 24) n)))
                (list (list 0 (- AIR-GUST 120))) 'gap 5 -1)
          (list 'P-east-gap-east 12 -1 10 6 (gap-script 1) (rests-in 12 -1 17 20)
                (list (list AIR-GUST (+ AIR-GUST 89))) 'gap 14 1)
          (list 'P-east-gap-west 12 -1 20 5 (gap-script -1) (rests-in 12 -1 8 13)
                (list (list 0 (- AIR-GUST 120))) 'gap 14 -1)))

      ;; Feedback generates actual inputs, then callers replay the entire script.
      ;; Stop at a threshold, retaining the genuine offset and velocity.
      (define (walk-to node target h limit)
        (let loop ((node node) (rev '()) (n 0))
          (cond ((not node) #f)
                ((if (> h 0) (>= (body-x (timed-node-body node)) target)
                             (<= (body-x (timed-node-body node)) target))
                 (reverse rev))
                ((>= n limit) #f)
                (else
                 (let ((in (intent h: h)))
                   (loop (STEP node in) (cons in rev) (+ n 1)))))))

      (define (return-to-bank leg node)
        (let* ((x (list-ref leg 1)) (y (list-ref leg 2))
               (kind (list-ref leg 8)) (left (* 16 (gcol x (list-ref leg 9))))
               (b (timed-node-body node)))
          (if (eq? kind 'lift)
              ;; Jump released: the shaft is air and falls to its genuine lower
              ;; floor. Continue west out of the field before checking a shelter.
              (let ((walk (walk-to node (- left 20) -1 220)))
                (and walk (last-node (timed-run STEP node
                                      (append walk (make-list 120 NO-INTENT))))))
              ;; Back over the gap from a standing take-off, never coyote time:
              ;; settle, walk to a spot two tiles from the edge (out of every
              ;; field), wait there for the crossing's phase (the gust eastward,
              ;; calm westward), then run to the take-off point and jump.
              (let* ((h (if (< (body-x b) left) 1 -1))
                     (right (+ left (* 16 GAP-WIDTH)))
                     (spot (if (> h 0) (- left 36) (+ right 28)))
                     ;; Join only an identical full state in the already
                     ;; replayed directed shelter cycle; no phase assignment.
                     (settled (wait node 0))
                     (rest0 (and settled (car settled)))
                     (to-spot (and rest0
                                   (let ((x (body-x (timed-node-body rest0))))
                                     (walk-to rest0 spot (if (< x spot) 1 -1) 300))))
                     (at-spot (and to-spot
                                   (last-node (timed-run STEP rest0 (append to-spot (make-list 30 NO-INTENT))))))
                     (proof (and at-spot (wait at-spot (if (> h 0) (+ AIR-GUST 5) 0))))
                     (rest (and proof (car proof)))
                     (run (and rest (walk-to rest (if (> h 0) (- left 10) (+ right 2)) h 120))))
                (and run
                     (last-node (timed-run STEP rest
                       (append run (list (intent h: h jump: #t press: #t))
                               (make-list 46 (intent h: h jump: #t))
                               (make-list 40 NO-INTENT)))))))))

      (define failures 0)
      ;; Isolate each real authored leg, closing alternatives. Translation
      ;; changes only the map origin; the grids, fields and clock are intact.
      ;; A public string selector still takes the isolated-room path. Symbols
      ;; are used only by the recursive call after constructing that isolate.
      ;; Reject unknown names: an empty selection must never report success.
      (when (and (pair? selected) (string? (car selected))
                 (not (find (lambda (leg)
                              (string=? (symbol->string (car leg)) (car selected)))
                            LEGS)))
        (error "unknown authored timing leg" (car selected)))
      (if (or (null? selected) (string? (car selected)))
          (for-each
            (lambda (leg)
              (let* ((name (car leg))
                     (rooms (cloudstair-timing-rooms CT name))
                     (probe (content CT rooms: rooms
                                        wmap: (make-worldmap rooms 25 11 16))))
                (set! failures
                  (+ failures (cloudstair-authored-timing probe profiles log name)))))
            (if (null? selected)
                LEGS
                (filter (lambda (leg)
                          (string=? (symbol->string (car leg)) (car selected)))
                        LEGS)))
          (begin
            (for-each
              (lambda (profile)
                (let ((carry (car profile)) (down (cdr profile)))
                  (for-each
                    (lambda (leg)
                      (let* ((cell (cons (gcol (list-ref leg 1) (list-ref leg 3))
                                         (grow (list-ref leg 2) (list-ref leg 4))))
                             (starts (cloudstair-entry-phases CT cell carry down))
                             (family (list-ref leg 5)) (arrives? (list-ref leg 6))
                             (window-reds 0) (survived 0) (stranded '())
                             (negative-crossings 0) (diagnostic-return-misses 0))
                        (when down
                          (for-each
                            (lambda (window)
                              (let ((bad (timed-window STEP (car starts) family arrives?
                                                       (car window) (cadr window) 120)))
                                (set! window-reds (+ window-reds (length bad)))))
                            (list-ref leg 7)))
                        (unless (shelter? (car starts))
                          (set! failures (+ failures 1)))
                        (for-each
                          (lambda (start)
                            (let* ((trace (timed-run STEP start (family start)))
                                   (end (last-node trace)))
                              (when end
                                ;; Settle a late aerial endpoint by actual release. The
                                ;; original flight and this suffix keep their phases.
                                (unless (still? end)
                                  (set! end (last-node (timed-run STEP end (make-list 180 NO-INTENT)))))
                                (when end
                                  (set! survived (+ survived 1))
                                  ;; Down gates the legal Cloudstair entrance.
                                  ;; I/P's short gaps may be crossed without it
                                  ;; from these artificial diagnostic seeds.
                                  (when (and (not down)
                                             (eq? (list-ref leg 8) 'lift)
                                             (arrives? end))
                                    (set! negative-crossings (+ negative-crossings 1)))
                                  (let* ((home (if (eq? (list-ref leg 8) 'lift)
                                                   (rests-in (list-ref leg 1) (list-ref leg 2) 0 10)
                                                   (if (> (list-ref leg 10) 0)
                                                       (rests-in (list-ref leg 1) (list-ref leg 2) 0 (- (list-ref leg 9) 1))
                                                       (rests-in (list-ref leg 1) (list-ref leg 2) (+ (list-ref leg 9) GAP-WIDTH) 24))))
                                         (back (if (home end) end
                                                   (and (or (eq? (list-ref leg 8) 'lift)
                                                            (shelter? end))
                                                        (return-to-bank leg end)))))
                                    (unless (and back (home back))
                                      ;; No-down gap seeds cannot occur in play:
                                      ;; the entrance gate excludes every such
                                      ;; carry set from every Cloudstair room.
                                      ;; Keep their local outcomes diagnostic,
                                      ;; while every reachable gap catch and
                                      ;; the lift negatives retain obligations.
                                      (if (or down (eq? (list-ref leg 8) 'lift))
                                          (set! stranded (cons (body-tau (timed-node-body start)) stranded))
                                          (set! diagnostic-return-misses (+ diagnostic-return-misses 1)))))))))
                          starts)
                        (set! failures (+ failures window-reds negative-crossings (length stranded)))
                        (log (list (car leg) 'carry carry 'down down 'phases AIR-PERIOD
                                     'window-failures window-reds 'survivors survived
                                     'no-down-crossings negative-crossings 'stranded (reverse stranded)
                                     'required-return (or down (eq? (list-ref leg 8) 'lift))
                                     'unreachable-profile-return-misses diagnostic-return-misses))))
                    (if (pair? selected)
                        (filter (lambda (leg) (eq? (car leg) (car selected))) LEGS)
                        LEGS))))
              profiles)))
      failures)))
