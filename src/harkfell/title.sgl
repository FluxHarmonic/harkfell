;;; (harkfell title) - What stands before the world: the start screen
;;; (ruling D32), the Flux Harmonic card (D33), in IM Fell (D34).
;;;
;;; Both are drawn as the room is: a pixel view of palette slots through
;;; (harkfell render)'s pass, put on the window at the room's whole scale;
;;; and then the words, which are images (scripts/art/type, one per whole
;;; scale) drawn at the window's own resolution over the pixel view, never
;;; scaled up from it.
;;;
;;; The start screen: black; the name, and D32's two lines; a few lantern
;;; moths drifting slowly round the words, drawn a little toward the
;;; pointer (a cursor, a touch) and glowing. Quiet: no menu, no motion but
;;; theirs.
;;;
;;; The card: black; the Flux Harmonic mark (assets/art/mark.txt, the mark in
;;; Harkfell's slots) fading in and out by the dither, no motion graphics.
;;;
;;; The palette is the Hollow's (the world begins there at dawn), or
;;; Reedfen's until the Hollow exists.
;;;
;;; What calls these (the frame sequence, CONTENT's (harkfell frame)) owns
;;; the timing; both draw on the window, after begin-frame:
;;;   (draw-start! w h alpha t px py web? kind [over])
;;;       w h: the window in pixels; alpha 0..1: how far it is faded in; t:
;;;       seconds of wall time (the moths are stepped at 60 Hz up to it); px py:
;;;       the pointer in window pixels, or #f; web?: the web build; kind:
;;;       'keys, 'touch or 'both, which second line (D32); over (optional,
;;;       #f when left out): #f (no save: no third line) or 0..1, D40's hold
;;;       to start over (a save exists; the line brightens as the hold
;;;       fills: half strength at 0, full at 1)
;;;   (start-over-hit? w h x y)   D40: is window pixel (x, y) on the hold
;;;                               line, on a w x h window (draw-start!'s w
;;;                               and h), padded as a touch target; #f
;;;                               while its image has not landed
;;;   (draw-card! w h alpha t)    the Flux Harmonic card at alpha 0..1, t seconds
;;;   (card-fade s)               D33's envelope at s seconds (in over 1.2 s,
;;;                               held, out by CARD-SECONDS), for a caller
;;;                               that wants it
;;;   (title-set-content! ct)     the world, for its palette (the Hollow's)
;;;   (start-reset!)              the moths anew
;;;   (start-words-landed?)       every line of the start screen has landed
;;;                               and they have begun to fade in
;;; The words' images come through (harkfell images), whose fetcher the
;;; shells install.

(define-library (harkfell title)
  (import (sigil math)
          (sigil list)
          (sigil string)
          (sigil graphics)
          (engine view)
          (harkfell palette)
          (harkfell render)
          (harkfell atlas)
          (harkfell content)
          (harkfell draw)
          (harkfell images))

  (export title-set-content! start-reset! draw-start! draw-card! draw-reveal!
          card-fade CARD-SECONDS start-moths TEXT-LAYOUT type-scale
          start-over-hit? over-id WORDS-FADE-S WORDS-STAGGER-S start-words-landed?)

  (begin
    (define (floor-int x) (exact (floor x)))

    ;; --- the images of the words ----------------------------------------------------


    ;; The whole scale an image is made at for a view drawn s device pixels
    ;; per view pixel: the nearest of 1..8.
    (define (type-scale s) (max 1 (min 8 (floor-int (+ s 0.5)))))

    (define (type-path id k) (string-append "assets/type/" id "@" (number->string k) ".png"))

    ;; Where each line of words stands, its centre in view pixels:
    ;; (id x y slot-name). D35 (David, 2026-09-24): the name is not on the
    ;; start screen; it comes at the first homecoming (draw-reveal!).
    ;; D40: "over", the hold to start over, only when a save exists; last.
    (define TEXT-LAYOUT
      (list (list "listen" 200 84 (quote fur-2))
            (list "step" 200 101 (quote fur-2))
            (list "over" 200 122 (quote fur-2))))
    ;; --- the palette ------------------------------------------------------------------------

    (define *content* #f)
    (define *strips* #f)
    (define (title-set-content! ct) (set! *content* ct) (set! *strips* #f))

    (define (palette-region)
      (let ((names (if *content* (map region-name (content-regions *content*)) '())))
        (cond ((memq 'hollow names) 'hollow)
              ((memq 'reedfen names) 'reedfen)
              ((pair? names) (car names))
              (else 'none))))

    (define (rgb) (region-colours (palette-region)))

    (define (ensure-strips!)
      (unless *strips* (set! *strips* (make-strips (rgb)))))

    ;; --- the moths --------------------------------------------------------------------------

    ;; A moth: #(x y vx vy phase speed)
    (define N-MOTHS 5)
    (define CX 200.0)
    (define CY 92.0)
    (define *moths* '())
    (define *tick* 0)

    (define (start-reset!)
      (set! *tick* 0)
      (set! *moths*
            (let loop ((i 0) (acc '()))
              (if (= i N-MOTHS)
                  (reverse acc)
                  (let* ((a (+ (* i 1.2566) 0.4))
                         (x (+ CX (* 150.0 (cos a))))
                         (y (+ CY (* 60.0 (sin a)))))
                    (loop (+ i 1)
                          (cons (vector x y 0.0 0.0 a (+ 0.0021 (* 0.0006 (modulo (* i 3) 5)))) acc)))))))

    (define (start-moths) *moths*)

    ;; One tick: each moth follows a point that goes slowly round an ellipse
    ;; about the words, wandering off it a little, and is drawn a little
    ;; toward the pointer when it is near (within REACH px).
    (define REACH 120.0)
    (define (start-tick! pointer)
      (when (null? *moths*) (start-reset!))
      (set! *tick* (+ *tick* 1))
      (let ((t *tick*))
        (for-each
          (lambda (m)
            (let* ((a (+ (vector-ref m 4) (vector-ref m 5)))
                   (i (vector-ref m 5))
                   (wx (* 12.0 (sin (+ (* t 0.011) (* 900.0 i)))))
                   (wy (* 7.0 (cos (+ (* t 0.017) (* 700.0 i)))))
                   (tx (+ CX (* 152.0 (cos a)) wx))
                   (ty (+ CY (* 62.0 (sin a)) wy))
                   (x (vector-ref m 0)) (y (vector-ref m 1))
                   (pull (if pointer
                             (let* ((dx (- (car pointer) x)) (dy (- (cdr pointer) y))
                                    (d (sqrt (+ (* dx dx) (* dy dy)))))
                               (if (< d REACH) (* 0.45 (- 1.0 (/ d REACH))) 0.0))
                             0.0))
                   (tx (if pointer (+ tx (* pull (- (car pointer) tx))) tx))
                   (ty (if pointer (+ ty (* pull (- (cdr pointer) ty))) ty))
                   (vx (* 0.955 (+ (vector-ref m 2) (* 0.0022 (- tx x)))))
                   (vy (* 0.955 (+ (vector-ref m 3) (* 0.0022 (- ty y))))))
              (vector-set! m 4 a)
              (vector-set! m 2 vx)
              (vector-set! m 3 vy)
              (vector-set! m 0 (+ x vx))
              (vector-set! m 1 (+ y vy))))
          *moths*)))

    ;; --- drawing ---------------------------------------------------------------------------

    ;; a cell's atlas index, looked up once per name (not every frame)
    (define *cells* (quote ()))
    (define (cell name)
      (let ((e (assoc name *cells*)))
        (if e
            (cdr e)
            (let ((i (atlas-index name)))
              (set! *cells* (cons (cons name i) *cells*))
              i))))

    (define (draw-cell-centred! i x y face)
      (when i
        (let ((sz (atlas-size i)))
          (set-color 1.0 1.0 1.0 1.0)
          (atlas-draw! i (- (floor-int x) (floor-int (/ (car sz) 2))) (- (floor-int y) (floor-int (/ (cdr sz) 2))) face))))

    (define (disc! cx cy r)
      (let* ((x0 (floor-int cx)) (y0 (floor-int cy)) (ri (floor-int r)))
        (let loop ((dy (- ri)))
          (when (<= dy ri)
            (let ((w (floor-int (sqrt (max 0.0 (- (* r r) (* dy dy)))))))
              (draw-filled-rect (- x0 w) (+ y0 dy) (+ 1 (* 2 w)) 1))
            (loop (+ dy 1))))))

    ;; The pixel view (black, moths or the mark) into the colour target.
    (define (pixel-pass! draw-things! black)
      (ensure-render!)
      (atlas-ensure!)
      (ensure-strips!)
      (with-render-target (room-index-rt)
        (set-blend-mode 'normal)
        (paint-slot! (slot-of 'black))
        (draw-filled-rect 0 0 VIEW-W VIEW-H)
        (draw-things!)
        (draw-strips! *strips*))
      (resolve! *tick* black (slot-of 'h2)))

    ;; The colour target onto the window at the fit, opaque.
    (define (present-view! f)
      (with-blend-mode 'none
        (set-color 1.0 1.0 1.0 1.0)
        (draw-render-target (room-color-rt) (fit-x f) (fit-y f) (fit-w f) (fit-h f))))

    ;; An image (PREFIX@K.png, one per whole scale) centred on view (vx, vy),
    ;; at the window's resolution, in colour rgb; fade 0..1 by alpha, or by
    ;; the dither dissolve when dissolve? (the card, the reveal). -> the
    ;; rectangle it took, in window pixels (x y w h), or #f while it loads.
    (define (draw-image! f prefix vx vy rgb fade dissolve?)
      (let* ((s (/ (fit-w f) (* 1.0 VIEW-W)))
             (k (type-scale s))
             (tex (image-texture (string-append prefix "@" (number->string k) ".png"))))
        (and tex
             (let* ((z (/ s k))
                    (w (* z (texture-width tex))) (h (* z (texture-height tex)))
                    (x (floor-int (- (+ (fit-x f) (* vx s)) (/ w 2))))
                    (y (floor-int (- (+ (fit-y f) (* vy s)) (/ h 2)))))
               (if dissolve?
                   (begin (set-color (car rgb) (cadr rgb) (caddr rgb) 1.0)
                          (draw-texture-dissolved! tex x y w h fade s))
                   (begin (set-color (car rgb) (cadr rgb) (caddr rgb) fade)
                          (draw-texture tex x y w h)))
               (list x y w h)))))

    ;; A line of words centred on view (vx, vy), at the window's resolution.
    (define (draw-words! f id vx vy rgb alpha)
      (draw-image! f (string-append "assets/type/" id) vx vy rgb alpha #f))

    ;; Which second line (D32): kind 'both "Press any key, or touch, to step
    ;; in.", 'keys drops "or touch" (the desktop build), 'touch drops "any
    ;; key" (a touch-only device).
    (define (step-id kind)
      (case kind
        ((keys) "step-keys")
        ((touch) "step-touch")
        (else "step-both")))

    ;; The moths are stepped at 60 Hz up to tick n (from the caller's seconds); a
    ;; clock that went back, or leapt more than a few seconds, starts them
    ;; anew rather than running them through the gap.
    (define (advance-moths! n pointer)
      (when (or (null? *moths*) (< n *tick*) (> (- n *tick*) 600))
        (start-reset!)
        (set! *tick* n))
      (let loop ()
        (when (< *tick* n)
          (start-tick! pointer)
          (loop))))

    (define (fit-of w h) (view-fit w h VIEW-W VIEW-H))

    ;; The start screen on a window of w x h pixels, after begin-frame.
    ;; alpha: 0..1, how far it has faded in (the words and the moths); t: the
    ;; caller's seconds of wall time; px py: the pointer in window pixels, or
    ;; #f; web?: the web build (unused: kind decides the line); kind: 'keys,
    ;; 'touch or 'both.
    (define (draw-start! w h alpha t px py web? kind . more)
      (let* ((over (and (pair? more) (car more)))
             (f (fit-of w h))
             (pointer (and px py (window->view f px py VIEW-W VIEW-H)))
             (secs t)
             (t (floor-int (* 60.0 t))))
        (advance-moths! t pointer)
        (pixel-pass!
          (lambda ()
            (for-each
              (lambda (m)
                (let* ((up (< (modulo (+ t (floor-int (* 1000 (vector-ref m 5)))) 8) 4))
                       (face (if (< (vector-ref m 2) 0.0) -1 1)))
                  (draw-cell-centred! (cell (if up "creatures/moth-up" "creatures/moth-down"))
                                      (vector-ref m 0) (vector-ref m 1) face)))
              *moths*)
            (with-additive-blend
              (for-each
                (lambda (m)
                  (let ((p (+ 0.8 (* 0.2 (sin (+ (* t 0.09) (* 40.0 (vector-ref m 5))))))))
                    (paint-light! (* 0.09 p)) (disc! (vector-ref m 0) (vector-ref m 1) 8.0)
                    (paint-light! (* 0.16 p)) (disc! (vector-ref m 0) (vector-ref m 1) 4.5)
                    (paint-light! (* 0.55 p)) (disc! (vector-ref m 0) (vector-ref m 1) 2.0)))
                *moths*)))
          (- 1.0 alpha))
        (present-view! f)
        (set-blend-mode 'normal)
        (draw-start-words! f alpha secs kind over)))

    ;; The start screen's words (playtest 1, #1: on the phone the second
    ;; line came before the first, each drawn as its image landed). Every
    ;; line's image is asked for each frame, so all of them fetch at once,
    ;; and so are the card's (the mark, "presents"), so the card has them
    ;; when it comes; no line is drawn until every line has landed. Then
    ;; they fade in over WORDS-FADE-S, in order, each WORDS-STAGGER-S after
    ;; the one above. Natively the images are there at once, and the fade
    ;; starts with the start screen.
    (define WORDS-FADE-S 0.9)
    (define WORDS-STAGGER-S 0.35)
    (define *words-since* #f)       ; the caller's seconds when every line had landed
    (define *start-kind* 'both)    ; the kind draw-start! was last given (for the hit test)

    ;; D40: the third line, when a save exists (the words are CONTENT's).
    (define (over-id kind)
      (case kind
        ((keys) "over-keys")
        ((touch) "over-touch")
        (else "over-both")))

    ;; D40's line on a window of w x h (as draw-start! gets): its image's
    ;; rectangle in window pixels, padded by OVER-PAD view pixels as a touch
    ;; target, or #f while the image has not landed.
    (define OVER-PAD 8.0)
    (define (over-rect w h)
      (let* ((f (fit-of w h))
             (s (/ (fit-w f) (* 1.0 VIEW-W)))
             (k (type-scale s))
             (l (assoc "over" TEXT-LAYOUT))
             (tex (image-texture (type-path (over-id *start-kind*) k))))
        (and tex
             (let* ((z (/ s k))
                    (iw (* z (texture-width tex))) (ih (* z (texture-height tex)))
                    (cx (+ (fit-x f) (* (cadr l) s))) (cy (+ (fit-y f) (* (caddr l) s)))
                    (pad (* OVER-PAD s)))
               (list (- cx (/ iw 2) pad) (- cy (/ ih 2) pad) (+ iw pad pad) (+ ih pad pad))))))

    ;; Is window pixel (x, y) on D40's line? CONTENT's touch hold asks.
    (define (start-over-hit? w h x y)
      (let ((r (over-rect w h)))
        (and r (>= x (car r)) (< x (+ (car r) (caddr r)))
             (>= y (cadr r)) (< y (+ (cadr r) (cadddr r))))))
    ;; every line has landed and the words have begun to show
    (define (start-words-landed?) (and *words-since* #t))

    (define (ramp x) (max 0.0 (min 1.0 x)))

    (define (draw-start-words! f alpha secs kind over)
      (let* ((s (/ (fit-w f) (* 1.0 VIEW-W)))
             (k (type-scale s))
             (lines (map (lambda (l) (if (string=? (car l) "step") (cons (step-id kind) (cdr l)) l))
                         (if over TEXT-LAYOUT (reverse (cdr (reverse TEXT-LAYOUT))))))
             (lines (map (lambda (l) (if (string=? (car l) "over") (cons (over-id kind) (cdr l)) l)) lines))
             (landed (map (lambda (l) (image-texture (type-path (car l) k))) lines)))
        ;; the card's images, asked for now so they are here when it comes
        (image-texture (string-append "assets/mark/mark@" (number->string k) ".png"))
        (image-texture (type-path "presents" k))
        (when (and *words-since* (< secs *words-since*)) (set! *words-since* #f))
        (when (and (not *words-since*) (not (memq #f landed))) (set! *words-since* secs))
        (set! *start-kind* kind)
        (when *words-since*
          (let ((colours (rgb)))
            (let loop ((ls lines) (i 0))
              (when (pair? ls)
                (let* ((l (car ls))
                       (a (* alpha (ramp (/ (- secs *words-since* (* i WORDS-STAGGER-S)) WORDS-FADE-S))))
                       (over? (string=? (car l) (over-id kind)))
                       ;; D40's line: dimmer than the prompt, brightening as the hold fills
                       (a (if over? (* a (+ 0.5 (* 0.5 (ramp over)))) a)))
                  (draw-words! f (car l) (cadr l) (caddr l) (vector-ref colours (slot-of (cadddr l))) a)
                  (loop (cdr ls) (+ i 1)))))))))

    ;; --- the card --------------------------------------------------------------------------

    (define CARD-SECONDS 4.0)
    (define (card-fade s)
      (cond ((< s 0.0) 0.0)
            ((< s 1.2) (/ s 1.2))
            ((< s 2.8) 1.0)
            ((< s CARD-SECONDS) (- 1.0 (/ (- s 2.8) 1.2)))
            (else 0.0)))

    ;; The card on a window of w x h pixels at alpha 0..1, after begin-frame:
    ;; black, and the Flux Harmonic mark (assets/mark, David's mark in the
    ;; palette's cream and oranges) at the window's resolution, smooth-edged,
    ;; coming and going by the dither (never a translucency); once it has
    ;; resolved, "presents" under it (Crash's card), in the text's dimmer cream.
    (define MARK-Y 80)
    (define (draw-card! w h alpha t)
      (let ((f (fit-of w h)) (white (list 1.0 1.0 1.0)))
        (set-color 0.0 0.0 0.0 1.0)
        (draw-filled-rect 0 0 w h)
        (set-blend-mode (quote normal))
        (let ((r (and (> alpha 0.0) (draw-image! f "assets/mark/mark" 200 MARK-Y white alpha #t))))
          (when (and r (>= alpha 0.999))
            (let* ((s (/ (fit-w f) (* 1.0 VIEW-W)))
                   (bottom (/ (- (+ (cadr r) (cadddr r)) (fit-y f)) s)))
              (draw-words! f "presents" 200 (+ bottom 9) (vector-ref (rgb) (slot-of (quote fur-2))) 1.0))))))

    ;; D35: the name at the first homecoming, over the play view (drawn after
    ;; the room is on the window): the wordmark in the creature's cream,
    ;; high over the room, at the window's resolution, coming and going by
    ;; the dither. alpha 0..1 is the caller's (CONTENT's: in, hold, out); t,
    ;; seconds since it began, is not needed yet. Play and input go on.
    (define REVEAL-Y 40)
    (define (draw-reveal! w h alpha t)
      (when (> alpha 0.0)
        (set-blend-mode (quote normal))
        ;; the halo under the name (the palette's darkest blue, soft, pre-rendered
        ;; with it), then the name: ink on the sky, dissolving together
        (draw-image! (fit-of w h) "assets/type/wordmark-halo" 200 REVEAL-Y (list 1.0 1.0 1.0) alpha #t)
        (draw-image! (fit-of w h) "assets/type/wordmark" 200 REVEAL-Y
                     (vector-ref (rgb) (slot-of (quote fur-1))) alpha #t)))))
