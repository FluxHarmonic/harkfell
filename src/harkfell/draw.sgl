;;; (harkfell draw) - Rooms, the body, and the review views, in the
;;; region's palette and its text-authored tiles (harkfell-design section 7).
;;;
;;; Everything in play is drawn as palette SLOTS into (harkfell render)'s
;;; index target, then resolved into colours in one shader pass; the shell
;;; puts the colour target on the window at a whole scale ((harkfell view)).
;;;
;;; A room is drawn in layers, back to front:
;;;   backdrop     the region's sky, a dithered ramp of its four sky slots
;;;                with a far silhouette, baked once per region
;;;   foliage      reeds (|) and the like: the region's reed cells in a layer
;;;                target of its own, a sway weight in G, composited through
;;;                the sway shader every frame
;;;   stones       A3's ring-stones, before the solids so the floor hides one
;;;                that sinks
;;;   solids       rock, rough rock, ledges, hazards: autotiled from the
;;;                region's tile sheet ((harkfell atlas)), baked once per
;;;                room into a layer target
;;;   creatures, the body
;;;   water        G over every water cell, so the resolve draws what is under
;;;                it as seen through water
;;;   what shows above water, the harmonic, the moths, light (B), a flash
;;; The backdrop and the layers are baked in passes of their own when the
;;; room or the content changes (prepare-play!), before the frame's pass.
;;;
;;; Materials without cells in the region's sheet (a region whose art is not
;;; written yet) draw as plain blocks of a ground slot, so nothing is missing.
;;;
;;; A0's test room (a world with no content) draws in a fallback palette.

(define-library (harkfell draw)
  (import (sigil math)
          (sigil list)
          (sigil string)
          (sigil graphics)
          (engine tilemap)
          (engine body)
          (engine font)
          (engine autotile)
          (engine worldmap)
          (harkfell world)
          (harkfell legend)
          (harkfell content)
          (harkfell gates)
          (harkfell creatures)
          (harkfell ice)
          (harkfell feel)
          (harkfell palette)
          (harkfell render)
          (harkfell haze)
          (harkfell atlas)
          (harkfell pipes look)
          (harkfell cloudstair look)
          (harkfell sprites))

  (export VIEW-W VIEW-H draw-world draw-readout
          set-draw-content! draw-play present-play!
          draw-overview prepare-overview! overview-size overview-room-at draw-news!
          slot player-frame set-look-sound! region-colours set-look-waking! waking-frame
          floating-reeds room-hue FIREFLY-RINGS firefly-light-budget
          room-render-light room-dark-extra moth-lit?)

  (begin
    (define (floor-int x) (exact (floor x)))

    ;; --- palettes ---------------------------------------------------------------------

    (define *content* #f)
    (define *rgb* '())             ; ((region . rgb-vector) ...)
    (define *strips* #f)           ; the strips texture in use
    (define *strip-texs* (quote ()))   ; ((region . texture) ...): one per region, so
                                   ; an overview of two regions never uploads one
                                   ; texture twice in a frame (sigil-graphics refuses)
    (define *strips-stale* (quote ()))  ; regions whose texture predates the content

    ;; A0's fallback: greys and a pale body, for the test room and a world
    ;; whose region has no palette.
    (define FALLBACK
      (let ((v (make-vector SLOT-COUNT MAGENTA)))
        (for-each (lambda (e) (vector-set! v (slot-of (car e)) (hex->rgb (cadr e))))
                  (list (list 'sky-1 "#262b36") (list 'sky-2 "#323846") (list 'sky-3 "#434a58") (list 'sky-4 "#5a6170")
                        (list 'ground-1 "#3a3b3e") (list 'ground-2 "#5c5d60") (list 'ground-3 "#707174") (list 'ground-4 "#949598")
                        (list 'leaf-1 "#4a4a3c") (list 'leaf-2 "#5c5a4b") (list 'leaf-3 "#7a7560")
                        (list 'water "#3d6690") (list 'accent "#7a3530")
                        (list 'fur-1 "#ebe0cc") (list 'fur-2 "#b8ab95") (list 'ink "#1f1f24")
                        (list 'h2 "#e8a84c") (list 'h3 "#b4dc9a") (list 'h4 "#8fb4e6") (list 'h5 "#e6a0b4")
                        (list 'h7 "#a47ce0") (list 'black "#000000")))
        v))

    (define (region-colours name) (region-rgb name))

    (define (region-rgb name)
      (let ((e (assq name *rgb*))) (if e (cdr e) FALLBACK)))

    (define (content-region ct name)
      (find (lambda (r) (eq? (region-name r) name)) (content-regions ct)))

    ;; The content to draw from (its palette, its rooms). Drops every cached
    ;; layer: a reload may have changed a room, a palette or a sheet.
    (define (set-draw-content! ct)
      (set! *content* ct)
      (set! *rgb* (if ct
                      (map (lambda (r)
                             (let ((roles (region-field r 'palette)))
                               (cons (region-name r)
                                     (if (list? roles)
                                         (region-rgb-vector roles (content-palette ct))
                                         FALLBACK))))
                           (content-regions ct))
                      '()))
      (set! *strips-stale* (map car *strip-texs*))
      (set! *layers-key* #f)
      (drop-overview!))

    ;; The strips for a region: its own texture, made on first use, its
    ;; colours brought up to date once after the content changes.
    (define (use-region! name)
      (let ((e (assq name *strip-texs*))
            (dark (if (eq? name 'pipes) PIPES-DARK (region-dark-lookup name))))
        (cond ((not e)
               (set! *strip-texs* (cons (cons name (make-strips (region-rgb name) dark)) *strip-texs*)))
              ((memq name *strips-stale*)
               (strips-update! (cdr e) (region-rgb name) dark)
               (set! *strips-stale* (filter (lambda (r) (not (eq? r name))) *strips-stale*)))
              (else #f))
        (set! *strips* (cdr (assq name *strip-texs*)))))

    ;; A slot by name (the sprites and the ears paint through this).
    (define (slot name) (slot-of name))

    (define (paint! name) (paint-slot! (slot-of name)))

    ;; --- the region's sheet and its cells ------------------------------------------------

    (define (region-sheet name)
      (let* ((r (and *content* (content-region *content* name)))
             (t (and r (region-field r 'tiles))))
        (if (symbol? t) (symbol->string t) (symbol->string name))))

    ;; (sheet . mat) -> #(cell indices, 16 masks x n variants) and n; #f
    ;; when the sheet has no such material.
    (define *mat-cells* '())

    (define (mat-cells sheet mat)
      (let* ((key (string-append sheet "/" mat))
             (e (assoc key *mat-cells*)))
        (if e
            (cdr e)
            (let* ((n (let loop ((v 0))
                        (if (atlas-index (material-cell-name sheet mat 0 v)) (loop (+ v 1)) v)))
                   (val (and (> n 0)
                             (cons n (list->vector
                                      (let masks ((m 0) (acc '()))
                                        (if (= m 16)
                                            (reverse acc)
                                            (masks (+ m 1)
                                                   (let vars ((v 0) (acc acc))
                                                     (if (= v n) acc
                                                         (vars (+ v 1) (cons (atlas-index (material-cell-name sheet mat m v)) acc))))))))))))
              (set! *mat-cells* (cons (cons key val) *mat-cells*))
              val))))

    ;; --- rooms: where things are ------------------------------------------------------------

    (define S 16)

    (define (global-tile rm c r)
      (let ((wm (content-map *content*)))
        (cons (+ c (* ROOM-COLS (- (room-x rm) (worldmap-x0 wm))))
              (+ r (* ROOM-ROWS (- (room-y rm) (worldmap-y0 wm)))))))

    ;; The material at a global tile; outside every room, rock (so a closed
    ;; border does not draw a rim against nothing).
    (define (material-at gc gr)
      (if (member (cons gc gr) *passage-air*)
          #f
          (char-material (world-char *content* gc gr))))

    ;; Each tile of the room whose material satisfies pick?, as
    ;; (draw! mat x y mask gc gr).
    (define (each-tile rm pick? draw!)
      (let loop ((r 0))
        (when (< r ROOM-ROWS)
          (let cl ((c 0))
            (when (< c ROOM-COLS)
              (let* ((g (global-tile rm c r))
                     (mat (material-at (car g) (cdr g))))
                (when (and mat (pick? mat))
                  (let* ((gc (car g)) (gr (cdr g))
                         (m (tile-mask (lambda (cc rr) (eq? (material-at cc rr) mat)) gc gr)))
                    (draw! mat (* S c) (* S r) m gc gr))))
              (cl (+ c 1))))
          (loop (+ r 1)))))

    (define (solid-mat? m) (memq m (list 'rock 'rough 'ledge 'hazard)))

    ;; Reeds stand on something (playtest 1, #4: "grass floating in the sky
    ;; one or two tiles above ground"). A reed cell ('|', grass in the
    ;; Hollow) is drawn where the room puts it; one whose column ends on air
    ;; or an updraft hangs in the sky. Every such cell, as (label c r):
    ;; the room's label and the cell, column and row from the top-left. The
    ;; cell under a room's bottom row is the room below's (rock where there
    ;; is none). test/test-art.sgl holds the world to none.
    (define (floating-reeds ct)
      (let ((wm (content-map ct)))
        (apply append
               (map (lambda (rm)
                      (let ((ox (* ROOM-COLS (- (room-x rm) (worldmap-x0 wm))))
                            (oy (* ROOM-ROWS (- (room-y rm) (worldmap-y0 wm)))))
                        (let loop ((i 0) (acc '()))
                          (if (= i (* ROOM-COLS ROOM-ROWS))
                              (reverse acc)
                              (let* ((c (modulo i ROOM-COLS)) (r (quotient* i ROOM-COLS))
                                     (below (world-char ct (+ ox c) (+ oy r 1))))
                                (loop (+ i 1)
                                      (if (and (char=? (room-char rm c r) #\|)
                                               (memv below (list #\space #\^)))
                                          (cons (list (room-label rm) c r) acc)
                                          acc)))))))
                    (map placed-data (content-rooms ct))))))
    (define (quotient* a b) (exact (floor (/ a b))))

    ;; --- the backdrop -----------------------------------------------------------------------

    ;; The Bayer 4x4 threshold, 0..1.
    (define bayer dither-threshold)

    ;; A region's backdrop, as slots. The sky is four flat bands, sky-1 at
    ;; the top to sky-4 low down, each meeting the next in a dithered seam
    ;; SEAM rows deep (the Amiga way: flat colour, dithered only where two
    ;; meet). A far silhouette stands on the horizon in sky-2 (distance is
    ;; the sky's own colour, section 7), and under it the far land lies in
    ;; mist, sky-3 thinning to sky-4.
    ;;   (seams horizon amp seed copses): seams, the rows where each band
    ;;   meets the next; amp, the hills' height; copses, how many clumps of
    ;;   far trees stand on them.
    (define SEAM 12)

    (define (backdrop-spec name)
      (case name
        ((hollow) (list (list 38 80 112) 120 30 7 0))    ; the fells stand high round the bowl
        (else (list (list 44 88 120) 126 9 3 5))))       ; Reedfen: low, wide, the sky most of it

    ;; The hills' height above the horizon at x (0..amp).
    (define (hill x amp seed)
      (let ((u (* 1.0 x)))
        (* amp (+ 0.5 (* 0.28 (sin (+ seed (* u 0.011))))
                  (* 0.14 (sin (+ (* 2.3 seed) (* u 0.029))))
                  (* 0.08 (sin (+ (* 1.7 seed) (* u 0.071))))))))

    ;; A copse: a rounded clump a few pixels high at xc, width w.
    (define (copses x n seed)
      (let loop ((k 0) (best 0.0))
        (if (= k n)
            best
            (let* ((xc (modulo (+ 37 (* k 83) (* seed 29)) VIEW-W))
                   (w (+ 6 (modulo (* (+ k seed) 7) 9)))
                   (d (/ (abs (- x xc)) (* 0.5 w))))
              (loop (+ k 1)
                    (if (< d 1.0)
                        (max best (* (+ 3.0 (modulo (* k 5) 3)) (sqrt (- 1.0 (* d d)))
                                     (+ 0.85 (* 0.15 (sin (* x 1.7))))))
                        best))))))

    ;; The sky slot at row y (0..3), dithered in the seams.
    (define (sky-slot seams x y)
      (let loop ((ss seams) (i 0))
        (cond ((null? ss) i)
              ((< y (- (car ss) (/ SEAM 2))) i)
              ((< y (+ (car ss) (/ SEAM 2)))
               (let ((frac (/ (- y (- (car ss) (/ SEAM 2))) (* 1.0 SEAM))))
                 (if (> frac (bayer x y)) (+ i 1) i)))
              (else (loop (cdr ss) (+ i 1))))))

    (define (backdrop-bytes name)
      (let* ((spec (backdrop-spec name))
             (seams (car spec)) (horizon (cadr spec)) (amp (caddr spec))
             (seed (cadddr spec)) (ncop (list-ref spec 4))
             (bv (make-bytevector (* 4 VIEW-W VIEW-H) 0)))
        (let cols ((x 0))
          (when (< x VIEW-W)
            (let ((top (floor-int (- horizon (hill x amp seed) (copses x ncop seed)))))
              (let rows ((y 0))
                (when (< y VIEW-H)
                  (let* ((s (cond ((< y top) (sky-slot seams x y))
                                  ((< y (+ horizon 3)) 1)
                                  ;; the far land in mist: sky-3, thinning to sky-4
                                  ((> (/ (- y horizon 3) 24.0) (bayer x y)) 3)
                                  (else 2)))
                         (o (* 4 (+ x (* y VIEW-W)))))
                    (bytevector-u8-set! bv o s)
                    (bytevector-u8-set! bv (+ o 3) 255))
                  (rows (+ y 1)))))
            (cols (+ x 1))))
        bv))

    ;; Open fen haze is pale sky coverage in the distance, not DARK. As in
    ;; Glasswood's valley, softly tapered bands follow a low, uneven horizon.
    (define (reedfen-bytes)
      (let ((bv (backdrop-bytes 'reedfen)))
        (let cols ((x 0))
          (when (< x VIEW-W)
            (let rows ((y 78))
              (when (< y 134)
                (let* ((upper (+ 94 (* 3.0 (sin (* x 0.019)))))
                       (lower (+ 117 (* 4.0 (sin (+ 1.2 (* x 0.012))))))
                       (mist (max (* 0.18 (max 0.0 (- 1.0 (/ (abs (- y upper)) 8.0))))
                                  (* 0.30 (max 0.0 (- 1.0 (/ (abs (- y lower)) 10.0)))))))
                  (when (< (bayer x y) mist)
                    (bytevector-u8-set! bv (* 4 (+ x (* y VIEW-W))) (slot-of 'sky-4))))
                (rows (+ y 1))))
            (cols (+ x 1))))
        bv))

    ;; Under the fen: a room under a ceiling of rock (under?) has earth
    ;; behind it, not sky. A back wall of peat in the ground's two darkest
    ;; slots: ground-1, with strata of ground-2 dithered in, thin roots
    ;; hanging from the top in leaf-1, and the odd stone in ground-2.
    (define (under-bytes)
      (let ((bv (make-bytevector (* 4 VIEW-W VIEW-H) 0)))
        (let cols ((x 0))
          (when (< x VIEW-W)
            (let* ((root (and (= 0 (modulo (+ (* x 7) (floor-int (* 5.0 (sin (* x 0.37))))) 23)) (> (sin (* x 0.9)) -0.2)))
                   (root-len (+ 10 (modulo (* x 13) 34))))
              (let rows ((y 0))
                (when (< y VIEW-H)
                  (let* ((band (+ 0.5 (* 0.5 (sin (+ (* y 0.21) (* 0.9 (sin (* x 0.023))))))))
                         (s (cond ((and root (< y root-len) (> (+ root-len (- y)) (* 4.0 (bayer x y)))) 8)
                                  ((> (* 0.22 band band band) (bayer x y)) 5)
                                  (else 4)))
                         (o (* 4 (+ x (* y VIEW-W)))))
                    (bytevector-u8-set! bv o s)
                    (bytevector-u8-set! bv (+ o 3) 255))
                  (rows (+ y 1)))))
            (cols (+ x 1))))
        bv))

    ;; --- Glasswood (the region's bible, "The look") ---

    (define (glw-hash x k) (modulo (+ (* x x 31) (* x (+ 17 k)) (* k 101) 7) 97))

    ;; Glasswood's backdrop: the misty valley below the scree and the far
    ;; wood standing in it. The sky's four bands (slate blue high up to the
    ;; warm haze); the valley's far side, a low ridge in sky-2; under it the
    ;; valley full of mist, the haze thick at the ridge's foot and thinning,
    ;; and the far birch wood rising out of it: thin trunks and dithered
    ;; crowns in sky-2, a pixel here and there catching the light (the wood
    ;; glitters far below), and a second band of mist lying across it.
    (define (glasswood-bytes sun)
      (let* ((seams (list 18 34 48)) (horizon 62)
             (tops (make-vector VIEW-W #f))
             (bv (make-bytevector (* 4 VIEW-W VIEW-H) 0)))
        ;; the far wood's trunks: about one column in seven, never two side by side
        (let loop ((x 0) (prev #f))
          (when (< x VIEW-W)
            (let ((t? (and (not prev) (< (glw-hash x 0) 15))))
              (when t? (vector-set! tops x (+ 70 (modulo (glw-hash x 3) 18))))
              (loop (+ x 1) t?))))
        (let ((crown? (lambda (x y)
                        (let loop ((dx -4))
                          (and (<= dx 4)
                               (let* ((tx (+ x dx))
                                      (top (and (>= tx 0) (< tx VIEW-W) (vector-ref tops tx))))
                                 (or (and top
                                          (let ((u (/ dx 3.5)) (v (/ (- y (+ top 3)) 7.0)))
                                            (< (+ (* u u) (* v v)) 1.0)))
                                     (loop (+ dx 1)))))))))
          (let cols ((x 0))
            (when (< x VIEW-W)
              (let ((ridge (floor-int (- horizon (hill x 10 11)))))
                (let rows ((y 0))
                  (when (< y VIEW-H)
                    (let* ((th (bayer x y))
                           (s (cond ((< y ridge) (sky-slot seams x y))
                                    ;; the ridge's crest catching the low sun
                                    ((< y (+ horizon 2)) (if (and (<= y (+ ridge 1)) (< th (* 0.45 sun))) 12 1))
                                    (else
                                     (let* ((d (- y horizon))
                                            ;; the bands drift up and down along the valley
                                            (band (+ 102 (* 5.0 (sin (+ 0.7 (* x 0.013)))) (* 2.0 (sin (* x 0.047)))))
                                            (mist (max (- 0.85 (* d (+ 0.032 (* 0.008 (sin (* x 0.021))))))
                                                       (* 0.65 (max 0.0 (- 1.0 (/ (abs (- y band)) 7.0))))))
                                            (top (vector-ref tops x))
                                            (trunk (and top (> y (+ top 2))))
                                            (crown (and (not trunk) (crown? x y) (> 0.5 (bayer (+ x 2) (+ y 1))))))
                                       (cond ((< th mist) 3)
                                             (trunk 1)
                                             (crown (if (= 0 (modulo (glw-hash (+ x (* 3 y)) 5) 9))
                                                        ;; the far crowns glitter, copper where the sun reaches
                                                        (if (< (glw-hash (+ y (* 7 x)) 1) (* 97.0 0.6 sun)) 12 3)
                                                        1))
                                             (else 2))))))
                           (o (* 4 (+ x (* y VIEW-W)))))
                      (bytevector-u8-set! bv o s)
                      (bytevector-u8-set! bv (+ o 3) 255))
                    (rows (+ y 1)))))
              (cols (+ x 1)))))
        bv))

    ;; Under Glasswood: a wall of blue ice, not earth. Ice in shade (ground-2)
    ;; with long flow bands of ice (ground-3), and pools of the ice's own glow
    ;; (water, which the dark leaves as it is: the caves' shapes stay just
    ;; visible, the bible's "faint blue glow from the ice itself"). Birch
    ;; roots hang from the top in bark grey.
    (define (glasswood-under-bytes)
      (let ((bv (make-bytevector (* 4 VIEW-W VIEW-H) 0)))
        (let cols ((x 0))
          (when (< x VIEW-W)
            (let* ((root (and (= 0 (modulo (+ (* x 7) (floor-int (* 5.0 (sin (* x 0.37))))) 29)) (> (sin (* x 0.9)) -0.2)))
                   (root-len (+ 12 (modulo (* x 13) 40))))
              (let rows ((y 0))
                (when (< y VIEW-H)
                  (let* ((th (bayer x y))
                         (flow (+ 0.5 (* 0.5 (sin (+ (* x 0.09) (* 2.2 (sin (+ (* y 0.031) (* x 0.004)))))))))
                         ;; the ice's glow: soft pools deep in the wall, a sparse
                         ;; dither of water thickening toward each pool's heart
                         (glow (* (sin (+ (* x 0.029) (* 1.6 (sin (* y 0.043))) 0.4))
                                  (sin (+ (* y 0.051) (* x 0.011) (* 0.8 (sin (* x 0.07)))))))
                         (s (cond ((and root (< y root-len) (> (+ root-len (- y)) (* 4.0 th))) 9)
                                  ((< th (* 0.5 (- glow 0.4))) 11)
                                  ((> flow (+ 0.62 (* 0.3 th))) 6)
                                  (else 5)))
                         (o (* 4 (+ x (* y VIEW-W)))))
                    (bytevector-u8-set! bv o s)
                    (bytevector-u8-set! bv (+ o 3) 255))
                  (rows (+ y 1)))))
            (cols (+ x 1))))
        bv))

    (define *backdrops* '())       ; ((key . texture) ...), key a region, 'under or 'glasswood-under

    (define (backdrop key)
      (let ((e (assq key *backdrops*)))
        (if e
            (cdr e)
            (let ((t (make-texture-from-pixels VIEW-W VIEW-H
                                               (if (cloudstair-backdrop-key? key)
                                                   (cloudstair-backdrop-bytes key)
                                               (case key
                                                 ((under) (under-bytes))
                                                 ((glasswood-under) (glasswood-under-bytes))
                                                 ((pipes-0) (pipes-backdrop-bytes 0))
                                                 ((pipes-1) (pipes-backdrop-bytes 1))
                                                 ((pipes-2) (pipes-backdrop-bytes 2))
                                                 ((glasswood) (glasswood-bytes 1.0))
                                                 ((glasswood-sun-0) (glasswood-bytes 0.0))
                                                 ((glasswood-sun-1) (glasswood-bytes 0.25))
                                                 ((glasswood-sun-2) (glasswood-bytes 0.5))
                                                 ((glasswood-sun-3) (glasswood-bytes 0.75))
                                                 ((glasswood-sun-4) (glasswood-bytes 1.0))
                                                 ((reedfen) (reedfen-bytes))
                                                 (else (backdrop-bytes key))))
                                               'nearest)))
              (set! *backdrops* (cons (cons key t) *backdrops*))
              t))))

    ;; Under ground: a room whose own top row is mostly rock (a ceiling:
    ;; more than 15 of its 25 cells solid or climbable) has earth behind it.
    ;; Not "a room above it": the Hollow stacks two rows of open-air rooms
    ;; under one sky, and the first rule drew its dawn bowl as a cave.
    ;; Cloudstair's rooms are all outdoors: a closed top there is the shelf
    ;; above, with the sky still behind (the region's seams close every
    ;; unjoined pair of rooms, so most tops are rock).
    (define (under? rm) (and (not (cloudstair? rm)) (room-under? rm)))
    (define (cloudstair? rm) (eq? (room-region rm) 'cloudstair))

    ;; The haze step (D51, replacing D16's focus pull): while a moment's
    ;; music sounds the far sky goes one palette step toward the region's
    ;; haze (sky-4), band by band from the horizon up, and back once it
    ;; stops; the room itself is as it was. Whole bands change slot, so no
    ;; pixel moves and no seam breaks (D16 first scattered the backdrop's
    ;; pixels, and at the game's whole scale every band seam grew zigzag
    ;; teeth). (harkfell haze) holds the rule and the ease, by the clock;
    ;; *focus* is 0..1, stepped once a drawn frame. The Pipes' backdrop (its
    ;; sky slots are cave walls) is left as it is.
    (define *focus* 0.0)
    (define *focus-at* #f)          ; the clock (s) at the last step
    (define *moment* #f)
    (define *look-now* #f)
    (define *bed-wind* 0.5)

    ;; From the shell, each frame: whether a moment's music sounds (its rows
    ;; still playing: sound-moment-sounding), the bed's wind level now (0..1;
    ;; the reeds bend with what you hear), and the clock in seconds.
    (define (set-look-sound! moment wind . now)
      (set! *moment* (and moment #t))
      (set! *bed-wind* (if (number? wind) wind 0.5))
      (set! *look-now* (and (pair? now) (number? (car now)) (car now))))

    ;; dt from the shell's clock; a frame without one counts as 1/60 s
    (define (step-focus!)
      (let ((dt (if (and *look-now* *focus-at*) (min 0.25 (max 0.0 (- *look-now* *focus-at*))) (/ 1.0 60.0))))
        (set! *focus-at* *look-now*)
        (set! *focus* (haze-focus-next *focus* *moment* dt))))

    ;; The room's backdrop: its region's sky, or earth when it lies under
    ;; another room; stepped into the haze while a moment's music sounds.
    (define (draw-backdrop! rm)
      (let ((tex (backdrop (cond ((eq? (room-region rm) 'pipes) (pipes-backdrop-key rm))
                                 ((cloudstair? rm) (cloudstair-backdrop-key rm))
                                 ((and (not (under? rm)) (glasswood-sheet? rm))
                                  ;; Glasswood's sky by the room's sun, in quarters
                                  (vector-ref (vector (quote glasswood-sun-0) (quote glasswood-sun-1) (quote glasswood-sun-2) (quote glasswood-sun-3) (quote glasswood-sun-4))
                                              (exact (round (* 4 (room-sun rm))))))
                                 ((not (under? rm)) (room-region rm))
                                 ((eq? (room-region rm) (quote glasswood)) (quote glasswood-under))
                                 (else (quote under)))))
            (bands (haze-bands *focus*)))
        (with-blend-mode (quote none)
          (set-color 1.0 1.0 1.0 1.0)
          (if (and (> bands 0) (not (eq? (room-region rm) 'pipes)))
              (draw-texture-hazed! tex VIEW-W VIEW-H (map (lambda (s) (haze-slot s bands)) (list 0 1 2)))
              (draw-texture tex 0 0 VIEW-W VIEW-H)))))
    ;; The sky's slow movers: three clouds over a room open to the sky, a
    ;; pixel every two seconds (section 7), each at its own height, coming
    ;; back round from the west. Placed by the room's coordinate, so two
    ;; rooms side by side do not show the same sky.
    (define CLOUDS (list (list "sky/cloud-a" 30 22) (list "sky/cloud-c" 190 40) (list "sky/cloud-b" 320 14)))
    (define CLOUD-SPAN (+ VIEW-W 80))

    ;; the clouds' atlas indices, looked up once (not by name every frame)
    (define *cloud-cells* (quote ()))
    (define (cloud-index name)
      (let ((e (assoc name *cloud-cells*)))
        (if e
            (cdr e)
            (let ((i (atlas-index name)))
              (set! *cloud-cells* (cons (cons name i) *cloud-cells*))
              i))))

    (define (draw-clouds! rm t)
      (unless (under? rm)
        (let ((shift (+ (floor-int (/ t 120)) (* 137 (room-x rm)) (* 61 (room-y rm)))))
          (set-color 1.0 1.0 1.0 1.0)
          (for-each (lambda (c)
                      (let ((i (cloud-index (car c))))
                        (when i
                          (atlas-draw! i (- (modulo (+ (cadr c) shift) CLOUD-SPAN) 40) (caddr c) 1))))
                    CLOUDS))))

    ;; --- the layers: solids and foliage, baked per room ---------------------------------------

    ;; One tile of a solid material: its autotile cell, or a plain block.
    (define (solid-tile! sheet mat x y m gc gr)
      (let* ((name (symbol->string (if (eq? mat 'rock) 'rock mat)))
             (mc (mat-cells sheet name)))
        (if mc
            (let* ((n (car mc))
                   (i (vector-ref (cdr mc) (+ (* m n) (tile-variant gc gr n)))))
              (set-color 1.0 1.0 1.0 1.0)
              (atlas-draw! i x y 1))
            (begin
              (paint! (case mat ((hazard) 'accent) ((ledge) 'ground-3) (else 'ground-2)))
              (if (eq? mat 'ledge)
                  (draw-filled-rect x y S 3)
                  (draw-filled-rect x y S S))))))

    (define (draw-solids! rm)
      (let* ((sheet (region-sheet (room-region rm)))
             ;; a cave (a room under a ceiling of rock) draws its rock as the
             ;; sheet's cave ice when the sheet has it (Glasswood's glass caves)
             (cave? (and (under? rm) (mat-cells sheet "cave") #t)))
        ;; under water nothing grows: a solid with water on it takes the mask
        ;; of one covered from above (no turf on a pool's floor)
        (each-tile rm (cond ((eq? (room-region rm) 'pipes)
                             (lambda (m) (memq m (list 'ledge 'hazard))))
                            ((cloudstair? rm) (lambda (m) #f))   ; all painted ((harkfell cloudstair look))
                            (else solid-mat?))
                   (lambda (mat x y m gc gr)
                     (let ((m (if (and (not (mask-has? m MASK-UP)) (eq? (material-at gc (- gr 1)) 'water))
                                  (+ m MASK-UP)
                                  m)))
                       (solid-tile! sheet (if (and cave? (eq? mat (quote rock))) (quote cave) mat) x y m gc gr))))
        ;; The rose stone remains behind the closed blue-linked rock face.
        (when (and (bowl? rm) (null? *passage-air*))
          (let ((g (global-tile rm 21 6)))
            (solid-tile! sheet 'rock (* 21 S) (* 6 S) 15 (car g) (cdr g))))))

    ;; Reeds: a column's cells, top over mid over base, one variant per
    ;; column so a stalk runs on from cell to cell.
    (define (reed-cell sheet part gc)
      (let loop ((n 0))
        (if (atlas-index (string-append sheet "/reeds-" part "-" (string (integer->char (+ 97 n)))))
            (loop (+ n 1))
            (and (> n 0)
                 (atlas-index (string-append sheet "/reeds-" part "-"
                                             (string (integer->char (+ 97 (tile-variant gc 0 n))))))))))

    (define (reed-part m)
      (cond ((not (mask-has? m MASK-UP)) "top")
            ((not (mask-has? m MASK-DOWN)) "base")
            (else "mid")))

    ;; The Old Birch: a | with a | beside it is part of a wide trunk, drawn
    ;; from the sheet's old-* cells by its place (l m r; top, mid, base; the
    ;; hollow in a middle column just above the base). #f where the sheet
    ;; has none (Reedfen's reeds and the Hollow's grass stand side by side
    ;; and stay as they are).
    (define (old-birch-cell sheet m gc gr)
      (let ((l (mask-has? m MASK-LEFT)) (r (mask-has? m MASK-RIGHT)))
        (and (or l r)
             (let* ((pos (cond ((not l) "l") ((not r) "r") (else "m")))
                    (row (cond ((not (mask-has? m MASK-UP)) "top-")
                               ((not (mask-has? m MASK-DOWN)) "base-")
                               (else "")))
                    (hollow? (and (string=? pos "m") (string=? row "") (= 2 (reed-run-down gc gr)))))
               (or (and hollow? (atlas-index (string-append sheet "/old-hollow")))
                   (atlas-index (string-append sheet "/old-" row pos)))))))

    ;; How many reed cells run down from global (gc, gr), itself included.
    (define (reed-run-down gc gr)
      (let loop ((r gr) (n 0))
        (if (eq? (material-at gc r) 'reeds) (loop (+ r 1) (+ n 1)) n)))
    (define (reed-run-up gc gr)
      (let loop ((r gr) (n 0))
        (if (eq? (material-at gc r) 'reeds) (loop (- r 1) (+ n 1)) n)))

    (define (draw-foliage! rm)
      (let ((sheet (region-sheet (room-region rm))))
        (set-blend-mode 'normal)
        (each-tile rm (lambda (m) (eq? m 'reeds))
                   (lambda (mat x y m gc gr)
                     (let ((i (or (old-birch-cell sheet m gc gr)
                                  (reed-cell sheet (reed-part m) gc) (reed-cell sheet "mid" gc))))
                       (if i
                           (begin (set-color 1.0 1.0 1.0 1.0) (atlas-draw! i x y 1))
                           (begin (paint! 'leaf-2)
                                  (draw-filled-rect (+ x 4) y 1 S) (draw-filled-rect (+ x 10) y 1 S))))))
        ;; Glasswood's low sun on the bark, before the weights so it sways with it
        (if (glasswood-sheet? rm)
            (draw-sun-on-trunks! rm)
            (draw-hollow-sun! rm))
        ;; the sway weight in G, row by row: 0 at a stalk's root, 1 at its tip
        (unless (eq? (room-region rm) 'pipes)
          (with-additive-blend
            (each-tile rm (lambda (m) (eq? m 'reeds))
                       (lambda (mat x y m gc gr)
                         (let* ((below (- (reed-run-down gc gr) 1))
                                (n (+ below (reed-run-up gc gr))))
                           (let rows ((py 0))
                             (when (< py S)
                               (set-color 0.0 (/ (+ (* below S) (- S py)) (* 1.0 n S)) 0.0 1.0)
                               (draw-filled-rect x (+ y py) S 1)
                               (rows (+ py 1)))))))))))

    ;; Front decoration (a room's decor: auto): a tuft of grass on about one
    ;; bare top in three of rock or rough rock (one with air above it), in
    ;; front of the creature, swaying; its weight rises up the tuft's six rows.
    ;; Glasswood's crowns: glazed twig sprays standing up from about two
    ;; branches (=) in three, with air above them (the sheet's crown-a, -b).
    (define (draw-front! rm)
      (when (eq? (room-decor rm) (quote auto))
        (let ((sheet (region-sheet (room-region rm))))
          (front-sprigs! rm sheet "tuft-" (list "a" "b" "c") (list (quote rock) (quote rough)) 3)
          (front-sprigs! rm sheet "crown-" (list "a" "b") (list (quote ledge)) 1.5))))

    ;; Sprigs of the sheet's PREFIX cells, 6 rows standing on the bare tops of
    ;; MATS: one top in PER has one, and they sway, their weight rising up the
    ;; six rows.
    (define (front-sprigs! rm sheet prefix names mats per)
      (let* ((cells (filter (lambda (x) x)
                            (map (lambda (v) (atlas-index (string-append sheet "/" prefix v))) names)))
             (n (length cells))
             (bare? (lambda (mat gc gr) (and (memq mat mats) (not (material-at gc (- gr 1))))))
             (pick (lambda (gc gr) (tile-variant (+ gc 7) (+ gr 3) (max 1 (exact (round (* per (max 1 n)))))))))
        (when (pair? cells)
          (set-blend-mode (quote normal))
          (each-tile rm (lambda (m) (memq m mats))
                     (lambda (mat x y m gc gr)
                       (let ((k (pick gc gr)))
                         (when (and (bare? mat gc gr) (< k n))
                           (set-color 1.0 1.0 1.0 1.0)
                           (atlas-draw! (list-ref cells k) x (- y 6) 1)))))
          (with-additive-blend
            (each-tile rm (lambda (m) (memq m mats))
                       (lambda (mat x y m gc gr)
                         (let ((k (pick gc gr)))
                           (when (and (bare? mat gc gr) (< k n))
                             (let rows ((py 0))
                               (when (< py 6)
                                 (set-color 0.0 (/ (- 6 py) 6.0) 0.0 1.0)
                                 (draw-filled-rect x (+ (- y 6) py) S 1)
                                 (rows (+ py 1))))))))))))

    (define *solid-rt* #f)
    (define *front-rt* #f)
    (define *foliage-rt* #f)
    (define *layers-key* #f)       ; the room the layers hold
    (define *passage-air* '())     ; global cells revealed in this room now

    (define (bowl? rm)
      (and (eq? (room-region rm) 'hollow) (= (room-x rm) 4) (= (room-y rm) 3)))

    (define (stone-visible? rm st)
      (not (and (bowl? rm) (= (stone-overtone st) 5) (null? *passage-air*))))

    (define (revealed-cells rm tm)
      (if (not tm)
          '()
          (filter-map
            (lambda (cell)
              (let ((g (global-tile rm (car cell) (cadr cell))))
                (and (eq? (tilemap-ref tm (car g) (cdr g)) 'air) g)))
            (apply append
              (map (lambda (thing) (thing-kw thing "cells"))
                   (room-things-of rm 'stone-passage))))))

    ;; Bake the room's layers if they are not this room's. Outside any pass.
    (define (prepare-layers! rm . live)
      (unless *solid-rt*
        (set! *solid-rt* (make-render-target VIEW-W VIEW-H 'nearest))
        (set! *foliage-rt* (make-render-target VIEW-W VIEW-H (quote nearest)))
        (set! *front-rt* (make-render-target VIEW-W VIEW-H (quote nearest))))
      (let ((revealed (revealed-cells rm (and (pair? live) (car live)))))
        (unless (and (eq? *layers-key* rm) (equal? revealed *passage-air*))
          (set! *passage-air* revealed)
          (atlas-ensure!)
          (with-render-target *solid-rt*
            (set-blend-mode 'normal)
            ;; the Pipes' limestone is painted from global pixels ((harkfell pipes look))
            (when (eq? (room-region rm) 'pipes)
              (let ((g (global-tile rm 0 0)))
                (draw-pipes-solids! rm
                                    (lambda (c r) (let ((gt (global-tile rm c r))) (material-at (car gt) (cdr gt))))
                                    (* S (car g)) (* S (cdr g)))))
            ;; Cloudstair's cliffs likewise ((harkfell cloudstair look))
            (when (cloudstair? rm)
              (let ((g (global-tile rm 0 0)))
                (draw-cloudstair-solids! rm
                                         (lambda (c r) (let ((gt (global-tile rm c r))) (material-at (car gt) (cdr gt))))
                                         (* S (car g)) (* S (cdr g)))))
            (draw-solids! rm)
            (draw-drifts! rm)
            (draw-sun-on-branches! rm)
            (draw-water-bed! rm))
          (with-render-target *foliage-rt*
            (set-blend-mode 'normal)
            (draw-foliage! rm))
          (with-render-target *front-rt*
            (set-blend-mode (quote normal))
            (draw-front! rm))
          (set! *glints* (room-glints rm))
          (set! *crusts* (room-crusts rm))
          (set! *layers-key* rm))))

    ;; Glints on the glaze (Glasswood's bible, "Moving pictures"): points of
    ;; light along the tops of glazed branches and ice, each catching the
    ;; sun now and then, more often as the wind rises (the same wind the
    ;; reeds and trunks bend in). ((x y phase sunny?) ...) for the room, view
    ;; px; only a region drawn from the glasswood sheet has any. A sunny glint
    ;; has a copper core (the low sun caught in the glaze), as many of them
    ;; as the room has sun.
    (define *glints* '())
    (define (room-glints rm)
      (if (not (glasswood-sheet? rm))
          '()
          (let ((acc '()) (sun (room-sun rm)))
            ;; along the tops of glazed branches and ice, and the ice crust on
            ;; open water (room-crusts' cells)
            (each-tile rm (lambda (m) (or (memq m (list 'ledge 'rock))
                                          (and (eq? m 'water) (not (under? rm)))))
                       (lambda (mat x y m gc gr)
                         (when (and (not (mask-has? m MASK-UP))
                                    (or (not (eq? mat 'water)) (not (material-at gc (- gr 1)))))
                           (for-each (lambda (dx)
                                       (let ((ph (tile-variant (+ gc dx) gr 97)))
                                         (set! acc (cons (list (+ x dx) y (* 1.0 ph) (< (modulo (* ph 7) 10) (* 10.0 sun))) acc))))
                                     (if (eq? mat 'ledge) (list 3 11) (list 6))))))
            acc)))

    (define (glint-on? g t)
      (> (sin (+ (* t 0.031) (* 0.7 (caddr g)))) (- 0.985 (* 0.03 (wind-at t)))))

    ;; The glints now, in the light pass (B, additive).
    (define (draw-glints! t)
      (for-each (lambda (g)
                  (when (glint-on? g t)
                    (paint-light! 0.6)
                    (draw-filled-rect (car g) (cadr g) 1 1)
                    (paint-light! 0.25)
                    (draw-filled-rect (- (car g) 1) (cadr g) 3 1)
                    (draw-filled-rect (car g) (- (cadr g) 1) 1 3)))
                *glints*))

    ;; The sunny glints' copper cores, after the light pass (ordinary blend:
    ;; a slot, unlit, so the core is the accent itself inside its lit halo).
    (define (draw-glint-cores! t)
      (for-each (lambda (g)
                  (when (and (cadddr g) (glint-on? g t))
                    (paint! 'accent)
                    (draw-filled-rect (car g) (cadr g) 1 1)))
                *glints*))

    ;; --- the low sun (David on contact sheet 1: copper as an accent, "copper
    ;; light on the bark and caught in the glaze, strongest in The Scree and
    ;; First Sight and fading toward the blue hour deeper in") ---

    (define (glasswood-sheet? rm) (string=? (region-sheet (room-region rm)) "glasswood"))

    ;; Explicit per-room sun overrides the original Glasswood position rule.
    ;; Other regions remain sunless unless authored; ceilings shelter both.
    (define (room-sun rm)
      (cond ((under? rm) 0.0)
            ((room-sun-value rm) (room-sun-value rm))
            ((not (glasswood-sheet? rm)) 0.0)
            (else
             (let* ((r (and *content* (content-region *content* (room-region rm))))
                    (b (and r (region-field r 'bounds)))
                    (xe (if (and (list? b) (= 2 (length b)) (list? (cadr b)))
                            (car (cadr b))
                            (room-x rm))))
               (max 0.0 (min 1.0 (- 1.0 (* 0.35 (- xe (room-x rm))))))))))

    ;; A copper pixel at (x, y) where the hash of (gc, k) falls under p.
    (define (sun-pixel! x y gc k p)
      (when (< (tile-variant (+ gc 13) (+ k 5) 100) (* 100.0 p))
        (draw-filled-rect x y 1 1)))

    ;; West light catches the Hollow’s stone lips and the grass above them.
    ;; Use its existing copper/bracken accent, baked before foliage sway.
    (define (draw-hollow-sun! rm)
      (when (and (eq? (room-region rm) 'hollow) (> (room-sun rm) 0.0))
        (paint! 'accent)
        (each-tile rm (lambda (m) (memq m '(rock rough)))
                   (lambda (mat x y mask gc gr)
                     (unless (mask-has? mask MASK-UP)
                       (let cols ((c 1))
                         (when (< c 15)
                           (sun-pixel! (+ x c) (- y 1) gc (+ (* 16 gr) c)
                                       (* 0.3 (room-sun rm)))
                           (cols (+ c 1)))))))))

    ;; Copper on the birches' sunlit edge: the lit column of each trunk
    ;; variant (a b c stand at columns 6-9, 9-11, 3-7), in runs of two rows,
    ;; about half of them in full sun; not up in a crown's first twigs.
    (define TRUNK-LIT-COL (vector 6 9 3))
    (define (draw-sun-on-trunks! rm)
      (let ((sun (room-sun rm)))
        (when (> sun 0.0)
          (paint! 'accent)
          (each-tile rm (lambda (m) (eq? m 'reeds))
                     (lambda (mat x y m gc gr)
                       (let* ((l (mask-has? m MASK-LEFT)) (rt (mask-has? m MASK-RIGHT))
                              ;; the Old Birch (| beside |): only its west edge, at column 3
                              (col (cond ((and (not l) rt) 3)
                                         ((or l rt) #f)
                                         (else (vector-ref TRUNK-LIT-COL (tile-variant gc 0 3)))))
                              (from (if (mask-has? m MASK-UP) 0 10)))
                         (let rows ((r from) (to (if (mask-has? m MASK-DOWN) 16 11)))
                           (when (and col (< r to))
                             (when (< (tile-variant (+ gc 13) (+ (* 8 gr) (quotient* r 2) 5) 100) (* 50.0 sun))
                               (draw-filled-rect (+ x col) (+ y r) 1 1))
                             (rows (+ r 1) to)))))))))

    ;; Copper caught in the glaze along the tops of the branches, and more
    ;; sparsely in the frozen crust on the snow of a bare top (rock, scree).
    (define (draw-sun-on-branches! rm)
      (let ((sun (room-sun rm)))
        (when (> sun 0.0)
          (paint! 'accent)
          (each-tile rm (lambda (m) (memq m (list 'ledge 'rock 'rough)))
                     (lambda (mat x y m gc gr)
                       (when (or (eq? mat 'ledge) (not (mask-has? m MASK-UP)))
                         (let cols ((c 1))
                           (when (< c 15)
                             (sun-pixel! (+ x c) y gc (+ (* 16 gr) c) (* (if (eq? mat 'ledge) 0.22 0.06) sun))
                             (cols (+ c 1))))))))))

    ;; A ring-stone's slots in its room (David's ruling, 2026-09-27: "The
    ;; stone colors can be unique to each area but the colors are
    ;; meaningful"). The body may take the region's own colours; the glyph's
    ;; harmonic colours (h2..h7) are world-wide slots, the same in every
    ;; region and under any light: (DARK and LIT leave them as they are). In
    ;; Glasswood the body is a step darker, ice in shade with an ice edge, so
    ;; a blue or green glyph reads against it.
    (define (stone-slot rm)
      (if (glasswood-sheet? rm)
          (lambda (n) (slot (case n ((ground-4) 'ground-3) ((ground-3) 'ground-2) ((ground-2) 'ground-1) (else n))))
          slot))


    ;; Light shafts through the trunks at the wood's edge (the bible's
    ;; "Moving pictures"): three broad bands of the low sun slanting down
    ;; from the upper left, below the far ridge, lighting what they cross a
    ;; step as a dither (never a wash), as strong as the room's sun and
    ;; breathing slowly. In the light pass (B, additive).
    (define SHAFTS (list 30 150 280))
    (define (draw-shafts! rm t)
      (let ((sun (room-sun rm)))
        (when (and (glasswood-sheet? rm) (> sun 0.0) (not (under? rm)))
          (paint-light! (* sun (+ 0.09 (* 0.03 (sin (* t 0.004))))))
          (for-each (lambda (x0)
                      (let rows ((y 64))
                        (when (< y VIEW-H)
                          (draw-filled-rect (+ x0 (quotient* (- y 64) 2)) y 16 2)
                          (rows (+ y 2)))))
                    SHAFTS))))

    ;; --- Glasswood's water and weather ---

    ;; Deep snow: a drift (the sheet's drift-a, -b) over about half the bare
    ;; tops of glass ice in a room under the sky, rising four pixels above
    ;; the tile, baked into the solid layer (snow does not sway).
    (define (draw-drifts! rm)
      (when (and (glasswood-sheet? rm) (not (under? rm)))
        (let ((cells (filter (lambda (i) i) (list (ice-cell "drift-a") (ice-cell "drift-b")))))
          (when (pair? cells)
            (set-color 1.0 1.0 1.0 1.0)
            (each-tile rm (lambda (m) (eq? m 'rock))
                       (lambda (mat x y m gc gr)
                         (let ((k (tile-variant (+ gc 11) gr (* 2 (length cells)))))
                           (when (and (< k (length cells)) (not (material-at gc (- gr 1))))
                             (atlas-draw! (list-ref cells k) x (- y 4) 1)))))))))

    ;; The bed under Glasswood's water, drawn into the solid layer so the
    ;; water pass sees it through the water (stones, dark ice, silt): the
    ;; water reads as depth, not a flat sheet of its colour. On the bottom
    ;; cell of each water column.
    (define (draw-water-bed! rm)
      (when (glasswood-sheet? rm)
        (let ((cells (filter (lambda (i) i) (list (ice-cell "water-bed-a") (ice-cell "water-bed-b")))))
          (when (pair? cells)
            (set-color 1.0 1.0 1.0 1.0)
            (each-tile rm (lambda (m) (eq? m 'water))
                       (lambda (mat x y m gc gr)
                         (if (mask-has? m MASK-DOWN)
                             ;; above the bed, dark water: the water's own colour
                             ;; shows only as the resolve's dither through it
                             (let ((d (ice-cell "water-deep")))
                               (when d (atlas-draw! d x y 1)))
                             (atlas-draw! (list-ref cells (tile-variant gc gr (length cells))) x y 1))))))))

    ;; A crust of clear ice across open water in daylight (the frozen tarn,
    ;; the pools under the sky): on each water cell with air above it, in a
    ;; room open to the sky. Drawn after the water pass, so it is solid ice,
    ;; not seen through water. ((x y) ...) for the room.
    (define *crusts* '())
    (define (room-crusts rm)
      (if (or (not (glasswood-sheet? rm)) (under? rm))
          '()
          (let ((acc '())
                (thin (room-thin-ice rm)))
            (each-tile rm (lambda (m) (eq? m 'water))
                       (lambda (mat x y m gc gr)
                         (unless (material-at gc (- gr 1))
                           (set! acc (cons (list x y) acc)))))
            ;; the frozen tarn (the challenge-and-danger pass, the leader's
            ;; dressing note): glass ice lying on meltwater, open above, and
            ;; not thin ice (drawn its own way), takes the crust too
            (let loop ((r 1))
              (when (< r (- ROOM-ROWS 1))
                (let cl ((c 0))
                  (when (< c ROOM-COLS)
                    (when (and (char=? (room-char rm c r) #\#)
                               (char=? (room-char rm c (+ r 1)) #\~)
                               (not (char-material (room-char rm c (- r 1))))
                               (not (member (cons c r) thin)))
                      (set! acc (cons (list (* S c) (* S r)) acc)))
                    (cl (+ c 1))))
                (loop (+ r 1))))
            acc)))
    (define (draw-crusts!)
      (let ((i (ice-cell "tarn-crust")))
        (when i
          (set-blend-mode 'normal)
          (set-color 1.0 1.0 1.0 1.0)
          (for-each (lambda (c) (atlas-draw! i (car c) (cadr c) 1)) *crusts*))))

    ;; Snow falling (the bible's "Moving pictures"): slow flakes, heavier
    ;; deeper in the wood (fewer where the sun is), none in the caves; each
    ;; drifts on its own and with the wind. In front of the creature.
    (define (draw-snow! rm t)
      (when (and (glasswood-sheet? rm) (not (under? rm)))
        (let* ((n (+ 18 (exact (floor (* 54.0 (- 1.0 (room-sun rm)))))))
               (wind (wind-at t)))
          (set-blend-mode 'normal)
          (paint! 'ground-4)
          (let loop ((i 0))
            (when (< i n)
              (let* ((u (- (* i 0.618034) (floor (* i 0.618034))))
                     (speed (+ 0.09 (* 0.07 u)))
                     (x (modulo (floor-int (+ (* i 83) (* 4.0 (sin (+ (* t 0.013) i))) (* t 0.04 wind))) VIEW-W))
                     (y (- (modulo (floor-int (+ (* i 37) (* t speed))) (+ VIEW-H 8)) 4)))
                (draw-filled-rect x y 1 1))
              (loop (+ i 1)))))))

    ;; The water: G over every water cell of the room, in the current pass.
    (define (draw-water! rm)
      (with-additive-blend
        (paint-water!)
        (each-tile rm (lambda (m) (eq? m 'water))
                   (lambda (mat x y m gc gr) (draw-filled-rect x y S S)))))

    ;; Thin drifting mist just above exposed water, behind creatures and
    ;; the foreground. Skip solid/reed cells so the banks remain crisp.
    (define (draw-reedfen-water-haze! rm t)
      (when (eq? (room-region rm) 'reedfen)
        (paint! 'sky-4)
        (each-tile rm (lambda (m) (eq? m 'water))
                   (lambda (mat x y mask gc gr)
                     (when (or (= y 0) (not (eq? (material-at gc (- gr 1)) 'water)))
                       (let cols ((dx 0))
                         (when (< dx S)
                           (let* ((px (+ x dx))
                                  (centre (+ (- y 5) (* 1.5 (sin (+ (* px 0.035) (* t 0.004)))))))
                             (let rows ((py (max 0 (- y 11))))
                               (when (< py y)
                                 (when (and (not (char-material
                                                  (room-char rm (quotient* px S) (quotient* py S))))
                                            (< (bayer px py)
                                               (* 0.22 (max 0.0 (- 1.0 (/ (abs (- py centre)) 6.0))))))
                                   (draw-filled-rect px py 1 1))
                                 (rows (+ py 1)))))
                           (cols (+ dx 1)))))))))

    ;; --- the body ----------------------------------------------------------------------------

    ;; The player's frame for a body at tick t (assets/art/player.txt):
    ;;   ground   idle, breathing (a b) with an ear flick now and then (c);
    ;;            running, six frames paced by the distance run, so the feet
    ;;            do not slide
    ;;   air      jump-a rising fast, jump-b at the top, fall a/b coming down
    ;;   cling    cling-a held still; climbing, a b c b paced by the height
    ;;   swim     a to d paddling while it moves, a at rest
    (define RUN-FRAMES (vector "run-a" "run-b" "run-c" "run-d" "run-e" "run-f"))
    (define CLIMB-FRAMES (vector "climb-a" "climb-b" "climb-c" "climb-b"))
    (define SWIM-FRAMES (vector "swim-a" "swim-b" "swim-c" "swim-d"))

    (define (step-of v per n) (modulo (floor-int (/ v per)) n))

    ;; Climbing is read from the body's height changing between ticks, not
    ;; from vy: a held climbable wall moves the body by its y and keeps vy at
    ;; 0 ((engine body)'s cling-step), so a vy test never saw a climb and the
    ;; climb frames never showed (playtest 1 #5). Keyed by the world's tick:
    ;; a draw that repeats a tick keeps that tick's answer.
    (define *climb-t* #f)          ; the tick last looked at, while clinging
    (define *climb-y* #f)          ; the body's y at that tick
    (define *climbing* #f)         ; did y change into that tick
    (define (climbing? b t)
      (unless (eqv? t *climb-t*)
        (set! *climbing* (and *climb-y* (not (= (body-y b) *climb-y*))))
        (set! *climb-t* t)
        (set! *climb-y* (body-y b)))
      *climbing*)
    (define (not-clinging!) (set! *climb-t* #f) (set! *climb-y* #f) (set! *climbing* #f))

    (define (player-frame b t)
      (let ((vx (body-vx b)) (vy (body-vy b)))
        (unless (eq? (body-mode b) 'cling) (not-clinging!))
        (case (body-mode b)
          ((swim) (if (or (> (abs vx) 0.2) (> (abs vy) 0.3)) (vector-ref SWIM-FRAMES (step-of t 8 4)) "swim-a"))
          ((cling) (if (climbing? b t) (vector-ref CLIMB-FRAMES (step-of (body-y b) 3.0 4)) "cling-a"))
          ((ground)
           (cond ((> (abs vx) 0.15) (vector-ref RUN-FRAMES (step-of (body-x b) 3.5 6)))
                 ((< (modulo t 347) 9) "idle-c")
                 ((< (modulo t 80) 40) "idle-a")
                 (else "idle-b")))
          (else
           (cond ((< vy -1.2) "jump-a")
                 ((< vy 0.7) "jump-b")
                 ((< (modulo t 12) 6) "fall-a")
                 (else "fall-b"))))))

    ;; The opening (D15): from the dawn until the first input the creature
    ;; lies curled with its ears flat, breathing (wake-a, wake-b), and every
    ;; six seconds or so lifts its head a moment (wake-c). The shell says when
    ;; (CONTENT's shell-waking?).
    (define *waking* #f)
    (define (set-look-waking! on) (set! *waking* (and on #t)))
    (define (waking-frame t)
      (cond ((< (modulo t 380) 70) "wake-c")
            ((< (modulo t 110) 55) "wake-a")
            (else "wake-b")))

    (define *player-cells* '())    ; ((name . atlas index) ...)
    (define (player-cell name)
      (let ((e (assoc name *player-cells*)))
        (if e
            (cdr e)
            (let ((i (atlas-index (string-append "player/" name))))
              (set! *player-cells* (cons (cons name i) *player-cells*))
              i))))

    ;; The body with its box's top-left at (bx, by): its frame standing on
    ;; the box's bottom, centred on it, mirrored facing left.
    (define (draw-body-at b bx by t)
      (let ((i (and (atlas-ready?) (player-cell (if *waking* (waking-frame t) (player-frame b t))))))
        (if i
            (let* ((sz (atlas-size i))
                   (x (- (floor-int (+ bx 4)) (floor-int (/ (car sz) 2))))
                   (y (- (floor-int (+ by 14)) (cdr sz))))
              (set-color 1.0 1.0 1.0 1.0)
              (atlas-draw! i x y (body-facing b)))
            (let ((x (- (floor-int bx) 1)) (y (floor-int by)))
              (paint! 'fur-1)
              (draw-filled-rect x (+ y 3) 10 11)
              (draw-filled-rect (+ x 2) y 1 3)
              (draw-filled-rect (+ x 7) y 1 3)))))

    ;; --- A0: the test room -----------------------------------------------------------------------

    (define (draw-world w)
      (let* ((tm (world-tiles w))
             (s (tilemap-size tm)))
        (paint! 'sky-1)
        (draw-filled-rect 0 0 VIEW-W VIEW-H)
        (let loop ((row 0))
          (when (< row (tilemap-rows tm))
            (let cols ((col 0))
              (when (< col (tilemap-cols tm))
                (let ((kind (tilemap-ref tm col row)) (x (* col s)) (y (* row s)))
                  (cond ((eq? kind 'solid)
                         (paint! 'ground-2) (draw-filled-rect x y s s)
                         (unless (kind-solid? (tilemap-ref tm col (- row 1)))
                           (paint! 'ground-4) (draw-filled-rect x y s 1)))
                        ((eq? kind 'climbable)
                         (paint! 'leaf-1) (draw-filled-rect x y s s)
                         (paint! 'leaf-2)
                         (draw-filled-rect (+ x 3) (+ y 2) 2 1) (draw-filled-rect (+ x 10) (+ y 5) 2 1)
                         (draw-filled-rect (+ x 5) (+ y 9) 2 1) (draw-filled-rect (+ x 12) (+ y 12) 2 1))
                        ((eq? kind 'hazard) (paint! 'accent) (draw-filled-rect x y s s))
                        (else #f)))
                (cols (+ col 1))))
            (loop (+ row 1))))
        (let ((b (world-body w)))
          (draw-body-at b (body-x b) (body-y b) (world-ticks w)))
        (with-additive-blend
          (paint-water!)
          (let loop ((row 0))
            (when (< row (tilemap-rows tm))
              (let cols ((col 0))
                (when (< col (tilemap-cols tm))
                  (when (kind-water? (tilemap-ref tm col row))
                    (draw-filled-rect (* col s) (* row s) s s))
                  (cols (+ col 1))))
              (loop (+ row 1)))))))

    ;; --- play ----------------------------------------------------------------------------------

    ;; A3: harmonics just taken, flashing: ((n x y tick) ...) in map pixels.
    (define *flashes* '())
    (define FLASH-TICKS 60)
    ;; Falling ice shattering on the floor: ((x y tick) ...), x the centre
    ;; and y the floor, map pixels ((harkfell ice)'s (ice shatter x y)).
    (define *shatters* '())
    (define SHATTER-TICKS 20)
    (define (draw-news! news tick)
      (for-each (lambda (n)
                  (cond ((eq? (car n) 'pickup)
                         (set! *flashes* (cons (list (cadr n) (caddr n) (cadddr n) tick) *flashes*)))
                        ((and (eq? (car n) 'ice) (eq? (cadr n) 'shatter))
                         (set! *shatters* (cons (list (caddr n) (cadddr n) tick) *shatters*)))
                        (else #f)))
                news)
      (set! *flashes* (filter (lambda (f) (< (- tick (cadddr f)) FLASH-TICKS)) *flashes*))
      (set! *shatters* (filter (lambda (s) (< (- tick (caddr s)) SHATTER-TICKS)) *shatters*)))

    ;; A glasswood cell by name, its atlas index looked up once.
    (define *ice-cells* '())
    (define (ice-cell name)
      (let ((e (assoc name *ice-cells*)))
        (if e
            (cdr e)
            (let ((i (atlas-index (string-append "glasswood/" name))))
              (set! *ice-cells* (cons (cons name i) *ice-cells*))
              i))))

    ;; Falling ice (the look track's frames): hanging, then its rim lit and
    ;; shaking a pixel either way while it shivers (D10: the tell is seen as
    ;; well as heard), falling as it hung, and shards on the floor where it
    ;; landed, flying then fewer.
    ;; Seen: everything, except in a moth-lit room (moth-lit?): there only
    ;; inside the moth light round the body (moth-light-radius). x y: map px.
    (define (seen-fn w)
      (let* ((p (world-room w)) (rm (and p (placed-data p))))
        (if (not (and rm (moth-lit? rm)))
            (lambda (x y) #t)
            (let* ((cs (world-critters w))
                   (moths (filter (lambda (c) (eq? (critter-kind c) 'moth)) (if cs (critters-list cs) '())))
                   (b (world-body w))
                   (r (moth-light-radius moths b))
                   (c (body-center b HARKFELL-FEEL)))
              (lambda (x y)
                (let ((dx (- x (car c))) (dy (- y (cdr c))))
                  (<= (+ (* dx dx) (* dy dy)) (* r r))))))))

    ;; Thin ice (the room's thin-ice things): meltwater showing through, a
    ;; glazed crust on its top, and cracks under a body stood on it, one more
    ;; a third of BRITTLE-TICKS. In a dark room only where the moth light is.
    (define (draw-thin-ice! w ox oy seen?)
      (let* ((p (world-room w)) (rm (and p (placed-data p))))
        (when rm
          (let ((crust (ice-cell "tarn-crust"))
                (b (world-body w))
                (n (body-brittle (world-body w))))
            (for-each (lambda (cr)
                        (let* ((x (* TILE (car cr))) (y (* TILE (cdr cr))))
                          (when (seen? (+ ox x 8) (+ oy y 8))
                            (set-blend-mode 'normal)
                            (paint! 'water)
                            (draw-filled-rect x (+ y 4) TILE (- TILE 4))
                            (set-color 1.0 1.0 1.0 1.0)
                            (when crust (atlas-draw! crust x y 1))
                            ;; the cracks, under a body standing over this cell
                            (let ((bx (- (+ (body-x b) 4.0) ox)))
                              (when (and (> n 0) (<= x bx) (< bx (+ x TILE)))
                                (paint! 'ground-1)
                                (let ((k (+ 1 (quotient (* 3 n) BRITTLE-TICKS))))
                                  (when (>= k 1) (draw-filled-rect (+ x 3) (+ y 1) 6 1))
                                  (when (>= k 2) (draw-filled-rect (+ x 8) (+ y 2) 5 1) (draw-filled-rect (+ x 1) (+ y 3) 4 1))
                                  (when (>= k 3) (draw-filled-rect (+ x 11) (+ y 1) 4 1) (draw-filled-rect (+ x 5) (+ y 3) 1 2))))))))
                      (room-thin-ice rm))))))

    ;; The meltwater under thin ice keeps the water's glow in the dark, so where
    ;; the moth light has not reached it, it would show the ice from across the
    ;; room (contact sheet 5, Root Ice). After the water pass, the water cell
    ;; under each unseen thin-ice cell is painted as shadowed rock.
    (define (cover-thin-water! w ox oy)
      (let* ((p (world-room w)) (rm (and p (placed-data p))))
        (when (and rm (moth-lit? rm))
          (let ((seen? (seen-fn w)))
            (set-blend-mode 'normal)
            (paint! 'ground-1)
            (for-each (lambda (cr)
                        (let ((x (* TILE (car cr))) (y (* TILE (+ (cdr cr) 1))))
                          (unless (seen? (+ ox x 8) (+ oy (* TILE (cdr cr)) 8))
                            (draw-filled-rect x y TILE TILE))))
                      (room-thin-ice rm))))))

    ;; D43: the room's upward icicles, ((c . r) ...) in room cells.
    (define (room-upward rm)
      (filter-map* (lambda (t)
                     (and (pair? t) (eq? (car t) 'upward-icicle)
                          (let ((a (thing-at t))) (and a (cons (car a) (cdr a))))))
                   (room-things rm)))

    (define (filter-map* f l)
      (let loop ((l l) (acc '()))
        (if (null? l) (reverse acc) (let ((v (f (car l)))) (loop (cdr l) (if v (cons v acc) acc))))))

    ;; Its frame (the look track's glasswood/upward-icicle@h7, 6 x 14), standing
    ;; on the floor of its cell.
    (define (draw-upward! rm)
      (let ((i (ice-cell "upward-icicle@h7")))
        (when i
          (set-color 1.0 1.0 1.0 1.0)
          (for-each (lambda (cr) (atlas-draw! i (+ (* TILE (car cr)) 5) (- (* TILE (+ (cdr cr) 1)) 14) 1))
                    (room-upward rm)))))

    ;; Its faint violet light (B, in the additive pass; the room's hue is H7's
    ;; there, room-hue), breathing slowly.
    (define (draw-upward-light! rm t)
      (for-each (lambda (cr)
                  (light-disc! (+ (* TILE (car cr)) 8.0) (- (* TILE (+ (cdr cr) 1)) 7.0) 7.0
                               (/ (+ 0.9 (* 0.3 (sin (* t 0.02)))) DARK-GAIN)))
                (room-upward rm)))

    (define (draw-ice! w ox oy t)
      (let ((is (world-ice w))
            (seen? (seen-fn w)))
        (draw-thin-ice! w ox oy seen?)
        (set-color 1.0 1.0 1.0 1.0)
        (when is
          (for-each (lambda (ic)
                      (let* ((st (icicle-state ic))
                             (i (ice-cell (case st ((shiver) "icicle-shiver") ((fall) "icicle-fall") (else "icicle-hang")))))
                        ;; unseen in the dark, a hanging icicle still shows its tip: two
                        ;; pixels of lit ice that the glint (draw-icicle-glints!) lights
                        (when (and (memq st '(hang shiver))
                                   (not (seen? (+ (icicle-x ic) 3.0) (+ (icicle-y ic) 7.0))))
                          (set-blend-mode 'normal)
                          (paint! 'ground-4)
                          (draw-filled-rect (+ (floor-int (- (icicle-x ic) ox)) 2) (+ (floor-int (- (icicle-y ic) oy)) 12) 2 2)
                          (set-color 1.0 1.0 1.0 1.0))
                        (unless (or (eq? st 'gone) (not i)
                                    (not (seen? (+ (icicle-x ic) 3.0) (+ (icicle-y ic) 7.0))))
                          (atlas-draw! i
                                       (+ (floor-int (- (icicle-x ic) ox)) (if (eq? st 'shiver) (if (odd? (quotient t 2)) 1 -1) 0))
                                       (floor-int (- (icicle-y ic) oy))
                                       1))))
                    (ices-list is)))
        (for-each (lambda (s)
                    (let ((i (ice-cell (if (< (- t (caddr s)) 8) "shatter-a" "shatter-b"))))
                      (when i
                        (atlas-draw! i (- (floor-int (- (car s) ox)) 6) (- (floor-int (- (cadr s) oy)) 4) 1))))
                  *shatters*)))

    (define (in-room? x y) (and (< -16 x (+ VIEW-W 16)) (< -16 y (+ VIEW-H 16))))

    ;; The wind the reeds bend in: a slow swell, scaled by the bed's wind level
    ;; now (set-look-sound!), so a windy room's reeds bend harder. The bed's
    ;; own gusts would drive it if the sound exported one.
    (define (wind-at t)
      (* (min 1.3 (/ *bed-wind* 0.5))
         (+ 0.55 (* 0.3 (sin (* t 0.004))) (* 0.15 (sin (* t 0.0113))))))

    ;; The slot of the light's own colour in the room: the harmonic the
    ;; room's light belongs to (its pickup, its stone, the moths' draw).
    ;; A room with neither takes its moths' harmonic (Root Ice's moths glow
    ;; H3's green, not H2's amber).
    ;; Is a global cell in the room the body is in? (The world's stones and
    ;; pickups are the whole world's: room-hue must look only at the room's.
    ;; The 0.2 RC review found it taking the world's first, H3's green in every
    ;; room from a new game, H4's blue once H2 and H3 were carried.)
    (define (cell-in-room? w cell)
      (let* ((s (tilemap-size (world-tiles w)))
             (p (world-room w))
             (q (worldmap-room-at-px (world-map w) (+ (* s (car cell)) (/ s 2.0)) (+ (* s (cdr cell)) (/ s 2.0)))))
        (and p q (= (placed-x p) (placed-x q)) (= (placed-y p) (placed-y q)))))

    (define (room-hue w)
      (if (and (world-room w)
               (eq? (room-region (placed-data (world-room w))) 'pipes))
          ;; Environment light is cream. Harmonic atlas/glyph pixels keep
          ;; their own slots even at a bright core in the resolve shader.
          (slot-of 'sky-4)
          (room-harmonic-hue w)))

    (define (room-harmonic-hue w)
      (let* ((stones (filter (lambda (st) (cell-in-room? w (stone-cell st))) (world-stones w)))
             (pickups (filter (lambda (pk) (cell-in-room? w (pickup-cell pk))) (world-pickups w)))
             (cs (let ((c (world-critters w))) (if c (critters-list c) '())))
             (moth (find (lambda (c) (and (memq (critter-kind c) '(moth firefly)) (critter-drawn c))) cs)))
        (slot-of (harmonic-role
                  (cond ((pair? pickups) (pickup-overtone (car pickups)))
                        ((pair? stones) (stone-overtone (car stones)))
                        (moth (critter-drawn moth))
                        ;; D43: behind the fall, the upward icicle's violet
                        ((and (world-room w) (placed-data (world-room w)) (pair? (room-upward (placed-data (world-room w))))) 7)
                        (else 2))))))

    ;; A disc of light (B, additive: the caller's blend) of amount a, radius
    ;; r, one rect per row.
    (define (light-disc! cx cy r a)
      (when (> a 0.0)
        (paint-light! a)
        (let* ((x0 (floor-int cx)) (y0 (floor-int cy)) (ri (floor-int r)))
          (let loop ((dy (- ri)))
            (when (<= dy ri)
              (let ((hw (floor-int (sqrt (max 0.0 (- (* r r) (* dy dy)))))))
                (draw-filled-rect (- x0 hw) (+ y0 dy) (+ 1 (* 2 hw)) 1))
              (loop (+ dy 1)))))))

    ;; The moth light (D42; the bible, "The lantern moths and the moth
    ;; light"). Only in a room darker than daylight, where the resolve takes
    ;; light (B) first off the dark, DARK-GAIN steps a unit:
    ;;   - a moth that is not drawn to you lifts the dark in a small patch
    ;;     round itself, so a cloud of moths you do not carry for is a faint
    ;;     glow in the dark;
    ;;   - moths drawn to you (they orbit your body) spread into a lit circle
    ;;     round you, about three tiles across: three rings adding up to the
    ;;     whole dark at the middle, the outer two dithering back into it.
    ;;     It grows with the moths' glow, which rises as they come to you,
    ;;     so the circle opens as they gather.
    ;; The rings only cancel the dark, never more, so inside the circle the
    ;; room and the moths' own glows look as they do by day (a moth's glow
    ;; stacked on a brighter circle burned white).
    (define MOTH-RINGS (list 36.0 27.0 19.0))
    (define FIREFLY-RINGS (list 4.0 3.0 2.0))

    ;; Covered fen rooms use one clean DARK step. The shared distance pass
    ;; extends this four-pixel light footprint by 32 pixels, with a four-pixel
    ;; transition at the edge; its centre never exceeds the daylight budget.
    (define (firefly-light-budget rm arrival)
      (if (room-firefly-cave? rm)
          (* (dark-steps (room-light rm)) (max 0.0 (min 1.0 arrival)))
          0.0))

    (define (draw-firefly-light! fireflies b rm ox oy)
      (when (room-firefly-cave? rm)
        (let* ((centre (body-center b HARKFELL-FEEL))
               (arrival (moth-arrival fireflies (car centre) (cdr centre)))
               (amount (/ (firefly-light-budget rm arrival) (* 3.0 DARK-GAIN))))
          (for-each (lambda (radius)
                      (light-disc! (- (car centre) ox) (- (cdr centre) oy 4)
                                   (* radius (+ 0.5 (* 0.5 arrival))) amount))
                    FIREFLY-RINGS))))
    ;; The challenge-and-danger pass (David, 2026-09-27: "I was never fully in
    ;; the dark"): the circle is drawn from where the drawn moths ARE
    ;; ((harkfell creatures) moth-arrival: their nearness times their glow),
    ;; not from their glow alone, and a dark room starts a step darker than
    ;; its light: (black), the step lifting as the moths arrive (room-dark-
    ;; extra). The rings cancel the whole of it. Your own body keeps a faint
    ;; light of two steps while the extra one is there, so you see yourself in
    ;; the black (one step left it near black, contact sheet 5); it fades as
    ;; the extra does (the review: a whole step left a lit spot on the body
    ;; once the moths had come).
    (define (draw-moth-light! moths b rm ox oy t)
      (let* ((c (body-center b HARKFELL-FEEL))
             (arr (moth-arrival moths (car c) (cdr c)))
             (dark (+ (dark-steps (room-light rm)) (room-dark-extra rm arr))))
        (when (and (room-moth-cave? rm) (> dark 0.0))
          (let* ((unit (/ dark DARK-GAIN))
                 (drawn (filter (lambda (c) (eq? (critter-state c) 'drawn)) moths))
                 (cx (- (car c) ox)) (cy (- (cdr c) oy 4)))
            (light-disc! (- (car c) ox) (- (cdr c) oy) 8.0 (/ (* 2.0 (min 1.0 (room-dark-extra rm arr))) DARK-GAIN))
            (for-each (lambda (c)
                        (unless (eq? (critter-state c) 'drawn)
                          (light-disc! (- (critter-x c) ox) (- (critter-y c) oy) 9.0
                                       (* 0.7 unit (max 0.3 (critter-glow c))))))
                      moths)
            (when (and (pair? drawn) (> arr 0.0))
              (let* ((n (min 1.0 (/ (length drawn) 3.0)))
                     (a (* (/ unit 3.0) arr)))
                (for-each (lambda (r) (light-disc! cx cy (* r (+ 0.6 (* 0.4 n)) (+ 0.5 (* 0.5 arr))) a))
                          MOTH-RINGS)))))))

    ;; A room the moth light navigates: darker than daylight (room-dark?) and
    ;; with moths drawn to some harmonic. Only these start black and show their
    ;; hazards only in the light; a dark room with no moths (Behind the Fall, at
    ;; the blue hour) keeps the dark its light: gives (the review: it was two
    ;; steps down for good). The Hollow's dawn bowl shade is not a cave.
    (define (moth-lit? rm)
      (room-moth-cave? rm))

    ;; The light a room is drawn at. Open-air lighting belongs to the
    ;; lighting track (the Hollow's dawn shade, Reedfen's covered rooms), so
    ;; every room draws its authored light: level; only moth caves add black.
    (define (room-render-light rm) (room-light rm))

    ;; Glints at the tips of a moth-lit room's hanging icicles, whether or not the
    ;; moth light has reached them (David, playing b22a4d6: he ran into an icicle
    ;; he never saw; the moth light's radius is smaller than the tell's four
    ;; tiles, so in the dark you were always inside the tell before you could
    ;; see the ice). A slow twinkle of about two steps while it hangs; while it
    ;; shivers, a flash of the whole dark every four ticks. Light pass.
    (define (draw-icicle-glints! w rm ox oy t)
      (let ((is (world-ice w)))
        ;; and a shut ring-stone's glyph glows faintly, so the door you cannot
        ;; open yet reads in the black (the Cave Mouth, the dark before H3)
        (when (moth-lit? rm)
          (for-each (lambda (st)
                      (when (and (stone-visible? rm st) (eq? (stone-state st) 'shut))
                        (let* ((cell (stone-cell st)) (s (tilemap-size (world-tiles w)))
                               (x (+ (- (* s (car cell)) ox) 8.0)) (y (+ (- (* s (cdr cell)) oy) 8.0)))
                          (when (in-room? x y)
                            (light-disc! x y 6.0 (/ (+ 1.6 (* 0.4 (sin (* t 0.05)))) DARK-GAIN))))))
                    (world-stones w)))
        (when (and is (moth-lit? rm))
          (let* ((dark (+ (dark-steps (room-light rm)) DARK-EXTRA))
                 (unit (/ 1.0 DARK-GAIN)))
            (for-each (lambda (ic)
                        (let ((st (icicle-state ic))
                              (x (+ (- (icicle-x ic) ox) 3.0))
                              (y (+ (- (icicle-y ic) oy) 13.0)))
                          (case st
                            ((hang) (light-disc! x y 2.5 (* unit (+ 1.6 (* 0.5 (sin (+ (* t 0.07) x)))))))
                            ((shiver) (light-disc! x y 3.5 (* unit (if (odd? (quotient t 4)) dark 1.0))))
                            (else #f))))
                      (ices-list is))))))

    ;; The extra dark of a moth-lit room before its moths arrive: one step
    ;; (black) with none of them near, lifting as they come; 0 anywhere else.
    ;; arr: moth-arrival.
    (define DARK-EXTRA 1.0)
    (define (room-dark-extra rm arr)
      (if (moth-lit? rm)
          (* DARK-EXTRA (- 1.0 (min 1.0 arr)))
          0.0))

    ;; The radius (px) the moth light shows things in, round the body: the
    ;; outer ring's, as the moths have come. Falling ice and thin ice in a dark
    ;; room are drawn only inside it (David: "you see hazards only as far as
    ;; your light reaches"). 0 with no moths near.
    (define (moth-light-radius moths b)
      (let* ((c (body-center b HARKFELL-FEEL))
             (arr (moth-arrival moths (car c) (cdr c)))
             (n (min 1.0 (/ (length (filter (lambda (c) (eq? (critter-state c) 'drawn)) moths)) 3.0))))
        (if (> arr 0.0) (* (car MOTH-RINGS) (+ 0.6 (* 0.4 n)) (+ 0.5 (* 0.5 arr))) 0.0)))

    ;; Play into the current (index) pass: the room, its things, the body.
    (define (draw-play w)
      (let* ((p (world-room w))
             (rm (and p (placed-data p))))
        (if (not rm)
            (draw-world w)
            (let* ((o (world-origin w))
                   (ox (car o)) (oy (cdr o))
                   (b (world-body w))
                   (t (world-ticks w))
                   (tm (world-tiles w))
                   (cs (let ((c (world-critters w))) (if c (critters-list c) '())))
                   (kind? (lambda (k) (lambda (c) (eq? (critter-kind c) k))))
                   (eyes? (lambda (c) (eq? (critter-frame c) 'eyes))))
              (draw-backdrop! rm)
              (draw-aurora! rm (and (world-aurora-at w)
                                   (- t (world-aurora-at w))))
              (set-blend-mode 'normal)
              (draw-clouds! rm t)
              (when (cloudstair? rm) (draw-cloudstair-sky! rm t))
              (sway-composite! *foliage-rt* t
                               (cond ((eq? (room-region rm) 'pipes) 0.0)
                                     ;; the grass leans with the gust's warning and blows with it
                                     ((cloudstair? rm) (cloudstair-wind (world-tau w) (wind-at t)))
                                     (else (wind-at t))))
              (for-each (lambda (st)
                          (let* ((cell (stone-cell st)) (s (tilemap-size tm))
                                 (x (- (* s (car cell)) ox)) (y (- (* s (cdr cell)) oy)))
                            (when (and (stone-visible? rm st) (in-room? x y))
                              (if (eq? (room-region rm) 'pipes)
                                  (draw-stone st x y t (world-carry w) (stone-slot rm) "pipes" #t)
                                  ;; the bowl's rose stone keeps its glyph after its reveal
                                  (if (and (bowl? rm) (= (stone-overtone st) 5))
                                      (draw-stone st x y t (world-carry w) (stone-slot rm) #f #t)
                                      (draw-stone st x y t (world-carry w) (stone-slot rm)))))))
                        (world-stones w))
              (set-color 1.0 1.0 1.0 1.0)
              (draw-render-target *solid-rt* 0.0 0.0 (inexact VIEW-W) (inexact VIEW-H))
              (draw-reedfen-water-haze! rm t)
              (draw-pipes-panels! rm)
              ;; Cloudstair's lifts, gusts and seeds, on the shared air clock;
              ;; elsewhere a lift column's seeds (the Hollow's launch lift)
              (if (cloudstair? rm)
                  (let ((c (body-center b HARKFELL-FEEL)))
                    (draw-cloudstair-air! rm t (world-tau w)
                                         (lambda (x y) (not (kind-solid? (tile-at tm (+ x ox) (+ y oy))))))
                    (draw-cloudstair-seeds! rm t (world-tau w) (- (car c) ox) (- (cdr c) oy) (world-carry w)))
                  (draw-lift-seeds! rm t (world-tau w)))
              ;; the authored down gift, until it is yours
              (unless (world-down w)
                (for-each (lambda (d)
                            (let ((at (thing-at d)))
                              (when at
                                (draw-down-gift! rm t (+ (* S (car at)) 8) (+ (* S (cdr at)) 8)))))
                          (room-things-of rm 'down)))
              ;; falling ice ((harkfell ice)), in front of the rock it hangs from
              (draw-ice! w ox oy t)
              ;; D43: the upward icicle, where the room has one
              (draw-upward! rm)
              (draw-upward-drips! rm t)
              ;; a reedling perched on a reed tip rides the tip's sway
              (for-each (lambda (c)
                          (unless (eyes? c)
                            (let ((d (if (and (eq? (critter-kind c) 'reedling)
                                              (memq (critter-frame c) (list 'perch 'peck 'sing)))
                                         (sway-offset (floor-int (- (critter-x c) ox)) t (wind-at t) 1.0)
                                         0)))
                              (draw-critter c (- ox d) oy t slot))))
                        (filter (lambda (c) (not (memq (critter-kind c) '(moth firefly)))) cs))
              (draw-body-at b (- (body-x b) ox) (- (body-y b) oy) t)
              (when (body-down b)
                (draw-down-tuft! b (- (body-x b) ox) (- (body-y b) oy) t))
              (draw-water! rm)
              (cover-thin-water! w ox oy)
              (draw-crusts!)
              (draw-snow! rm t)
              (for-each (lambda (c) (draw-critter c ox oy t slot)) (filter eyes? cs))
              (draw-pipes-cues! rm t)
              ;; front decoration, in front of the creature, swaying
              (set-blend-mode (quote normal))
              (sway-composite! *front-rt* t (wind-at t))
              (for-each (lambda (pk)
                          (let* ((c (cell-centre tm (pickup-cell pk))) (x (- (car c) ox)) (y (- (cdr c) oy)))
                            (when (in-room? x y) (draw-pickup (pickup-overtone pk) x y t slot))))
                        (world-pickups w))
              (let ((moths (filter (lambda (c) (memq (critter-kind c) '(moth firefly))) cs)))
                (for-each (lambda (c) (draw-critter c ox oy t slot)) moths)
                ;; light last: B, added
                (with-additive-blend
                  (for-each (lambda (st)
                              (let* ((cell (stone-cell st)) (s (tilemap-size tm))
                                     (x (- (* s (car cell)) ox)) (y (- (* s (cdr cell)) oy)))
                                (when (and (stone-visible? rm st) (in-room? x y))
                                  (draw-stone-light st x y t slot))))
                            (world-stones w))
                  (for-each (lambda (pk)
                              (let* ((c (cell-centre tm (pickup-cell pk))) (x (- (car c) ox)) (y (- (cdr c) oy)))
                                (when (in-room? x y) (draw-pickup-light (pickup-overtone pk) x y t))))
                            (world-pickups w))
                  (let ((cave-moths (filter (kind? 'moth) moths)))
                    (for-each (lambda (c) (draw-critter-glow c ox oy t slot)) cave-moths)
                    (draw-moth-light! cave-moths b rm ox oy t))
                  (draw-firefly-light! (filter (kind? 'firefly) moths) b rm ox oy)
                  ;; D50: the homeward shaft's light, and the arch's once it answers H5
                  (when (cloudstair? rm)
                    (draw-homeward-light! rm t)
                    (draw-arch-light! rm t (lambda (x y) (not (kind-solid? (tile-at tm (+ x ox) (+ y oy)))))))
                  ;; the waiting down glows a little where the room is darker
                  ;; than daylight (in daylight it shows as it is)
                  (unless (or (world-down w) (>= (room-render-light rm) 1.0))
                    (for-each (lambda (d)
                                (let ((at (thing-at d)))
                                  (when at
                                    (light-disc! (+ (* S (car at)) 8) (+ (* S (cdr at)) 6)
                                                 (+ 7.0 (sin (* t 0.05))) 0.3))))
                              (room-things-of rm 'down)))
                  (draw-icicle-glints! w rm ox oy t)
                  (draw-upward-light! rm t)
                  (draw-pipes-lights! rm t)
                  (draw-glints! t)
                  (draw-shafts! rm t)
                  (for-each (lambda (f) (draw-flash-light (- (cadr f) ox) (- (caddr f) oy) (- t (cadddr f))))
                            *flashes*)))
              (draw-glint-cores! t)
              (for-each (lambda (f) (draw-flash (car f) (- (cadr f) ox) (- (caddr f) oy) (- t (cadddr f)) slot))
                        *flashes*)))))

    ;; The whole frame of play, as far as the colour target: bake what the
    ;; room needs, draw it as slots (after: a thunk drawn last in the same
    ;; pass, the ears), resolve it; black: optionally a further fade to black
    ;; (the frame's dawn), by the same dither as the world's dim. Outside any
    ;; pass.
    (define (present-play! w after . black)
      (ensure-render!)
      (atlas-ensure!)
      (step-focus!)
      (let* ((p (world-room w))
             (rm (and p (placed-data p)))
             (region (if rm (room-region rm) 'none)))
        (when rm (prepare-layers! rm (world-tiles w)))
        ;; a passing cloud's shadow on Cloudstair's stone, none anywhere else
        (apply set-cloud-shade! (if (and rm (cloudstair? rm)) (cloudstair-shade rm (world-ticks w)) (list 0.0 0.0 0.0)))
        (use-region! region)
        (with-render-target (room-index-rt)
          (set-blend-mode 'normal)
          (draw-play w)
          (set-blend-mode 'normal)
          (after)
          (draw-strips! *strips*))
        (resolve! (world-ticks w)
                  (max (world-dim w) (if (pair? black) (car black) 0.0))
                  (if rm (room-hue w) (slot-of 'h2))
                  (if rm (room-render-light rm) 1.0)
                  (if rm
                      (let ((c (body-center (world-body w) HARKFELL-FEEL))
                            (cs (world-critters w)))
                        (room-dark-extra rm (moth-arrival (if cs (critters-list cs) '()) (car c) (cdr c))))
                      0.0)
                  (and rm (room-daylight-pools? rm)))))

    ;; --- the overviews: the region sheet and the atlas ----------------------------------

    ;; rooms: room records. k: the scale (1 for the sheet, 1/4 for the atlas).
    ;; gap: pixels between rooms. -> (w h x0 y0), x0 y0 the least room coordinate.
    (define (overview-size rooms k gap)
      (if (null? rooms)
          (list VIEW-W VIEW-H 0 0)
          (let* ((xs (map room-x rooms)) (ys (map room-y rooms))
                 (x0 (apply min xs)) (y0 (apply min ys))
                 (nx (+ 1 (- (apply max xs) x0))) (ny (+ 1 (- (apply max ys) y0))))
            (list (+ gap (* nx (+ gap (floor-int (* k VIEW-W)))))
                  (+ gap (* ny (+ gap (floor-int (* k VIEW-H)))))
                  x0 y0))))

    ;; The room drawn at overview pixel (px, py), or #f.
    (define (overview-room-at rooms k gap px py)
      (let* ((sz (overview-size rooms k gap))
             (cw (+ gap (floor-int (* k VIEW-W))))
             (ch (+ gap (floor-int (* k VIEW-H))))
             (rx (+ (caddr sz) (floor-int (/ (- px gap) cw))))
             (ry (+ (cadddr sz) (floor-int (/ (- py gap) ch)))))
        (let find ((rs rooms))
          (cond ((null? rs) #f)
                ((and (= (room-x (car rs)) rx) (= (room-y (car rs)) ry)) (car rs))
                (else (find (cdr rs)))))))

    ;; Cache rooms in pages of up to eight full-size images. Individual
    ;; room targets would also exhaust sokol's sampler pool at 82 rooms.
    ;; Each page is composed in one pass, then kept until content changes.
    (define *room-colors* '())     ; ((room . (page-texture . index)) ...)
    (define *overview-pages* '())  ; render targets owning those textures
    (define OVERVIEW-BATCH 8)

    (define (drop-overview!)
      (for-each render-target-free! *overview-pages*)
      (set! *overview-pages* '())
      (set! *room-colors* '()))

    ;; A room as it stands in the overview: backdrop, foliage (still),
    ;; stones shut, solids, water.
    (define (draw-room-still rm)
      (draw-backdrop! rm)
      (set-blend-mode 'normal)
      (draw-clouds! rm 0)
      (when (cloudstair? rm) (draw-cloudstair-sky! rm 0))
      (sway-composite! *foliage-rt* 0 0.0)
      (set-color 1.0 1.0 1.0 1.0)
      (draw-render-target *solid-rt* 0.0 0.0 (inexact VIEW-W) (inexact VIEW-H))
      (draw-reedfen-water-haze! rm 0)
      (when (cloudstair? rm)
        (draw-cloudstair-air! rm 0 0)
        (draw-cloudstair-seeds! rm 0 0 -1000.0 -1000.0))
      (draw-pipes-panels! rm)
      (draw-pipes-cues! rm 0)
      (draw-upward-drips! rm 0)
      (with-additive-blend
        (draw-pipes-lights! rm 0))
      (draw-water! rm))

    ;; Outside any pass: resolve one bounded batch per frame. Every
    ;; render pass appends to sokol_gp's same per-frame vertex buffer; all
    ;; 82 rooms in one frame overflow it even though each pass is small.
    ;; Call once each frame until this returns #t (all rooms are cached).
    (define (prepare-overview! rooms)
      (ensure-render!)
      (let ((batch
              (let next ((pending rooms) (n 0) (acc '()))
                (cond
                  ((or (null? pending) (= n OVERVIEW-BATCH)) (reverse acc))
                  ((assq (car pending) *room-colors*) (next (cdr pending) n acc))
                  (else (next (cdr pending) (+ n 1) (cons (car pending) acc)))))))
        (unless (null? batch)
          (let* ((targets (map bake-overview-room! batch))
                 (page (make-render-target (* VIEW-W (length batch)) VIEW-H 'nearest)))
            (with-render-target page
              (with-blend-mode 'none
                (set-color 1.0 1.0 1.0 1.0)
                (let copy ((ts targets) (i 0))
                  (unless (null? ts)
                    (draw-render-target (car ts) (inexact (* i VIEW-W)) 0.0
                                        (inexact VIEW-W) (inexact VIEW-H))
                    (copy (cdr ts) (+ i 1))))))
            ;; The page pass has consumed the temporary room targets.
            (for-each render-target-free! targets)
            (set! *overview-pages* (cons page *overview-pages*))
            (let ((texture (render-target->texture page)))
              (let cache ((rs batch) (i 0))
                (unless (null? rs)
                  (set! *room-colors*
                        (cons (cons (car rs) (cons texture i)) *room-colors*))
                  (cache (cdr rs) (+ i 1)))))))
        (every (lambda (rm) (assq rm *room-colors*)) rooms)))

    (define (bake-overview-room! rm)
      (prepare-layers! rm)
      (use-region! (room-region rm))
      (with-render-target (room-index-rt)
        (set-blend-mode 'normal)
        (draw-room-still rm)
        (draw-strips! *strips*))
      (resolve! 0 0.0 (slot-of (if (eq? (room-region rm) 'pipes) 'sky-4 'h2))
                (room-render-light rm) 0.0 (room-daylight-pools? rm))
      (let ((rt (make-render-target VIEW-W VIEW-H 'nearest)))
        (with-render-target rt
          (with-blend-mode 'none
            (set-color 1.0 1.0 1.0 1.0)
            (draw-render-target (room-color-rt) 0.0 0.0 (inexact VIEW-W) (inexact VIEW-H))))
        rt))

    ;; A music note (section 8's atlas mark for a room with a fixed moment),
    ;; 5x7 with its top-left at (x, y).
    (define (draw-note-mark x y)
      (set-color 0.0 0.0 0.0 0.6)
      (draw-filled-rect (- x 1) (- y 1) 7 9)
      (set-color 0.95 0.9 0.6)
      (draw-filled-rect (+ x 2) y 1 5)
      (draw-filled-rect (+ x 3) y 2 1)
      (draw-filled-rect (+ x 4) (+ y 1) 1 1)
      (draw-filled-rect x (+ y 5) 3 2))

    ;; Every room at its place (prepare-overview! first), scale k, gap px
    ;; apart on a dark ground; with labels?, each labelled with its
    ;; coordinate, and a note mark on a room with a fixed moment. In colours:
    ;; the overview's pass is not a palette pass.
    (define (draw-overview rooms k gap labels?)
      (let* ((sz (overview-size rooms k gap))
             (x0 (caddr sz)) (y0 (cadddr sz))
             (cw (+ gap (floor-int (* k VIEW-W))))
             (ch (+ gap (floor-int (* k VIEW-H)))))
        (set-color 0.07 0.07 0.08)
        (draw-filled-rect 0 0 (car sz) (cadr sz))
        (for-each
          (lambda (rm)
            (let ((ox (+ gap (* cw (- (room-x rm) x0))))
                  (oy (+ gap (* ch (- (room-y rm) y0))))
                  (e (assq rm *room-colors*)))
              (when e
                (with-blend-mode 'none
                  (set-color 1.0 1.0 1.0 1.0)
                  (draw-texture-region (cadr e) (inexact ox) (inexact oy)
                                       (* k VIEW-W) (* k VIEW-H)
                                       (* (cddr e) VIEW-W) VIEW-H VIEW-W (- VIEW-H))))
              (when labels?
                (let ((label (string-append "x" (number->string (room-x rm)) "y" (number->string (room-y rm)))))
                  (set-color 0.0 0.0 0.0 0.6)
                  (draw-filled-rect (+ ox 1) (+ oy 1) (+ 2 (text-width-mini label 1)) 7)
                  (set-color 0.95 0.95 0.9)
                  (draw-text-mini label (+ ox 2) (+ oy 2) 1)
                  (when (room-moment rm)
                    (draw-note-mark (- (+ ox (floor-int (* k VIEW-W))) 8) (+ oy 2)))))))
          rooms)))

    ;; Lines of text at the top right of the rectangle x y w, cells of
    ;; SCALE px, over a dark band (the ?ms readout, in window pixels).
    (define C-TEXT '(0.95 0.95 0.90))
    (define C-TEXT-BG '(0.0 0.0 0.0 0.55))
    (define (draw-readout lines x y w scale)
      (let* ((line-h (* scale 7))
             (widest (let loop ((ls lines) (m 0))
                       (if (null? ls) m (loop (cdr ls) (max m (text-width-mini (car ls) scale))))))
             (left (- (+ x w) widest (* 3 scale))))
        (apply set-color C-TEXT-BG)
        (draw-filled-rect (- left scale) y (+ widest (* 3 scale)) (+ (* line-h (length lines)) scale))
        (apply set-color C-TEXT)
        (let loop ((ls lines) (ty (+ y scale)))
          (unless (null? ls)
            (draw-text-mini (car ls) left ty scale)
            (loop (cdr ls) (+ ty line-h))))))))
