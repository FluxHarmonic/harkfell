;;; (harkfell audio) - What both shells call for the sound, once a frame, and
;;; the adapter from the world to the sound director's PLACE.
;;;
;;;   (audio-boot! say)          open the mixer (suspended on the web until a gesture)
;;;   (audio-world! content)     the world loaded: the director learns its moments
;;;   (audio-gesture!)           a user gesture: resume the context (the web's autoplay policy)
;;;   (audio-bench!)             ?bench / --bench: the phone measurement ((harkfell bench));
;;;                              the director is silent while it runs
;;;   (audio-carry! "2,3")       ?carry= / --carry: the harmonics carried (A3's pickups do this in play)
;;;   (audio-tone-room! "X,Y")   ?tone= / --tone: where H2's finding tone is
;;;   (audio-frame! frame-ms work-ms)   every frame, after the world's ticks
;;;   (audio-lines)              the readout's sound lines

(define-library (harkfell audio)
  (import (sigil core)
          (sigil time)
          (sigil math)
          (sigil list)
          (sigil string)
          (engine mixer)
          (engine body)
          (engine worldmap)
          (engine tilemap)
          (harkfell world)
          (harkfell content)
          (harkfell shell)
          (harkfell tunes)
          (harkfell sound)
          (harkfell gates)
          (harkfell hush)
          (harkfell bench))

  (export audio-boot! audio-world! audio-gesture! audio-bench! audio-frame! audio-now
          audio-pause! audio-resume! audio-paused? audio-set-wall-clock! audio-cue-words
          audio-carry! audio-tone-room! audio-lines world-place room-moment-name
          audio-sound-door! frame-event! save-extras restore-extras!)

  (begin
    (define *say* (lambda parts #f))
    (define *last* #f)

    ;; The wall clock the sound runs on; a test drives it by hand
    ;; (audio-set-wall-clock! f; #f is the real clock again). A new clock starts
    ;; the sound's clock afresh, unpaused: a test's hand clock and its pauses
    ;; must not reach the next test file (the suite is one process).
    (define (real-clock) (/ (current-jiffy) (* 1.0 (jiffies-per-second))))
    (define *wall-clock* real-clock)
    (define (wall-now) (*wall-clock*))
    (define (audio-set-wall-clock! f)
      (set! *wall-clock* (or f real-clock))
      (set! *paused-at* #f)
      (set! *paused-total* 0.0))

    ;; D40: the game pauses when it loses focus, and the sound with it. The
    ;; sound's clock (audio-now) leaves out the time paused, from the end of
    ;; the hold's fade to the resume, so every ramp, the hush, the moments'
    ;; timers and the mixer's events wait; the mixer stops pulling, so the bed
    ;; and a moment mid-play resume exactly where they were; cue voices are
    ;; dropped. The page suspends its AudioContext on the "audio hold" line
    ;; (after the fade has played) and resumes it on "audio release".
    ;;   (audio-pause!)    fade out over HOLD-FADE-S, then hold
    ;;   (audio-resume!)   pull again, fade in over RELEASE-FADE-S
    ;; Both are safe to call twice.
    (define *paused-at* #f)       ; the wall clock at the pause, or #f
    (define *paused-total* 0.0)   ; seconds left out of the sound's clock
    (define (held-for w) (if *paused-at* (max 0.0 (- w *paused-at* HOLD-FADE-S)) 0.0))
    (define (audio-now) (let ((w (wall-now))) (- w *paused-total* (held-for w))))
    (define (audio-paused?) (and *paused-at* #t))

    (define (audio-pause!)
      (unless *paused-at*
        (mixer-hold! (audio-now))
        (set! *paused-at* (wall-now))
        (*say* "audio" "hold")))

    (define (audio-resume!)
      (when *paused-at*
        (let ((w (wall-now)))
          (set! *paused-total* (+ *paused-total* (held-for w)))
          (set! *paused-at* #f)
          (mixer-release! (audio-now))
          (*say* "audio" "release"))))

    (define (audio-boot! say)
      (set! *say* say)
      (mixer-open!)
      ;; the sound's deferred work runs after the pump (audio-frame!), not in the frame
      (sound-set-work-in-frame! #f)
      (shell-set-extra-lines! audio-lines)
      ;; A4: a save keeps the moments heard and the time played, and a
      ;; continue gives them back ((harkfell save))
      (shell-set-save-extras! save-extras restore-extras!)
      ;; A4: the frame's phases: the card's tune, the hold, the dawn (frame-event!)
      (shell-add-frame-listener! frame-event!)
      ;; D35: the wordmark's reveal is timed by the playing moment as heard
      (shell-set-moment-clock! (lambda () (let ((m (sound-moment-playing)))
                                            (and m (let ((t (sound-moment-time))) (and t (cons m t)))))))
      (*say* "audio" (number->string (mixer-rate)) (symbol->string (mixer-state))))

    (define (audio-gesture!) (mixer-resume!))

    (define (audio-bench!) (sound-reset!) (bench-start! *say*))

    ;; "2,3" -> (2 3)
    (define (numbers s) (filter number? (map string->number (string-split s ","))))

    ;; ?carry=: the body carries these (the world's, A3; and the sound's,
    ;; for A0's room, which has no world of gates)
    (define (audio-carry! s) (shell-set-carry! (numbers s)) (sound-set-carry! (numbers s)))

    ;; ?sound=a,b / --sound a,b (A4): the sound's listening doors.
    ;;   border:cross | border:through   the region-border mode (default cross: measured on David's phone)
    ;;   bench:a4       the slice's phone measurement ((harkfell bench), A4's phases)
    ;;   moment:NAME    the moment NAME plays over the bed MOMENT-DOOR-S after the
    ;;                  bed has opened and the tune's text is in, whatever the hush
    ;;                  says (to hear a moment whose room is not written yet)
    ;; The opening needs no door: the frame plays it on every launch (below).
    (define MOMENT-DOOR-S 4.0)
    (define *moment-door* #f)      ; #f | (name) | (name . t)
    (define (audio-sound-door! s)
      (for-each (lambda (item)
                  (cond ((string=? item "border:cross") (sound-set-border-mode! 'cross))
                        ((string=? item "border:through") (sound-set-border-mode! 'through))
                        ((string=? item "bench:a4") (bench-set-phases! 'a4))
                        ;; 0.1.1: the web's cues through the old ring, to hear and measure it
                        ((string=? item "cues:ring") (mixer-set-cue-path! 'ring))
                        ((and (> (string-length item) 7) (string=? (substring item 0 7) "moment:"))
                         (let ((name (substring item 7 (string-length item))))
                           ;; ask for the text now: on the web the page fetches it
                           (tune-text name)
                           (set! *moment-door* (list name))))
                        (else (*say* "audio" "unknown-door" item))))
                (string-split s ",")))

    ;; The web probe (2026-09-24): the door auditioned before the page had
    ;; fetched the tune, so no player opened and nothing played. It waits for
    ;; the text as well as the bed.
    (define (moment-door-frame! now)
      (let ((d *moment-door*))
        (cond ((not d) #f)
              ((and (null? (cdr d)) (sound-region) (tune-text (car d))) (set! *moment-door* (cons (car d) now)))
              ((and (number? (cdr d)) (>= now (+ (cdr d) MOMENT-DOOR-S)))
               (sound-audition! (car d))
               (set! *moment-door* #f))
              (else #f))))

    ;; --- the frame (content's (harkfell frame)): D32, D33, D15 ------------------------
    ;; card   the card's tune starts (the fundamental and its overtones), and
    ;;        the world is held: no bed yet
    ;; hold   black: the card is over or skipped; the tune goes on to its world
    ;;        section (a skip lands there at the next bar), the fundamental held
    ;;        as the wind rises
    ;; dawn   the Hollow fades in: the world is released, the bed opens, and the
    ;;        opening hands over to it over OPENING-HANDOFF-S (3 s, the dawn's length)
    ;; A door into a room skips the frame, so none of this happens there.
    ;; Not while the bench measures: the opening would play into its figures.
    (define (frame-event! ev)
      (case (if (or (bench-running?) (bench-done?)) #f ev)
        ((card) (sound-hold! #t) (sound-opening-start!))
        ((hold) (sound-opening-skip!))
        ((dawn play) (sound-hold! #f))
        (else #f)))

    ;; What a save keeps of the sound: the fixed moments' rooms heard and the
    ;; wandering moments heard, in the save's one list of strings (a wandering
    ;; one as "wander:NAME"), and the time played.
    (define WANDER-PREFIX "wander:")
    (define (save-extras)
      (let ((h (sound-hush)))
        (list (append (hush-spent h) (map (lambda (n) (string-append WANDER-PREFIX n)) (hush-wander-spent h)))
              (hush-played h))))
    (define (wander-key? k) (and (string? k) (>= (string-length k) 7) (string=? (substring k 0 7) WANDER-PREFIX)))
    (define (restore-extras! moments played)
      (sound-restore-hush! (filter (lambda (k) (not (wander-key? k))) moments)
                           played
                           (map (lambda (k) (substring k 7 (string-length k))) (filter wander-key? moments))))

    ;; ?tone= (A2's placeholder door): the finding tones are placed from the
    ;; world's pickups now; this moves A2's placeholder only, which sounds
    ;; only where the world has no gates.
    (define (audio-tone-room! s)
      (let ((n (numbers s)))
        (when (= (length n) 2) (sound-set-tone-room! (car n) (cadr n)))))

    ;; --- the adapter -------------------------------------------------------------------
    (define (kw-ref l name)
      (let find ((l l))
        (cond ((or (not (pair? l)) (null? (cdr l))) #f)
              ((and (keyword? (car l)) (string=? (keyword->string (car l)) name)) (cadr l))
              (else (find (cdr l))))))

    ;; A room's fixed moment as a tune name (a string), or #f.
    (define (room-moment-name rm)
      (let* ((m (room-moment rm))
             (t (and (list? m) (kw-ref m "tune"))))
        (and (symbol? t) (symbol->string t))))

    ;; A4: the moment's conditions, moment: (tune: T when: first-visit
    ;; carrying: 2 still: 6); each a number, or #f.
    (define (room-moment-number rm key)
      (let* ((m (room-moment rm))
             (v (and (list? m) (kw-ref m key))))
        (and (number? v) (> v 0) v)))

    ;; A region's wandering moments (its wander: list) as tune names.
    (define (region-wander reg)
      (let ((w (and reg (region-field reg 'wander))))
        (if (list? w)
            (filter-map (lambda (x) (cond ((symbol? x) (symbol->string x)) ((string? x) x) (else #f))) w)
            '())))

    (define (region-of ct sym)
      (find (lambda (r) (eq? (region-name r) sym)) (content-regions ct)))

    ;; bed: (wind 0.4 water 0.8) -> ((wind . 0.4) (water . 0.8))
    (define (plist->alist l)
      (if (and (pair? l) (pair? (cdr l)))
          (cons (cons (car l) (cadr l)) (plist->alist (cddr l)))
          '()))

    (define TILE 16)

    ;; The place the director needs, from the running world; #f outside the
    ;; written world (A0's test room, the atlas, the sheet).
    ;; A3: the world's pickups, stones and news in absolute world pixels
    ;; (shift: the map's own pixel origin, as for px py below).
    (define (abs-news news sx sy)
      (map (lambda (n)
             (let ((k (length n)))
               ;; every item ends with x y
               (append (list-head* n (- k 2))
                       (list (+ sx (list-ref n (- k 2))) (+ sy (list-ref n (- k 1)))))))
           news))

    (define (list-head* l n) (if (or (= n 0) (null? l)) '() (cons (car l) (list-head* (cdr l) (- n 1)))))

    (define (world-place w ct . news)
      (let* ((wm (and w (world-map w)))
             (sx (if wm (* (worldmap-cols wm) (worldmap-size wm) (worldmap-x0 wm)) 0))
             (sy (if wm (* (worldmap-rows wm) (worldmap-size wm) (worldmap-y0 wm)) 0))
             (pl (world-place-a2 w ct)))
        (and pl
             (if (world-gates w)
                 (let ((tm (world-tiles w)))
                   (place pl
                          carry: (world-carry w)
                          tones: (map (lambda (p) (let ((c (cell-centre tm (pickup-cell p))))
                                                    (list (pickup-overtone p) (+ sx (car c)) (+ sy (cdr c)))))
                                      (world-pickups w))
                          stones: (map (lambda (st) (let ((c (cell-centre tm (stone-cell st))))
                                                      (list (stone-overtone st) (stone-state st) (+ sx (car c)) (+ sy (cdr c)))))
                                       (world-stones w))
                          news: (abs-news (if (pair? news) (car news) '()) sx sy)))
                 pl))))

    (define (world-place-a2 w ct)
      (let* ((p (and w (world-room w)))
             (rm (and p (placed-data p))))
        ;; A4: before the world (the start screen and the card) there is no
        ;; place: the bed begins at the frame's hold, as the wind rises
        (and rm ct (memq (shell-frame-phase) (list 'hold 'dawn 'play))
             (let* ((reg (region-of ct (room-region rm)))
                    (b (world-body w))
                    (wm (world-map w))
                    (bed (region-field reg 'bed))
                    (frogs (filter-map (lambda (t)
                                         (and (pair? t) (eq? (car t) 'bellfrog)
                                              (let ((at (kw-ref (cdr t) "at")))
                                                (and (pair? at) (+ (* TILE (car at)) (/ TILE 2.0))))))
                                       (let ((ts (room-things rm))) (if (list? ts) ts '())))))
               (place key: (room-label rm)
                           region: (room-region rm)
                           bed-tune: (cond ((string? bed) bed) ((symbol? bed) (symbol->string bed)) (else #f))
                           groups: (or (region-field reg 'bed-channels) '())
                           levels: (plist->alist (room-bed rm))
                           moment: (room-moment-name rm)
                           moment-carrying: (room-moment-number rm "carrying")
                           moment-still: (room-moment-number rm "still")
                           wander: (region-wander reg)
                           frogs: frogs
                           ;; ABSOLUTE world pixels: the map's pixels start at its
                           ;; westmost and northmost room (x0 y0), not at room (0 0)
                           px: (+ (body-x b) 4.0 (* (worldmap-cols wm) (worldmap-size wm) (worldmap-x0 wm)))
                           py: (+ (body-y b) 6.0 (* (worldmap-rows wm) (worldmap-size wm) (worldmap-y0 wm)))
                           rx: (room-x rm) ry: (room-y rm)
                           still: (and (eq? (world-phase w) 'play)
                                       (memq (body-mode b) '(ground))
                                       (< (abs (body-vx b)) 0.01)
                                       (< (abs (body-vy b)) 0.01))
                           returns: (world-returns w)
                           ;; A4: the movement sounds read the body and the tile under its feet
                           mode: (body-mode b)
                           vx: (body-vx b)
                           bx: (body-x b)
                           foot: (foot-kind (world-tiles w) b))))))

    ;; The tile kind just under the body's feet (its box: 8 by 14 px,
    ;; HARKFELL-FEEL), or #f off the map.
    (define (foot-kind tm b)
      (let ((col (exact (floor (/ (+ (body-x b) 4.0) TILE))))
            (row (exact (floor (/ (+ (body-y b) 14.5) TILE)))))
        (and (>= col 0) (>= row 0) (< col (tilemap-cols tm)) (< row (tilemap-rows tm))
             (tilemap-ref tm col row))))

    (define (filter-map f l)
      (let loop ((l l) (acc '()))
        (if (null? l) (reverse acc)
            (let ((v (f (car l)))) (loop (cdr l) (if v (cons v acc) acc))))))

    ;; The fixed moments the rooms name and every region's wandering ones,
    ;; opened ahead.
    (define (audio-world! ct)
      (when ct
        (let ((ms (filter-map (lambda (p) (room-moment-name (placed-data p))) (content-rooms ct)))
              (ws (apply append (map region-wander (content-regions ct)))))
          (sound-boot! (append ms ws) *say*))))

    ;; The frame's deferred sound work (the cue bank, the moments opened ahead)
    ;; runs AFTER the pump, so the sinks are topped up first, for at most
    ;; WORK-MS-SOUNDING of wall time while anything sounds, WORK-MS-QUIET
    ;; while nothing does (the start screen before the gesture: free time), and
    ;; at least one step (0.1.1: David's test, crackle at startup and the jump
    ;; late; measured by verify.mjs's startup leg).
    (define WORK-MS-SOUNDING 3.0)
    (define WORK-MS-QUIET 12.0)
    (define (wall-ms) (/ (* 1000.0 (current-jiffy)) (jiffies-per-second)))
    (define (work-more? budget-ms)
      (let ((until (+ (wall-ms) budget-ms)))
        (lambda () (< (wall-ms) until))))
    (define (sounding?) (any source-live? (mixer-sources)))

    (define (audio-frame! frame-ms work-ms)
      (let ((now (audio-now)))
        (cond
          ((or (bench-running?) (bench-done?))
            (begin (shell-take-news!) (shell-take-body-events!) (when (bench-running?) (bench-frame! now frame-ms work-ms))))
          ;; paused (D40): the director waits; the frame's news is let go
          (*paused-at* (shell-take-news!) (shell-take-body-events!))
          (else
            (let ((dt (if *last* (min 0.25 (- now *last*)) 0.0)))
              (moment-door-frame! now)
              (let ((moves (shell-take-body-events!))
                    (pl (world-place (shell-world) (shell-content) (shell-take-news!))))
                (sound-frame! now dt (and pl (place pl moves: moves)))))))
        (set! *last* now)
        (mixer-pump! now)
        (unless (or *paused-at* (bench-running?) (bench-done?))
          (sound-work! (work-more? (if (sounding?) WORK-MS-SOUNDING WORK-MS-QUIET))))))

    (define (r1 x) (number->string (/ (round (* 10.0 x)) 10.0)))

    ;; The cues' path and latency, as words (the web's "cues" probe and the
    ;; readout): PATH MODE plays N ring-ms X lag-ms Y ("-" when not measured).
    ;; Both figures leave out the device's own output latency.
    (define (audio-cue-words)
      (let* ((st (mixer-stats))
             (num (lambda (v) (if (number? v) (r1 v) "-"))))
        (list (symbol->string (stats-ref st 'cue-path))
              (let ((m (stats-ref st 'cue-mode))) (if m (symbol->string m) "-"))
              "plays" (number->string (stats-ref st 'cue-plays))
              "ring-ms" (num (stats-ref st 'cue-ring-ms))
              "lag-ms" (num (stats-ref st 'cue-lag-ms)))))

    (define (audio-lines)
      (let ((st (mixer-stats)))
        (append (sound-lines)
                (list (string-append "music " (r1 (stats-ref st 'frame-ms)) " ms/frame pump "
                                     (r1 (car (stats-ref st 'pump))) " dry " (number->string (stats-ref st 'dry-sounding))
                                     " rate " (number->string (mixer-rate)))
                      (string-append "cues " (string-join (audio-cue-words) " "))))))))
