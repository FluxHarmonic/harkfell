;;; (harkfell check) - Gate 3 of section 8, reach, on the written world; and
;;; the text report an author reads (scripts/room-check).
;;;
;;; The search is (engine reach)'s, over the whole world map (so a route may
;;; leave a room and come back through its neighbour, as a player would),
;;; from the world's start cell (world/world.sgl's (start ...)), with every
;;; candidate edge accepted only if its witness replays (witness-lands?).
;;; Then, for every room:
;;;
;;;   unreachable   a standable cell no path from the start reaches. Red,
;;;                 unless the room declares it (unreached: ((C R) ...)),
;;;                 and a declared cell that IS reached is red too (the
;;;                 declaration has gone stale).
;;;   trap          a cell the start reaches from which no path leads back
;;;                 to the start: once there, you are stuck. Red.
;;;   water trap    water the search swims into (a water anchor) from which no
;;;                 standing cell that leads back to the start is reached: a
;;;                 well you swim in for ever. Red. (No cell in water is
;;;                 standable, so the plain trap check cannot see it.)
;;;
;;; "Back to the start" is stronger than the design's "an exit or the
;;; room's entry" and is what the world check means for a region you can
;;; walk out of; it is the same thing while the world is one region.
;;;
;;; The report draws the room's grid with every standable cell marked:
;;;   *   reached, and the start is reachable from it
;;;   !   not reached from the start
;;;   ?   reached, but a trap (no way back)
;;;   @   the start
;;;   -   declared unreached (and not reached)

(define-library (harkfell check)
  (import (sigil struct)
          (sigil list)
          (sigil string)
          (sigil math)
          (engine tilemap)
          (engine body)
          (engine roomfile)
          (engine worldmap)
          (engine reach)
          (harkfell feel)
          (harkfell content))

  (export start-cell content-reach reach-problems room-report
          room-cells-global global->local local->global room-standable-cells
          room-start-cell reach-summary
          content-reach-carrying content-reach-carrying* set-reach-reuse! sets-bare room-gated carry-label
          content-pickup-cells content-stone-cells tiles-carrying
          content-reach-seeded PICKUP-TOUCH carry-union edge-touches
          cset? cset-carry cset-graph cset-entries cset-fwd cset-back cset-touch)

  (begin
    (define (room-tile-origin ct rm)
      (let ((wm (content-map ct)))
        (cons (* ROOM-COLS (- (room-x rm) (worldmap-x0 wm)))
              (* ROOM-ROWS (- (room-y rm) (worldmap-y0 wm))))))

    (define (local->global ct rm c r)
      (let ((o (room-tile-origin ct rm)))
        (cons (+ (car o) c) (+ (cdr o) r))))

    (define (global->local ct rm cell)
      (let ((o (room-tile-origin ct rm)))
        (cons (- (car cell) (car o)) (- (cdr cell) (cdr o)))))

    ;; The world's start as a global cell, or #f.
    (define (start-cell ct)
      (let ((s (content-start ct)))
        (and s
             (let ((rm (content-room ct (car (cadr s)) (cadr (cadr s)))))
               (and rm (local->global ct rm (car (caddr s)) (cadr (caddr s))))))))

    ;; The standable cells of a room, global.
    (define (room-standable-cells ct rm)
      (let ((tm (worldmap-tiles (content-map ct)))
            (o (room-tile-origin ct rm)))
        (filter (lambda (cell) (standable? tm (car cell) (cdr cell)))
                (apply append
                       (map (lambda (r) (map (lambda (c) (cons (+ (car o) c) (+ (cdr o) r))) (iota ROOM-COLS)))
                            (iota ROOM-ROWS))))))

    (define (room-cells-global ct rm) (room-standable-cells ct rm))

    ;; The water cells of a room, global, in reading order: a room with
    ;; nowhere to stand (The Drowned Bell, all water and rock) is entered
    ;; swimming.
    (define (room-water-cells ct rm)
      (let ((tm (worldmap-tiles (content-map ct)))
            (o (room-tile-origin ct rm)))
        (filter (lambda (cell) (kind-water? (tilemap-ref tm (car cell) (cdr cell))))
                (apply append
                       (map (lambda (r) (map (lambda (c) (cons (+ (car o) c) (+ (cdr o) r))) (iota ROOM-COLS)))
                            (iota ROOM-ROWS))))))

    ;; Where a door (?room=, --room) puts the body in a room, as a global
    ;; cell: the world's start cell if it is in this room, else the room's
    ;; start: field, else the standable cell nearest the room's middle
    ;; (reading order breaks ties), else, in a room with nowhere to stand,
    ;; the water cell nearest the middle (0.1.1: ?room=reedfen:14,5 said "no
    ;; room"); #f if the room has neither.
    (define (room-start-cell ct rm)
      (let* ((s (content-start ct))
             (standable (room-standable-cells ct rm))
             (cells (if (null? standable) (room-water-cells ct rm) standable)))
        (cond ((and s (eq? (car s) (room-region rm))
                    (= (car (cadr s)) (room-x rm)) (= (cadr (cadr s)) (room-y rm)))
               (local->global ct rm (car (caddr s)) (cadr (caddr s))))
              ((room-start rm) (local->global ct rm (car (room-start rm)) (cdr (room-start rm))))
              ((null? cells) #f)
              (else
               (let ((mid (local->global ct rm 12 5)))
                 (let loop ((cs (cdr cells)) (best (car cells)))
                   (if (null? cs)
                       best
                       (loop (cdr cs)
                             (if (< (dist2 (car cs) mid) (dist2 best mid)) (car cs) best)))))))))

    (define (dist2 a b)
      (let ((dx (- (car a) (car b))) (dy (- (cdr a) (cdr b))))
        (+ (* dx dx) (* dy dy))))


    ;; --- harmonics: carry sets, and a pickup as a change of carry ------------------
    ;;
    ;; A ring-stone keyed to a harmonic you carry opens (harkfell gates), so
    ;; what is reachable depends on what you carry. The checker searches each
    ;; CARRY SET a player can actually hold, and for each builds the world's
    ;; tilemap with the stones of the carried harmonics open.
    ;;
    ;; A PICKUP IS A CHANGE OF CARRY (t-c53681, Glasswood). The states are
    ;; (cell, carry): standing there, holding that. The empty set is entered at
    ;; the start. An edge (a witness) whose replay touches a harmonic you do not
    ;; carry (the gates' rule: the body's box within PICKUP-TOUCH px of the
    ;; harmonic's cell centre, any tick of the replay, its start and its settle
    ;; included) takes you to the larger set at the edge's far end; so does
    ;; standing on the harmonic's cell. Each larger set's search is seeded at
    ;; those places (as well as at the start), so what a player can do right
    ;; after the pickup is searched even where the start, carrying the same,
    ;; could not get to it (a stone keyed to the harmonic that was the step up
    ;; to it has opened). Sets are searched smallest first; a pickup only ever
    ;; grows the carry, so every way into a set is known before it is searched.
    ;;
    ;; FORWARD (which states exist) is over-approximated: a touching edge also
    ;; leaves you in the smaller set at its far end, because a pickup can be
    ;; jumped over (6 px) by a trajectory the search did not keep, and that is
    ;; how the Glasswood review's softlock is made. The one exception: coming
    ;; to rest on the harmonic's own cell always takes it.
    ;;
    ;; BACK (can the start be reached from a state, carrying anything) is exact
    ;; per witness: an edge that touches a harmonic counts only as taking it.
    ;; Over-approximating what exists and under-approximating the ways out
    ;; means a trap found is reported, and a trap missed would need a state or
    ;; an edge the search does not have (the search's own caveat).
    ;;
    ;; Not modelled: a stone takes RING-TICKS + SINK-TICKS (88 ticks, about
    ;; 1.5 s) to open after you come near carrying its harmonic; the checker
    ;; takes it as open at once, as it always has. And a trajectory after a
    ;; mid-air pickup is taken to go on as its witness did (a stone keyed to
    ;; the harmonic cannot open under it in less than 88 ticks).

    (define PICKUP-TOUCH 6.0)   ; a pickup's reach around its cell's centre, px ((harkfell gates) TOUCH)

    (define (things-global ct kind)
      (apply append
             (map (lambda (p)
                    (let ((rm (placed-data p)))
                      (filter (lambda (x) x)
                              (map (lambda (t)
                                     (let ((a (thing-at t)) (o (thing-kw t "overtone")))
                                       (and a (integer? o) (cons o (local->global ct rm (car a) (cdr a))))))
                                   (room-things-of rm kind)))))
                  (content-rooms ct))))

    ;; ((overtone . cell) ...), global cells.
    (define (content-pickup-cells ct) (things-global ct 'harmonic))
    (define (content-stone-cells ct) (things-global ct 'ring-stone))

    ;; The world's tilemap with the stones keyed to carry open (air).
    (define (tiles-carrying ct carry)
      (let loop ((ss (content-stone-cells ct)) (tm (worldmap-tiles (content-map ct))))
        (cond ((null? ss) tm)
              ((memv (car (car ss)) carry)
               (loop (cdr ss) (tilemap-set tm (car (cdr (car ss))) (cdr (cdr (car ss))) 'air)))
              (else (loop (cdr ss) tm)))))

    (define (carry-label carry)
      (if (null? carry)
          "carrying nothing"
          (string-append "carrying " (string-join (map (lambda (h) (string-append "H" (number->string h))) carry) " "))))

    ;; Sorted, without repeats.
    (define (sorted-carry l)
      (let loop ((l (list-sort < l)) (acc '()))
        (cond ((null? l) (reverse acc))
              ((and (pair? acc) (= (car acc) (car l))) (loop (cdr l) acc))
              (else (loop (cdr l) (cons (car l) acc))))))

    (define (carry-union a b) (sorted-carry (append a b)))

    ;; The reach graph from the start, carrying carry (#f with no start).
    ;; log: optional, (expanded steps kind cell) after each anchor.
    (define (content-reach-carrying ct carry . log)
      (apply content-reach-carrying* ct carry #f log))

    ;; A4 (REUSE, (engine reach)): with base, an earlier set's graph, the
    ;; search takes from its memo whatever the stones that differ did not touch.
    (define (content-reach-carrying* ct carry base . log)
      (apply content-reach-seeded ct carry base '() log))

    ;; The same, searched from the start AND from seeds (cells a pickup lands
    ;; you in, carrying carry).
    (define (content-reach-seeded ct carry base seeds . log)
      (let ((s (start-cell ct))
            (tm (tiles-carrying ct carry)))
        (and s
             (let ((starts (cons s (filter (lambda (c) (not (equal? c s))) seeds))))
               (if (and base *reuse*)
                   (apply reach-search* tm HARKFELL-FEEL starts witness-lands?
                          (graph-memo base) (tilemap-changes (graph-tm base) tm) log)
                   (apply reach-search tm HARKFELL-FEEL starts witness-lands? log))))))

    ;; REUSE on (the default) or off: --no-reuse, and the fixture check that
    ;; compares the two.
    (define *reuse* #t)
    (define (set-reach-reuse! on) (set! *reuse* on))

    ;; One carry set, searched.
    ;;   entries  the cells it is entered at: the start (the empty set), or
    ;;            where a pickup leaves you
    ;;   fwd      vector by cell index: standing there carrying this can happen
    ;;   back     vector by cell index: from standing there carrying this, the
    ;;            start is reachable (picking up more on the way if need be)
    ;;   touch    ((from-index to-index overtones witness) ...): the edges whose
    ;;            replay takes harmonics this set does not hold
    (define-struct cset
      (carry default: '())
      (graph default: #f)
      (entries default: '())
      (fwd default: #f)
      (back default: #f)
      (touch default: '())
      (touch-all default: '()))   ; every edge of the set's graph that takes something, from anywhere (raw: (i j hs w))

    ;; Does body b's box touch the harmonic lying in cell? ((harkfell gates)'s rule.)
    (define (body-touches? tm b cell)
      (let* ((s (tilemap-size tm))
             (cx (+ (* s (car cell)) (/ s 2.0)))
             (cy (+ (* s (cdr cell)) (/ s 2.0)))
             (x (body-x b)) (y (body-y b))
             (w (feel-box-w HARKFELL-FEEL)) (h (feel-box-h HARKFELL-FEEL)))
        (and (< (- cx PICKUP-TOUCH) (+ x w)) (< x (+ cx PICKUP-TOUCH))
             (< (- cy PICKUP-TOUCH) (+ y h)) (< y (+ cy PICKUP-TOUCH)))))

    (define (in-rect? rect cell)
      (and (<= (car rect) (car cell) (caddr rect)) (<= (cadr rect) (cdr cell) (cadddr rect))))

    ;; The edges of g whose replay touches a harmonic not in carry:
    ;; ((from-index to-index overtones witness) ...). Only the edges out of a
    ;; cell whose walk rectangle ((engine reach) graph-walk-rect) holds a
    ;; harmonic's cell are replayed: every body of those edges lies inside it.
    (define (edge-touches g carry pickups)
      (let* ((tm (graph-tm g))
             (free (filter (lambda (p) (not (memv (car p) carry))) pickups))
             (edges (graph-edges g))
             (n (vector-length edges)))
        (if (null? free)
            '()
            (let loop ((i 0) (acc '()))
              (if (>= i n)
                  (reverse acc)
                  (let* ((es (vector-ref edges i))
                         (near (if (null? es)
                                   '()
                                   (let ((rect (graph-walk-rect g (index-cell tm i))))
                                     (if rect (filter (lambda (p) (in-rect? rect (cdr p))) free) free)))))
                    (loop (+ i 1)
                          (if (null? near)
                              acc
                              (let each ((es es) (acc acc))
                                (if (null? es)
                                    acc
                                    (let* ((w (cdr (car es)))
                                           (trace (witness-trace tm HARKFELL-FEEL w))
                                           (hs (sorted-carry
                                                 (map car (filter (lambda (p) (find (lambda (b) (body-touches? tm b (cdr p))) trace))
                                                                  near)))))
                                      (each (cdr es)
                                            (if (null? hs) acc (cons (list i (car (car es)) hs w) acc))))))))))))))

    ;; Cells reachable over g's edges from entries. Every edge is followed,
    ;; touching or not (FORWARD above), except one whose replay takes a harmonic
    ;; and comes to rest on that harmonic's own cell: standing there, you hold it
    ;; (blocked? i e). A body resting on the cell by an overhang that misses
    ;; the harmonic does not hold it, and its edge is followed (the review of
    ;; phase 1: blocking by cell lost that state from every set).
    (define (forward-carrying g entries blocked?)
      (let* ((tm (graph-tm g))
             (seen (make-vector (* (tilemap-cols tm) (tilemap-rows tm)) #f))
             (edges (graph-edges g)))
        (let loop ((front (map (lambda (c) (cell-index tm (car c) (cdr c))) entries)) (back '()))
          (cond ((and (null? front) (null? back)) seen)
                ((null? front) (loop (reverse back) '()))
                (else
                 (let ((i (car front)))
                   (if (vector-ref seen i)
                       (loop (cdr front) back)
                       (begin
                         (vector-set! seen i #t)
                         (loop (cdr front)
                               (append (map car (filter (lambda (e) (not (blocked? i e))) (vector-ref edges i)))
                                       back))))))))))

    (define (find-set sets carry)
      (find (lambda (e) (equal? (cset-carry e) carry)) sets))

    ;; Add cells to carry's entries in an alist ((carry . cells) ...).
    (define (add-entries pending carry cells)
      (cond ((null? pending) (list (cons carry cells)))
            ((equal? (car (car pending)) carry)
             (cons (cons carry (append (cdr (car pending))
                                       (filter (lambda (c) (not (member c (cdr (car pending))))) cells)))
                   (cdr pending)))
            (else (cons (car pending) (add-entries (cdr pending) carry cells)))))

    ;; The pending set to search next: fewest harmonics, then the first listed.
    (define (smallest pending)
      (let loop ((l (cdr pending)) (best (car pending)))
        (cond ((null? l) best)
              ((< (length (car (car l))) (length (car best))) (loop (cdr l) (car l)))
              (else (loop (cdr l) best)))))

    ;; Every carry set a player can hold, searched: (cset ...), the empty set
    ;; first, then in the order searched; #f with no start.
    (define (content-reach ct . log)
      (let ((s (start-cell ct)))
        (and s
             (let* ((pickups (content-pickup-cells ct))
                    (sets
                      (let loop ((pending (list (list '() s))) (done '()))
                        (if (null? pending)
                            (reverse done)
                            (let* ((p (smallest pending))
                                   (carry (car p))
                                   (entries (cdr p))
                                   ;; the first set searched (the last of done) lends its memo
                                   (base (and (pair? done) (cset-graph (list-ref done (- (length done) 1)))))
                                   (g (apply content-reach-seeded ct carry base entries log))
                                   (tm (graph-tm g))
                                   (touch-all (edge-touches g carry pickups))
                                   (by-from (let ((v (make-vector (* (tilemap-cols tm) (tilemap-rows tm)) '())))
                                              (for-each (lambda (t) (vector-set! v (car t) (cons t (vector-ref v (car t))))) touch-all)
                                              v))
                                   (blocked? (lambda (i e)
                                               (let ((t (find (lambda (t) (eq? (cadddr t) (cdr e))) (vector-ref by-from i))))
                                                 (and t (find (lambda (q) (and (memv (car q) (caddr t))
                                                                              (= (car e) (cell-index tm (car (cdr q)) (cdr (cdr q))))))
                                                              pickups)
                                                      #t))))
                                   (fwd (forward-carrying g entries blocked?))
                                   ;; each pickup edge as (i j hs w), its far end j settled in
                                   ;; the larger set's tilemap (a stone keyed to what was just
                                   ;; taken, that held the body up, opens under it); j #f when
                                   ;; the body comes to rest nowhere
                                   (touch (map (lambda (t)
                                                 (let* ((tm2 (tiles-carrying ct (carry-union carry (caddr t))))
                                                        (c (settle-cell tm2 HARKFELL-FEEL (index-cell tm (cadr t)))))
                                                   (list (car t) (and c (cell-index tm (car c) (cdr c))) (caddr t) (cadddr t))))
                                               (filter (lambda (t) (vector-ref fwd (car t))) touch-all)))
                                   (rest (filter (lambda (q) (not (eq? q p))) pending))
                                   ;; where each pickup leaves you: the touching edge's far
                                   ;; end, and the harmonic's own cell (settled likewise)
                                   (next (let add ((ts touch) (pd rest))
                                           (if (null? ts)
                                               pd
                                               (let* ((t (car ts))
                                                      (hs (caddr t))
                                                      (pd (if (cadr t)
                                                              (add-entries pd (carry-union carry hs) (list (index-cell tm (cadr t))))
                                                              pd)))
                                                 (add (cdr ts)
                                                      (let each ((hs hs) (pd pd))
                                                        (if (null? hs)
                                                            pd
                                                            (let ((to (carry-union carry (list (car hs)))))
                                                              (each (cdr hs)
                                                                    (add-entries pd to
                                                                                 (filter-map* (lambda (q)
                                                                                                (and (= (car q) (car hs))
                                                                                                     (settle-cell (tiles-carrying ct to) HARKFELL-FEEL (cdr q))))
                                                                                              pickups))))))))))))
                              (loop next (cons (cset carry: carry graph: g entries: entries fwd: fwd touch: touch touch-all: touch-all) done)))))))
               (with-back sets s)))))

    ;; BACK for every set, exact per witness. A set's ways out go within it
    ;; (edges that take nothing) or up to a larger set (edges that take
    ;; something), so the largest sets are done first.
    (define (with-back sets s)
      (let loop ((order (list-sort (lambda (a b) (> (length (cset-carry a)) (length (cset-carry b)))) sets))
                 (done '()))   ; ((carry . back) ...)
        (if (null? order)
            (map (lambda (e) (cset e back: (cdr (assoc (cset-carry e) done)))) sets)
            (let* ((e (car order))
                   (g (cset-graph e))
                   (tm (graph-tm g))
                   (n (* (tilemap-cols tm) (tilemap-rows tm)))
                   (edges (graph-edges g))
                   (touched (make-vector n '()))   ; from-index -> witnesses that take something
                   (into (make-vector n '()))
                   (seen (make-vector n #f)))
              (for-each (lambda (t) (vector-set! touched (car t) (cons (cadddr t) (vector-ref touched (car t)))))
                        (cset-touch-all e))
              ;; the edges that take nothing, reversed
              (let fill ((i 0))
                (when (< i n)
                  (for-each (lambda (x)
                              (unless (memq (cdr x) (vector-ref touched i))
                                (vector-set! into (car x) (cons i (vector-ref into (car x))))))
                            (vector-ref edges i))
                  (fill (+ i 1))))
              (let* ((up (filter-map* (lambda (t)
                                        (let ((b (assoc (carry-union (cset-carry e) (caddr t)) done)))
                                          (and b (cadr t) (vector-ref (cdr b) (cadr t)) (car t))))
                                      (cset-touch e)))
                     (seeds (cons (cell-index tm (car s) (cdr s)) up)))
                (let bfs ((front seeds) (back '()))
                  (cond ((and (null? front) (null? back)) #f)
                        ((null? front) (bfs (reverse back) '()))
                        (else
                         (let ((i (car front)))
                           (if (vector-ref seen i)
                               (bfs (cdr front) back)
                               (begin
                                 (vector-set! seen i #t)
                                 (bfs (cdr front) (append (vector-ref into i) back))))))))
                (loop (cdr order) (cons (cons (cset-carry e) seen) done)))))))

    ;; The set searched with no harmonics (for --path).
    (define (sets-bare sets) (cset-graph (car sets)))

    (define (cell-str c) (string-append "(" (number->string (car c)) "," (number->string (cdr c)) ")"))

    ;; Per room: (room unreached traps stale wet gated), cells room-local.
    ;;   unreached  standing there can happen with NO carry set (less declared)
    ;;   traps      ((carry . cells) ...): standing there carrying that can
    ;;              happen, and from there no way leads back to the start
    ;;   stale      declared unreached, but reached with some set
    ;;   wet        ((carry . cells) ...): water traps, per set
    ;;   gated      ((cell . carry) ...): reached, but not carrying nothing; carry
    ;;              is the first set (in search order) that reaches it
    (define (classify ct sets)
      (let* ((tm (graph-tm (cset-graph (car sets)))))
        (map (lambda (p)
               (let* ((rm (placed-data p))
                      (cells (room-standable-cells ct rm))
                      (idx (lambda (c) (cell-index tm (car c) (cdr c))))
                      (declared (room-unreached rm))
                      (local (lambda (c) (global->local ct rm c)))
                      (fwd-any (lambda (c) (find (lambda (e) (vector-ref (cset-fwd e) (idx c))) sets)))
                      (o (let ((g (global->local ct rm (cons 0 0)))) (cons (- (car g)) (- (cdr g)))))
                      (in-room? (lambda (c) (and (<= (car o) (car c) (+ (car o) ROOM-COLS -1))
                                                 (<= (cdr o) (cdr c) (+ (cdr o) ROOM-ROWS -1)))))
                      (unreached (filter (lambda (c) (not (fwd-any c))) cells))
                      (traps (filter (lambda (x) (pair? (cdr x)))
                                     (map (lambda (e)
                                            (cons (cset-carry e)
                                                  (map local (filter (lambda (c) (and (vector-ref (cset-fwd e) (idx c))
                                                                                      (not (vector-ref (cset-back e) (idx c)))))
                                                                     cells))))
                                          sets)))
                      (wet (filter (lambda (x) (pair? (cdr x)))
                                   (map (lambda (e)
                                          (cons (cset-carry e)
                                                (map (lambda (w) (local (car w)))
                                                     (filter (lambda (w)
                                                               (and (in-room? (car w))
                                                                    (not (find (lambda (c) (vector-ref (cset-back e) (idx c))) (cdr w)))))
                                                             (graph-waters (cset-graph e))))))
                                        sets)))
                      (bare (car sets))
                      (gated (filter-map* (lambda (c)
                                            (and (not (vector-ref (cset-fwd bare) (idx c)))
                                                 (let ((e (fwd-any c))) (and e (cons (local c) (cset-carry e))))))
                                          cells)))
                 (list rm
                       (filter (lambda (c) (not (member c declared))) (map local unreached))
                       traps
                       (filter (lambda (c) (member c declared))
                               (map local (filter (lambda (c) (fwd-any c)) cells)))
                       wet
                       gated)))
             (content-rooms ct))))

    (define (filter-map* f l)
      (let loop ((l l) (acc '()))
        (if (null? l) (reverse acc) (let ((v (f (car l)))) (loop (cdr l) (if v (cons v acc) acc))))))

    ;; A global cell as "region:X,Y (c,r)".
    (define (where ct cell)
      (let* ((wm (content-map ct))
             (rx (+ (worldmap-x0 wm) (exact (floor (/ (car cell) ROOM-COLS)))))
             (ry (+ (worldmap-y0 wm) (exact (floor (/ (cdr cell) ROOM-ROWS)))))
             (rm (content-room ct rx ry)))
        (if rm (string-append (room-label rm) " " (cell-str (global->local ct rm cell))) "?")))

    ;; The harmonics: every one is taken with some set; and wherever taking it
    ;; leaves you (the far end of each edge that takes it, and its own cell),
    ;; the start is reachable carrying what you then hold (picking it up never
    ;; strands you). One problem per harmonic and set it was taken from.
    (define (pickup-problems ct sets)
      (apply append
             (map (lambda (p)
                    (let* ((h (car p)) (cell (cdr p))
                           (takes (apply append
                                         (map (lambda (e)
                                                (map (lambda (t) (cons e t))
                                                     (filter (lambda (t) (memv h (caddr t))) (cset-touch e))))
                                              sets))))
                      (if (null? takes)
                          (list (problem path: "world/world.sgl" line: #f
                                         message: (string-append "harmonic H" (number->string h) " at " (where ct cell)
                                                                 " is not reachable with any harmonics a player can carry")))
                          (let each ((ts takes) (said '()) (acc '()))
                            (if (null? ts)
                                (reverse acc)
                                (let* ((e (car (car ts)))
                                       (t (cdr (car ts)))
                                       (from (cset-carry e))
                                       (after (find-set sets (carry-union from (caddr t))))
                                       (own (find-set sets (carry-union from (list h))))
                                       (tm (graph-tm (cset-graph e)))
                                       (stuck (filter (lambda (x)
                                                        (let ((set (car x)) (i (cdr x)))
                                                          (not (and set i (vector-ref (cset-back set) i)))))
                                                      (list (cons after (cadr t))
                                                            (cons own (let ((c (and own (settle-cell (graph-tm (cset-graph own)) HARKFELL-FEEL cell))))
                                                                        (and c (cell-index tm (car c) (cdr c)))))))))
                                  (if (or (null? stuck) (member from said))
                                      (each (cdr ts) said acc)
                                      (each (cdr ts) (cons from said)
                                            (cons (problem path: "world/world.sgl" line: #f
                                                           message: (string-append "harmonic H" (number->string h) " at " (where ct cell)
                                                                                   ": picked up " (carry-label from)
                                                                                   ", there is no way back to the start from "
                                                                                   (let ((i (cdr (car stuck))))
                                                                                     (if i (where ct (index-cell tm i)) "where it lands (it comes to rest nowhere)"))))
                                                  acc)))))))))
                  (content-pickup-cells ct))))

    (define (carried-cells l)
      (string-join (map (lambda (x) (string-append (carry-label (car x)) ": " (string-join (map cell-str (cdr x)) " "))) l) "; "))

    ;; Problems ((engine roomfile) problems, one per room and kind).
    (define (reach-problems ct sets)
      (if (not sets)
          (list (problem path: "world/world.sgl" line: #f message: "no start: nothing to search from"))
          (append
            (apply append
                   (map (lambda (e)
                          (let ((rm (car e)))
                            (append
                              (if (null? (cadr e)) '()
                                  (list (problem path: (room-path rm) line: #f
                                                 message: (string-append (room-label rm) ": cells "
                                                                         (string-join (map cell-str (cadr e)) " ")
                                                                         " are not reachable from the start, carrying anything a player can"))))
                              (if (null? (caddr e)) '()
                                  (list (problem path: (room-path rm) line: #f
                                                 message: (string-append (room-label rm) ": traps, no way back to the start from them ("
                                                                         (carried-cells (caddr e)) ")"))))
                              (if (null? (list-ref e 4)) '()
                                  (list (problem path: (room-path rm) line: #f
                                                 message: (string-append (room-label rm) ": water traps, swimming there reaches no standing place that leads back to the start ("
                                                                         (carried-cells (list-ref e 4)) ")"))))
                              (if (null? (cadddr e)) '()
                                  (list (problem path: (room-path rm) line: (field-line (roomfile-text (room-file rm)) "unreached")
                                                 message: (string-append (room-label rm) ": unreached: lists "
                                                                         (string-join (map cell-str (cadddr e)) " ")
                                                                         ", which the start does reach")))))))
                        (classify ct sets)))
            (pickup-problems ct sets))))

    ;; A room's gated cells: ((c . r) . carry) for each cell reached only
    ;; carrying something (the gate tests read it).
    (define (room-gated ct sets rm)
      (let find ((es (classify ct sets)))
        (cond ((null? es) '())
              ((eq? (car (car es)) rm) (list-ref (car es) 5))
              (else (find (cdr es))))))

    ;; The room's grid with its standable cells marked, then a line each for
    ;; what is wrong. Lines, for printing. A gated cell is marked with the
    ;; digit of the highest harmonic in the first set that reaches it.
    (define (room-report ct sets rm)
      (let* ((e (let find ((es (classify ct sets)))
                  (cond ((null? es) #f)
                        ((eq? (car (car es)) rm) (car es))
                        (else (find (cdr es))))))
             (s (start-cell ct))
             (cells (map (lambda (c) (global->local ct rm c)) (room-standable-cells ct rm)))
             (start-local (and s (global->local ct rm s)))
             (trap-cells (apply append (map cdr (caddr e))))
             (gated (list-ref e 5))
             (mark (lambda (c r)
                     (let ((cell (cons c r)))
                       (cond ((and start-local (equal? cell start-local)) #\@)
                             ((not (member cell cells)) #f)
                             ((member cell trap-cells) #\?)
                             ((member cell (cadr e)) #\!)
                             ((member cell (room-unreached rm)) #\-)
                             ((assoc cell gated)
                              (let ((carry (cdr (assoc cell gated))))
                                (string-ref (number->string (apply max carry)) 0)))
                             (else #\*))))))
        (append
          (list (string-append (room-label rm) "  \"" (room-title rm) "\"")
                (string-append "  intent: " (room-intent rm)))
          (map (lambda (r)
                 (string-append "  |"
                                (list->string (map (lambda (c) (or (mark c r) (room-char rm c r))) (iota ROOM-COLS)))
                                "|"))
               (iota ROOM-ROWS))
          (list (string-append "  standable " (number->string (length cells))
                               ", unreachable " (number->string (length (cadr e)))
                               ", traps " (number->string (length trap-cells))
                               ", gated " (number->string (length gated))))
          (if (null? gated) '()
              (list (string-append "  GATED (reached only carrying): "
                                   (string-join (map (lambda (g) (string-append (cell-str (car g)) " " (carry-label (cdr g)))) gated) ", "))))
          (if (null? (cadr e)) '() (list (string-append "  UNREACHABLE " (string-join (map cell-str (cadr e)) " "))))
          (if (null? (caddr e)) '() (list (string-append "  TRAP " (carried-cells (caddr e)))))
          (if (null? (list-ref e 4)) '() (list (string-append "  WATER TRAP " (carried-cells (list-ref e 4)))))
          (if (null? (cadddr e)) '() (list (string-append "  STALE unreached: " (string-join (map cell-str (cadddr e)) " ")))))))

    ;; One line per carry set searched: its search's stats, how many places it
    ;; is entered at, and how many edges take a harmonic.
    (define (reach-summary sets)
      (string-join
        (map (lambda (e)
               (string-append (carry-label (cset-carry e)) ": "
                              (string-join (map (lambda (p) (string-append (symbol->string (car p)) " " (number->string (cdr p))))
                                                (graph-stats (cset-graph e)))
                                           ", ")
                              ", entered at " (number->string (length (cset-entries e)))
                              ", pickup edges " (number->string (length (cset-touch e)))))
             sets)
        (string-append (string #\newline) "       ")))))
