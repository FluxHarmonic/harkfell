;;; (harkfell sprites) - A3's living things drawn: the creatures, the
;;; ring-stones and the harmonics you find, as palette SLOTS into
;;; (harkfell render)'s index target.
;;;
;;; A frame is drawn facing right with its bottom row ending at the feet
;;; (x, y) and its columns centred on x; facing left mirrors it. Each
;;; character names a slot through the sprite's key ('.' is nothing).
;;; Pixels are drawn as horizontal runs.
;;;
;;; Light is not a colour: it goes into the index target's B channel,
;;; added (the caller wraps the -light and -glow draws in additive
;;; blending), and the resolve lights what is under it inside the palette.
;;;
;;; slot: the caller's (name -> slot number), (harkfell draw)'s slot.
;;;
;;;   (draw-critter c ox oy t slot)       one creature, in room pixels (ox oy:
;;;                                       the room's origin in map pixels)
;;;   (draw-critter-glow c ox oy t slot)  a moth's light
;;;   (draw-stone st x y t carry slot)    a ring-stone in its cell's top-left
;;;   (draw-stone-light st x y t slot)    its light while it rings
;;;   (draw-pickup n x y t slot)          an unfound harmonic at a cell's centre
;;;   (draw-pickup-light n x y t)         its light
;;;   (draw-flash n x y age slot)         a harmonic just taken (age in ticks)
;;;   (draw-flash-light x y age)          its light
;;;   (harmonic-role n)                   the slot name of a harmonic's colour

(define-library (harkfell sprites)
  (import (sigil math)
          (sigil list)
          (sigil string)
          (sigil graphics)
          (harkfell render)
          (harkfell gates)
          (harkfell creatures))

  (export draw-critter draw-critter-glow draw-stone draw-stone-light draw-pickup draw-pickup-light
          draw-flash draw-flash-light harmonic-role FRAMES)

  (begin
    (define (harmonic-role n)
      (case n ((2) 'h2) ((3) 'h3) ((4) 'h4) ((5) 'h5) ((7) 'h7) (else 'h2)))

    (define (floor-int x) (exact (floor x)))
    (define (quotient* a b) (exact (floor (/ a b))))

    ;; A disc of radius r at (cx, cy) in whole pixels, one rect per row.
    (define (disc! cx cy r)
      (let* ((x0 (floor-int cx)) (y0 (floor-int cy)) (ri (floor-int r)))
        (let loop ((dy (- ri)))
          (when (<= dy ri)
            (let ((w (floor-int (sqrt (max 0.0 (- (* r r) (* dy dy)))))))
              (draw-filled-rect (- x0 w) (+ y0 dy) (+ 1 (* 2 w)) 1))
            (loop (+ dy 1))))))

    ;; Light of amount a in a disc (additive: the caller's blend).
    (define (light-disc! cx cy r a)
      (when (> a 0.0)
        (paint-light! a)
        (disc! cx cy r)))

    ;; rows: the frame; key: ((char . slot-name) ...); slot: name -> number
    (define (sprite! rows key x y face slot)
      (let* ((h (length rows))
             (w (apply max (map string-length rows)))
             (x0 (- (floor-int x) (quotient* w 2)))
             (y0 (- (floor-int y) h)))
        (let loop ((rs rows) (r 0))
          (unless (null? rs)
            (let* ((row (car rs)) (n (string-length row)))
              (let run ((c 0))
                (when (< c n)
                  (let ((ch (string-ref row c)))
                    (if (char=? ch #\.)
                        (run (+ c 1))
                        (let ((end (let more ((e (+ c 1)))
                                     (if (and (< e n) (char=? (string-ref row e) ch)) (more (+ e 1)) e))))
                          (let ((k (assv ch key)))
                            (when k
                              (paint-slot! (slot (cdr k)))
                              (if (> face 0)
                                  (draw-filled-rect (+ x0 c) (+ y0 r) (- end c) 1)
                                  (draw-filled-rect (+ x0 (- w end)) (+ y0 r) (- end c) 1))))
                          (run end)))))))
            (loop (cdr rs) (+ r 1))))))

    ;; --- the frames ------------------------------------------------------------------------
    (define REEDLING-KEY
      (list (cons #\h 'ground-3) (cons #\b 'ground-3) (cons #\w 'ground-2) (cons #\c 'leaf-3)
            (cons #\e 'ink) (cons #\k 'accent) (cons #\l 'ink)))

    (define REEDLING
      (list
        (cons 'perch (list "....hh."
                           "...hhek"
                           "wbbbbb."
                           ".wbcc.."
                           "...l.l."))
        (cons 'peck (list "......."
                          "w......"
                          "wbbbbh."
                          ".bccbek"
                          "...l.l."))
        (cons 'sing (list ".....k."
                          "....hk."
                          "....he."
                          "wbbbbb."
                          ".wbcc.."
                          "...l.l."))
        (cons 'fly (list "..w...."
                         "..ww..."
                         "wbbbbek"
                         "..bcc.."))
        (cons 'fly2 (list "wbbbbek"
                          "..wcc.."
                          "...w..."))
        (cons 'glide (list "wwbbbek"
                           "..bcc.."))))

    (define FROG-KEY
      (list (cons #\g 'leaf-2) (cons #\d 'ground-2) (cons #\t 'sky-3) (cons #\p 'ink)
            (cons #\f 'leaf-1) (cons #\s 'leaf-1)))

    (define FROG
      (list
        (cons 'sit (list "....sp.."
                         "..ggggg."
                         ".gdgggtt"
                         "ggggttt."
                         ".f..ff.."))
        (cons 'blink (list "....ss.."
                           "..ggggg."
                           ".gdgggtt"
                           "ggggttt."
                           ".f..ff.."))
        (cons 'croak (list "....sp..."
                           "..ggggg.."
                           ".gdggtttt"
                           "ggggttttt"
                           ".f..fttt."))
        (cons 'crouch (list "....ss.."
                            "..gggpg."
                            "gdgggggg"
                            "fgtttff."))
        (cons 'leap (list "....sp."
                          "..gggg."
                          ".gdgt.."
                          "gg....."
                          "f......"))
        (cons 'fall (list "...ssp.."
                          ".gdgggg."
                          "ggttt..."
                          ".f...f.."))
        (cons 'eyes (list "..ss"
                          "gpgg"))))

    (define MOTH
      (list
        (cons 'up (list "w...w"
                        ".wbw."
                        "..b.."))
        (cons 'down (list "....."
                          "wwbww"
                          "..b.."))))

    (define FRAMES (list (cons 'reedling REEDLING) (cons 'bellfrog FROG) (cons 'moth MOTH)))

    (define (frame-of table name) (let ((e (assq name table))) (if e (cdr e) (cdr (car table)))))

    ;; --- creatures ---------------------------------------------------------------------------
    (define (draw-critter c ox oy t slot)
      (let ((x (- (critter-x c) ox)) (y (- (critter-y c) oy)) (face (critter-facing c)))
        (case (critter-kind c)
          ((reedling)
           (let* ((f (critter-frame c))
                  (name (cond ((eq? f 'fly) (if (< (modulo (+ t (critter-anim c)) 8) 4) 'fly 'fly2))
                              ((memq f (list 'perch 'peck 'sing 'glide)) f)
                              (else 'perch)))
                  ;; a perched bird breathes: up a pixel now and then
                  (bob (if (and (eq? name 'perch) (< (modulo (+ t (* 3 (critter-anim c))) 90) 8)) -1 0)))
             (sprite! (frame-of REEDLING name) REEDLING-KEY x (+ y bob) face slot)))
          ((bellfrog)
           (let* ((f (critter-frame c))
                  (name (if (memq f (list 'sit 'blink 'croak 'crouch 'leap 'fall 'eyes)) f 'sit)))
             (sprite! (frame-of FROG name) FROG-KEY x y face slot)))
          ((moth)
           (let* ((drawn (eq? (critter-state c) 'drawn))
                  (wing (if drawn (harmonic-role (or (critter-drawn c) 2)) 'sky-4))
                  (name (if (< (modulo (+ t (critter-anim c)) 6) 3) 'up 'down)))
             (sprite! (frame-of MOTH name) (list (cons #\w wing) (cons #\b 'fur-1))
                      x (+ y 2) face slot)))
          (else #f))))

    ;; A moth's light: a soft disc, pulsing; stronger when it is drawn to a
    ;; harmonic you carry (the resolve gives the core the harmonic's colour).
    (define (draw-critter-glow c ox oy t slot)
      (when (eq? (critter-kind c) 'moth)
        (let* ((x (- (critter-x c) ox)) (y (- (critter-y c) oy))
               (g (critter-glow c))
               (drawn (eq? (critter-state c) 'drawn))
               (pulse (+ 0.85 (* 0.15 (sin (* 0.11 (+ t (critter-anim c))))))))
          (light-disc! x y (+ 4.0 (* 2.5 g)) (* (if drawn 0.3 0.18) g pulse))
          (light-disc! x y 2.5 (* (if drawn 0.35 0.2) g pulse)))))

    ;; --- ring-stones ----------------------------------------------------------------------------
    ;; x y: the cell's top-left. The stone stands in its cell, rounded, with
    ;; its harmonic's glyph cut in its face (a ring and a notch per step above
    ;; the fundamental). Shut: the glyph dark. Near miss: it shivers, the
    ;; glyph flickering in the colour of what you carry. Ringing: the glyph
    ;; burns and the stone glows. Sinking: it goes down into the floor (the
    ;; floor, drawn after, covers it). Open: its top lies flush with the
    ;; floor, the glyph glowing, and it glows again each time it rings.
    (define (glyph! x y n s)
      (paint-slot! s)
      (draw-filled-rect (+ x 6) (+ y 4) 4 1)
      (draw-filled-rect (+ x 6) (+ y 9) 4 1)
      (draw-filled-rect (+ x 5) (+ y 5) 1 4)
      (draw-filled-rect (+ x 10) (+ y 5) 1 4)
      (let loop ((k 0))
        (when (< k (- n 1))
          (draw-filled-rect (+ x 7 (* 2 k)) (+ y 11) 1 2)
          (loop (+ k 1)))))

    (define (stone-body! x y slot)
      (paint-slot! (slot 'ground-3))
      (draw-filled-rect (+ x 2) y 12 16)
      (draw-filled-rect (+ x 1) (+ y 1) 14 15)
      (paint-slot! (slot 'ground-2))
      (draw-filled-rect (+ x 12) (+ y 2) 2 14)
      (draw-filled-rect (+ x 2) (+ y 14) 12 2)
      (paint-slot! (slot 'ground-4))
      (draw-filled-rect (+ x 3) (+ y 1) 8 1)
      (draw-filled-rect (+ x 2) (+ y 2) 1 5))

    (define (draw-stone st x y t carry slot)
      (let* ((n (stone-overtone st))
             (key (slot (harmonic-role n)))
             (state (stone-state st))
             (sink (stone-sink st)))
        (case state
          ((open)
           ;; its top flush with the floor, below the passage
           (paint-slot! (slot 'ground-3))
           (draw-filled-rect (+ x 1) (+ y 14) 14 2)
           (paint-slot! key)
           (draw-filled-rect (+ x 6) (+ y 14) 4 1)
           #f)
          (else
           (let* ((shiver (stone-shiver st))
                  (jx (if (and (> shiver 0) (odd? (quotient* shiver 2))) (if (odd? (quotient* shiver 4)) 1 -1) 0))
                  (ringing (memq state (list 'ringing 'sinking)))
                  (jx (if (and ringing (< (stone-t st) 30) (eq? state 'ringing)) (if (odd? (quotient* t 2)) 1 0) jx))
                  (sy (+ y (floor-int (* 16.0 sink))))
                  (sx (+ x jx)))
             (stone-body! sx sy slot)
             (cond
               (ringing (glyph! sx sy n key))
               ((> shiver 0)
                ;; the wrong colour flickers in the glyph: the harmonic you carry
                (let ((wrong (if (pair? carry) (slot (harmonic-role (car carry))) key)))
                  (glyph! sx sy n (if (odd? (quotient* shiver 3)) wrong key))))
               (else
                ;; mute: the glyph cut dark in the stone, its colour a rim
                ;; that shows only now and then, breathing very slowly
                (glyph! sx sy n (if (> (sin (* 0.02 t)) 0.6) key (slot 'ground-1))))))))))

    ;; A stone's light while it rings and sinks, and each time an open stone
    ;; rings again (150 ticks). Rings of light go out from it like the sound.
    (define (draw-stone-light st x y t slot)
      (let* ((state (stone-state st))
             (a (case state
                  ((ringing) (min 1.0 (/ (stone-t st) 12.0)))
                  ((sinking) (- 1.0 (* 0.5 (stone-sink st))))
                  ((open) (max 0.0 (- 1.0 (/ (stone-t st) 150.0))))
                  (else 0.0)))
             (cy (if (eq? state 'open) (+ y 14) (+ y 7 (floor-int (* 16.0 (stone-sink st))))))
             (p (+ 0.8 (* 0.2 (sin (* 0.3 t))))))
        (when (> a 0.0)
          (light-disc! (+ x 8) cy 16.0 (* 0.3 a p))
          (light-disc! (+ x 8) cy 9.0 (* 0.35 a p))
          ;; two rings going out, 40 ticks apart
          (let loop ((k 0))
            (when (< k 2)
              (let* ((u (/ (modulo (+ t (* 20 k)) 40) 40.0))
                     (r (+ 6.0 (* 22.0 u))))
                (paint-light! (* 0.9 a (- 1.0 u)))
                (let dots ((j 0))
                  (when (< j 16)
                    (let ((ang (* j 0.3927)))
                      (draw-filled-rect (floor-int (+ x 8 (* r (cos ang)))) (floor-int (+ cy (* r (sin ang)))) 1 1))
                    (dots (+ j 1)))))
              (loop (+ k 1)))))))

    ;; --- the harmonics --------------------------------------------------------------------------
    ;; An unfound harmonic at (x, y), a cell's centre: a small bright mote
    ;; in its colour, bobbing, with specks rising.
    (define (pickup-bob y t) (+ y (* 2.0 (sin (* 0.05 t)))))

    (define (draw-pickup n x y t slot)
      (let* ((s (slot (harmonic-role n)))
             (by (pickup-bob y t)))
        (paint-slot! s)
        (let loop ((k 0))
          (when (< k 3)
            (let* ((u (/ (modulo (+ t (* 37 k)) 110) 110.0))
                   (sx (+ x (* 5.0 (sin (+ (* 2.1 k) (* 6.28 u))))))
                   (sy (- by (* 18.0 u))))
              (when (< u 0.7)
                (draw-filled-rect (floor-int sx) (floor-int sy) 1 1)))
            (loop (+ k 1))))
        (draw-filled-rect (- (floor-int x) 1) (- (floor-int by) 2) 3 5)
        (draw-filled-rect (- (floor-int x) 2) (- (floor-int by) 1) 5 3)
        (paint-slot! (slot 'fur-1))
        (draw-filled-rect (floor-int x) (- (floor-int by) 1) 1 2)))

    (define (draw-pickup-light n x y t)
      (let* ((by (pickup-bob y t))
             (p (+ 0.8 (* 0.2 (sin (* 0.09 t))))))
        (light-disc! x by 10.0 (* 0.3 p))
        (light-disc! x by 6.0 (* 0.4 p))))

    ;; A harmonic just taken: a ring of its colour opening out over FLASH
    ;; ticks, and its light going out.
    (define (draw-flash n x y age slot)
      (let ((u (/ age 60.0)))
        (when (< u 0.8)
          (paint-slot! (slot (harmonic-role n)))
          (let loop ((k 0))
            (when (< k 8)
              (let ((a (* k 0.785)))
                (draw-filled-rect (floor-int (+ x (* 30.0 u (cos a)))) (floor-int (+ y (* 30.0 u (sin a)))) 1 1))
              (loop (+ k 1)))))))

    (define (draw-flash-light x y age)
      (let ((u (/ age 60.0)))
        (when (< u 1.0)
          (light-disc! x y (+ 4.0 (* 40.0 u)) (* 0.4 (- 1.0 u)))
          (light-disc! x y (* 8.0 (- 1.0 u)) (* 0.5 (- 1.0 u))))))))
