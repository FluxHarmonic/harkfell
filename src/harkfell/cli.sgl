;;; (harkfell cli) - The content gates from the command line (native).
;;;
;;;   harkfell --room-check [--world DIR] [--parse-only] [--verbose] [REGION:X,Y ...]
;;;
;;; --parse-only stops before reach (gates 1 and 2 only): quick, and says so.
;;;
;;;   harkfell --room-check --path REGION:X,Y C,R [--have 2,3]
;;;
;;; (A3) The search runs once per carry set a player can hold ((harkfell
;;; check)); --have names the set whose graph --path walks (default: none).
;;; How the checker says a cell is reached: the shortest chain of accepted
;;; edges from the start to cell (C, R) of that room, each edge's witness as
;;; run-length input (R right, L left, U up, D down, J jump held, * the press;
;;; "30 R" is thirty ticks of right) and where the body came to rest. Every
;;; line is a witness that replayed.
;;;
;;; Reads the world (world/ by default), runs gates 1 to 3 of section 8
;;; (parse and legend, the region map, seams; then reach, over the whole
;;; world from its start), prints every problem as FILE:LINE: message, then
;;; the reach report of each room named (every room when none is), and a
;;; last line:
;;;
;;;   PASS room-check: N rooms, parse seams map reach green
;;;   FAIL room-check: N problems
;;;   SETUP-FAILED room-check: <why>
;;;
;;; Exit 0, 1 or 2 to match. Reach is skipped (and the run is a FAIL) when
;;; the earlier gates are red: a world that does not read has no geometry
;;; to search.

(define-library (harkfell cli)
  (import (sigil io)
          (sigil list)
          (sigil string)
          (sigil fs)
          (sigil time)
          (sigil math)
          (engine roomfile)
          (engine reach)
          (engine worldmap)
          (engine body)
          (harkfell feel)
          (harkfell content)
          (harkfell check)
          (harkfell source))

  (export room-check-main arg-value)

  (begin
    (define (say . parts) (display (apply string-append parts)) (newline))

    ;; The value after a flag in args, or #f.
    (define (arg-value args flag)
      (let ((m (member flag args)))
        (and m (pair? (cdr m)) (cadr m))))

    (define (now-s) (/ (* 1.0 (current-jiffy)) (jiffies-per-second)))

    (define (intent-code in)
      (let ((s (string-append (cond ((> (intent-h in) 0) "R") ((< (intent-h in) 0) "L") (else ""))
                              (cond ((< (intent-v in) 0) "U") ((> (intent-v in) 0) "D") (else ""))
                              (if (intent-jump in) "J" "")
                              (if (intent-press in) "*" ""))))
        (if (string=? s "") "-" s)))

    ;; list-tail is not bound in this Sigil (measured: unbound variable).
    (define (drop-n l n) (if (or (= n 0) (null? l)) l (drop-n (cdr l) (- n 1))))

    ;; A script as "N CODE, N CODE, ...".
    (define (script-rle script)
      (let loop ((s script) (acc '()))
        (if (null? s)
            (string-join (reverse acc) ", ")
            (let* ((c (intent-code (car s)))
                   (n (let count ((l s) (k 0)) (if (and (pair? l) (string=? (intent-code (car l)) c)) (count (cdr l) (+ k 1)) k))))
              (loop (drop-n s n) (cons (string-append (number->string n) " " c) acc))))))

    (define (cell-label ct cell)
      (let* ((wm (content-map ct))
             (p (worldmap-room wm (+ (worldmap-x0 wm) (exact (floor (/ (car cell) ROOM-COLS))))
                                  (+ (worldmap-y0 wm) (exact (floor (/ (cdr cell) ROOM-ROWS)))))))
        (if p
            (let ((l (global->local ct (placed-data p) cell)))
              (string-append (room-label (placed-data p)) " (" (number->string (car l)) "," (number->string (cdr l)) ")"))
            "outside")))

    ;; The chain of edges from the start to cell (breadth first).
    (define (print-path ct g target)
      (let* ((start (start-cell ct)))
        (let loop ((front (list start)) (parents (list (cons start #f))))
          (cond ((null? front) (say "no path from the start to " (cell-label ct target)))
                ((assoc target parents)
                 (let walk ((c target) (chain '()))
                   (let ((p (cdr (assoc c parents))))
                     (if (not p)
                         (for-each (lambda (e)
                                     (say "  " (cell-label ct (car e)) " -> " (cell-label ct (cadr e))
                                          ", " (number->string (length (witness-script (caddr e)))) " ticks"
                                          (if (> (witness-hops (caddr e)) 1)
                                              (string-append ", " (number->string (witness-hops (caddr e))) " hops")
                                              "")
                                          ":\n      " (script-rle (witness-script (caddr e)))))
                                   chain)
                         (walk (car p) (cons (list (car p) c (cdr p)) chain))))))
                (else
                 (let* ((c (car front))
                        (next (filter (lambda (e) (not (assoc (car e) parents))) (graph-edges-from g c))))
                   (loop (append (cdr front) (map car next))
                         (append parents (map (lambda (e) (cons (car e) (cons c (cdr e)))) next)))))))))

    (define (room-check-main args)
      (let* ((dir (or (arg-value args "--world") "world"))
             (keys (filter (lambda (a) (and (parse-room-key a) (not (equal? a dir)))) args)))
        (if (not (file-exists? (string-append dir "/world.sgl")))
            (begin (say "SETUP-FAILED room-check: no " dir "/world.sgl") 2)
            (let* ((t0 (now-s))
                   (ct (load-content (read-world-source dir)))
                   (ps (content-problems ct)))
              (say "world: " dir ", " (number->string (length (content-rooms ct))) " rooms")
              (for-each (lambda (p) (say (problem->string p))) ps)
              (cond
                ((not (null? ps))
                  (say "FAIL room-check: " (number->string (length ps)) " problems before reach (reach not run)")
                  1)
                ((member "--parse-only" args)
                  (say "PASS room-check --parse-only: " (number->string (length (content-rooms ct)))
                       " rooms, parse seams map green (reach NOT run)")
                  0)
                (else
                  (let* ((g (if (member "--verbose" args)
                                (content-reach ct (lambda (n steps kind cell)
                                                    (say "  anchor " (number->string n) " kind " (number->string kind)
                                                         " cell " (number->string (car cell)) "," (number->string (cdr cell))
                                                         " steps " (number->string steps) " t " (number->string (exact (round (- (now-s) t0)))))))
                                (content-reach ct)))
                         (t1 (now-s))
                         (rps (reach-problems ct g))
                         (rooms (map placed-data (content-rooms ct)))
                         (shown (if (null? keys)
                                    rooms
                                    (filter (lambda (rm) (member (room-label rm) keys)) rooms))))
                    (when g
                      (say "reach: " (reach-summary g) ", " (number->string (exact (round (- t1 t0)))) " s")
                      (when (member "--verbose" args)
                        (for-each (lambda (e)
                                    (say "  rejected by the replay: ("
                                         (number->string (caar e)) "," (number->string (cdar e)) ") -> ("
                                         (number->string (cadr e)) "," (number->string (cddr e)) ")"))
                                  (apply append (map (lambda (e) (graph-rejected (cdr e))) g)))))
                    (for-each (lambda (p) (say (problem->string p))) rps)
                    (let ((pk (arg-value args "--path"))
                          (pc (let ((m (member "--path" args))) (and m (pair? (cdr m)) (pair? (cddr m)) (caddr m)))))
                      (when (and g pk pc)
                        (let* ((k (parse-room-key pk))
                               (rm (and k (content-room ct (cadr k) (caddr k))))
                               (xy (map string->number (string-split pc ","))))
                          (if (and rm (= (length xy) 2) (car xy) (cadr xy))
                              (begin
                                (say "path to " pk " (" pc "):")
                                (let* ((hv (arg-value args "--have"))
                                       (carry (if hv (list-sort < (filter integer? (map string->number (string-split hv ",")))) '()))
                                       (e (assoc carry g)))
                                  (if e
                                      (print-path ct (cdr e) (local->global ct rm (car xy) (cadr xy)))
                                      (say "--have: no carry set " (carry-label carry) " is one a player can hold"))))
                              (say "--path: no room " pk " or no cell " pc)))))
                    (when (and g (not (member "--path" args)))
                      (for-each (lambda (rm)
                                  (newline)
                                  (for-each say (room-report ct g rm)))
                                shown))
                    (newline)
                    (if (null? rps)
                        (begin
                          (say "PASS room-check: " (number->string (length rooms)) " rooms, parse seams map reach green")
                          0)
                        (begin
                          (say "FAIL room-check: " (number->string (length rps)) " reach problems")
                          1)))))))))))
