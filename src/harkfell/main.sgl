;;; (harkfell main) - The entry, and the one seam between the two targets.
;;;
;;; The project's scaffold: the package, the build configs (native dev and
;;; release, the browser), the page and the serving scripts, with an entry
;;; that builds on both targets and does nothing yet. Phase A0 (movement)
;;; replaces it with the shells.

(define-library (harkfell main)
  (import (sigil io))

  (export main sigil-web-dispatch-event)

  (begin
    (define (main . args)
      (cond-expand
        (wasm 0)
        (else (display "harkfell: nothing to play yet") (newline) 0)))

    (define (sigil-web-dispatch-event type payload)
      0)))
