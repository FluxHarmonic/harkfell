;;; (engine stick) - A touch joystick's vector read as one of eight
;;; directions.
;;;
;;; The page tracks the finger and sends its offset from the ring's
;;; center in ring radii (dx right, dy DOWN, each -1..1, the length
;;; clamped to 1). This module turns that into a direction a platformer
;;; can use: none, or one of e ne n nw w sw s se, as (h . v) with -1, 0
;;; or 1 in each (v is screen-down positive, so up is -1).
;;;
;;; Tuned for clinging and wall jumping: the left and
;;; right sectors are the widest, so "hold toward the wall" does not slip
;;; into a diagonal (a climb) when the thumb wobbles:
;;;
;;;   e, w      60 degrees each (within 30 of horizontal)
;;;   n, s      50 degrees each (within 25 of vertical)
;;;   diagonals 35 degrees each
;;;
;;; Two kinds of hysteresis keep a thumb resting on a boundary from
;;; flickering between directions: the current sector is widened by 6
;;; degrees on each side before the others are asked (the WIDE and NARROW
;;; tangents below; change them together), and the
;;; dead zone engages below DEAD-OUT but lets go only below DEAD-IN.
;;;
;;; Angles are compared through tangents (|dy| < tan(a) * |dx|), so no
;;; trigonometry runs per event and every target computes the same
;;; answer.

(define-library (engine stick)
  (import (sigil math))

  (export stick-sector sector->hv
          DEAD-IN DEAD-OUT)

  (begin
    (define DEAD-IN 0.2)     ; below this the stick is at rest
    (define DEAD-OUT 0.28)   ; from rest, this far is needed to move

    ;; tan of 30, 36, 24 (the horizontal sectors' half-width: plain,
    ;; widened, narrowed) and of 25, 31, 19 (the vertical ones').
    (define TAN-H 0.57735)
    (define TAN-H-WIDE 0.72654)
    (define TAN-H-NARROW 0.44523)
    (define TAN-V 0.46631)
    (define TAN-V-WIDE 0.60086)
    (define TAN-V-NARROW 0.34433)

    (define (diagonal? s) (or (eq? s 'ne) (eq? s 'nw) (eq? s 'se) (eq? s 'sw)))
    (define (horizontal? s) (or (eq? s 'e) (eq? s 'w)))
    (define (vertical? s) (or (eq? s 'n) (eq? s 's)))

    ;; The sector for (dx, dy), given the sector in force before (prev).
    (define (stick-sector dx dy prev)
      (let ((m2 (+ (* dx dx) (* dy dy)))
            (dead (if (eq? prev 'none) DEAD-OUT DEAD-IN)))
        (if (< m2 (* dead dead))
            'none
            (let* ((ax (abs dx))
                   (ay (abs dy))
                   ;; the horizontal and vertical half-widths, widened for
                   ;; the sector in force and narrowed next to a diagonal
                   ;; in force (which widens the diagonal)
                   (th (cond ((horizontal? prev) TAN-H-WIDE)
                             ((diagonal? prev) TAN-H-NARROW)
                             (else TAN-H)))
                   (tv (cond ((vertical? prev) TAN-V-WIDE)
                             ((diagonal? prev) TAN-V-NARROW)
                             (else TAN-V))))
              (cond ((< ay (* th ax)) (if (> dx 0) 'e 'w))
                    ((< ax (* tv ay)) (if (> dy 0) 's 'n))
                    ((> dx 0) (if (> dy 0) 'se 'ne))
                    (else (if (> dy 0) 'sw 'nw)))))))

    (define (sector->hv s)
      (case s
        ((e) (cons 1 0))
        ((ne) (cons 1 -1))
        ((n) (cons 0 -1))
        ((nw) (cons -1 -1))
        ((w) (cons -1 0))
        ((sw) (cons -1 1))
        ((s) (cons 0 1))
        ((se) (cons 1 1))
        (else (cons 0 0))))))
