;;; Constructive routes on complete actual states. Spatial graphs suggest
;;; scripts only; accepted motion and waits have directed physical proofs.
(define-library (engine reach routes)
  (import (sigil list)
          (engine body) (engine air) (engine tilemap) (engine reach) (engine reach timed))

  (export timed-route-finder)

  (begin
    (define (still? node)
      (and node
           (let ((b (timed-node-body node)))
             (and (eq? (body-mode b) 'ground)
                  (= (body-vx b) 0) (= (body-vy b) 0)))))

    (define (last-node trace) (and (pair? trace) (car (reverse trace))))

    (define (distances graph target)
      (let* ((tm (graph-tm graph)) (n (* (tilemap-cols tm) (tilemap-rows tm)))
             (incoming (make-vector n '())) (dist (make-vector n #f)))
        (let fill ((i 0))
          (when (< i n)
            (for-each
              (lambda (edge)
                (vector-set! incoming (car edge)
                             (cons i (vector-ref incoming (car edge)))))
              (vector-ref (graph-edges graph) i))
            (fill (+ i 1))))
        (let loop ((front (list (cons (cell-index tm (car target) (cdr target)) 0)))
                   (back '()))
          (cond
            ((and (null? front) (null? back)) dist)
            ((null? front) (loop (reverse back) '()))
            (else
             (let* ((entry (car front)) (i (car entry)) (d (cdr entry)))
               (if (vector-ref dist i)
                   (loop (cdr front) back)
                   (begin
                     (vector-set! dist i d)
                     (loop (cdr front)
                           (append (map (lambda (j) (cons j (+ d 1)))
                                        (vector-ref incoming i)) back))))))))))

    ;; guides: actual node -> spatial candidate graph in that ability/carry.
    ;; wait: actual node, target phase -> (actual node . real elapsed ticks).
    ;; record! receives genuine safe catches and nonhazard terminal states.
    ;; incomplete! is called at a hard bound; callers must never report PASS.
    (define (timed-route-finder advance tiles-for f guides shelter? wait
                                bound record! incomplete! . reports)
      (let ((distance-cache '()) (invariant-rests #{}))
        (define (cell-of node)
          (and (still? node)
               (rest-cell (tiles-for (timed-node-data node)) f (timed-node-body node))))
        (define (distance-for graph target)
          (let ((prior (find (lambda (e) (and (eq? (car e) graph)
                                             (equal? (cadr e) target))) distance-cache)))
            (if prior (caddr prior)
                (let ((dist (distances graph target)))
                  (set! distance-cache (cons (list graph target dist) distance-cache))
                  dist))))
        (define (replay node script)
          (let run ((node node) (script script) (rev '()))
            (cond
              ((not node) (reverse (cons #f rev)))
              ((null? script)
               (let settle ((node node) (n 0) (rev (cons node rev)))
                 (cond
                   ((not node) (reverse rev))
                   ((or (still? node) (= n 180)) (reverse rev))
                   (else
                    (let ((next (advance node NO-INTENT)))
                      (settle next (+ n 1) (cons next rev)))))))
              (else
               (let ((next (advance node (car script))))
                 (if (and (timed-wait? node next) (not (shelter? node)))
                     (reverse (cons node rev))
                     (run next (cdr script) (cons node rev))))))))
        ;; Keys with tau removed describe poses for waiting certificates,
        ;; never simulated arrivals.
        ;; Hidden fields and product state must remain identical on every
        ;; real no-input tick before a waiting rest can share a continuation.
        (define (rotation-key node)
          (timed-key (timed-node node body: (body (timed-node-body node) tau: 0))))
        (define (invariant-rest? node)
          (and (still? node)
               (let ((key (rotation-key node)))
                 (if (dict-contains? invariant-rests key)
                     (dict-ref invariant-rests key)
                     (let ((proved
                             (and (shelter? node)
                                  (let loop ((node node) (left (* 2 AIR-PERIOD)))
                                    (if (= left 0)
                                        #t
                                        (let ((next (advance node NO-INTENT)))
                                          (and (timed-wait? node next)
                                               (equal? key (rotation-key next))
                                               (loop next (- left 1)))))))))
                       (set! invariant-rests (dict-set invariant-rests key proved))
                       proved)))))
        (define (remaining node target)
          (let ((cell (cell-of node)))
            (if cell
                (let* ((graph (guides node)) (tm (graph-tm graph))
                       (dist (distance-for graph target)))
                  (or (vector-ref dist (cell-index tm (car cell) (cdr cell))) 100000))
                100000)))
        (define (observe trace target)
          (for-each (lambda (node) (when (still? node) (record! node))) trace)
          (let* ((end (last-node trace))
                 (goal (if (and end (equal? (cell-of end) target))
                           end
                           (find (lambda (node)
                                   (and node (equal? (cell-of node) target)))
                                 trace))))
            (when (and end (not (still? end))) (record! end))
            ;; A suggestion can overshoot a real standing goal or fail after
            ;; reaching it. That safe prefix is a physical arrival in its own
            ;; right; requiring the whole suggested suffix would hide it.
            ;; Preserve the terminal arrival when it already meets the goal.
            (if goal
                (list goal)
                (let ((seen #{}) (choices '()))
                  ;; A composite can fail only after reaching a real place
                  ;; to wait. Resume from those prefixes, retaining their
                  ;; actual phase, body and acquisitions. Prefer the latest
                  ;; equivalent rest; replayed invariant cycles alone allow
                  ;; coalescing its earlier waiting poses.
                  (for-each
                    (lambda (node)
                      (when (and node (or (still? node) (eq? node end)))
                        (let ((key (if (invariant-rest? node)
                                       (cons 'cycle (rotation-key node))
                                       (cons 'actual (timed-key node)))))
                          (unless (dict-contains? seen key)
                            (set! seen (dict-set seen key #t))
                            (set! choices (cons node choices))))))
                    (reverse trace))
                  (list-sort (lambda (a b) (< (remaining a target) (remaining b target)))
                             (reverse choices))))))
        ;; Two fair priorities order the same complete actual states. Grid
        ;; distance exposes nearby physical continuations despite misleading
        ;; hints; frozen hops expose detours around actual walls and roofs.
        ;; Neither priority supplies a simulated arrival or an accepted edge.
        ;; Optional reports receive actual node, target, count, pending, depth.
        (define (report node target count pending depth)
          (when (and (pair? reports)
                     (or (= count 1) (= (modulo count 250) 0)))
            ((car reports) node target count pending depth)))
        (lambda (start target)
          (let ((queued #{}) (seen #{}) (count 0) (halted #f)
                (physical (vector (make-vector 64 #f) 0 2))
                (guided (vector (make-vector 64 #f) 0 5))
                (turn 'physical) (serial 0))
            (define (stop!)
              (unless halted
                (set! halted #t)
                (incomplete!)))
            (define (physical-distance node)
              (let ((cell (cell-of node)))
                (if cell
                    (+ (abs (- (car cell) (car target)))
                       (abs (- (cdr cell) (cdr target))))
                    100000)))
            (define (before? queue a b)
              (let ((score (vector-ref queue 2)))
                (or (< (vector-ref a score) (vector-ref b score))
                    (and (= (vector-ref a score) (vector-ref b score))
                         (or (< (vector-ref a 3) (vector-ref b 3))
                             (and (= (vector-ref a 3) (vector-ref b 3))
                                  (< (vector-ref a 4) (vector-ref b 4))))))))
            (define (push-entry! queue entry)
              (let ((heap (vector-ref queue 0)) (size (vector-ref queue 1)))
                (when (= size (vector-length heap))
                  (let ((larger (make-vector (* 2 size) #f)))
                    (let copy ((i 0))
                      (when (< i size)
                        (vector-set! larger i (vector-ref heap i))
                        (copy (+ i 1))))
                    (set! heap larger)
                    (vector-set! queue 0 heap)))
                (let rise ((i size))
                  (if (= i 0)
                      (vector-set! heap i entry)
                      (let* ((parent (quotient (- i 1) 2))
                             (above (vector-ref heap parent)))
                        (if (before? queue entry above)
                            (begin
                              (vector-set! heap i above)
                              (rise parent))
                            (vector-set! heap i entry)))))
                (vector-set! queue 1 (+ size 1))))
            (define (push! node depth)
              (let* ((key (timed-key node))
                     (prior (dict-ref queued key #f)))
                (unless (and prior (<= prior depth))
                  (cond
                    ;; The expansion bound also limits frontier memory. Overflow
                    ;; stays explicitly incomplete; it cannot supply a witness.
                    ((or (> depth 2048)
                         (>= (vector-ref physical 1) (* 8 (max 1 bound)))
                         (>= (vector-ref guided 1) (* 8 (max 1 bound))))
                     (stop!))
                    (else
                     (set! queued (dict-set queued key depth))
                     (let* ((distance (physical-distance node))
                            (entry (vector node depth (+ depth distance) distance serial
                                           (+ depth (remaining node target)))))
                       (set! serial (+ serial 1))
                       (push-entry! physical entry)
                       (push-entry! guided entry)))))))
            (define (pop! queue)
              (let* ((heap (vector-ref queue 0))
                     (size (- (vector-ref queue 1) 1))
                     (first (vector-ref heap 0))
                     (last (vector-ref heap size)))
                (vector-set! queue 1 size)
                (vector-set! heap size #f)
                (when (> size 0)
                  (let sink ((i 0))
                    (let ((left (+ (* 2 i) 1)))
                      (if (>= left size)
                          (vector-set! heap i last)
                          (let* ((right (+ left 1))
                                 (child (if (and (< right size)
                                                 (before? queue (vector-ref heap right)
                                                          (vector-ref heap left)))
                                            right left))
                                 (below (vector-ref heap child)))
                            (if (before? queue below last)
                                (begin
                                  (vector-set! heap i below)
                                  (sink child))
                                (vector-set! heap i last)))))))
                first))
            (define (resume nodes depth eligible?)
              (let loop ((nodes nodes))
                (and (not halted) (pair? nodes)
                     (let ((next (car nodes)))
                       (cond
                         ((equal? (cell-of next) target) next)
                         (else
                          (when (eligible? next) (push! next depth))
                          (loop (cdr nodes))))))))
            (define (expand node depth)
              (let ((cell (cell-of node)))
                (if (not cell)
                    (let recover
                      ((scripts
                        (cons (make-list 360 NO-INTENT)
                          (append
                            (apply append
                              (map (lambda (h)
                                     (map (lambda (held)
                                            (append
                                              (if held (list (intent h: h jump: #t press: #t)) '())
                                              (make-list 120 (intent h: h jump: held))
                                              (make-list 180 NO-INTENT)))
                                          '(#f #t))) '(-1 1)))
                            (map (lambda (v)
                                   (append (make-list 120 (intent v: v))
                                           (make-list 180 NO-INTENT))) '(-1 1))))))
                      (and (not halted) (pair? scripts)
                           (or (resume (observe (replay node (car scripts)) target)
                                       (+ depth 1) still?)
                               (recover (cdr scripts)))))
                    (let* ((graph (guides node)) (tm (graph-tm graph))
                           (dist (distance-for graph target))
                           (edges
                             (list-sort
                               (lambda (a b)
                                 (< (or (vector-ref dist (cell-index tm (caar a) (cdar a)))
                                        100000)
                                    (or (vector-ref dist (cell-index tm (caar b) (cdar b)))
                                        100000)))
                               (graph-edges-from graph cell))))
                      (let try ((edges edges))
                        (and (not halted) (pair? edges)
                             (or
                               (let depart ((phases (list 'actual AIR-GUST 0)))
                                 (and (not halted) (pair? phases)
                                      (or
                                        (let* ((proof (and (not (eq? (car phases) 'actual))
                                                           (wait node (car phases))))
                                               (stage (if (eq? (car phases) 'actual) node
                                                          (and proof (car proof)))))
                                          (and stage
                                               (resume
                                                 (observe (replay stage (witness-script (cdar edges))) target)
                                                 (+ depth 1)
                                                 (lambda (end)
                                                   ;; Repositioning and hidden body changes
                                                   ;; are genuine progress even within this
                                                   ;; cell. Frozen labels never rule them out.
                                                   ;; Clock-only changes continue unless a real
                                                   ;; invariant waiting cycle covers that phase.
                                                   (and (cell-of end)
                                                        (not (or (equal? (timed-key node) (timed-key end))
                                                                 (and (equal? (rotation-key node)
                                                                              (rotation-key end))
                                                                      (invariant-rest? node)))))))))
                                        (depart (cdr phases)))))
                               (try (cdr edges)))))))))
            (if (equal? (cell-of start) target)
                start
                (begin
                  (push! start 0)
                  (let search ()
                    (and (not halted)
                         (or (> (vector-ref physical 1) 0) (> (vector-ref guided 1) 0))
                         (let* ((preferred (if (eq? turn 'physical) physical guided))
                                (other (if (eq? turn 'physical) guided physical))
                                (queue (if (> (vector-ref preferred 1) 0) preferred other))
                                (entry (pop! queue))
                                (node (vector-ref entry 0))
                                (depth (vector-ref entry 1))
                                (key (timed-key node)))
                           (cond
                             ((< (dict-ref queued key) depth) (search))
                             ((and (dict-contains? seen key)
                                   (<= (dict-ref seen key) depth)) (search))
                             ((>= count bound) (stop!) #f)
                             (else
                              (set! seen (dict-set seen key depth))
                              (set! count (+ count 1))
                              ;; Stale duplicate entries cost no expansion. Switch
                              ;; priorities only after a genuine state expansion.
                              (set! turn (if (eq? turn 'physical) 'guided 'physical))
                              (report node target count
                                      (+ (vector-ref physical 1) (vector-ref guided 1)) depth)
                              (or (expand node depth) (search)))))))))))))))
