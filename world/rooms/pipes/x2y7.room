  light: 0.33
  grid:
  ("#########################"
   "######      ##    #######"
   "####        ##      #####"
   "###         ##       ####"
   "##          ##        ###"
   "#   |                   #"
   "#   ||                |  "
   "    ||                || "
   "    ||    ##~~##      || "
   "##################%  %###"
   "##################%  %###")
  things: ((lantern-moth at: (7 3) count: 3 drawn: 3))
  moment: (tune: three-echoes still: 8)
  decor: auto)
