   "#####         |||       #"
   "    #         |||        "
   "    o         |||        "
   "#########%  %############"
   "#########%  %############")
  things: ((lantern-moth at: (8 4) count: 3 drawn: 3)
           (ring-stone at: (4 8) overtone: 4))
  decor: auto)
