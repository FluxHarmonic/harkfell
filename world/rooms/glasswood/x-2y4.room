;; world/rooms/glasswood/x-2y4.room
(room
  region: glasswood
  at: (-2 4)
  title: "Owl's Watch"
  intent: "a snow owl on a high branch turns its head to follow you: a breath at the foot of the branches"
  bed: (wind 0.4 water 0.1 hum 0.2 drone 0.4)
  grid:
  ("### |     |      |     ##"
   "### |=====|      |     ##"
   "### |     |      |     ##"
   "### |     |      |     ##"
   "### |=====|      |       "
   "    |     |     ===      "
   "    |     |      |       "
   "   #########     |       "
   "#########################"
   "#########################"
   "#########################")
  things: ((snow-owl at: (17 4)) (snow-vole at: (21 7)))
  decor: auto)
;; The foot of the Branch Stair: two birches (columns 4 and 10) with rungs
;; at rows 4 and 1, and on up through the Branch Stair's (a held jump each,
;; rung to rung). The owl watches from its branch (17,5); a vole in the
;; snow (21,7). H3's tone first reaches here, faint, from the west.
