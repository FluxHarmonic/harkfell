;; world/rooms/glasswood/x-3y3.room
(room
  region: glasswood
  at: (-3 3)
  title: "The Crowns"
  intent: "the tops of the wood under the whole sky, every twig in glass and clinking in the wind: a breath"
  bed: (wind 0.9 water 0.0 hum 0.1 drone 0.3)
  grid:
  ("       |     |     |     "
   "       |     |     |     "
   "       |     |     |     "
   "       |     |     |     "
   "       |     |     |     "
   "       |    ====   |     "
   "###  =====   |   ==== ###"
   "###    |     |     |  ###"
   "###    |     |     |  ###"
   "#########################"
   "#########################")
  things: ((snow-owl at: (13 4)))
  decor: auto)
;; The tops of three birches (columns 7, 13, 19), their crowns of glazed
;; branches at different heights between two pillars of rock (columns 0-2
;; and 22-24) level with the Branch Stair and the Crown Gap. Hops of one and
;; two tiles from crown to crown; the owl sits on the highest (13,4). A miss
;; lands on the rock bed under the wood (row 8), a held jump from the
;; crowns and the pillars. A breath under the whole sky. Nothing joins it
;; below (the Icicle Gallery's overhang).
