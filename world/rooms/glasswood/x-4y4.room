;; world/rooms/glasswood/x-4y4.room
(room
  region: glasswood
  at: (-4 4)
  title: "The Frozen Tarn"
  intent: "a tarn frozen clear as glass, with stones the old people sank lying under the ice: stand still and it sings"
  bed: (wind 0.3 water 0.3 chimes 0.45 drone 0.5)
  grid:
  ("     |             |    #"
   "     |             |    #"
   "     |             |    #"
   "     |             |    #"
   "     |             |    #"
   "     |             |     "
   "     |             |     "
   "     |             | ### "
   "#########################"
   "#######~~~~~~~~~~~#######"
   "###%%%###################")
  moment: (tune: singing-ice when: first-visit still: 8)
  decor: auto)
;; The tarn, glass over dark water, between two birches on its shores;
;; open above to the Crown Gap (a miss lands here). Its moment,
;; singing-ice (still: 8): stand on the ice and it sings.
