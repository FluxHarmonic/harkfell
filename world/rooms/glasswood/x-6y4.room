;; world/rooms/glasswood/x-6y4.room
(room
  region: glasswood
  at: (-6 4)
  title: "Behind the Fall"
  intent: "a hollow behind the frozen curtain that a careful eye finds, where one icicle grows upward and hums a note no stone has"
  bed: (wind 0.0 water 0.2 hum 0.5 drone 0.8)
  light: 0.7
  grid:
  ("#########################"
   "#########################"
   "############      #######"
   "#########           #####"
   "########             ####"
   "#######                  "
   "#######                  "
   "#######                  "
   "#########################"
   "#########################"
   "#########################")
  decor: auto)
;; Through the false wall in the Frozen Fall's curtain (its columns 0-3,
;; rows 5-7): a hollow in the rock at the blue hour. THE SECRET (D43) IS
;; NOT HERE YET: the upward icicle humming H7, faintly violet, needs
;; SYSTEMS' (upward-icicle at: (C R)) thing, which is not built. Its place
;; is (13,7), on the floor in the middle of the hollow; LOOK's frame is
;; glasswood/upward-icicle@h7.
