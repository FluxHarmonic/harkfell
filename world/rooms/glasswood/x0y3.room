;; world/rooms/glasswood/x0y3.room
(room
  region: glasswood
  at: (0 3)
  title: "The Scree"
  intent: "through the old stone door, scree falls away west into mist, and the birches glitter far below"
  bed: (wind 0.8 water 0.1 chimes 0.6)
  grid:
  ("                        #"
   "                        #"
   "                        #"
   "                        #"
   "                        #"
   "                        #"
   "%%%%%%%%%% %%%%%%%%%    #"
   "%%%%%%%%%%        %%    #"
   "%%%%%%%%%%        %%    #"
   "%%%%%%%%%%               "
   "%%%%%%%%%%          #####")
  decor: auto)
;; The door from Scree End comes in at the bottom right (24,9) onto a
;; ledge (columns 20-24). West of it the scree falls away (columns 10-19)
;; into the Scree Foot below. Over the fall a rib of rimed rock (row 6)
;; runs from the ledge's rough end (columns 18-19, climbed from the ledge)
;; west to the scree's shoulder (columns 0-9), which runs on into First
;; Sight. The shoulder's rough east face (column 9) is the climb back up
;; from the Scree Foot, with a hop over the slot at column 10.
