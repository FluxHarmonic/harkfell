;; world/rooms/glasswood/x0y4.room
(room
  region: glasswood
  at: (0 4)
  title: "Scree Foot"
  intent: "the foot of the scree, where the ground opens into the dark: the first dark, before you have a light"
  bed: (wind 0.4 water 0.2 chimes 0.3 drone 0.5)
  grid:
  ("%%%%%%%%%%          #####"
   "%%%%%%%%%%    |     #####"
   "%%%%%%%%%%    |     #####"
   "%%%%%%%%%%    |     #####"
   "%%%%%%%%%%    |     #####"
   "              |     #####"
   "              |     #####"
   "           ## |     #####"
   "###%%%%########%    %####"
   "###############%    %####"
   "###############%    %####")
  decor: auto)
;; Under the scree's shoulder (its rough face, column 9, is the climb back
;; up to the Scree). Where you drop from the Scree's ledge the floor opens
;; (columns 16-19) into the Cave Mouth's dark: the dark before H3 is on the
;; way in. The rough walls of the hole (15 and 20) are the way back up, and
;; the way home from the caves. West under the scree to the Icicle Walk.
