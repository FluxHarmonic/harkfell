;; world/rooms/glasswood/x-3y4.room
(room
  region: glasswood
  at: (-3 4)
  title: "Icicle Gallery"
  intent: "a long overhang hung with icicles: listen for each one, wait, and go"
  bed: (wind 0.3 water 0.1 chimes 0.45 drone 0.5)
  grid:
  ("#########################"
   "#########################"
   "#########################"
   "#########################"
   "#                       #"
   "                         "
   "                         "
   "                         "
   "######   ######   #######"
   "######   ######   #######"
   "#########################")
  things: ((icicle at: (2 4)) (icicle at: (11 4)) (icicle at: (20 4)))
  decor: auto)
;; Under the Crowns' ridge: a long low overhang with three icicles and two
;; pits between them (columns 6-8 and 15-17, two deep). Each pit is taken
;; at a run; the icicle past it (columns 11 and 2, three tiles on from the
;; far lip) rings as you land, so you commit to the jump and then brake. The
;; third (20) rings as you come in from the Owl's Watch: stop, let it fall,
;; go. A missed jump is a climb out of the pit.
