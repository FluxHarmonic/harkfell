  ("###  %###################"
   "###  %###################"
   "###  %##  ###      ##   #"
   "###  %     #             "
   "###  %                   "
   "     %          %########"
   "     %          %########"
   "                %########"
   "  |      |  ||  %########"
   "  ||    ||| ||| %########"
   "#########################")
  things: ((fen-vole at: (12 9))
           (firefly at: (14 6) count: 3 drawn: 2))
  decor: auto)
