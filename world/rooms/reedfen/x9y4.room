;; world/rooms/reedfen/x9y4.room
(room
  region: reedfen
  at: (9 4)
  title: "Drowned Channel"
  intent: "too wide to jump: the first swim, bank to bank"
  bed: (wind 0.1 water 0.9)
  grid:
  ("#########################"
   "#########################"
   "#########################"
   "##  ##  ####   ##  ######"
   "#        ##          ## #"
   "                         "
   "                         "
   "     ||            |     "
   "    ####~~~~~~~~####     "
   "  ||####~~~~~~~~####||   "
   "#########################")
  things: ((pike at: (11 9)))
  decor: auto)
;; Eight tiles of still water between two banks; a jump reaches three.
;; Swim, and leap out when your head is above the surface.
;; A3 put H2 on the east bank; A4 moved it to the Far Mound (x17y3), the
;; fen's far end, as the design has it.
