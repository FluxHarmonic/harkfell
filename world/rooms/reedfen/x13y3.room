  intent: "a round pool ringed by bellfrogs: the choir's room"
  bed: (wind 0.4 water 0.7 reeds 0.4)
  grid:
  ("                         "
   "                         "
   "                         "
   "                         "
   "                         "
   "                         "
   "  |  ||               |  "
   " ||||||    |      | |||  "
   "########~~~###~~~########"
   "########~~~###~~~########"
   "#########################")
  things: ((bellfrog at: (5 7))
           (bellfrog at: (7 7))
           (bellfrog at: (12 7))
           (bellfrog at: (18 7)))
  moment: (tune: frog-choir when: first-visit still: 6)
  decor: auto)
