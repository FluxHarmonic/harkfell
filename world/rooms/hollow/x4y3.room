;; world/rooms/hollow/x4y3.room
(room
  region: hollow
  at: (4 3)
  title: "The Hollow"
  intent: "where you wake: a bowl of turf over a low hum, and a mute stone at its heart"
  bed: (wind 0.3 water 0.1 hum 1.0 drone 0.7)
  sun: 0.35
  grid:
  ("                         "
   "                         "
   "                         "
   "                         "
   "  #                   #  "
   " |#|               ##### "
   "##### |           |# o##%"
   "#######         ########%"
   "#########       o    o o%"
   "#########################"
   "#########################")
  things: ((ring-stone at: (16 8) overtone: 2)
           (ring-stone at: (21 8) overtone: 3)
           (ring-stone at: (23 8) overtone: 4)
           (ring-stone at: (21 6) overtone: 5)
           (stone-passage at: (23 8) cells: ((23 7) (23 6) (22 6)))
           (standing-stone at: (2 5))
           (standing-stone at: (22 5))
           (lantern-moth at: (18 6) count: 3 drawn: 3)
           (lantern-moth at: (11 5) count: 4 drawn: 2))
  moment: ((tune: hollow-answers when: first-visit carrying: 2)
           (tune: hollow-fifth when: first-visit carrying: 3)
           (tune: hollow-octave when: first-visit carrying: 4)
           (tune: hollow-third when: first-visit carrying: 5))
  unreached: ((20 6))
  decor: auto)
;; Existing amber, green and blue identities stay fixed. Blue reveals only
;; the interior rough stair to rose; the eastern and southern seams stay shut.
;; The small pocket beyond H5 is reserved and explicitly unreachable in 0.3.
