;; world/rooms/hollow/x2y3.room
(room
  region: hollow
  at: (2 3)
  title: "The Old Cut"
  intent: "a doorway the old people cut into the fell, blocked by fallen rock, and the wind sounding a note inside: the way to the Pipes, heard and not yet"
  bed: (wind 0.4 hum 0.3 drone 0.3)
  light: 1
  sun: 1
  grid:
  ("#           %############"
   "            %############"
   "            %############"
   "            %############"
   "            %############"
   "   #####    %############"
   "   #####                 "
   " |#   o |     |     | |  "
   "##%  %###################"
   "##%  %###################"
   "##%  %###################")
  things: ((ring-stone at: (6 7) overtone: 2))
  decor: auto)
;; Amber seals the entire one-cell approach under the cut roof. The shaft
;; inside has rough return faces and a standing bank west of the door.
