;; world/rooms/hollow/x7y2.room
(room
  region: hollow
  at: (7 2)
  title: "Updraft Edge"
  intent: "seeds rising past the fell's edge higher than any jump: the way to Cloudstair, shown and not yet"
  bed: (wind 0.9 drone 0.3)
  light: 1
  sun: 1
  grid:
  ("########^^^##############"
   "      # ^^^             #"
   "      ##^^^             #"
   "      o ^^^             #"
   "####### ^^^             #"
   "####### ^^^             #"
   "####### ^^^             #"
   "#######=======          #"
   "#########################"
   "####### ^^^             #"
   "####### ^^^             #")
  things: ((ring-stone at: (6 3) overtone: 4)
           (air-field at: (8 0) size: (3 8) kind: steady-lift))
  decor: auto)
;; Blue seals the only approach. Its roof and the pocket floor separate
;; this lift from the Rim. The return shelf is seven tiles below the north
;; seam: a normal jump plus one smooth-wall kick cannot cross it.
