;; Two four-tile gaps (3-6, 12-15) with the deep drop under each, the gust
;; over each, and a five-tile rest between. J's steady lift (21-23) lands
;; on the east bank, out of the wind.
(room
  region: cloudstair
  at: (12 -1)
  title: "The Open Crossing"
  intent: "eastward gusts cross two exposed breaks, with a sheltered rest between their drifts"
  bed: (wind 0.9 water 0 air 0.5 drone 0.3)
  light: 1
  sun: 1
  grid:
  ("#########################"
   "######             ######"
   "###                  ####"
   "#                       #"
   "#                    ^^^#"
   "                     ^^^#"
   "                     ^^^#"
   " |      | |      | | ^^^#"
   "###    #####    #####^^^#"
   "###    #####    #####^^^#"
   "###xxxx#####xxxx#####^^^#")
  things: ((air-field at: (3 1) size: (4 8) kind: east-gust)
           (air-field at: (12 1) size: (4 8) kind: east-gust))
  decor: auto)
