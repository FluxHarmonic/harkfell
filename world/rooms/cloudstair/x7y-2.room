;; K's steady lift comes up in columns 4-6. Open sky above. West of it the
;; homeward shaft (columns 2-3, D50, beside a cliff two tiles thick) drops
;; to K's rose stone and home; with H5 the arch's wind carries a glider
;; over the lift to it.
(room
  region: cloudstair
  at: (7 -2)
  title: "The Last Grass"
  intent: "the last grass faces a sky larger than the fell beneath it: a breath"
  bed: (wind 0.8 water 0 air 0.5 drone 0.3)
  light: 1
  sun: 1
  grid:
  ("##                       "
   "##                       "
   "##                       "
   "##                       "
   "##                       "
   "##  ^^^                  "
   "##  ^^^                  "
   "##  ^^^       | |        "
   "##  ^^^      ####        "
   "##  ^^^ |  ########  | | "
   "##  ^^^##################")
  things: ((reedling flock: 5 zone: reeds)
           ;; the homeward wind on from the arch (D50), above the lift's seeds,
           ;; blowing only while the arch's rose stone is open (R 12,7)
           (air-field at: (4 1) size: (21 4) kind: homeward gate: (37 7)))
  moment: (tune: the-last-grass when: first-visit)
  decor: auto)
