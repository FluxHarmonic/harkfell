;;; world/world.sgl - The world bible's data (harkfell-design section 8).
;;;
;;; Read by the game and by the content gates (scripts/room-check). The
;;; prose half is BIBLE.md; each region's rooms and intents are laid out in
;;; regions/<region>.map before any room exists.
;;;
;;; A1's mini bible: one region, Reedfen, with a placeholder palette. The
;;; gating graph, the hush and the other regions come with the phases that
;;; need them.

;; Where the game begins: the region, the room, the cell (column, row) the
;; body stands in. A4: the bottom of the Hollow's bowl, beside the stone
;; (the design's section 4: you wake over the hum).
(start region: hollow room: (4 3) cell: (15 8))

;; The world palette: (role "#rrggbb" note). A4's palettes (the look track;
;; (harkfell palette) explains the slots). A region lists exactly sixteen
;; roles in SLOT order in its palette:, sky-1..4 ground-1..4 leaf-1..3 water
;; accent fur-1 fur-2 ink; the last three are the player's and the same in
;; every region. Low saturation, one warm accent per region (section 7).
(palette
  ;; Reedfen: low, wide, wet; the sky is most of the screen
  (fen-sky-1 "#7b92a1" "high sky, grey-blue")
  (fen-sky-2 "#99adb4" "middle sky; far hills")
  (fen-sky-3 "#b9c7c2" "low sky")
  (fen-sky-4 "#d8dbcb" "the horizon, a little warm; mist; the water's skin")
  (fen-peat-1 "#2c2b27" "deep peat, shadow")
  (fen-peat-2 "#4a453b" "peat")
  (fen-peat-3 "#6c6552" "mud, old stone")
  (fen-peat-4 "#968e76" "lit stone, dry mud")
  (fen-reed-1 "#4d5a3d" "reeds in shade")
  (fen-reed-2 "#75794b" "reeds")
  (fen-reed-3 "#aea267" "seed heads, lit blades")
  (fen-water "#46616b" "still water")
  (fen-brack "#b9754a" "Reedfen's one warm accent: the brackish water")
  ;; the Hollow: a meadow ring of mute stones round a shallow bowl, at dawn
  (hol-sky-1 "#65718e" "high sky, slate")
  (hol-sky-2 "#9298ad" "middle sky; far fells")
  (hol-sky-3 "#c6b7b2" "low sky, rose-grey")
  (hol-sky-4 "#e8d1ac" "dawn at the horizon")
  (hol-stone-1 "#2d2b2c" "shadow")
  (hol-stone-2 "#4d4a48" "limestone in shade")
  (hol-stone-3 "#767470" "limestone")
  (hol-stone-4 "#a7a59b" "limestone lit")
  (hol-turf-1 "#435234" "turf in shade")
  (hol-turf-2 "#66763f" "turf")
  (hol-turf-3 "#9aa25e" "grass lit")
  (hol-tarn "#465a6b" "the tarn")
  (hol-bracken "#b0643a" "the Hollow's one warm accent: bracken")
  ;; Glasswood: a birch wood the morning after an ice storm, every twig
  ;; cased in clear ice; a low winter sun at the wood's edge. NO GREEN in
  ;; these sixteen (the bible: H3's pale green is the only green on screen;
  ;; test/test-art.sgl checks each role's hue)
  (glw-sky-1 "#586c8e" "high sky, slate blue")
  (glw-sky-2 "#8497b3" "middle sky; the far wood")
  (glw-sky-3 "#b7c1d0" "low sky, pale")
  (glw-sky-4 "#e9dccb" "a warm haze at the horizon; mist")
  (glw-ice-1 "#1c2130" "blue-black shadow")
  (glw-ice-2 "#44587a" "ice in shade, snow in shadow")
  (glw-ice-3 "#8ba3c2" "ice and glazed rock")
  (glw-ice-4 "#e8eef6" "lit snow")
  (glw-birch-1 "#27242a" "birch marks, near black")
  (glw-birch-2 "#8c8790" "bark in shade")
  (glw-birch-3 "#f2e8da" "bark lit, warm white")
  (glw-melt "#2f5f8f" "blue ice and dark meltwater")
  (glw-copper "#cc7f45" "the low sun: Glasswood's one warm accent")
  ;; Pipes: warm dry chalk, black wet joints, cream lips and ochre stains.
  ;; Slots 0..3 are the distant cave wall; 8..10 are hanging limestone.
  (pip-wall-1 "#25221f" "distant wet limestone")
  (pip-wall-2 "#3c3730" "distant pipe shadows")
  (pip-wall-3 "#625a4d" "distant dry chalk")
  (pip-wall-4 "#d8cdb4" "neutral cream light and far lips")
  (pip-stone-1 "#191817" "near-black wet joints")
  (pip-stone-2 "#514b42" "limestone in shade")
  (pip-stone-3 "#958b78" "dry chalk and carved walls")
  (pip-stone-4 "#e5dbc5" "cream edges and static hairs")
  (pip-curtain-1 "#302c26" "hanging pipes in shadow")
  (pip-curtain-2 "#716655" "hanging stone")
  (pip-curtain-3 "#b4a58a" "hanging pipe lips")
  (pip-seep "#777974" "ordinary clear seep, without harmonic blue")
  (pip-ochre "#b17d45" "the Pipes' one warm accent: ochre stains")
  ;; Cloudstair: pale cliffs in a large sky, dry grass and cream seeds; the
  ;; slow cloud below the crags takes the water slot. The warm accent is
  ;; sunlight on the grass; rose stays H5's alone.
  (cld-sky-1 "#6f88a6" "high sky, clear grey-blue")
  (cld-sky-2 "#98aec4" "middle sky; the far cliffs")
  (cld-sky-3 "#c4d0da" "low sky, cloud in shadow")
  (cld-sky-4 "#eceee6" "cloud tops in sun")
  (cld-stone-1 "#2c3036" "shadow under the shelves")
  (cld-stone-2 "#575c64" "cliff stone in shade")
  (cld-stone-3 "#8f938f" "pale cliff stone")
  (cld-stone-4 "#cfcdc2" "lit stone edges")
  (cld-grass-1 "#565a43" "dry grass in shade")
  (cld-grass-2 "#8a875b" "dry grass")
  (cld-grass-3 "#c6bb8b" "lit grass heads, the seeds' cream")
  (cld-cloud "#b0bfce" "the slow cloud below the crags")
  (cld-sun "#dcae5c" "Cloudstair's one warm accent: sunlight on the grass")
  ;; the player, the same everywhere
  (fur-1 "#ede5d3" "the creature's fur")
  (fur-2 "#b8ab95" "its fur in shade")
  (ink "#26252b" "its eye")
  ;; A3: each harmonic has one colour, used everywhere (section 3, "How the
  ;; player learns a gate"): the glyph on a ring-stone, the harmonic when you
  ;; find it, the moths drawn to it. World-wide roles, not a region's.
  (h2 "#eaa648" "H2, amber")
  (h3 "#b4dc9a" "H3, pale green")
  (h4 "#8fb4e6" "H4, cold blue")
  (h5 "#e6a0b4" "H5, rose")
  (h7 "#a47ce0" "H7, a violet no region uses")
  (black "#000000" "fades"))

;; The Hollow (A4): the start, a bowl on the fell above the fen; seven rooms
;; wide and two high, west of Reedfen (topics/harkfell-a4-region-maps). It
;; gives nothing: it holds the first gate (the bowl's H2 stone) and the way
;; down (the H3 stone under it), and shows the ways on. PLACEHOLDER palette
;; roles until the look track's hol-* roles are merged.
(region hollow
  name: "The Hollow"
  bounds: ((1 2) (7 3))
  bed: "hollow-bed"
  bed-channels: (wind water hum drone)
  mode: ionian
  palette: (hol-sky-1 hol-sky-2 hol-sky-3 hol-sky-4 hol-stone-1 hol-stone-2 hol-stone-3 hol-stone-4
            hol-turf-1 hol-turf-2 hol-turf-3 hol-tarn hol-bracken fur-1 fur-2 ink)
  tiles: hollow
  roster: (reedling lantern-moth)
  moments: (high-fell hollow-answers hollow-fifth hollow-octave)
  wander: (stones-remember)
  gives: ())

;; Glasswood (0.2, topics/harkfell-glasswood-bible and -map, D41-D46): a
;; birch wood caught by an ice storm, west of the Hollow and lower, at
;; negative x. You come down into it through the old amber door at Scree
;; End (H2); H3 lies in the Old Birch at its far west corner. PHASE 1 holds
;; only the negative-coordinates probe (The Scree, First Sight), and LOOK's
;; dark look probe (Root Ice). The palette and tiles are the look track's
;; (glw-*, assets/art/glasswood.txt). The sound is the sound track's
;; (2026-09-28): glasswood-bed, channel 3 the glazed twigs clinking; the
;; three moments here, hollow-fifth in the Hollow, and two wandering ones.
(region glasswood
  name: "Glasswood"
  bounds: ((-6 3) (0 6))
  overtone: 3
  bed: "glasswood-bed"
  bed-channels: (wind water chimes drone)
  mode: lydian
  palette: (glw-sky-1 glw-sky-2 glw-sky-3 glw-sky-4 glw-ice-1 glw-ice-2 glw-ice-3 glw-ice-4
            glw-birch-1 glw-birch-2 glw-birch-3 glw-melt glw-copper fur-1 fur-2 ink)
  tiles: glasswood
  roster: (lantern-moth snow-owl snow-vole)
  moments: (the-ice-rings singing-ice blue-hall)
  wander: (glaze-wind under-ice)
  gives: ((overtone 3)))

(region reedfen
  name: "Reedfen"
  bounds: ((8 3) (17 5))
  overtone: 2
  bed: "reedfen-bed"
  bed-channels: (wind water reeds drone)
  mode: dorian
  palette: (fen-sky-1 fen-sky-2 fen-sky-3 fen-sky-4 fen-peat-1 fen-peat-2 fen-peat-3 fen-peat-4
            fen-reed-1 fen-reed-2 fen-reed-3 fen-water fen-brack fur-1 fur-2 ink)
  hazard: brackish
  tiles: reedfen
  roster: (reedling bellfrog firefly fen-vole pike heron-shape)
  moments: (first-open-water frog-choir drowned-bell)
  wander: (seed-wind)
  gives: ((overtone 2) (ability down)))

;; The creatures (section 6): a behaviour kind each. A3 brings the first
;; three to life ((harkfell creatures)); the rest are placed but not drawn.
;; A lantern moth is drawn to a harmonic: the room names which (drawn: N),
;; Glasswood’s moths follow H3; Reedfen’s silent fireflies follow H2.
(creature reedling behaviour: flock)
(creature bellfrog behaviour: hop)
(creature lantern-moth behaviour: follow)
(creature firefly behaviour: follow)
(creature fen-vole behaviour: burrow)
(creature pike behaviour: swim)
(creature heron-shape behaviour: giant)
(creature snow-owl behaviour: perch)
(creature snow-vole behaviour: burrow)
(creature stone-snail behaviour: walk)

;; Pipes: carved limestone beneath the Hollow.
(region pipes
  name: "The Pipes"
  bounds: ((1 4) (6 8))
  overtone: 4
  bed: "pipes-bed"
  bed-channels: (wind water pipes drone)
  mode: aeolian
  palette: (pip-wall-1 pip-wall-2 pip-wall-3 pip-wall-4
            pip-stone-1 pip-stone-2 pip-stone-3 pip-stone-4
            pip-curtain-1 pip-curtain-2 pip-curtain-3 pip-seep pip-ochre fur-1 fur-2 ink)
  tiles: pipes
  roster: (lantern-moth stone-snail)
  moments: (wind-in-stone three-echoes the-pipes-breathe)
  wander: (air-below seep-song)
  gives: ((overtone 4)))
;; Cloudstair (0.4, topics/harkfell-cloudstair-bible and -map): pale cliffs
;; and shelves above the Hollow's Updraft Edge, reached on the launch lift
;; behind its blue stone with the cattail down; H5 on the still crag at V.
;; The bed, its moments and wandering pieces are SOUND's; until they land
;; the region has no bed (the director plays none) and no moments.
(region cloudstair
  name: "Cloudstair"
  bounds: ((7 -2) (12 1))
  overtone: 5
  bed-channels: (wind water air drone)
  mode: mixolydian
  palette: (cld-sky-1 cld-sky-2 cld-sky-3 cld-sky-4
            cld-stone-1 cld-stone-2 cld-stone-3 cld-stone-4
            cld-grass-1 cld-grass-2 cld-grass-3 cld-cloud cld-sun fur-1 fur-2 ink)
  hazard: gap
  tiles: cloudstair
  roster: (seed reedling)
  moments: ()
  wander: ()
  gives: ((overtone 5)))
;; Seeds: small tufted seeds that drift in the lifts, rise with the gust and
;; settle in shelter. Never a platform, never harmful.
(creature seed behaviour: drift)
