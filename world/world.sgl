;;; world/world.sgl - The world bible's data (harkfell-design section 8).
;;;
;;; Read by the game and by the content gates (scripts/room-check). The
;;; prose half is BIBLE.md; each region's rooms and intents are laid out in
;;; regions/<region>.map before any room exists.
;;;
;;; A1's mini bible: one region, Reedfen, with a placeholder palette. The
;;; gating graph, the hush and the other regions come with the phases that
;;; need them.

;; Where the game begins: the region, the room, the cell (column, row) the
;; body stands in. A4: the bottom of the Hollow's bowl, beside the stone
;; (the design's section 4: you wake over the hum).
(start region: hollow room: (4 3) cell: (15 8))

;; The world palette: (role "#rrggbb" note). A4's palettes (the look track;
;; (harkfell palette) explains the slots). A region lists exactly sixteen
;; roles in SLOT order in its palette:, sky-1..4 ground-1..4 leaf-1..3 water
;; accent fur-1 fur-2 ink; the last three are the player's and the same in
;; every region. Low saturation, one warm accent per region (section 7).
(palette
  ;; Reedfen: low, wide, wet; the sky is most of the screen
  (fen-sky-1 "#7b92a1" "high sky, grey-blue")
  (fen-sky-2 "#99adb4" "middle sky; far hills")
  (fen-sky-3 "#b9c7c2" "low sky")
  (fen-sky-4 "#d8dbcb" "the horizon, a little warm; mist; the water's skin")
  (fen-peat-1 "#2c2b27" "deep peat, shadow")
  (fen-peat-2 "#4a453b" "peat")
  (fen-peat-3 "#6c6552" "mud, old stone")
  (fen-peat-4 "#968e76" "lit stone, dry mud")
  (fen-reed-1 "#4d5a3d" "reeds in shade")
  (fen-reed-2 "#75794b" "reeds")
  (fen-reed-3 "#aea267" "seed heads, lit blades")
  (fen-water "#46616b" "still water")
  (fen-brack "#b9754a" "Reedfen's one warm accent: the brackish water")
  ;; the Hollow: a meadow ring of mute stones round a shallow bowl, at dawn
  (hol-sky-1 "#65718e" "high sky, slate")
  (hol-sky-2 "#9298ad" "middle sky; far fells")
  (hol-sky-3 "#c6b7b2" "low sky, rose-grey")
  (hol-sky-4 "#e8d1ac" "dawn at the horizon")
  (hol-stone-1 "#2d2b2c" "shadow")
  (hol-stone-2 "#4d4a48" "limestone in shade")
  (hol-stone-3 "#767470" "limestone")
  (hol-stone-4 "#a7a59b" "limestone lit")
  (hol-turf-1 "#435234" "turf in shade")
  (hol-turf-2 "#66763f" "turf")
  (hol-turf-3 "#9aa25e" "grass lit")
  (hol-tarn "#465a6b" "the tarn")
  (hol-bracken "#b0643a" "the Hollow's one warm accent: bracken")
  ;; the player, the same everywhere
  (fur-1 "#ede5d3" "the creature's fur")
  (fur-2 "#b8ab95" "its fur in shade")
  (ink "#26252b" "its eye")
  ;; A3: each harmonic has one colour, used everywhere (section 3, "How the
  ;; player learns a gate"): the glyph on a ring-stone, the harmonic when you
  ;; find it, the moths drawn to it. World-wide roles, not a region's.
  (h2 "#eaa648" "H2, amber")
  (h3 "#b4dc9a" "H3, pale green")
  (h4 "#8fb4e6" "H4, cold blue")
  (h5 "#e6a0b4" "H5, rose")
  (h7 "#a47ce0" "H7, a violet no region uses")
  (black "#000000" "fades"))

;; The Hollow (A4): the start, a bowl on the fell above the fen; seven rooms
;; wide and two high, west of Reedfen (topics/harkfell-a4-region-maps). It
;; gives nothing: it holds the first gate (the bowl's H2 stone) and the way
;; down (the H3 stone under it), and shows the ways on. PLACEHOLDER palette
;; roles until the look track's hol-* roles are merged.
(region hollow
  name: "The Hollow"
  bounds: ((1 2) (7 3))
  bed: "hollow-bed"
  bed-channels: (wind water hum drone)
  mode: ionian
  palette: (hol-sky-1 hol-sky-2 hol-sky-3 hol-sky-4 hol-stone-1 hol-stone-2 hol-stone-3 hol-stone-4
            hol-turf-1 hol-turf-2 hol-turf-3 hol-tarn hol-bracken fur-1 fur-2 ink)
  tiles: hollow
  roster: (reedling lantern-moth)
  moments: (high-fell hollow-answers)
  wander: (stones-remember)
  gives: ())

(region reedfen
  name: "Reedfen"
  bounds: ((8 3) (17 5))
  overtone: 2
  bed: "reedfen-bed"
  bed-channels: (wind water reeds drone)
  mode: dorian
  palette: (fen-sky-1 fen-sky-2 fen-sky-3 fen-sky-4 fen-peat-1 fen-peat-2 fen-peat-3 fen-peat-4
            fen-reed-1 fen-reed-2 fen-reed-3 fen-water fen-brack fur-1 fur-2 ink)
  hazard: brackish
  tiles: reedfen
  roster: (reedling bellfrog lantern-moth fen-vole pike heron-shape)
  moments: (first-open-water frog-choir drowned-bell)
  wander: (seed-wind)
  gives: ((overtone 2) (ability down)))

;; The creatures (section 6): a behaviour kind each. A3 brings the first
;; three to life ((harkfell creatures)); the rest are placed but not drawn.
;; A lantern moth is drawn to a harmonic: the room names which (drawn: N),
;; Reedfen's to H2 (Glasswood's will be H3's, the moth light).
(creature reedling behaviour: flock)
(creature bellfrog behaviour: hop)
(creature lantern-moth behaviour: follow)
(creature fen-vole behaviour: burrow)
(creature pike behaviour: swim)
(creature heron-shape behaviour: giant)
