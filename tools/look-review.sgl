;;; Look review: read-only frames through the actual renderer, without a
;;; release or web build. Run it in a native test harness that loads this
;;; tree's src/ (procedures/harkfell-look-review-harness in the notes), on
;;; your own Xvfb, with PIPES_LOOK_CONTROL naming a file that holds the case.
;;; The file is re-read every frame; a changed case reloads world/ (so room
;;; edits show without restarting) and prints "LOOK frame ready: CASE".
;;;   sheet:REGION        every room of REGION at its authored light
;;;   sheet-lit:REGION    the same at light 1.0 (a structural preview)
;;;   atlas               every room of the world at 1/4, as the ?atlas door
;;;   room:REGION:X:Y:C:R:CARRY:TICKS[:MODE[:TAU0]]
;;;                       one room in play: body at cell (C R), carrying
;;;                       CARRY (e.g. 2-3, or none), after TICKS world ticks;
;;;                       MODE down carries the cattail down, glide also holds
;;;                       jump; ride stands 120 ticks then glides west; fidgetK steps right and back until the last K ticks,
;;;                       then stands still (prints "LOOK still N"); heardS
;;;                       draws as if the Seventh's Rest moment had been
;;;                       heard S seconds;
;;;                       TAU0 is where the gust clock starts (default 0)
;;;                       C "start" (any R) puts it where ?room= would
;;;   room:...:MODE:TAU0:PHASE  the Underhum's finale state for the frame: none,
;;;                       listening or fused (the look's review override)
;;;   name:REGION:X:Y:C:R:CARRY:TICKS:ALPHA:W:H
;;;                       the same room on a W x H window (fitted as the web
;;;                       fits it), with D47's region name over it at ALPHA
;;;                       (0..1), at the top centre where the game shows it
;;; Anything after the documented fields is ignored, so appending ":2" makes
;;; a fresh case of the same view. Art and code changes need a restart.
;;; It opens no save and no audio device.
(import (sigil test) (sigil process) (sigil fs) (sigil string) (sigil io)
        (sigil desktop) (sigil graphics) (sigil list)
        (engine body) (engine worldmap)
        (substratic view present)
        (harkfell content) (harkfell source) (harkfell draw) (harkfell render)
        (harkfell view) (harkfell title)
        (harkfell world) (harkfell gates) (harkfell check) (harkfell feel)
        (harkfell underhum look))

(define CONTROL (getenv "PIPES_LOOK_CONTROL"))
(define (load-review) (load-content (read-world-source "world")))
(define (parse-case s) (string-split s ":"))
(define (num s) (string->number s))
(define (carry-of s) (if (string=? s "none") '() (map string->number (string-split s "-"))))

(define (review-world ct parts)
  (let* ((rm (content-room ct (num (list-ref parts 2)) (num (list-ref parts 3))))
         ;; C "start": where the ?room= door puts the body (room-start-cell)
         (g (if (string=? (list-ref parts 4) "start")
                (room-start-cell ct rm)
                (local->global ct rm (num (list-ref parts 4)) (num (list-ref parts 5)))))
         (wm (content-map ct))
         ;; MODE (optional 9th field): down, the body carries the cattail
         ;; down; glide, it carries it and holds jump every tick (a body put
         ;; in the air then glides down).
         (mode (if (> (length parts) 8) (list-ref parts 8) "none"))
         (down? (member mode '("down" "glide" "ride")))
         ;; TAU0 (optional 10th field): the gust clock the body starts at
         (tau0 (if (> (length parts) 9) (num (list-ref parts 9)) 0))
         (_ (set-underhum-review-phase!
              (let ((p (and (> (length parts) 10) (list-ref parts 10))))
                (and p (not (string=? p "none")) (string->symbol p)))))
         (b (body (cell-body (worldmap-tiles wm) HARKFELL-FEEL (car g) (cdr g)) down: (and down? #t) tau: tau0))
         (in (if (string=? mode "glide") (intent jump: #t) (intent)))
         ;; fidgetK: a step right and back every 30 ticks until the last K
         ;; ticks, then stand: the body has stood still about K ticks while
         ;; a dark room's moths have had the whole time to arrive (the drip
         ;; door's build, by seconds of stillness)
         (hop-k (and (> (string-length mode) 6) (string=? (substring mode 0 6) "fidget")
                     (string->number (substring mode 6 (string-length mode)))))
         (input (lambda (n)
                  (cond ((string=? mode "ride")
                         (let ((elapsed (- (num (list-ref parts 7)) n)))
                           (cond ((= elapsed 120) (intent h: -1 jump: #t press: #t))
                                 ((> elapsed 120) (intent h: -1 jump: #t))
                                 (else (intent)))))
                        ((not (and hop-k (> n hop-k))) in)
                        ((< (modulo n 30) 4) (intent h: 1))
                        ((< 14 (modulo n 30) 19) (intent h: -1))
                        (else in))))
         (w (world-populate (world-at wm b) (content-stones ct) (content-pickups ct)
                            (carry-of (list-ref parts 6)))))
    (let loop ((w w) (n (num (list-ref parts 7))))
      (if (= n 0)
          (begin
            (when hop-k (display "LOOK still ") (display (world-still w)) (newline))
            ;; heardS: as if the Seventh's Rest moment had been heard S
            ;; seconds (the harness plays no sound); otherwise none
            (let ((s (and (> (string-length mode) 5) (string=? (substring mode 0 5) "heard")
                          (string->number (substring mode 5 (string-length mode))))))
              (set-look-sound! (and s "seventh-rest") #f #f s))
            w)
          (loop (cdr (world-take-news (world-tick w (input n)))) (- n 1))))))

(define (selected) (string-trim (read-file-string CONTROL)))

;; name: the region's name as its definition gives it.
(define (region-title ct name)
  (let ((r (find (lambda (r) (eq? (region-name r) name)) (content-regions ct))))
    (and r (let ((v (region-field r 'name))) (if (pair? v) (car v) v)))))
(define *presenter* #f)

(test "review"
  (run-game "Opus review" 1200 528
    (lambda ()
      (gfx-setup)
      (set-viewport #f)
      (let loop ((current #f) (w #f) (rooms '()) (ct #f) (announced? #f))
        (wait-frame)
        (let* ((sel (selected))
               (changed? (not (equal? current sel)))
               (ct (if changed? (let ((c (load-review))) (set-draw-content! c) c) ct))
               (parts (parse-case sel))
               (kind (car parts))
               (atlas? (string=? kind "atlas"))
               (name? (string=? kind "name"))
               (sheet? (or atlas? (string=? kind "sheet") (string=? kind "sheet-lit")))
               (k (if atlas? 0.25 1)) (gap (if atlas? 2 8))
               (rooms (if changed?
                          (if (and sheet? (not atlas?))
                              (let ((rs (region-rooms ct (string->symbol (cadr parts)))))
                                (if (string=? kind "sheet-lit") (map (lambda (rm) (room rm light: 1.0)) rs) rs))
                              (if atlas? (map placed-data (content-rooms ct)) '()))
                          rooms))
               (w (if changed? (and (not sheet?) (review-world ct parts)) w)))
          (when changed?
            (unless (null? (content-problems ct))
              (display "PROBLEMS: ") (display (content-problems ct)) (newline))
            (let ((size (cond (sheet? (overview-size rooms k gap))
                              (name? (list (num (list-ref parts 9)) (num (list-ref parts 10))))
                              (else '(1200 528)))))
              (window-set-size! (car size) (cadr size))
              (display "SIZE ") (display (car size)) (display " ") (display (cadr size)) (newline)))
          (let ((ready? (or (not sheet?) (prepare-overview! rooms)))
                (announced? (and (not changed?) announced?)))
            (unless sheet? (present-play! w (lambda () #f)))
            (begin-frame)
            (cond
              (sheet? (draw-overview rooms k gap #t))
              (name?
               (let* ((ww (num (list-ref parts 9))) (wh (num (list-ref parts 10))))
                 (unless *presenter* (set! *presenter* (make-presenter VIEW-W VIEW-H)))
                 (view-present! *presenter* (room-color-rt) (view-fit ww wh VIEW-W VIEW-H))
                 (draw-region-name! ww wh (region-title ct (string->symbol (cadr parts)))
                                    (num (list-ref parts 8)))))
              (else (set-color 1.0 1.0 1.0 1.0)
                    (draw-render-target (room-color-rt) 0 0 1200 528)))
            (end-frame)
            (when (and ready? (not announced?))
              (display "LOOK frame ready: ") (display sel) (newline)
              (flush-output-port (current-output-port)))
            (unless (quit-requested?)
              (loop sel w rooms ct (or announced? ready?)))))))))
