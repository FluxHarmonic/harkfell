(job "h7-reedfen-with" 40 (layer "reedfen-bed" 0.5 (2 3 4 5 7) ((1 . 0.5) (2 . 0.4) (3 . 0.4) (4 . 0.6) (5 . 0.6) (6 . 0.6) (7 . 0.6) (8 . 0.6))))
(job "h7-glasswood-without" 40 (layer "glasswood-bed" 0.5 (2 3 4 5) ((1 . 0.5) (2 . 0.4) (3 . 0.4) (4 . 0.6) (5 . 0.6) (6 . 0.6) (7 . 0.6) (8 . 0.6))))
(job "h7-glasswood-with" 40 (layer "glasswood-bed" 0.5 (2 3 4 5 7) ((1 . 0.5) (2 . 0.4) (3 . 0.4) (4 . 0.6) (5 . 0.6) (6 . 0.6) (7 . 0.6) (8 . 0.6))))
(job "h7-pipes-without" 40 (layer "pipes-bed" 0.5 (2 3 4 5) ((1 . 0.5) (2 . 0.4) (3 . 0.6) (4 . 0.6) (5 . 0.6) (6 . 0.6) (7 . 0.6) (8 . 0.6))))
(job "h7-pipes-with" 40 (layer "pipes-bed" 0.5 (2 3 4 5 7) ((1 . 0.5) (2 . 0.4) (3 . 0.6) (4 . 0.6) (5 . 0.6) (6 . 0.6) (7 . 0.6) (8 . 0.6))))
