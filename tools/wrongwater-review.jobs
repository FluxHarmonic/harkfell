(job "dip-hollow-answers" 30 (layer "hollow-bed" 0.5 (2 3 4 5 7) ((1 . 0.5) (2 . 0.4) (3 . 0.3) (4 . 0.21) (5 . 0.21) (6 . 0.21) (7 . 0.21) (8 . 0.021))) (layer "hollow-answers" 1.0 () () 1.0))
