(import (sigil test)
        (engine reach pool)
        (engine reach geometry memo)
        (engine reach)
        (engine reach geopool)
        (engine reach wire)
        (engine tilemap)
        (engine air)
        (harkfell feel)
        (harkfell content)
        (harkfell source)
        (harkfell check))

(define WORLD "test/fixtures/worlds/carry-softlock")
(define OTHER "test/fixtures/worlds/carry-softlock-rock")
(define CT (load-content (read-world-source WORLD)))

(test-group "spatial geometry workers fail closed"
  (test "different source world cannot supply geometry"
    (let ((pool (make-pool (list "./build/release/bin/harkfell"
                                 "--reach-worker" "outside" "--world" OTHER) 1)))
      (assert-error
        (pool-verify! pool "I" (string-append "I " (spatial-worker-context CT))))
      (pool-close! pool)))
  (test "a dead worker cannot become an empty successful search"
    (let ((pool (make-pool (list "sh" "-c" "exit 1") 1)))
      (assert-error (pool-verify! pool "I" "I expected"))
      (pool-close! pool)))
  (test "a malformed worker response fails verification"
    (let ((pool (make-pool
                  (list "sh" "-c" "while IFS= read -r line; do echo WRONG; done") 1)))
      (assert-error (pool-verify! pool "I" "I expected"))
      (pool-close! pool))))

(define TM (make-tilemap 8 8 1))
(define ANSWER '(() (0 0 1 1) 17))

(define (filled-memo tm)
  (let* ((memo (make-geometry-memo))
         (generation (geometry-memo-select! memo tm HARKFELL-FEEL #f)))
    (geometry-memo-set! memo generation "exact anchor/body request" ANSWER)
    memo))

(define (answer-signature answer)
  (wire-join
    (wire-value
      (list
        (map (lambda (note)
               (list (car note) (cadr note) (caddr note)
                     (wire-body-value (list-ref note 3))
                     (string->symbol (wire-script (list-ref note 4)))))
             (car answer))
        (cadr answer) (caddr answer)))))

(test-group "pure anchor memo invalidation"
  (test "an actual cached worker answer equals fresh native geometry bit for bit"
    (let* ((tm (tiles-carrying CT '()))
           (start (start-cell CT))
           (rep (stand-body tm HARKFELL-FEEL (car start) (cdr start)))
           (k (* 6 (cell-index tm (car start) (cdr start))))
           (spec (list '() (list start)))
           (memo (make-geometry-memo))
           (pool (make-pool (list "./build/release/bin/harkfell"
                                  "--reach-worker" "outside" "--world" WORLD) 1))
           (serve (reach-search tm HARKFELL-FEEL (list start) witness-lands? #f 'serve)))
      (geometry-memo-select! memo tm HARKFELL-FEEL #f)
      (let ((remote (make-geometry-remote pool spec memo)))
        ((vector-ref remote 0) k rep #t)
        (let ((first ((vector-ref remote 1) k))
              (requests (pool-requests pool)))
          (geometry-memo-select! memo tm HARKFELL-FEEL #f)
          (let ((again (make-geometry-remote pool spec memo)))
            ((vector-ref again 0) k rep #t)
            (assert-equal (answer-signature first)
                          (answer-signature ((vector-ref again 1) k)))
            (assert-equal requests (pool-requests pool))
            (assert-equal (answer-signature ((vector-ref serve 0) k rep))
                          (answer-signature first)))))
      (pool-close! pool)))
  (test "unchanged and unrelated tiles retain the exact answer and step count"
    (let ((memo (filled-memo TM)))
      (geometry-memo-select! memo TM HARKFELL-FEEL #f)
      (assert-equal ANSWER (geometry-memo-ref memo "exact anchor/body request"))
      (geometry-memo-select! memo (tilemap-set TM 7 7 'solid) HARKFELL-FEEL #f)
      (assert-equal ANSWER (geometry-memo-ref memo "exact anchor/body request"))
      (assert-false (geometry-memo-ref memo "different body request"))))
  (test "a changed tile on the dependency rectangle boundary invalidates"
    (let ((memo (filled-memo TM)))
      (geometry-memo-select! memo (tilemap-set TM 1 1 'solid) HARKFELL-FEEL #f)
      (assert-false (geometry-memo-ref memo "exact anchor/body request"))))
  (test "a remote air gate invalidates even outside the dependency rectangle"
    (let* ((tm (tilemap TM air: (list (air-field gate: '(7 . 7) lift: 3.0))))
           (memo (filled-memo tm)))
      (geometry-memo-select! memo (tilemap-set tm 7 7 'solid) HARKFELL-FEEL #f)
      (assert-false (geometry-memo-ref memo "exact anchor/body request"))))
  (test "physics context changes invalidate every answer"
    (for-each
      (lambda (tm)
        (let ((memo (filled-memo TM)))
          (geometry-memo-select! memo tm HARKFELL-FEEL #f)
          (assert-false (geometry-memo-ref memo "exact anchor/body request"))))
      (list (make-tilemap 7 8 1) (tilemap TM size: 2) (tilemap TM edge: 'air)
            (tilemap TM air: (list (air-field lift: 3.0)))))
    (let ((memo (filled-memo TM)))
      (geometry-memo-select! memo TM HARKFELL-FEEL #t)
      (assert-false (geometry-memo-ref memo "exact anchor/body request"))))
  (test "late answers cannot populate a newer generation"
    (let* ((memo (make-geometry-memo))
           (old (geometry-memo-select! memo TM HARKFELL-FEEL #f)))
      (geometry-memo-select! memo (tilemap-set TM 1 1 'solid) HARKFELL-FEEL #f)
      (geometry-memo-set! memo old "exact anchor/body request" ANSWER)
      (assert-false (geometry-memo-ref memo "exact anchor/body request")))))

(let ((summary (run-tests-filtered (lambda (test) #t))))
  (for-each
    (lambda (result)
      (display (test-result-name result))
      (display ": ")
      (display (if (test-result-passed? result) "PASS" (test-result-message result)))
      (newline))
    (test-summary-results summary))
  (unless (and (= (test-summary-total summary) 9)
               (= (test-summary-passed summary) 9)
               (= (test-summary-failed summary) 0))
    (error "spatial pool controls did not execute all nine tests"))
  (display "RESULT spatial-pool-controls PASS 9/9\n"))
