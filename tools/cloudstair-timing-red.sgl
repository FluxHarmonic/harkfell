;; Shorten only the fixture's pulse until its real ascent has one viable
;; launch tick. The 90-tick departure gate must reject that lucky witness.
;; This sabotage does not change the game's shared clock or room fields.
(import (sigil list)
        (engine body)
        (engine tilemap)
        (engine reach timed)
        (harkfell cloudstair probes))

(define TM (probe-lift-map #t))
(define OFF (tilemap TM air: '()))
(define START (probe-lift-start TM 300 #t))
(define ON-STEP (probe-step TM))
(define OFF-STEP (probe-step OFF))

(define (short-pulse cut)
  (lambda (node in)
    ((if (<= (body-tau (timed-node-body node)) cut) ON-STEP OFF-STEP)
     node in)))

(define (lands? advance tau)
  (let* ((start (timed-node START body: (body (timed-node-body START) tau: tau)))
         (trace (timed-run advance start (probe-lift-script start))))
    (and trace (probe-lift-arrives? (car (reverse trace))))))

(let find ((cut 330))
  (cond
    ((> cut 410)
      (display "INCOMPLETE: no single-tick sabotage found")
      (newline))
    (else
      (let ((advance (short-pulse cut)))
        (if (and (lands? advance 300) (not (lands? advance 301)))
            (begin
              (write (list 'last-force-tick cut
                           'first-departure-succeeds #t
                           'failed-departures
                           (length (timed-window advance START probe-lift-script
                                                 probe-lift-arrives? 300 389 120))))
              (newline))
            (find (+ cut 1)))))))
