(import (sigil list)
        (engine body)
        (engine reach timed)
        (harkfell feel)
        (harkfell content)
        (harkfell source)
        (harkfell cloudstair probes))

(define CT (load-content (read-world-source "world")))
(for-each
  (lambda (carry down)
    (let* ((tm (probe-entry-map CT carry))
           (start (probe-entry-start tm down))
           (script (probe-entry-script start))
           (trace (timed-run (probe-step tm) start script))
           (end (and trace (car (reverse trace)))))
      (write (list 'carry carry 'down down 'arrived (and end (probe-entry-arrives? end))))
      (newline)
      (when end
        (let ((b (timed-node-body end)))
          (write (list 'x (body-x b) 'y (body-y b) 'mode (body-mode b) 'tau (body-tau b)))
          (newline)))))
  '((2) (2 4) (2 4))
  '(#t #f #t))
