;; Pure restoration instrument: a synthetic northern placement moves the
;; origin while the saved entry remains in the actual opened Hollow stone.
(import (sigil list)
        (engine tilemap)
        (engine worldmap)
        (engine body)
        (engine reach)
        (harkfell content)
        (harkfell source)
        (harkfell check)
        (harkfell feel)
        (harkfell gates)
        (harkfell world)
        (harkfell save))
(define CT (load-content (read-world-source "world")))
(define P (placed x: 7 y: -2 tiles: (make-tilemap 25 11 16)
                   data: (room region: 'probe x: 7 y: -2)))
(define PS (cons P (content-rooms CT)))
(define NORTH (content CT rooms: PS wmap: (make-worldmap PS 25 11 16)))
(define G (local->global CT (content-room CT 7 2) 6 3))
(define STONES
  (map (lambda (s)
         (if (equal? (stone-cell s) G)
             (stone s state: 'open)
             s))
       (content-stones CT)))
(define B
  (body (stand-body (tiles-carrying CT '(2 4)) HARKFELL-FEEL (car G) (cdr G))
        down: #t tau: 479))
(define D (save-datum CT B '(2 4) STONES '() 10.0 #t #t '(hollow reedfen)))
(define R (save-restore NORTH D))
(define GN (restored-cell R))
(define B2
  (body (stand-body (tiles-carrying NORTH (restored-carry R))
                    HARKFELL-FEEL (car GN) (cdr GN))
        down: (restored-down R) tau: (restored-tau R)))
(define W
  (world-tick
    (world-populate (world-at (content-map NORTH) B2)
      (map (lambda (s)
             (if (find (lambda (opened) (equal? (car opened) (stone-cell s)))
                       (restored-stones R))
                 (stone s state: 'open)
                 s))
           (content-stones NORTH))
      (content-pickups NORTH) (restored-carry R))
    NO-INTENT))
(write (list 'old-origin (worldmap-y0 (content-map CT)) 'new-origin (worldmap-y0 (content-map NORTH))
             'local (global->local NORTH (content-room NORTH 7 2) GN)
             'restored-down (restored-down R) 'restored-tau (restored-tau R)
             'announced (restored-announced R) 'notes (restored-notes R)
             'ground (body-mode (world-body W)) 'next-tau (world-tau W)
             'stone (tilemap-ref (world-tiles W) (car GN) (cdr GN))))
(newline)
