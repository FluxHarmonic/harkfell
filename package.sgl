;;; Harkfell - a quiet exploration platformer about carrying lost harmonics
;;; home, in Sigil.
;;;
;;; One source tree, two targets, the shape Crash The Stack uses (its master
;;; e737d21): (harkfell main) is the seam that picks the shell, (harkfell
;;; shell native) over sigil-desktop for the dev/release configs and
;;; (harkfell shell web) over the browser's requestAnimationFrame for the
;;; web config.
;;;
;;; The modules under (engine ...) are written for the shared Sigil game
;;; engine Crash's P5 is to extract (ruling D6): no Harkfell names in them.
;;;
;;;   scripts/dev sigil build                       native (dev: bytecode)
;;;   scripts/dev sigil build --config release      native, what you play
;;;   scripts/dev sigil build --config web          browser (manifest has binaryen)
;;;   scripts/host-web                              host a snapshot of build/web on wg0

(import (sigil process) (sigil string) (sigil time) (sigil math) (sigil fs) (sigil list))

(define sigil-repo "codeberg:sigil/sigil")
(define app-repo "codeberg:sigil/sigil-desktop")
(define graphics-repo "codeberg:sigil/sigil-graphics")

;; The web build's version, stamped into the page (Crash's web-version):
;; the git commit, plus the build's second when the tree was dirty, so two
;; dirty builds of one commit are still two versions.
(define (web-version)
  (let* ((sha (string-trim (process-output->string "git" "rev-parse" "--short=12" "HEAD")))
         (dirty (string-trim (process-output->string "git" "status" "--porcelain" "--untracked-files=no")))
         (sha (if (string=? sha "") "unversioned" sha)))
    (if (string=? dirty "")
        sha
        (string-append sha "-dirty-" (number->string (exact (floor (current-second))))))))

;; A string as a JSON string literal, safe inside a <script> element ("<"
;; is escaped, so no text can close the element).
(define (json-string s)
  (let loop ((cs (string->list s)) (acc '()))
    (if (null? cs)
        (string-append "\"" (apply string-append (reverse acc)) "\"")
        (let* ((c (car cs))
               (i (char->integer c)))
          (loop (cdr cs)
                (cons (cond ((char=? c #\") "\\\"")
                            ((char=? c #\\) "\\\\")
                            ((char=? c #\newline) "\\n")
                            ((char=? c #\<) "\\u003c")
                            ((< i 32) (string-append "\\u00" (if (< i 16) "0" "") (number->string i 16)))
                            (else (string c)))
                      acc))))))

(define (sorted-dir d)
  (list-sort string<? (filter (lambda (n) (not (or (string=? n ".") (string=? n ".."))))
                              (directory-list d))))

(define (has-suffix? s suf)
  (let ((n (string-length s)) (m (string-length suf)))
    (and (>= n m) (string=? (substring s (- n m) n) suf))))

;; A world file, not an editor's lock or autosave (.#x.room, #x.room#):
;; the same rule as (harkfell source)'s world-file-name?.
(define (world-name? n suf)
  (and (has-suffix? n suf) (not (memv (string-ref n 0) (list #\. #\#)))))

;; The world's files the game reads (the same set (harkfell source) reads
;; natively), as a JSON array of [path, text] for the page.
(define (world-json)
  (let* ((files (append
                  (if (file-exists? "world/world.sgl") (list "world/world.sgl") '())
                  (if (directory? "world/regions")
                      (map (lambda (n) (string-append "world/regions/" n))
                           (filter (lambda (n) (world-name? n ".map")) (sorted-dir "world/regions")))
                      '())
                  (if (directory? "world/rooms")
                      (apply append
                             (map (lambda (r)
                                    (let ((d (string-append "world/rooms/" r)))
                                      (if (directory? d)
                                          (map (lambda (n) (string-append d "/" n))
                                               (filter (lambda (n) (world-name? n ".room")) (sorted-dir d)))
                                          '())))
                                  (sorted-dir "world/rooms")))
                      '()))))
    (string-append "["
                   (string-join (map (lambda (f)
                                       (string-append "[" (json-string f) "," (json-string (read-file-string f)) "]"))
                                     files)
                                ",\n")
                   "]")))

;; After link-web-application: the page's __VERSION__ stamped, the world
;; baked in (__WORLD__), and the Pages edge headers (COOP/COEP) copied
;; beside it.
(define (stamp-web-version ctx)
  (let* ((out (config-output-dir (context-config ctx)))
         (page-path (path-join out "index.html"))
         (page (read-file-string page-path)))
    (write-file-string (path-join out "_headers") (read-file-string "web/_headers"))
    (write-file-string page-path
                       (string-replace (string-replace page "__VERSION__" (web-version))
                                       "__WORLD__" (world-json)))
    (display "  web version ") (display (web-version)) (newline)
    ctx))

(package
  name: "harkfell"
  version: "0.1.0"
  sigil: "0.22.6"
  description: "A quiet exploration platformer about carrying lost harmonics home"
  license: "GPL-3.0-or-later"
  authors: (list "David Wilson <david@daviwil.com>")

  entry: '(harkfell main)
  bundle-name: "harkfell"

  configs: (list
    (config
      name: 'dev
      output-dir: "build/dev"
      debug?: #t
      optimize: 0
      bundle?: #t)
    (config
      name: 'release
      output-dir: "build/release"
      debug?: #f
      optimize: 2
      backend: 'native
      bundle?: #t)
    ;; wasm32-wasi through zig, native codegen; the shell drives one frame
    ;; per requestAnimationFrame dispatch (Crash's web config).
    (config
      name: 'web
      output-dir: "build/web"
      toolchain: 'zig
      target: "wasm32-wasi"
      backend: 'native
      debug?: #f
      optimize: 2
      bundle?: #t
      features: '(web wasm graphics)))

  dependencies: (list
    ;; Window and keyboard (GLFW); native only. 0.11.0 for D37: the window's
    ;; size and fullscreen (window-set-size!, set-fullscreen!); 0.13.0 for
    ;; the window's size in screen units (window-width, window-height).
    (from-git url: app-repo version: "^0.13.0" configs: '(dev release))
    ;; Drawing, both targets.
    (from-git url: graphics-repo version: "^0.11.4")
    ;; Web only: the wasm runtime and loader, the WebGL2 bridge and app
    ;; shell, and localStorage for (engine store).
    (from-git url: sigil-repo package: "sigil-wasm-runtime" version: ">=0.22.6" configs: '(web))
    (from-git url: sigil-repo package: "sigil-wasm-gles3" version: ">=0.22.6" configs: '(web))
    (from-git url: sigil-repo package: "sigil-browser" version: ">=0.22.6" configs: '(web))
    ;; A2, the sound: the tune model and the live player (0.7.0 has the bed
    ;; nodes and kinds), and the sink (sokol natively, the WebAudio bridge on
    ;; the web).
    (from-git url: "codeberg:sigil/motif" version: "^0.7.0")
    (from-git url: "codeberg:sigil/sigil-audio" version: "^0.12.2")
    (from-git url: sigil-repo package: "sigil-wasm-audio" version: ">=0.22.6" configs: '(web)))

  dev-dependencies: (list
    (from-git url: sigil-repo package: "sigil-test" version: ">=0.22.6")
    (from-git url: sigil-repo package: "sigil-test-runner" version: ">=0.22.6"))

  tasks: (list
    (task
      name: 'build
      description: "Compile the game (and, on the web config, link the browser app)"
      steps: (list
        ;; the web config: sigil-audio's native-init stub (src/c/wasm-audio-stub.c)
        (lambda (ctx)
          (if (memq (target-os ctx) '(wasm wasi))
              ((create-static-library name: "harkfell")
               ((compile-c-sources sources: (list "src/c/wasm-audio-stub.c")
                                   flags: (with-sigil-c-flags '("-std=c99"))) ctx))
              ctx))
        (compile-sigil-modules sources: "src/**/*.sgl")
        ;; assets/ (the tunes) beside the page
        (link-assets)
        (lambda (ctx)
          (if (memq (target-os ctx) '(wasm wasi))
              (stamp-web-version
                ((link-web-application name: "harkfell" html-mount-id: "status") ctx))
              ctx))))))
