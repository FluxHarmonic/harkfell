#!/usr/bin/env bash
# The S0 gate (Harkfell design §10, S0): the sketches' own checks.
#
#   scripts/gate [-j N] [--tool PATH]      the gate
#   scripts/gate --sabotage                the speaker check against a planted
#                                          pure 147 Hz sine drone: must be RED
#                                          (exit 1 caught, exit 3 NOT caught)
#
# 1. PRESENCE: the tool answers `probe` (its motif has the 0.7.0 bed kinds
#    and still refuses a made-up one). Otherwise SETUP-FAILED: nothing below
#    would test the sketches' motif.
# 2. TWICE: every .cts in assets/tunes (the population is the directory,
#    counted) renders to WAV in two separate processes, and the two files
#    are byte-identical. A control first: two different tunes must hash
#    differently, so the comparison can see a difference at all.
# 3. SPEAKER: `sketchbook speaker` over every tune but the moments (the
#    beds, the hum, the noises, the finding tones): each sounding channel
#    keeps at least a quarter of its energy above 300 Hz; the beds are checked
#    twice, as written (saw) and as the page's FM switch plays them.
#
# Last line: GATE GREEN | GATE RED | GATE SETUP-FAILED. Scratch goes to a
# mktemp directory, never under the repo.

set -euo pipefail
cd "$(dirname "$0")/.."
JOBS=4
TOOL=build/release/bin/sketchbook
SABOTAGE=0
while [ $# -gt 0 ]; do
  case "$1" in
    -j) JOBS=$2; shift 2 ;;
    --tool) TOOL=$2; shift 2 ;;
    --sabotage) SABOTAGE=1; shift ;;
    *) echo "gate: unknown option $1" >&2; exit 2 ;;
  esac
done

setup_failed() { echo "gate: $*" >&2; echo "GATE SETUP-FAILED ($*)"; exit 2; }
[ -x "$TOOL" ] || setup_failed "no tool at $TOOL (sigil build --config release)"
WORK=$(mktemp -d "${TMPDIR:-/tmp}/sketch-gate.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

echo "gate: tool $TOOL ($(stat -c %y "$TOOL")), motif $(readlink -f .sigil/deps/motif) at $(git -C .sigil/deps/motif rev-parse --short HEAD 2>/dev/null || echo '?')"
"$TOOL" probe || setup_failed "the tool's motif lacks the bed kinds"

# --- the sabotage: a pure 147 Hz sine drone must fail the speaker check -------
if [ "$SABOTAGE" -eq 1 ]; then
  src=assets/tunes/hum-build-saw.cts
  plant="$WORK/sabotage-sine.cts"
  # H2 (instrument 1, D-3 = 146.8 Hz) becomes a pure sine; nothing else changes
  awk '/\(instrument id: 1 name: "H2 D3" patch: \(drone-saw [^)]*\)/ { sub(/patch: \(drone-saw [^)]*\)/, "patch: (simple-sine osc-amp: 0.3 attack: 4 release: 6)") } { print }' "$src" > "$plant"
  changed=$(diff "$src" "$plant" | grep -c '^>' || true)
  grep -q 'simple-sine' "$plant" || { echo "gate: the plant did not land"; echo "GATE SETUP-FAILED (plant absent)"; exit 2; }
  [ "$changed" -eq 1 ] || { echo "gate: the plant changed $changed lines, expected 1"; echo "GATE SETUP-FAILED (plant size)"; exit 2; }
  echo "gate: planted $(diff "$src" "$plant" | grep '^>' | cut -c1-120)"
  out=$("$TOOL" speaker "$plant" --seconds 20) && rc=0 || rc=$?
  echo "$out"
  # caught means: a nonzero exit AND the planted channel (ch1) failing on its
  # share (not merely "no channel sounds", which a broken plant would give).
  # Exit 1 when caught (the check is red, as it must be); 3 when not.
  if [ "$rc" -eq 0 ] || ! echo "$out" | grep -q "^FAIL .* ch1: .* of its energy above 300 Hz"; then
    echo "SABOTAGE NOT CAUGHT (the speaker check passed a pure sine drone)"; exit 3
  fi
  echo "GATE RED (sabotage: the pure 147 Hz sine drone failed the speaker check, as it must)"
  exit 1
fi

# --- 2. twice ------------------------------------------------------------------------
ls assets/tunes/*.cts > "$WORK/population"
POP=$(wc -l < "$WORK/population")
[ "$POP" -gt 0 ] || setup_failed "no tunes in assets/tunes"
echo "gate: population $POP tunes"
export TOOL WORK
xargs -P "$JOBS" -I{} bash -c '
  f=$1; n=$(basename "$f" .cts)
  for pass in a b; do
    if "$TOOL" render-tune "$f" "$WORK/$n.$pass.wav" > "$WORK/$n.$pass.log" 2>&1 && [ -s "$WORK/$n.$pass.wav" ]; then
      sha256sum "$WORK/$n.$pass.wav" | cut -d" " -f1 > "$WORK/$n.$pass.sha"
      stat -c %s "$WORK/$n.$pass.wav" > "$WORK/$n.$pass.size"
      rm -f "$WORK/$n.$pass.wav"
    else
      echo FAILED > "$WORK/$n.$pass.sha"
    fi
  done' _ {} < "$WORK/population"

same=0; differ=0; failed=0
while read -r f; do
  n=$(basename "$f" .cts)
  a=$(cat "$WORK/$n.a.sha" 2>/dev/null || echo MISSING); b=$(cat "$WORK/$n.b.sha" 2>/dev/null || echo MISSING)
  if [ "$a" = FAILED ] || [ "$b" = FAILED ] || [ "$a" = MISSING ] || [ "$b" = MISSING ]; then
    failed=$((failed + 1)); echo "FAILED  $n: $(tail -1 "$WORK/$n.a.log" 2>/dev/null)"
  elif [ "$a" = "$b" ]; then
    same=$((same + 1)); echo "same    $n  ${a:0:16}  $(cat "$WORK/$n.a.size") bytes"
  else
    differ=$((differ + 1)); echo "DIFFER  $n  ${a:0:16} vs ${b:0:16}"
  fi
done < "$WORK/population"
# the control: the comparison sees a difference between two different tunes
first=$(sed -n 1p "$WORK/population" | xargs basename -s .cts); second=$(sed -n 2p "$WORK/population" | xargs basename -s .cts)
if [ "$(cat "$WORK/$first.a.sha")" = "$(cat "$WORK/$second.a.sha")" ]; then
  echo "gate: CONTROL FAILED: $first and $second hash the same; the comparison cannot see a difference"
  echo "GATE SETUP-FAILED (control)"; exit 2
fi
echo "gate: control: $first and $second hash differently"
echo "gate: twice: population $POP, same $same, DIFFER $differ, FAILED $failed"

# --- 3. speaker -------------------------------------------------------------------------
grep -v '/moment-' "$WORK/population" > "$WORK/speaker-files"
echo "gate: speaker check over $(wc -l < "$WORK/speaker-files") tunes (all but the moments), 130 s a channel (the hum's last voice enters at 60 s)"
xargs -P "$JOBS" -I{} bash -c 'n=$(basename "$1" .cts); if "$TOOL" speaker "$1" --seconds 130 > "$WORK/$n.spk" 2>&1; then echo 0 > "$WORK/$n.spkrc"; else echo 1 > "$WORK/$n.spkrc"; fi' _ {} < "$WORK/speaker-files"
# the beds again as the page's FM switch plays them (swap-drone-kind): the page
# can play them that way, so the speaker rule covers it (review, 2026-09-24)
grep '/bed-' "$WORK/speaker-files" > "$WORK/fm-files"
{ while read -r f; do basename "$f" .cts; done < "$WORK/speaker-files"; while read -r f; do echo "$(basename "$f" .cts)-fm"; done < "$WORK/fm-files"; } > "$WORK/spk-names"
NSPK=$(wc -l < "$WORK/spk-names")
echo "gate: and $(wc -l < "$WORK/fm-files") beds in the FM voicing"
xargs -P "$JOBS" -I{} bash -c 'n=$(basename "$1" .cts)-fm; if "$TOOL" speaker "$1" --seconds 130 --voicing fm > "$WORK/$n.spk" 2>&1; then echo 0 > "$WORK/$n.spkrc"; else echo 1 > "$WORK/$n.spkrc"; fi' _ {} < "$WORK/fm-files"
speaker_ok=1; spk_done=0
while read -r n; do
  cat "$WORK/$n.spk" 2>/dev/null | grep -v '^speaker check:' || true
  rc=$(cat "$WORK/$n.spkrc" 2>/dev/null || echo missing)
  [ "$rc" = 0 ] || speaker_ok=0
  [ "$rc" = missing ] || spk_done=$((spk_done + 1))
done < "$WORK/spk-names"
voices=$(cat "$WORK"/*.spk | grep -c '^pass ' || true)
fails=$(cat "$WORK"/*.spk | grep -c '^FAIL' || true)
echo "gate: speaker: $spk_done of $NSPK tunes checked, $voices voices pass, $fails fail"
[ "$spk_done" -eq "$NSPK" ] || speaker_ok=0
# the verdict from the output too, not the exit status alone (an exit status the
# tool never set read as success once: every FAIL line is a failure)
[ "$fails" -eq 0 ] || speaker_ok=0
[ "$voices" -gt 0 ] || speaker_ok=0

if [ "$same" -eq "$POP" ] && [ "$differ" -eq 0 ] && [ "$failed" -eq 0 ] && [ "$speaker_ok" -eq 1 ]; then
  echo "GATE GREEN ($same of $POP tunes render byte-identically twice; the speaker check passes)"
  exit 0
fi
echo "GATE RED"
exit 1
