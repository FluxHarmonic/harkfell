;;; The world's sounds exist (A2): every room's fixed moment and every
;;; region's bed names a tune at assets/tunes/NAME.cts that reads as a tune.
;;; A1's content gate checks that a moment's name is one of its region's
;;; moments:; this checks there is a file behind it, so a typo or a missing
;;; file is red here rather than silent in play (the director skips a tune it
;;; cannot open).
;;;
;;; The control and the break: the real world (clean), and a copy whose Reed
;;; Bridge names a moment with no file (red, naming the room and the tune).

(import (sigil test)
        (sigil list)
        (sigil string)
        (motif tune)
        (engine worldmap)
        (harkfell content)
        (harkfell source)
        (harkfell tunes)
        (harkfell sound)
        (harkfell gates)
        (harkfell audio))

(define WORLD (read-world-source "world"))

;; Every sound the content names, as (what . tune-name).
(define (named-tunes ct)
  (append
    (filter-map* (lambda (p)
                   (let* ((rm (placed-data p)) (m (room-moment-name rm)))
                     (and m (cons (string-append (room-label rm) " moment") m))))
                 (content-rooms ct))
    (filter-map* (lambda (r)
                   (let ((b (region-field r 'bed)))
                     (and b (cons (string-append (symbol->string (region-name r)) " bed")
                                  (if (symbol? b) (symbol->string b) b)))))
                 (content-regions ct))))

(define (filter-map* f l)
  (let loop ((l l) (acc '()))
    (if (null? l) (reverse acc) (let ((v (f (car l)))) (loop (cdr l) (if v (cons v acc) acc))))))

;; The problems: a name with no file, or a file that does not read.
(define (tune-problems ct)
  (filter-map* (lambda (e)
                 (cond ((not (tune-exists? (cdr e)))
                        (string-append (car e) ": no " (tune-path (cdr e))))
                       ((not (guard (x (#t #f)) (read-tune-string (tune-text (cdr e)))))
                        (string-append (car e) ": " (tune-path (cdr e)) " does not read"))
                       (else #f)))
               (named-tunes ct)))

(define (ends-with? s suf)
  (let ((n (string-length s)) (m (string-length suf)))
    (and (>= n m) (string=? (substring s (- n m) n) suf))))

(define (swap s a b)
  (let ((n (string-length s)) (m (string-length a)))
    (let loop ((k 0))
      (cond ((> (+ k m) n) (error "swap: not found" a))
            ((string=? (substring s k (+ k m)) a)
             (string-append (substring s 0 k) b (substring s (+ k m) n)))
            (else (loop (+ k 1)))))))

(test-group "tunes: every named sound has its file"
  (test "the world names at least one moment and one bed (the check has a subject)"
    (let ((ns (named-tunes (load-content WORLD))))
      (assert-true (find (lambda (e) (string-contains? (car e) "moment")) ns))
      (assert-true (find (lambda (e) (string-contains? (car e) "bed")) ns))))
  (test "the real world: every one exists and reads (the control)"
    (assert-equal '() (tune-problems (load-content WORLD))))
  (test "a moment with no file is red, naming the room and the path"
    (let* ((src (map (lambda (e)
                       (cond ((ends-with? (car e) "x9y3.room")
                              (cons (car e) (swap (cdr e) "tune: first-open-water" "tune: no-such-moment")))
                             ;; A4: every moment the region names has a file now, so the
                             ;; region names one more that has none
                             ((ends-with? (car e) "world.sgl")
                              (cons (car e) (swap (cdr e) "moments: (first-open-water" "moments: (no-such-moment first-open-water")))
                             (else e)))
                     WORLD))
           (ps (tune-problems (load-content src))))
      (assert-true (member "reedfen:9,3 moment: no assets/tunes/no-such-moment.cts" ps)))))

;; A3: every cue the director renders, and for every harmonic placed in the
;; world (a pickup or a ring-stone) its finding tone, its pickup cue, its
;; ring and its near miss: each has a file that reads. The director plays
;; nothing for a harmonic whose tune is missing, so a missing file would be
;; silent in play.
(define (a3-tunes ct)
  (append (sound-cue-tunes)
          (apply append
                 (map (lambda (n)
                        (map (lambda (base) (string-append base (number->string n)))
                             (list "tone-h" "pickup-h" "ring-h" "miss-h")))
                      (append (map pickup-overtone (content-pickups ct))
                              (map stone-overtone (content-stones ct)))))))

(define (unreadable names)
  (filter (lambda (n) (not (and (tune-exists? n) (guard (x (#t #f)) (read-tune-string (tune-text n))))))
          names))

(test-group "tunes: the A3 cues and each placed harmonic's sounds"
  (test "the world places H2 (the check has a subject), and every cue and H2 tune reads"
    (let ((ct (load-content WORLD)))
      (assert-true (member "ring-h2" (a3-tunes ct)))
      (assert-true (member "croak-h2" (a3-tunes ct)))
      (assert-equal '() (unreadable (a3-tunes ct)))))
  (test "a harmonic with no tunes is red (H4 has none yet; H3 gained its stone's in A4)"
    (assert-true (member "ring-h4" (unreadable (list "ring-h2" "ring-h4"))))))
