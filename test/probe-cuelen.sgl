(import (sigil test) (sigil time) (sigil math) (motif tune player) (harkfell tunes))
(define RATE 32000)
(define TH (expt 10.0 -4.0))   ; -80 dBFS
(define BUF (make-bytevector (* 8 1024) 0))
(define (blk-peak)
  (let loop ((i 0) (m 0.0))
    (if (= i 2048) m (loop (+ i 1) (max m (abs (bytevector-ieee-single-ref BUF (* 4 i) 'little)))))))
(define (probe name)
  (let* ((p (open-tune-player (tune-parsed name) RATE loop: #f))
         (t0 (current-jiffy)))
    (let loop ((n 0) (last 0))
      (if (and (< n 200) (player-pull! p BUF 0 1024))
          (loop (+ n 1) (if (> (blk-peak) TH) (+ n 1) last))
          (let ((ms (/ (* 1000.0 (- (current-jiffy) t0)) (jiffies-per-second))))
            (display "PROBE ") (display name) (display " blocks ") (display n)
            (display " audible ") (display last) (display " ms/block ") (display (/ (round (* 100 (/ ms (max n 1)))) 100.0)) (newline))))))
(test-group "probe" (test "cue lengths"
  (for-each probe (list "chirp-a" "chirp-b" "croak-a" "croak-b" "croak-h2" "flurry" "jump" "land-hard" "land-soft" "miss-h2" "miss-h3" "moth-a" "moth-b" "moth-h2" "pickup-h2" "return-tone" "ring-h2" "ring-h3" "song-h2" "splash" "spot-bird" "spot-plop" "step-fen-a" "step-fen-b" "step-grass-a" "step-grass-b" "step-stone-a" "step-stone-b" "step-wood-a" "step-wood-b" "stone-slide" "wall-jump" ))
  (assert-true #t)))
