;;; The wordmark's one showing (D35, (harkfell reveal)), and its schedule.
;;;
;;;   keyed to hollow-answers   a ring heard at the tune's start waits for
;;;                             13.3 s, is full at 15.0 (the arrival), holds to
;;;                             24.0, and is gone by 26.0; a ring after 13.3
;;;                             starts at once
;;;   the fallback              no moment playing: 2 s in, 4 s held, 2 s out
;;;
;;; The shell's trigger, once per save, is test-begin's.

(import (sigil test)
        (sigil list)
        (harkfell reveal))

(define (near? a b) (< (abs (- a b)) 0.001))

(test-group "reveal: keyed to hollow-answers"
  (let ((s (reveal-schedule 0.0)))
    (test "a ring at the tune's start: nothing until 13.3, full at 15.0"
      (assert-equal 0.0 (reveal-alpha s 13.2))
      (assert-true (< 0.0 (reveal-alpha s 14.0) 1.0))
      (assert-true (near? 1.0 (reveal-alpha s 15.01))))
    (test "held to 24.0, gone by 26.0"
      (assert-true (near? 1.0 (reveal-alpha s 23.9)))
      (assert-true (< 0.0 (reveal-alpha s 25.0) 1.0))
      (assert-equal 0.0 (reveal-alpha s 26.01))
      (assert-true (reveal-done? s 26.01))
      (assert-false (reveal-done? s 25.9))))
  (test "a ring at tt 14: it starts at once, and still holds to the tune's 24.0"
    (let ((s (reveal-schedule 14.0)))
      (assert-true (> (reveal-alpha s 0.5) 0.0))
      (assert-true (near? 1.0 (reveal-alpha s 9.9)))
      (assert-equal 0.0 (reveal-alpha s 12.1))))
  (test "a ring after the tune's hold: in over 1.7 s and straight out"
    (let ((s (reveal-schedule 25.0)))
      (assert-true (near? 1.0 (reveal-alpha s 1.7)))
      (assert-true (reveal-done? s 3.8)))))

(test-group "reveal: the fallback, no moment playing"
  (let ((s (reveal-schedule #f)))
    (test "2 s in, 4 s held, 2 s out"
      (assert-true (near? 0.5 (reveal-alpha s 1.0)))
      (assert-true (near? 1.0 (reveal-alpha s 5.0)))
      (assert-true (near? 0.5 (reveal-alpha s 7.0)))
      (assert-equal 0.0 (reveal-alpha s 8.01))
      (assert-true (reveal-done? s 8.0)))))
