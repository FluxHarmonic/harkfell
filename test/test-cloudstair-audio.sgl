;;; Cloudstair's sound through the real director and a headless mixer: the
;;; gust follows the simulation's clock, stays out of the moment duck, and
;;; goes quiet and re-aligns while the clock is frozen; the gap, the seeds,
;;; the down and H5's pickup route. Run through the native audio harness.
(import (sigil test)
        (sigil list)
        (sigil math)
        (engine mixer)
        (harkfell sound))

(define RATE 32000)
(mixer-open-headless! RATE (lambda (id buf n gain) #f))
(define SAID '())
(define (said? . words) (and (member words SAID) #t))
(sound-boot! '("above-the-cloud") (lambda parts (set! SAID (cons parts SAID))))
(sound-reset!)
(sound-set-rng! 7)

;; F, Between Cliffs (8,0): a pulsed lift at columns 11-13; absolute pixels
(define FX (* 400.0 8)) (define FY 0.0)
(define LIFT (list (list 'lift (+ FX 176.0) (+ FY 16.0) 48.0 128.0)))
(define (room key region bed . kw) (apply place key: key region: region bed-tune: bed groups: '(wind water air drone)
                                          levels: '((wind . 0.5) (water . 0.15) (air . 0.7) (drone . 0.3))
                                          carry: '(2 4) tones: '() stones: '() kw))
(define F (room "cloudstair:8,0" 'cloudstair "cloudstair-bed" px: (+ FX 120.0) py: 120.0 rx: 8 ry: 0 gusts: LIFT))
(define S (room "cloudstair:9,-2" 'cloudstair "cloudstair-bed" px: (+ (* 400.0 9) 100.0) py: -200.0 rx: 9 ry: -2
                moment: "above-the-cloud" gusts: (list (list 'lift (+ (* 400.0 9) 176.0) -288.0 48.0 112.0))))
(define I (room "cloudstair:11,0" 'cloudstair "cloudstair-bed" px: (+ (* 400.0 11) 120.0) py: 120.0 rx: 11 ry: 0
                still: #t gaps: (list (list (+ (* 400.0 11) 168.0) 168.0))))
(define K (room "cloudstair:7,-1" 'cloudstair #f px: (+ (* 400.0 7) 100.0) py: -100.0 rx: 7 ry: -1
                seeds: (list (list (+ (* 400.0 7) 200.0) -30.0) (list (+ (* 400.0 7) 88.0) -90.0))))
(define T 0.0)
;; frames at 30 fps; tau advances two ticks a frame unless frozen
(define (run pl frames tau0 . freeze)
  (let loop ((i 0) (tau tau0))
    (when (< i frames)
      (set! T (+ T (/ 1.0 30.0)))
      (sound-frame! T (/ 1.0 30.0) (place pl tau: tau))
      (mixer-pump! T)
      (loop (+ i 1) (if (and (pair? freeze) (car freeze)) tau (modulo (+ tau 2) 600)))))
  (modulo (+ tau0 (if (and (pair? freeze) (car freeze)) 0 (* 2 (- frames 1)))) 600))

;; the loops render on demand: entering a gust room pulls them to the queue's head
(define (until-loops pl)
  (let loop ((k 0))
    (when (and (< k 4000) (not (and (sound-loop 'gust-lift) (sound-loop 'gust-east))))
      (run pl 1 0)
      (loop (+ k 1)))))
(until-loops F)

(define (rms bv from-s to-s)
  (let ((a (exact (round (* from-s RATE)))) (b (exact (round (* to-s RATE)))))
    (let loop ((i a) (e 0.0))
      (if (< i b)
          (let ((x (bytevector-ieee-single-ref bv (* 4 i) 'little))) (loop (+ i 1) (+ e (* x x))))
          (sqrt (/ e (- b a)))))))
(define (db x) (* 20.0 (/ (log (max x 1e-9)) (log 10.0))))
(define (head) (cadr (sound-gust)))
(define (gust-src) (sound-gust-source))
(define (cycle-diff a b) (let ((d (- a b))) (cond ((> d 5.0) (- d 10.0)) ((< d -5.0) (+ d 10.0)) (else d))))

(test-group "cloudstair: the gust's loops"
  (test "both loops are exactly one 10 s cycle"
    (assert-equal (* 4 10 RATE) (bytevector-length (sound-loop 'gust-lift)))
    (assert-equal (* 4 10 RATE) (bytevector-length (sound-loop 'gust-east))))
  (test "calm is silent once the rush has released (by 1.5 s), the warning sounds in its last second, the rush after tau 360"
    (for-each
      (lambda (n)
        (let ((bv (sound-loop n)))
          (assert-true (< (db (rms bv 1.5 4.95)) -80.0))
          (assert-true (> (db (rms bv 5.3 6.0)) -45.0))
          (assert-true (> (db (rms bv 6.05 9.9)) -40.0))
          ;; the rush is broader and louder than the warning's start
          (assert-true (> (rms bv 6.0 6.6) (* 2.0 (rms bv 5.0 5.5))))))
      '(gust-lift gust-east)))
  (test "the rush's release is folded onto the cycle's start, then fades"
    (let ((bv (sound-loop 'gust-lift)))
      (assert-true (> (db (rms bv 0.0 0.1)) -40.0))
      (assert-true (< (db (rms bv 1.0 1.5)) -50.0)))))

(test-group "cloudstair: the gust follows tau"
  (test "entering mid-gust plays the rush where the physics is (tau 450 -> 7.5 s), not a warning"
    (sound-reset!)
    (run F 1 450)
    (assert-true (sound-gust))
    (assert-equal 'gust-lift (car (sound-gust)))
    (assert-true (< (abs (cycle-diff (head) 7.5)) 0.06)))
  (test "two seconds of play keep it on the clock"
    (let ((tau (run F 60 451)))
      (assert-true (< (abs (cycle-diff (head) (/ tau 60.0))) 0.06))))
  (test "a frozen clock (a soft return's fade) silences it, and on release it re-aligns to tau"
    (let* ((tau (run F 30 100 #t)))
      (assert-true (caddr (sound-gust)))
      (assert-true (< (source-factor (gust-src) 'freeze T) 0.01))
      (let ((tau2 (run F 6 (+ tau 2))))
        (assert-false (caddr (sound-gust)))
        (assert-true (< (abs (cycle-diff (head) (/ tau2 60.0))) 0.1)))))
  (test "an eastward gap gives the east loop, a room with no timed field none"
    (run (place F gusts: (list (list 'east (+ FX 160.0) 16.0 64.0 128.0))) 2 200)
    (assert-equal 'gust-east (car (sound-gust)))
    (run (place F gusts: '()) 30 210)
    (assert-false (sound-gust))))

(test-group "cloudstair: the gust under S's moment"
  (test "the moment plays and ducks the bed, but never the gust"
    (sound-reset!)
    (set! SAID '())
    (sound-preopen! "above-the-cloud")
    (run S 60 200)
    (assert-equal "above-the-cloud" (sound-moment-playing))
    (let ((g (gust-src)))
      (assert-true g)
      (assert-equal 1.0 (source-factor g 'duck T))
      (assert-true (> (source-gain g T) 0.1))))
  (test "the warning and the rush's start dip the moment 3 dB, and it comes back"
    (run S 45 320)
    ;; a literal, not GUST-MOMENT-DIP: a test reading the constant moves with it
    (assert-true (< (source-factor (mixer-find MOMENT-ID) 'gust T) 0.75))
    (run S 60 440)
    (assert-true (> (source-factor (mixer-find MOMENT-ID) 'gust T) 0.98))))

(test-group "cloudstair: the gap, the seeds, the down, H5"
  (test "near a deep gap its draught sounds, and the ears are not drawn to it"
    (sound-reset!)
    (run I 45 0)
    (assert-true (sound-voice-source "local-gap"))
    (assert-equal 'up (sound-ears))
    (run (place I gaps: '()) 30 0)
    (assert-false (sound-voice-source "local-gap")))
  (test "before H5 the seeds click and chirr, and never answer"
    (sound-reset!)
    (run K (* 30 120) 0)
    (let ((calls (sound-seed-calls)))
      (assert-true (> (length calls) 8))
      (assert-true (every (lambda (n) (memq n '(seed-click seed-chirr))) calls))))
  (test "carrying H5 they answer now and then, F#5/A5, no more than one every 9 s"
    (sound-reset!)
    (run (place K carry: '(2 4 5)) (* 30 120) 0)
    (let ((answers (filter (lambda (n) (memq n '(seed-answer-a seed-answer-b))) (sound-seed-calls))))
      (assert-true (> (length answers) 1))
      (assert-true (<= (length answers) 14))))
  (test "the down's arrival and H5's pickup find their cues"
    (set! SAID '())
    (run (place K news: '((down 100.0 100.0) (pickup 5 120.0 100.0))) 1 0)
    (assert-false (said? "sound" "cue-missing" "down-settles"))
    (assert-false (said? "sound" "cue-missing" "pickup-h5"))
    (assert-true (or (said? "sound" "cue" "down-settles") (said? "sound" "cue-waiting" "down-settles")))
    (assert-true (or (said? "sound" "cue" "pickup-h5") (said? "sound" "cue-waiting" "pickup-h5"))))
  (test "the down opens with a soft sound as a glide starts, once, not on every frame of it"
    (sound-reset!)
    (run K 2 0)
    (run (place K gliding: #t) 1 0)
    (assert-true (assq 'glide-open (sound-moved)))
    ;; held for a second and a half: still the one opening
    (let loop ((i 0) (n 0))
      (if (< i 45)
          (begin (run (place K gliding: #t) 1 0)
                 (loop (+ i 1) (if (assq 'glide-open (sound-moved)) (+ n 1) n)))
          (assert-equal 0 n))))
  (test "a glide let go and taken again within 0.4 s does not open it again"
    (run (place K gliding: #f) 15 0)
    (run (place K gliding: #t) 1 0)
    (assert-true (assq 'glide-open (sound-moved)))
    (run (place K gliding: #f) 2 0)
    (run (place K gliding: #t) 1 0)
    (assert-false (assq 'glide-open (sound-moved)))
    (run (place K gliding: #f) 12 0)
    (run (place K gliding: #t) 1 0)
    (assert-true (assq 'glide-open (sound-moved)))))
