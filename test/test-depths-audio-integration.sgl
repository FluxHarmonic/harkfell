(import (sigil test)
        (sigil list)
        (engine body)
        (engine mixer)
        (engine reach)
        (engine worldmap)
        (harkfell content)
        (harkfell source)
        (harkfell feel)
        (harkfell gates)
        (harkfell world)
        (harkfell audio)
        (harkfell sound)
        (harkfell shell))

(define CT (load-content (read-world-source "world")))
(define SAID '())
(define (prepared-director!)
  (shell-test-room!)
  (mixer-open-headless! 32000 #f)
  (sound-reset!)
  (sound-set-work-in-frame! #t)
  (sound-boot! '() (lambda parts (set! SAID (cons parts SAID))))
  (let loop ((frame 0))
    (when (< frame 1500)
      (let ((now (* frame 0.02)))
        (sound-frame! now 0.02 #f)
        (mixer-pump! now))
      (loop (+ frame 1))))
  (set! SAID '()))

(test-group "depths: real adapter reaches the final director"
  (test "a real full-key heart ring plays ring-heart through world-place"
    (prepared-director!)
    (let* ((heart (find stone-heart? (content-stones CT)))
           (cell (stone-cell heart))
           (tm (worldmap-tiles (content-map CT)))
           (w (world-populate
                (world-at (content-map CT)
                          (cell-body tm HARKFELL-FEEL (car cell) (- (cdr cell) 1)))
                (content-stones CT) (content-pickups CT) '(2 3 4 5)))
           (rung (world-tick w (intent)))
           (pl (world-place rung CT (world-news rung))))
      (assert-true (find (lambda (item)
                           (and (eq? (car item) 'ring) (eq? (cadr item) 'heart)))
                         (place-news pl)))
      (sound-frame! 30.0 0.02 pl)
      (mixer-pump! 30.0)
      (assert-true (member '("sound" "cue" "ring-heart") SAID))))
  (test "the fifth bench plays its H7 ring on the event frame"
    (prepared-director!)
    (sound-frame! 30.0 0.02
      (place key: "underhum:8,6" region: 'underhum carry: '(2 3 4 5 7)
             news: '((bench 7 3240.0 1192.0))))
    (mixer-pump! 30.0)
    (assert-true (member '("sound" "cue" "ring-h7") SAID))))
