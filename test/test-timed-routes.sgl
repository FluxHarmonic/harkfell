(import (sigil list) (sigil test)
        (engine body) (engine tilemap) (engine reach)
        (engine reach timed) (engine reach waits) (engine reach routes)
        (harkfell feel))

(define F HARKFELL-FEEL)
(define TM
  (let floor ((c 0) (tm (make-tilemap 8 4 16)))
    (if (= c 8) tm (floor (+ c 1) (tilemap-set tm c 3 'solid)))))
(define START
  (timed-node body: (body (stand-body TM F 1 2) down: #t tau: 359) data: '(2 4)))
(define SCRIPT (append (make-list 30 (intent h: 1)) (make-list 30 NO-INTENT)))
(define (step node in)
  (timed-node node body: (body-step (timed-node-body node) in TM F)))
(define END (car (reverse (timed-run step START SCRIPT))))
(define TARGET (rest-cell TM F (timed-node-body END)))
(define (guide target)
  (let ((edges (make-vector 32 '())))
    (vector-set! edges (cell-index TM 1 2)
                 (list (cons (cell-index TM (car target) (cdr target))
                             (witness from: '(1 . 2) script: SCRIPT))))
    (reach-graph tm: TM cells: (standable-cells TM) starts: '((1 . 2)) edges: edges)))
(define (finder graph advance bound record! incomplete!)
  (timed-route-finder advance (lambda (carry) TM) F (lambda (node) graph)
                      (lambda (node) (timed-shelter? TM F advance node))
                      (timed-waiter TM F advance) bound record! incomplete!))

(test-group "timed routes: suggestions require actual replay"
  (test "arrival is the actual full body and phase, rather than a cell seed"
    (let* ((route (finder (guide TARGET) step 20 (lambda (node) #t) (lambda () #t)))
           (arrival (route START TARGET)))
      (assert-true arrival)
      (assert-equal (timed-key END) (timed-key arrival))
      (assert-false (equal? '(1 . 2) TARGET))
      (assert-equal 419 (body-tau (timed-node-body arrival)))))
  (test "a candidate's falsely labelled destination cannot establish reach"
    (let* ((claimed '(7 . 2))
           (route (finder (guide claimed) step 20 (lambda (node) #t) (lambda () #t))))
      (assert-false (route START claimed))))
  (test "mid-route acquisition preserves the real body and phase"
    (let* ((take (lambda (node in)
                   (let ((next (step node in)))
                     (timed-node next data: '(2 4 5)))))
           (route (finder (guide TARGET) take 20 (lambda (node) #t) (lambda () #t)))
           (arrival (route START TARGET)))
      (assert-true arrival)
      (assert-equal '(2 4 5) (timed-node-data arrival))
      (assert-equal (timed-key (timed-node END data: '(2 4 5))) (timed-key arrival))))
  (test "a hard route bound signals incomplete and cannot provide a witness"
    (let* ((incomplete #f)
           (route (finder (guide TARGET) step 0 (lambda (node) #t)
                          (lambda () (set! incomplete #t)))))
      (assert-false (route START TARGET))
      (assert-true incomplete)))
  (test "an optimistic direct suggestion cannot hide a real route through a waiting rest"
    (let* ((goal '(7 . 2))
           (edges (make-vector 32 '()))
           (second (append (make-list 50 (intent h: 1)) (make-list 30 NO-INTENT))))
      ;; The claimed direct edge fails actual replay. It makes both the start
      ;; and the intermediate rest one suggested hop from the goal; physical
      ;; progress through that rest must not be pruned by that optimistic cost.
      (vector-set! edges (cell-index TM 1 2)
        (list (cons (cell-index TM 7 2) (witness from: '(1 . 2) script: (list NO-INTENT)))
              (cons (cell-index TM (car TARGET) (cdr TARGET))
                    (witness from: '(1 . 2) script: SCRIPT))))
      (vector-set! edges (cell-index TM (car TARGET) (cdr TARGET))
        (list (cons (cell-index TM 7 2) (witness from: TARGET script: second))))
      (let* ((graph (reach-graph tm: TM cells: (standable-cells TM) edges: edges))
             (route (finder graph step 20 (lambda (node) #t) (lambda () #t)))
             (arrival (route START goal))
             (fresh (car (reverse (timed-run step END second)))))
        (assert-true arrival)
        (when arrival
          (assert-equal goal (rest-cell TM F (timed-node-body arrival)))
          (assert-equal (timed-key fresh) (timed-key arrival))))))
  (test "a real standing goal before a hazardous suffix is a valid prefix"
    (let* ((hazard-tm (tilemap-set TM 7 2 'hazard))
           (advance
             (lambda (node in)
               (let ((b (body-step (timed-node-body node) in hazard-tm F)))
                 (and (not (memq 'hazard (body-events b)))
                      (timed-node node body: b)))))
           (script (append SCRIPT (make-list 80 (intent h: 1))))
           (edges (make-vector 32 '())))
      (vector-set! edges (cell-index TM 1 2)
        (list (cons (cell-index TM (car TARGET) (cdr TARGET))
                    (witness from: '(1 . 2) script: script))))
      (let* ((graph (reach-graph tm: hazard-tm cells: (standable-cells hazard-tm)
                                 edges: edges))
             (route (timed-route-finder advance (lambda (carry) hazard-tm) F
                      (lambda (node) graph)
                      (lambda (node) (timed-shelter? hazard-tm F advance node))
                      (timed-waiter hazard-tm F advance)
                      20 (lambda (node) #t) (lambda () #t)))
             (arrival (route START TARGET))
             (prefix (timed-run advance START SCRIPT)))
        (assert-false (timed-run advance START script))
        (assert-true arrival)
        (when arrival
          (assert-true
            (find (lambda (node) (equal? (timed-key node) (timed-key arrival)))
                  prefix))
          (assert-equal TARGET (rest-cell hazard-tm F (timed-node-body arrival)))))))
  (test "cyclic suggestions cannot spend the bound before a real sibling route"
    (let* ((goal '(7 . 2))
           (out (append (make-list 50 (intent h: 1)) (make-list 30 NO-INTENT)))
           (middle (car (reverse (timed-run step START out))))
           (middle-cell (rest-cell TM F (timed-node-body middle)))
           (back (append (make-list 30 (intent h: -1)) (make-list 30 NO-INTENT)))
           (finish (append (make-list 30 (intent h: 1)) (make-list 30 NO-INTENT)))
           (edges (make-vector 32 '())))
      ;; Both cyclic rests have an optimistic one-hop suggestion to the goal.
      ;; Those suggestions do not move. Their real cycle changes the exact
      ;; clock and body, so a depth-first search can starve the useful sibling.
      (vector-set! edges (cell-index TM 1 2)
        (list (cons (cell-index TM 7 2)
                    (witness from: '(1 . 2) script: (list NO-INTENT)))
              (cons (cell-index TM (car TARGET) (cdr TARGET))
                    (witness from: '(1 . 2) script: SCRIPT))
              (cons (cell-index TM (car middle-cell) (cdr middle-cell))
                    (witness from: '(1 . 2) script: out))))
      (vector-set! edges (cell-index TM (car TARGET) (cdr TARGET))
        (list (cons (cell-index TM 7 2)
                    (witness from: TARGET script: (list NO-INTENT)))
              (cons (cell-index TM 1 2) (witness from: TARGET script: back))))
      (vector-set! edges (cell-index TM (car middle-cell) (cdr middle-cell))
        (list (cons (cell-index TM 7 2) (witness from: middle-cell script: finish))))
      (let* ((incomplete #f)
             (graph (reach-graph tm: TM cells: (standable-cells TM) edges: edges))
             (route (finder graph step 8 (lambda (node) #t)
                            (lambda () (set! incomplete #t))))
             (arrival (route START goal))
             (fresh (car (reverse (timed-run step START (append out finish))))))
        (assert-true arrival)
        (assert-false incomplete)
        (when arrival
          (assert-equal (timed-key fresh) (timed-key arrival))))))
  (test "a composite's real intermediate rest can wait and resume a local route"
    (let* ((hazard-tm (tilemap-set TM 7 2 'hazard))
           (advance
             (lambda (node in)
               (let ((b (body-step (timed-node-body node) in hazard-tm F)))
                 (and (not (memq 'hazard (body-events b)))
                      (timed-node node body: b)))))
           (finish (append (make-list 30 (intent h: 1)) (make-list 30 NO-INTENT)))
           (fresh (car (reverse (timed-run advance END finish))))
           (goal (rest-cell hazard-tm F (timed-node-body fresh)))
           (composite (append SCRIPT (make-list 80 (intent h: 1))))
           (edges (make-vector 32 '())))
      ;; The composite reaches a real waiting rest, then its later departure
      ;; is mistimed and hazardous. That prefix offers a legal place to stop
      ;; and replay a different local suggestion; no new body may be seeded.
      (vector-set! edges (cell-index TM 1 2)
        (list (cons (cell-index TM (car goal) (cdr goal))
                    (witness from: '(1 . 2) script: composite))))
      (vector-set! edges (cell-index TM (car TARGET) (cdr TARGET))
        (list (cons (cell-index TM (car goal) (cdr goal))
                    (witness from: TARGET script: finish))))
      (let* ((graph (reach-graph tm: hazard-tm cells: (standable-cells hazard-tm)
                                 edges: edges))
             (route (timed-route-finder advance (lambda (carry) hazard-tm) F
                      (lambda (node) graph)
                      (lambda (node) (timed-shelter? hazard-tm F advance node))
                      (timed-waiter hazard-tm F advance)
                      20 (lambda (node) #t) (lambda () #t)))
             (arrival (route START goal)))
        (assert-false (timed-run advance START composite))
        (assert-true arrival)
        (when arrival
          (assert-equal (timed-key fresh) (timed-key arrival))))))
  (test "phase-varying hidden fields retain every real intermediate rest"
    (let* ((hazard-tm (tilemap-set TM 7 2 'hazard))
           (advance
             (lambda (node in)
               (let* ((b (timed-node-body node))
                      (cell (rest-cell hazard-tm F b)))
                 (and (not (and (equal? cell TARGET)
                                (= (body-vx b) 0)
                                (> (intent-h in) 0)
                                (not (<= 400 (body-tau b) 407))))
                      (let* ((next (body-step b in hazard-tm F))
                             (tau (body-tau next))
                             (side (if (or (<= 400 tau 407) (<= 411 tau 418)) -1 1)))
                        (and (not (memq 'hazard (body-events next)))
                             (timed-node node body: (body next side: side))))))))
           (finish (append (make-list 30 (intent h: 1)) (make-list 30 NO-INTENT)))
           (prefix (timed-run advance START SCRIPT))
           (anchor (find (lambda (node) (= (body-tau (timed-node-body node)) 407)) prefix))
           (fresh (car (reverse (timed-run advance anchor finish))))
           (goal (rest-cell hazard-tm F (timed-node-body fresh)))
           (composite (append SCRIPT (make-list 80 (intent h: 1))))
           (edges (make-vector 32 '())))
      ;; Two equal-looking poses share side=-1 at different phases. Their
      ;; no-input cycle changes that hidden field, and only the earlier
      ;; departure is useful. A shelter's position-only test is insufficient.
      (vector-set! edges (cell-index TM 1 2)
        (list (cons (cell-index TM (car goal) (cdr goal))
                    (witness from: '(1 . 2) script: composite))))
      (vector-set! edges (cell-index TM (car TARGET) (cdr TARGET))
        (list (cons (cell-index TM (car goal) (cdr goal))
                    (witness from: TARGET script: finish))))
      (let* ((graph (reach-graph tm: hazard-tm cells: (standable-cells hazard-tm)
                                 edges: edges))
             (route (timed-route-finder advance (lambda (carry) hazard-tm) F
                      (lambda (node) graph)
                      (lambda (node) (timed-shelter? hazard-tm F advance node))
                      (timed-waiter hazard-tm F advance)
                      40 (lambda (node) #t) (lambda () #t)))
             (arrival (route START goal)))
        (assert-false (timed-run advance START composite))
        (assert-true arrival)
        (when arrival
          (assert-equal (timed-key fresh) (timed-key arrival)))))))

(test-group "timed routes: optimistic hints are not physical distance"
  (test "a cheap cyclic hint cannot starve a nearby actual continuation"
    (let* ((goal '(7 . 2))
           (out (append (make-list 50 (intent h: 1)) (make-list 30 NO-INTENT)))
           (middle (car (reverse (timed-run step START out))))
           (middle-cell (rest-cell TM F (timed-node-body middle)))
           (back (append (make-list 30 (intent h: -1)) (make-list 30 NO-INTENT)))
           (finish (append (make-list 30 (intent h: 1)) (make-list 30 NO-INTENT)))
           (edges (make-vector 32 '()))
           (hints (append (map (lambda (c) (cons c 0)) (iota 8))
                          (map (lambda (c) (cons c 1)) (iota 8)))))
      (define (put from target script)
        (vector-set! edges (cell-index TM (car from) (cdr from))
          (cons (cons (cell-index TM (car target) (cdr target))
                      (witness from: from script: script))
                (vector-ref edges (cell-index TM (car from) (cdr from))))))
      (put '(1 . 2) middle-cell out)
      (put '(1 . 2) TARGET SCRIPT)
      (put '(1 . 2) goal (list NO-INTENT))
      (put TARGET '(1 . 2) back)
      (put TARGET goal (list NO-INTENT))
      ;; These labels give the useful physical script a long frozen cost.
      ;; The labels are suggestions: finish really reaches the nearby goal.
      (put middle-cell (car hints) finish)
      (let link ((cells hints))
        (when (pair? cells)
          (put (car cells) (if (pair? (cdr cells)) (cadr cells) goal) (list NO-INTENT))
          (link (cdr cells))))
      (let* ((incomplete #f)
             (graph (reach-graph tm: TM cells: (standable-cells TM) edges: edges))
             (route (finder graph step 20 (lambda (node) #t)
                            (lambda () (set! incomplete #t))))
             (arrival (route START goal))
             (fresh (car (reverse (timed-run step START (append out finish))))))
        (assert-equal goal (rest-cell TM F (timed-node-body fresh)))
        (assert-true arrival)
        (assert-false incomplete)
        (when arrival
          (assert-equal goal (rest-cell TM F (timed-node-body arrival))))))))

(test-group "timed routes: a complete hidden-field phase cycle"
  (test "a broad frontier keeps the actual phase-specific departure"
    (let* ((hazard-tm (tilemap-set TM 7 2 'hazard))
           (advance
             (lambda (node in)
               (let* ((b (timed-node-body node))
                      (cell (rest-cell hazard-tm F b)))
                 (and (not (and (equal? cell TARGET)
                                (= (body-vx b) 0)
                                (> (intent-h in) 0)
                                (not (= (body-tau b) 407))))
                      (let* ((next (body-step b in hazard-tm F))
                             (tau (body-tau next))
                             (side (if (or (<= 400 tau 407) (<= 411 tau 418)) -1 1)))
                        (and (not (memq 'hazard (body-events next)))
                             (timed-node node body: (body next side: side))))))))
           (long-prefix (append (make-list 30 (intent h: 1)) (make-list 600 NO-INTENT)))
           (finish (append (make-list 30 (intent h: 1)) (make-list 30 NO-INTENT)))
           (prefix (timed-run advance START long-prefix))
           (anchor (find (lambda (node) (= (body-tau (timed-node-body node)) 407)) prefix))
           (fresh (car (reverse (timed-run advance anchor finish))))
           (goal (rest-cell hazard-tm F (timed-node-body fresh)))
           (composite (append long-prefix (make-list 80 (intent h: 1))))
           (edges (make-vector 32 '())))
      ;; The rest really traverses the whole clock with a varying body field.
      ;; Its one useful departure is retained as the actual replayed node.
      (vector-set! edges (cell-index TM 1 2)
        (list (cons (cell-index TM (car goal) (cdr goal))
                    (witness from: '(1 . 2) script: composite))))
      (vector-set! edges (cell-index TM (car TARGET) (cdr TARGET))
        (list (cons (cell-index TM (car goal) (cdr goal))
                    (witness from: TARGET script: finish))))
      (let* ((graph (reach-graph tm: hazard-tm cells: (standable-cells hazard-tm)
                                 edges: edges))
             (route (timed-route-finder advance (lambda (carry) hazard-tm) F
                      (lambda (node) graph)
                      (lambda (node) (timed-shelter? hazard-tm F advance node))
                      (timed-waiter hazard-tm F advance)
                      1200 (lambda (node) #t) (lambda () #t)))
             (arrival (route START goal)))
        (assert-false (timed-run advance START composite))
        (assert-true arrival)
        (when arrival
          (assert-equal (timed-key fresh) (timed-key arrival)))))))
