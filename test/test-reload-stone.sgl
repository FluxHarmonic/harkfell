;;; Live reload while standing in an opened ring-stone's cell keeps the body
;;; where it is (the A3 review's finding 5: the reload looked for rock in the
;;; content's map, where the stone is still solid, and sent the body to the
;;; room's entry). Driven through the shell, as live reload runs it.

(import (sigil test)
        (sigil list)
        (sigil math)
        (engine body)
        (harkfell world)
        (harkfell source)
        (harkfell feel)
        (harkfell gates)
        (harkfell shell)
        (harkfell content)
        (engine worldmap))

(define SRC (read-world-source "world"))
(shell-boot!)
(shell-load-content! SRC)
(shell-set-carry! '(2))
(shell-goto! "reedfen:10,3" (cons 18 8))

(define (frames n) (let loop ((k 0)) (when (< k n) (shell-frame! (/ 1 60.0)) (loop (+ k 1)))))
(define (body-col) (exact (floor (/ (car (body-center (world-body (shell-world)) HARKFELL-FEEL)) 16))))
;; the Old Stone's ring-stone (x10y3, cell (21,8)), found by its place: the
;; Hollow (A4) has two more
(define OLD-STONE-CELL (cons (+ 21 (* 25 (- 10 (worldmap-x0 (content-map (shell-content)))))) (+ 8 (* 11 (- 3 (worldmap-y0 (content-map (shell-content))))))))
(define (the-stone) (find (lambda (s) (equal? (stone-cell s) OLD-STONE-CELL)) (world-stones (shell-world))))
(define (stone-col) (car (stone-cell (the-stone))))

;; the stone rings and opens with the body standing three tiles off
(frames 150)
(define OPENED (stone-state (the-stone)))
;; then walk right until the body's centre is in the stone's column, and stop
(shell-key-down! 'right)
(let loop ((k 0)) (when (and (< k 120) (< (body-col) (stone-col))) (frames 1) (loop (+ k 1))))
(shell-key-up! 'right)
(frames 30)
(define BEFORE (world-body (shell-world)))
(define IN-CELL (= (body-col) (stone-col)))
;; a reload of the Old Stone's own file, unchanged
(define PS (shell-replace-file! "world/rooms/reedfen/x10y3.room" (cdr (assoc "world/rooms/reedfen/x10y3.room" SRC))))
(define AFTER (world-body (shell-world)))
;; snapshotted here: every top-level form below runs before any test does
(define STONE-AFTER-1 (stone-state (the-stone)))

(test-group "reload: standing in an opened stone's cell"
  (test "the stone opened, and the body stands in its column"
    (assert-equal 'open OPENED)
    (assert-true IN-CELL))
  (test "a clean reload leaves the body where it was, and the stone open"
    (assert-equal '() PS)
    (assert-true (< (abs (- (body-x AFTER) (body-x BEFORE))) 0.01))
    (assert-equal 'open STONE-AFTER-1)))

;; A reload that moves the map's origin (Glasswood's rooms are written room by
;; room, each further west, under live reload). A room added at x -2 moves the
;; origin from x -1 to x -2, every global cell 25 columns east; the body must
;; stay in the Old Stone and the opened stone stay open (the review of phase 1:
;; the body went one room west and the stone read shut).
(define WEST-ROOM
  (string-append
    "(room\n  region: glasswood\n  at: (-2 3)\n  title: \"Probe West\"\n  intent: \"a sealed room west of First Sight\"\n  grid:\n  ("
    "\"#########################\"\n   \"#                       #\"\n   \"#                       #\"\n   \"#                       #\"\n"
    "   \"#                       #\"\n   \"#                       #\"\n   \"#                       #\"\n   \"#                       #\"\n"
    "   \"#                       #\"\n   \"#########################\"\n   \"#########################\"))\n"))
(define WEST-MAP
  (string-append
    "(map\n  region: glasswood\n  origin: (-2 3)\n  layout:\n  (\"C B-A\" \"     \" \"     \" \"     \" \"  U  \")\n  rooms:\n"
    "  ((A \"The Scree\" \"through the old stone door, scree falls away west into mist, and the birches glitter far below\")\n"
    "   (B \"First Sight\" \"the scree's last shoulder over the mist, where the whole glazed wood glitters below: a breath\")\n"
    "   (C \"Probe West\" \"a sealed room west of First Sight\")\n"
    "   (U \"Root Ice\" \"a low cave where the birches' roots hang down through the ice: a breath in the dark\"))\n  borders: ((A east)))\n"))
(define X0-BEFORE (worldmap-x0 (content-map (shell-content))))
(define PS2 (shell-replace-files! (list (cons "world/rooms/glasswood/x-2y3.room" WEST-ROOM)
                                        (cons "world/regions/glasswood.map" WEST-MAP))))
(define X0-AFTER (worldmap-x0 (content-map (shell-content))))
(define STONE-AFTER (cons (+ 21 (* 25 (- 10 X0-AFTER))) (+ 8 (* 11 (- 3 (worldmap-y0 (content-map (shell-content))))))))

(test-group "reload: the map's origin moves west"
  (test "the reload is clean and moves the origin from x -1 to x -2"
    (assert-equal '() PS2)
    (assert-equal -1 X0-BEFORE)
    (assert-equal -2 X0-AFTER))
  (test "the body stays in the Old Stone, where it stood"
    (assert-equal "reedfen:10,3" (shell-room-label))
    (assert-true (< (abs (- (body-x (world-body (shell-world))) (+ (body-x AFTER) 400.0))) 0.01)))
  (test "and the opened stone stays open"
    (assert-equal 'open (stone-state (find (lambda (s) (equal? (stone-cell s) STONE-AFTER)) (world-stones (shell-world)))))))
