;;; A game begun from the start, through the shell (A4): the frame runs
;;; before the world, the save is written as you play, a continue comes back
;;; to it, and a door neither runs the frame nor touches the save.
;;;
;;;   new game     the world does not step until the dawn; once playing, a
;;;                save is written, in the world's start room
;;;   continue     a save at the Reed Bridge, carrying H2, with the Old Stone
;;;                opened, comes back as all three
;;;   a door       after a goto the save on disk is left as it was, however
;;;                far the body walks
;;;
;;;   start over   (D40) a continue offers it: R held 1.6 s, or a long press on
;;;                the line, wipes the save for a new game; a shorter hold,
;;;                or a tap, does not
;;;   the pause    (D40) paused, the world does not step; resumed, it does
;;;
;;; The store is pointed at a scratch directory, so no real save is touched.

(import (sigil test)
        (sigil list)
        (sigil math)
        (sigil fs)
        (sigil time)
        (engine body)
        (substratic store kv)
        (engine worldmap)
        (harkfell world)
        (harkfell source)
        (harkfell content)
        (harkfell check)
        (harkfell feel)
        (harkfell gates)
        (harkfell save)
        (harkfell shell))

(define SRC (read-world-source "world"))
(define DIR (string-append "/tmp/harkfell-test-begin-" (number->string (current-jiffy))))
(shell-boot!)
(set-store-root! DIR)
(store-remove! SAVE-KEY)
(shell-load-content! SRC)
(define CT (shell-content))

(define (frames n) (let loop ((k 0)) (when (< k n) (shell-frame! (/ 1 60.0)) (loop (+ k 1)))))
(define (body-now) (world-body (shell-world)))

;; --- a new game ---------------------------------------------------------------------
(define NOTES (shell-begin! #f #f))
(define B0 (body-now))
(define TICKS0 (world-ticks (shell-world)))
(frames 300)                                   ; 5 s: the start screen and the card
(define PHASE-5S (shell-frame-phase))
(define STILL-5S (= (world-ticks (shell-world)) TICKS0))
(frames 900)                                   ; 15 s more: well into play
(define PHASE-20S (shell-frame-phase))
(define SAVED (store-read-datum SAVE-KEY))

(test-group "begin: a new game"
  (test "no save: a new game"
    (assert-false NOTES))
  (test "five seconds in, the frame runs and the world has not stepped"
    (assert-true (memq PHASE-5S (list 'start-out 'card)))
    (assert-true STILL-5S))
  (test "twenty seconds in, it plays, and a save is written in the start's room"
    (assert-equal 'play PHASE-20S)
    (assert-true (pair? SAVED))
    (let ((r (save-restore CT SAVED)))
      (assert-true (restored? r))
      (assert-equal (start-cell CT) (restored-cell r)))))

;; --- a continue ------------------------------------------------------------------------
(define (global x y c r) (local->global CT (content-room CT x y) c r))
(define STONE-G (global 10 3 21 8))
(define CONT
  (save-datum CT
              (cell-body (worldmap-tiles (content-map CT)) HARKFELL-FEEL (car (global 9 3 4 7)) (cdr (global 9 3 4 7)))
              (list 2)
              (map (lambda (s) (if (equal? (stone-cell s) STONE-G) (stone s state: 'open) s)) (content-stones CT))
              (list "reedfen:9,3") 100.0))
(define NOTES2 (shell-begin! #f CONT))
;; snapshots here: every top-level form runs before any test does
(define CELL2 (let ((c (body-center (body-now) HARKFELL-FEEL)))
                (cons (exact (floor (/ (car c) 16))) (exact (floor (/ (cdr c) 16))))))
(define CARRY2 (world-carry (shell-world)))
(define STONE2 (and (find (lambda (s) (and (equal? (stone-cell s) STONE-G) (stone-open? s)))
                          (world-stones (shell-world)))
                    #t))

(test-group "begin: a continue"
  (test "nothing forgiven"
    (assert-equal '() NOTES2))
  (test "the body stands in the Reed Bridge, where the save was"
    (assert-equal (global 9 3 4 7) CELL2))
  (test "carrying H2, and the Old Stone open"
    (assert-equal '(2) CARRY2)
    (assert-true STONE2)))

;; --- a door --------------------------------------------------------------------------------
(frames 1200)                                  ; into play; the continue's save is written
(define BEFORE-DOOR (store-get SAVE-KEY))
(shell-goto! "reedfen:10,4")
(shell-key-down! 'left)
(frames 240)                                   ; walk west, into the Drowned Channel
(shell-key-up! 'left)
(frames 30)
(define ROOM-AFTER (shell-room-label))
(define AFTER-DOOR (store-get SAVE-KEY))
;; a door taken while a begun game's frame is still on its start screen: the
;; frame ends and the world steps at once (the review: the old form of this
;; test could not fail, the frame having reached play long before)
(shell-begin! #f #f)
(frames 30)
(define PHASE-BEFORE-DOOR (shell-frame-phase))
(shell-goto! "reedfen:10,4")
(define TICKS-AT-DOOR (world-ticks (shell-world)))
(frames 10)
(define PHASE-DOOR (shell-frame-phase))
(define STEPPED-AFTER-DOOR (> (world-ticks (shell-world)) TICKS-AT-DOOR))

(test-group "begin: a door"
  (test "the door's walk left its room (the premise), and the save is as it was"
    (assert-false (string=? ROOM-AFTER "reedfen:10,4"))
    (assert-true (string? BEFORE-DOOR))
    (assert-equal BEFORE-DOOR AFTER-DOOR))
  (test "a door taken on the start screen ends the frame, and the world steps at once"
    (assert-true (memq PHASE-BEFORE-DOOR (list 'start-in 'start)))
    (assert-equal 'play PHASE-DOOR)
    (assert-true STEPPED-AFTER-DOOR)))

;; --- the review's finding 1: input given before the world must not move it --------
;; A jump pressed on the start screen, and a key held down from the card on,
;; leave the creature where it woke on the dawn's first ticks (D15).
(store-remove! SAVE-KEY)
(shell-begin! #f #f)
(define B-WAKE (body-now))
(frames 30)
(shell-key-down! 'space)
(frames 1)
(shell-key-up! 'space)
(let loop ((k 0)) (when (and (< k 900) (not (eq? (shell-frame-phase) 'card))) (frames 1) (loop (+ k 1))))
(shell-key-down! 'right)
(let loop ((k 0)) (when (and (< k 900) (not (eq? (shell-frame-phase) 'dawn))) (frames 1) (loop (+ k 1))))
(define PHASE-AT (shell-frame-phase))
(frames 30)
(define B-DAWN (body-now))
(shell-key-up! 'right)

(test-group "begin: nothing given before the world moves it"
  (test "the dawn came (the premise)"
    (assert-equal 'dawn PHASE-AT))
  (test "half a second into the dawn the creature is where it woke, on the ground"
    (assert-true (< (abs (- (body-x B-DAWN) (body-x B-WAKE))) 0.01))
    (assert-true (< (abs (- (body-y B-DAWN) (body-y B-WAKE))) 0.01))
    (assert-equal 'ground (body-mode B-DAWN))))

;; --- D35: the wordmark's one showing, at the first homecoming ---------------------
;; A continue at the start (the bowl's bottom, beside its H2 stone), carrying
;; H2, the stone still shut, the save never revealed: once the world steps
;; the stone rings, and the wordmark shows. The save says so at once; a
;; continue from it shows nothing when the (now open) stone rings again.
(define HOME
  (save-datum CT
              (cell-body (worldmap-tiles (content-map CT)) HARKFELL-FEEL (car (start-cell CT)) (cdr (start-cell CT)))
              (list 2) (content-stones CT) '() 0.0))
(shell-begin! #f HOME)
(define (max-alpha n)
  (let loop ((k 0) (m 0.0))
    (if (>= k n) m (begin (shell-frame! (/ 1 60.0)) (loop (+ k 1) (max m (shell-reveal-alpha)))))))
(define SHOWN (max-alpha 1500))                ; 25 s: the frame, the ring, the showing
(define REVEALED (shell-revealed?))
(define AFTER-HOME (store-read-datum SAVE-KEY))
(define REST (save-restore CT AFTER-HOME))
(shell-begin! #f AFTER-HOME)
(define SHOWN-AGAIN (max-alpha 1500))

(test-group "begin: the wordmark at the first homecoming (D35)"
  (test "carrying H2 home past the bowl's stone, the wordmark shows"
    (assert-true REVEALED)
    (assert-true (> SHOWN 0.99)))
  (test "the save says it has shown"
    (assert-true (restored? REST))
    (assert-true (restored-revealed REST)))
  (test "and a continue from that save does not show it again"
    (assert-equal 0.0 SHOWN-AGAIN)))

;; --- D40: starting over ------------------------------------------------------------------
;; A continue (the Reed Bridge save, carrying H2, the Old Stone open) offers
;; starting over. R held 1.6 s on the start screen wipes the save and begins
;; a new game from the start: nothing carried, the stone shut, and the save
;; written anew only once the new game plays. A shorter hold cancels.
(define (cell-now)
  (let ((c (body-center (body-now) HARKFELL-FEEL)))
    (cons (exact (floor (/ (car c) 16))) (exact (floor (/ (cdr c) 16))))))
(define (stone-open-now?)
  (and (find (lambda (s) (and (equal? (stone-cell s) STONE-G) (stone-open? s))) (world-stones (shell-world))) #t))

(store-write-datum! SAVE-KEY CONT)
(shell-begin! #f CONT)
(define OFFERED (shell-over-offered?))
(frames 30)
(shell-over-key! #t)
(frames 60)                                     ; 1 s held
(define HALF (shell-over-progress))
(define MID-SAVED (store-get SAVE-KEY))
(frames 36)                                     ; 1.6 s held
(shell-over-key! #f)
(define PHASE-OVER (shell-frame-phase))
(define WIPED (store-get SAVE-KEY))
(define CELL-OVER (cell-now))
(define CARRY-OVER (world-carry (shell-world)))
(define STONE-OVER (stone-open-now?))
(frames 1200)                                   ; into the new game's play
(define PHASE-NEW (shell-frame-phase))
(define NEW-SAVE (save-restore CT (store-read-datum SAVE-KEY)))

;; a hold let go at 1.2 s
(store-write-datum! SAVE-KEY CONT)
(shell-begin! #f CONT)
(frames 30)
(shell-over-key! #t)
(frames 72)
(shell-over-key! #f)
(frames 1)
(define PHASE-CANCEL (shell-frame-phase))
(define PROGRESS-CANCEL (shell-over-progress))
(define KEPT (store-get SAVE-KEY))
(define CARRY-CANCEL (world-carry (shell-world)))

;; with no save there is nothing to start over
(store-remove! SAVE-KEY)
(shell-begin! #f #f)
(define OFFERED-NONE (shell-over-offered?))
(define PROGRESS-NONE (shell-over-progress))

(test-group "begin: starting over (D40)"
  (test "a continue offers it; a new game does not"
    (assert-true OFFERED)
    (assert-false OFFERED-NONE)
    (assert-false PROGRESS-NONE))
  (test "a second into the hold: two thirds of the way, and the save still there"
    (assert-true (< 0.6 HALF 0.73))
    (assert-true (string? MID-SAVED)))
  (test "held 1.6 s: the save is wiped and the frame goes on"
    (assert-equal 'start-out PHASE-OVER)
    (assert-false WIPED))
  (test "the new game is at the start, carrying nothing, the Old Stone shut"
    (assert-equal (start-cell CT) CELL-OVER)
    (assert-equal '() CARRY-OVER)
    (assert-false STONE-OVER))
  (test "once it plays, the new game's save is written at the start"
    (assert-equal 'play PHASE-NEW)
    (assert-true (restored? NEW-SAVE))
    (assert-equal (start-cell CT) (restored-cell NEW-SAVE))
    (assert-equal '() (restored-carry NEW-SAVE)))
  (test "let go at 1.2 s: nothing wiped, the progress back to 0, the continue kept"
    (assert-true (memq PHASE-CANCEL (list 'start-in 'start)))
    (assert-equal 0.0 PROGRESS-CANCEL)
    (assert-true (string? KEPT))
    (assert-equal '(2) CARRY-CANCEL)))

;; --- D40: a press on the web's start screen --------------------------------------------
;; The line is where the hit test says (here: below y 500). A short press on
;; it does nothing; a press elsewhere steps in; a long press on it starts over.
(shell-set-over-hit! (lambda (w h x y) (> y 500)))
(store-write-datum! SAVE-KEY CONT)
(shell-begin! #t CONT)
(frames 30)
(shell-start-press! 100 600)
(frames 30)
(shell-start-release!)
(frames 5)
(define PHASE-TAP-LINE (shell-frame-phase))
(shell-start-press! 100 100)
(shell-start-release!)
(frames 2)
(define PHASE-TAP-ELSEWHERE (shell-frame-phase))
(define KEPT-TAP (store-get SAVE-KEY))

(store-write-datum! SAVE-KEY CONT)
(shell-begin! #t CONT)
(frames 30)
(shell-start-press! 100 600)
(frames 96)
(shell-start-release!)
(define PHASE-LONG (shell-frame-phase))
(define WIPED-LONG (store-get SAVE-KEY))

(test-group "begin: a press on the web's start screen (D40)"
  (test "a short press on the line does nothing"
    (assert-true (memq PHASE-TAP-LINE (list 'start-in 'start))))
  (test "a press elsewhere steps in, and the continue is kept"
    (assert-equal 'start-out PHASE-TAP-ELSEWHERE)
    (assert-true (string? KEPT-TAP)))
  (test "a 1.6 s press on the line starts over"
    (assert-equal 'start-out PHASE-LONG)
    (assert-false WIPED-LONG)))

;; --- D40: the pause ---------------------------------------------------------------------
;; In play, a pause stops the world (no tick in a second of frames) and the
;; listeners hear it; a resume goes on. A second pause or resume is nothing.
(define HEARD '())
(shell-add-pause-listener! (lambda (ev) (set! HEARD (append HEARD (list ev)))))
(store-remove! SAVE-KEY)
(shell-begin! #f #f)
(frames 1200)
(define PHASE-P (shell-frame-phase))
(define FIRST-PAUSE (shell-pause!))
(define SECOND-PAUSE (shell-pause!))
(define T0 (world-ticks (shell-world)))
(frames 60)
(define T1 (world-ticks (shell-world)))
(define FIRST-RESUME (shell-resume!))
(define SECOND-RESUME (shell-resume!))
(frames 60)
(define T2 (world-ticks (shell-world)))
;; snapshot: the listener stays registered, and later sections pause again
(define HEARD-D40 HEARD)

(test-group "begin: the pause (D40)"
  (test "in play (the premise)"
    (assert-equal 'play PHASE-P))
  (test "paused, a second of frames steps the world not at all"
    (assert-equal T0 T1))
  (test "resumed, it steps again"
    (assert-true (>= (- T2 T1) 55)))
  (test "each change is heard once, in order; a repeat does nothing"
    (assert-true FIRST-PAUSE)
    (assert-false SECOND-PAUSE)
    (assert-true FIRST-RESUME)
    (assert-false SECOND-RESUME)
    (assert-equal '(pause resume) HEARD-D40)))

(store-remove! SAVE-KEY)

;; --- 0.1.1: the door into a room with nowhere to stand ---------------------------------
;; The Drowned Bell (reedfen 14,5) is all water and rock. Its door answered
;; "no room" (t-1319c7), while &at=12,2 worked: the door's default cell was
;; the standable cell nearest the middle, and the room has none. The door now
;; puts the body in the water cell nearest the middle, swimming.
(define WATER-DOOR (shell-goto! "reedfen:14,5"))
(frames 30)
(define WATER-ROOM (shell-room-label))
(define WATER-MODE (body-mode (body-now)))
(define LAND-DOOR (shell-goto! "reedfen:10,4"))
(define LAND-ROOM (shell-room-label))

(test-group "begin: the door into water (0.1.1)"
  (test "reedfen:14,5 has a door, and the body swims in that room"
    (assert-true WATER-DOOR)
    (assert-equal "reedfen:14,5" WATER-ROOM)
    (assert-equal 'swim WATER-MODE))
  (test "a room with somewhere to stand still gets its standing door (the control)"
    (assert-true LAND-DOOR)
    (assert-equal "reedfen:10,4" LAND-ROOM)))

(store-remove! SAVE-KEY)

;; --- 0.1.1: the native focus pause (shell-focus!, polled once a frame) ------------------
;; Before the first #t, #f is not a loss (Wayland reads #f until the
;; keyboard-enter); after it, #f pauses and #t resumes, each heard once.
(define FOCUS-HEARD '())
(shell-add-pause-listener! (lambda (ev) (set! FOCUS-HEARD (append FOCUS-HEARD (list ev)))))
(store-remove! SAVE-KEY)
(shell-begin! #f #f)
(frames 1200)
(define F-PHASE (shell-frame-phase))
(define F0 (world-ticks (shell-world)))
(let loop ((k 0)) (when (< k 30) (shell-focus! #f) (shell-frame! (/ 1 60.0)) (loop (+ k 1))))
(define F1 (world-ticks (shell-world)))
(define F-HEARD-EARLY FOCUS-HEARD)
(let loop ((k 0)) (when (< k 30) (shell-focus! #t) (shell-frame! (/ 1 60.0)) (loop (+ k 1))))
(define F2 (world-ticks (shell-world)))
(let loop ((k 0)) (when (< k 60) (shell-focus! #f) (shell-frame! (/ 1 60.0)) (loop (+ k 1))))
(define F3 (world-ticks (shell-world)))
(define F-PAUSED (shell-paused?))
(let loop ((k 0)) (when (< k 60) (shell-focus! #t) (shell-frame! (/ 1 60.0)) (loop (+ k 1))))
(define F4 (world-ticks (shell-world)))

(test-group "begin: the native focus pause (0.1.1)"
  (test "in play (the premise)"
    (assert-equal 'play F-PHASE))
  (test "a #f before any #t is not a loss: nothing heard, the world steps"
    (assert-equal '() F-HEARD-EARLY)
    (assert-true (>= (- F1 F0) 25)))
  (test "after a #t, #f pauses: a second of #f frames steps the world not at all"
    (assert-true F-PAUSED)
    (assert-true (>= (- F2 F1) 25))
    (assert-equal F2 F3))
  (test "#t resumes; each change heard once, in order"
    (assert-true (>= (- F4 F3) 55))
    (assert-false (shell-paused?))
    (assert-equal '(pause resume) FOCUS-HEARD)))

(store-remove! SAVE-KEY)
