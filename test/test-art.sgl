;;; The art gate (A4, the look track): the text-authored cells, the region
;;; palettes and the palette pass's lookups, held to section 7's rules.
;;;
;;;   - every cell uses the key only, and the generated module is the text's
;;;     (scripts/art/cells refuses otherwise; here the module's cells are
;;;     checked again, since the module is what ships)
;;;   - a region lists exactly sixteen roles, each in the world palette, the
;;;     last three the player's (fur-1 fur-2 ink), so the creature is the same
;;;     everywhere
;;;   - every lookup (water, deep, reflect, lit) sends a slot to a slot, so an
;;;     effect cannot leave the palette
;;;   - every material a sheet authors composes all sixteen autotile shapes
;;;     at 16 x 16; reeds have as many top, mid and base cells, so a stalk
;;;     runs on
;;;   - the player has every frame player-frame can ask for
;;;   - nothing that matters by colour alone: climbable rock has holds (dark
;;;     joints) that smooth rock has not
;;;   - the look fixture's palette is world/world.sgl's

(import (sigil test)
        (sigil list)
        (sigil string)
        (engine body)
        (harkfell palette)
        (harkfell atlas)
        (harkfell art cells)
        (harkfell source)
        (harkfell content)
        (harkfell draw)
        (harkfell title)
        (sigil fs))

(define (string-prefix? p s)
  (and (>= (string-length s) (string-length p)) (string=? p (substring s 0 (string-length p)))))
(define (drop l n) (if (= n 0) l (drop (cdr l) (- n 1))))

(define WORLD (load-content (read-world-source "world")))
(define LOOK (load-content (read-world-source "test/fixtures/worlds/look")))

(define (cell name)
  (let ((e (find (lambda (c) (string=? (car c) name)) CELLS)))
    (and e (cdr e))))

(define (sheet-cells sheet)
  (filter (lambda (c) (string-prefix? (string-append sheet "/") (car c))) CELLS))

(define (count-chars rows pred)
  (apply + (map (lambda (r) (length (filter pred (string->list r)))) rows)))

(test-group "art: the cells"
  (test "every character of every cell is in the key"
    (let ((bad (filter (lambda (c)
                         (any (lambda (r)
                                (any (lambda (ch) (not (or (char=? ch #\.) (char=? ch #\_) (char-slot ch))))
                                     (string->list r)))
                              (cdr c)))
                       CELLS)))
      (assert-equal '() (map car bad))))
  (test "every row of a cell is as wide as its first"
    (let ((bad (filter (lambda (c)
                         (let ((w (string-length (cadr c))))
                           (any (lambda (r) (not (= w (string-length r)))) (cdr c))))
                       CELLS)))
      (assert-equal '() (map car bad))))
  (test "the key's slots are the palette's"
    (assert-equal (slot-of 'sky-1) (char-slot #\a))
    (assert-equal (slot-of 'ground-1) (char-slot #\1))
    (assert-equal (slot-of 'leaf-3) (char-slot #\7))
    (assert-equal (slot-of 'water) (char-slot #\w))
    (assert-equal (slot-of 'accent) (char-slot #\x))
    (assert-equal (slot-of 'fur-1) (char-slot #\F))
    (assert-equal (slot-of 'ink) (char-slot #\k))
    (assert-equal (slot-of 'h2) (char-slot #\h))
    (assert-equal (slot-of 'black) (char-slot #\0))
    (assert-false (char-slot #\.))
    (assert-false (char-slot #\_))))

(test-group "art: the palettes"
  (test "every region lists sixteen roles, each in the world palette, ending fur-1 fur-2 ink"
    (for-each
      (lambda (ct)
        (for-each
          (lambda (r)
            (let ((roles (region-field r 'palette))
                  (world (map car (content-palette ct))))
              (assert-equal 16 (length roles))
              (assert-equal '() (filter (lambda (x) (not (memq x world))) roles))
              (assert-equal (list 'fur-1 'fur-2 'ink) (drop roles 13))))
          (content-regions ct)))
      (list WORLD LOOK)))
  (test "every world-wide slot has a colour in the world palette"
    (for-each (lambda (w) (assert-true (assq w (content-palette WORLD)))) WORLD-SLOTS))
  (test "the look fixture's palette is world/world.sgl's"
    (assert-equal (content-palette WORLD) (content-palette LOOK)))
  (test "a lookup names only slots"
    (for-each (lambda (table)
                (for-each (lambda (e)
                            (assert-true (memq (car e) SLOTS))
                            (assert-true (memq (cdr e) SLOTS)))
                          table))
              (list WATER DEEP REFLECT LIT)))
  (test "sky under water turns to the water's colour (the water reads as water)"
    (assert-equal (slot-of 'water) (lookup WATER (slot-of 'sky-2)))))

(test-group "art: autotiling"
  (test "an overlay keeps under '.', erases under '_', replaces elsewhere"
    (assert-equal (list "1.3" "444") (compose-rows (list "123" "444") (list "._3"))))
  (test "a lone block takes every side and corner; an inside block takes none"
    (let* ((fills (list (list "22" "22")))
           (parts (list (cons "top" (list "66")) (cons "top-left" (list "_.")))))
      (assert-equal (list ".6" "22") (autotile-rows fills parts 0 0))
      (assert-equal (list "22" "22") (autotile-rows fills parts 15 0))))
  (test "every material a sheet authors has all sixteen shapes, 16 x 16"
    (for-each
      (lambda (sheet)
        (for-each
          (lambda (mat)
            (let ((fills (filter (lambda (c) (string-prefix? (string-append sheet "/" mat "-fill-") (car c))) CELLS)))
              (when (pair? fills)
                (let vloop ((v 0))
                  (when (< v (length fills))
                    (let loop ((m 0))
                      (when (< m 16)
                        (let ((rows (autotile-rows (map cdr fills)
                                                   (filter-map (lambda (p)
                                                                 (let ((c (cell (string-append sheet "/" mat "-" p))))
                                                                   (and c (cons p c))))
                                                               PART-NAMES)
                                                   m v)))
                          (assert-equal 16 (length rows))
                          (assert-true (every (lambda (r) (= 16 (string-length r))) rows)))
                        (loop (+ m 1))))
                    (vloop (+ v 1)))))))
          MATERIALS))
      (list "reedfen" "hollow")))
  (test "reeds have as many top, mid and base cells, so a stalk runs on"
    (for-each
      (lambda (sheet)
        (let ((n (lambda (part) (length (filter (lambda (c) (string-prefix? (string-append sheet "/reeds-" part "-") (car c))) CELLS)))))
          (assert-true (> (n "top") 0))
          (assert-equal (n "top") (n "mid"))
          (assert-equal (n "top") (n "base"))))
      (list "reedfen" "hollow")))
  (test "climbable rock has holds that smooth rock has not (not colour alone)"
    (for-each
      (lambda (sheet)
        ;; the smooth rock's body is dark in Reedfen (peat is ground-2), so the
        ;; test is on the DARKEST slot, ground-1: the joints between holds
        (let ((joints (lambda (mat)
                        (let ((fills (filter (lambda (c) (string-prefix? (string-append sheet "/" mat "-fill-") (car c))) CELLS)))
                          (/ (apply + (map (lambda (c) (count-chars (cdr c) (lambda (ch) (char=? ch #\1)))) fills))
                             (* 256.0 (length fills)))))))
          (assert-true (> (joints "rough") 0.15))
          (assert-true (< (joints "rock") 0.03))))
      (list "reedfen" "hollow"))))

(test-group "art: the player"
  (test "every frame player-frame can name exists, and faces the same way"
    (for-each (lambda (name) (assert-true (cell (string-append "player/" name))))
              (list "idle-a" "idle-b" "idle-c" "run-a" "run-b" "run-c" "run-d" "run-e" "run-f"
                    "jump-a" "jump-b" "fall-a" "fall-b" "cling-a" "climb-a" "climb-b" "climb-c"
                    "swim-a" "swim-b" "swim-c" "swim-d")))
  (test "the player is drawn in the player's slots only"
    (let ((bad (filter (lambda (c)
                         (any (lambda (r) (any (lambda (ch) (not (memv ch (list #\. #\F #\f #\k)))) (string->list r)))
                              (cdr c)))
                       (sheet-cells "player"))))
      (assert-equal '() (map car bad))))
  (test "standing still breathes; running, falling, clinging and swimming pick their frames"
    (let ((b (lambda (mode vx vy) (body x: 40.0 y: 40.0 mode: mode vx: vx vy: vy))))
      (assert-equal "idle-a" (player-frame (b 'ground 0.0 0.0) 10))
      (assert-equal "idle-b" (player-frame (b 'ground 0.0 0.0) 50))
      (assert-true (string-prefix? "run-" (player-frame (b 'ground 1.2 0.0) 10)))
      (assert-equal "jump-a" (player-frame (b 'air 0.0 -4.0) 10))
      (assert-true (string-prefix? "fall-" (player-frame (b 'air 0.0 3.0) 10)))
      (assert-equal "cling-a" (player-frame (b 'cling 0.0 0.0) 10))
      (assert-true (string-prefix? "climb-" (player-frame (b 'cling 0.0 -0.75) 10)))
      (assert-equal "swim-a" (player-frame (b 'swim 0.0 0.0) 10)))))

(test-group "art: the start screen, the card, the type (D32-D34)"
  (test "the card fades in over 1.2 s, holds, and is gone by CARD-SECONDS"
    (assert-equal 0.0 (card-fade 0.0))
    (assert-true (< 0.4 (card-fade 0.6) 0.6))
    (assert-equal 1.0 (card-fade 2.0))
    (assert-equal 0.0 (card-fade CARD-SECONDS))
    (assert-equal 4.0 CARD-SECONDS))
  (test "every line of words is made at every whole scale, 1 to 8"
    (for-each (lambda (id)
                (let loop ((k 1))
                  (when (<= k 8)
                    (assert-true (file-exists? (string-append "assets/type/" id "@" (number->string k) ".png")))
                    (loop (+ k 1)))))
              (list "wordmark" "listen" "step-both" "step-keys" "step-touch" "presents")))
  (test "a scale picks the nearest image, 1 to 8"
    (assert-equal 2 (type-scale 2.0))
    (assert-equal 3 (type-scale 2.6))
    (assert-equal 1 (type-scale 0.4))
    (assert-equal 8 (type-scale 12.0)))
  (test "the fonts ship with their licence (OFL)"
    (for-each (lambda (f) (assert-true (file-exists? (string-append "assets/fonts/" f))))
              (list "IMFeENrm28P.ttf" "IMFeENit28P.ttf" "IMFeENsc28P.ttf" "OFL.txt")))
  (test "the mark is made at every whole scale, reserved, and its raw never ships"
    (let loop ((k 1))
      (when (<= k 8)
        (assert-true (file-exists? (string-append "assets/mark/mark@" (number->string k) ".png")))
        (loop (+ k 1))))
    (assert-true (file-exists? "assets/RESERVED.md"))
    (assert-false (file-exists? "assets/refs")))
  (test "the waking frames exist and are the player's slots only"
    (for-each (lambda (n) (assert-true (cell (string-append "player/" n)))) (list "wake-a" "wake-b" "wake-c"))
    (assert-equal "wake-c" (waking-frame 10))
    (assert-true (member (waking-frame 200) (list "wake-a" "wake-b"))))
  (test "each sheet has tufts for its front decoration; the sky has clouds"
    (for-each (lambda (s) (assert-true (cell (string-append s "/tuft-a")))) (list "reedfen" "hollow"))
    (assert-true (cell "sky/cloud-a"))))

(test-group "art: the player's frames as player-frame picks them"
  (test "every frame player-frame returns, over every mode and a spread of motion and time, has a cell"
    (let ((names '()))
      (for-each
        (lambda (mode)
          (for-each
            (lambda (v)
              (let loop ((t 0))
                (when (< t 400)
                  (let ((n (player-frame (body x: (* 1.7 t) y: (* 0.9 t) mode: mode vx: (car v) vy: (cdr v)) t)))
                    (unless (member n names) (set! names (cons n names))))
                  (loop (+ t 7)))))
            (list (cons 0.0 0.0) (cons 1.2 0.0) (cons -1.2 0.0) (cons 0.0 -4.0) (cons 0.0 0.3) (cons 0.0 3.0)
                  (cons 0.0 -0.75) (cons 0.0 0.75) (cons 0.9 0.5))))
        (list 'ground 'air 'cling 'swim))
      (assert-true (> (length names) 12))
      (assert-equal '() (filter (lambda (n) (not (cell (string-append "player/" n)))) names)))))
