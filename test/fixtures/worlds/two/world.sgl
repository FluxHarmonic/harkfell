;;; A two-region fixture world for A3's every-region gate: a pickup of H2
;;; in one region (testfen, Reedfen's bed) and a room in another (testhollow,
;;; the Hollow's bed). The rooms are not neighbours: A1's joins do not cross
;;; regions yet.
(start region: testfen room: (0 0) cell: (2 9))

(palette
  (sky-1 "#8fa3b3" "sky") (stone-1 "#5d5a55" "rock") (stone-2 "#7a766f" "rock lit"))

(region testfen
  name: "Test fen"
  bounds: ((0 0) (0 0))
  bed: "reedfen-bed"
  bed-channels: (wind water reeds drone)
  palette: (sky-1 stone-1 stone-2)
  roster: (frog)
  moments: ()
  gives: ((overtone 2)))

(region testhollow
  name: "Test hollow"
  bounds: ((2 0) (2 0))
  bed: "bed-hollow"
  bed-channels: (wind water texture drone)
  palette: (sky-1 stone-1 stone-2)
  roster: (frog)
  moments: ())

(creature frog behaviour: hop)
