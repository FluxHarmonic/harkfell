;;; The A0 gate's replay leg, on the bytecode VM (this suite's target).
;;;
;;; The scripted input sequence ((harkfell replay): a route through the
;;; whole room, then pseudo-random wandering, 1800 ticks) produces the same
;;; positions every run. The recordings, one per shipped target:
;;;
;;;   test/fixtures/replay-native.txt   `build/release/bin/harkfell --replay`
;;;                                      (scripts/gate-replay checks it)
;;;   test/fixtures/replay-web.txt      the wasm build (verify.mjs, leg replay)
;;;
;;; This leg compares the bytecode VM's trace with the NATIVE recording:
;;; the two were measured byte-identical (1800 of 1800 lines) when the
;;; recording was made, so a difference here is a finding about the VM or
;;; the codegen, and the message says which line.
;;;
;;; To re-record after a change to the physics, the room or the script:
;;; re-derive the route (tools/find-route.sgl), rebuild the release and the
;;; web build, then
;;;   build/release/bin/harkfell --replay > test/fixtures/replay-native.txt
;;;   node verify.mjs --legs replay --record-replay test/fixtures/replay-web.txt
;;; and say in the commit whether the two still agree.
;;;
;;; Positive control, independent of the fixture: the same script with one
;;; press added (tick 700, direction kept) against this run's own trace: the
;;; first difference must be at or after tick 700. The comparison can fail,
;;; and fails where the input changed.

(import (sigil test)
        (sigil list)
        (sigil string)
        (sigil fs)
        (sigil math)
        (engine body)
        (harkfell replay))

(define FIXTURE "test/fixtures/replay-native.txt")

(define (fixture-lines)
  (filter (lambda (l) (> (string-length l) 0))
          (string-split (read-file-string FIXTURE) "\n")))

;; The 1-based index of the first line where the two lists differ, or #f.
(define (first-difference a b)
  (let loop ((a a) (b b) (i 1))
    (cond ((and (null? a) (null? b)) #f)
          ((or (null? a) (null? b)) i)
          ((string=? (car a) (car b)) (loop (cdr a) (cdr b) (+ i 1)))
          (else i))))

(define (with-press-at script n)
  (let loop ((s script) (i 1) (acc '()))
    (cond ((null? s) (reverse acc))
          ((= i n) (loop (cdr s) (+ i 1) (cons (intent h: (intent-h (car s)) v: (intent-v (car s)) jump: #t press: #t) acc)))
          (else (loop (cdr s) (+ i 1) (cons (car s) acc))))))

(test-group "replay"
  (let ((want (fixture-lines))
        (got (replay-lines)))
    (test "the recording holds 1800 ticks"
      (assert-equal REPLAY-TICKS (length want)))
    (test "the bytecode trace equals the native recording, line for line"
      (assert-equal #f (first-difference got want)))
    (test "positive control: one changed input changes the trace from there"
      (let ((d (first-difference (replay-lines-of (with-press-at (replay-script) 700)) got)))
        (assert-true (and d (>= d 700)))))))

;; Coverage: what the recording exercises, so a re-recording that stops
;; exercising a verb fails here instead of passing quietly (the review of
;; 2026-09-23 found the first script's wander stuck in one corner, blind to
;; a coyote plant). Fields: TICK X Y VX VY MODE RETURNS.
(define (column lines i) (map (lambda (l) (list-ref (string-split l " ") i)) lines))

(test-group "replay coverage"
  (let* ((want (fixture-lines))
         (xs (map string->number (column want 1)))
         (modes (column want 5))
         (count (lambda (m) (length (filter (lambda (x) (string=? x m)) modes))))
         (returns (string->number (list-ref (string-split (car (reverse want)) " ") 6))))
    (test "at least three soft returns"
      (assert-true (>= returns 3)))
    (test "at least 100 ticks each swimming and clinging"
      (assert-true (>= (count "swim") 100))
      (assert-true (>= (count "cling") 100)))
    (test "the body crosses the room: x below 40 and above 360"
      (assert-true (< (apply min xs) 40.0))
      (assert-true (> (apply max xs) 360.0)))))
