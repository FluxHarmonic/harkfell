(import (sigil test)
        (sigil list)
        (engine air)
        (engine body)
        (engine tilemap)
        (engine reach)
        (engine reach timed)
        (engine reach waits)
        (harkfell feel)
        (harkfell content)
        (harkfell source)
        (harkfell check)
        (harkfell cloudstair reach)
        (harkfell cloudstair probes))

(define F HARKFELL-FEEL)
(define FLOOR
  (let loop ((c 0) (tm (make-tilemap 12 12 16)))
    (if (= c 12)
        tm
        (loop (+ c 1) (tilemap-set tm c 11 'solid)))))
(define NODE
  (timed-node body: (body (stand-body FLOOR F 4 10) down: #t tau: 299) data: '(2 4)))
(define (stepper tm)
  (lambda (node in)
    (let ((b (body-step (timed-node-body node) in tm F)))
      (and (not (memq 'hazard (body-events b))) (timed-node node body: b)))))
(define STEP (stepper FLOOR))

(test-group "timed reach: exact directed shelter cycles"
  (test "cycle joins agree with fresh physical replay across warning and wrap"
    (let ((wait (timed-waiter FLOOR F STEP)))
      (for-each
        (lambda (tau)
          (let* ((node (timed-node NODE body: (body (timed-node-body NODE) tau: tau)))
                 (proof (wait node 0))
                 (trace (timed-run STEP node (make-list (cdr proof) NO-INTENT))))
            (assert-true (> (cdr proof) 0))
            (assert-equal (timed-key (car (reverse trace))) (timed-key (car proof)))))
        '(299 479 0 240 389))))
  (test "exposed waits and frozen clocks cannot create cycle edges"
    (let* ((tm (tilemap FLOOR air: (list (air-field x: 64 y: 144 w: 32 h: 32 east: 0.8 pulsed: #t))))
           (exposed (timed-waiter tm F (stepper tm)))
           (frozen (timed-waiter FLOOR F (lambda (n in) n))))
      (assert-false (exposed NODE 0))
      (assert-false (frozen NODE 0))))
  (test "changed carry and ability require their own actual wait proof"
    (let ((wait (timed-waiter FLOOR F STEP)))
      (assert-true (wait NODE 0))
      (let* ((other (timed-node NODE data: '(2 3 4) body: (body (timed-node-body NODE) down: #f)))
             (proof (wait other 0)))
        (assert-equal '(2 3 4) (timed-node-data (car proof)))
        (assert-false (body-down (timed-node-body (car proof)))))))
  (test "a compact rest still executes every requested tick and a same-phase full cycle"
    (let* ((calls 0)
           (counted (lambda (node in)
                      (set! calls (+ calls 1))
                      (STEP node in)))
           (wait (timed-waiter FLOOR F counted))
           (rest (car (wait NODE 0))))
      (set! calls 0)
      (let ((proof (wait rest 3)))
        (assert-equal 3 (cdr proof))
        (assert-equal 3 calls)
        (assert-equal (timed-key (car (reverse (timed-run STEP rest (make-list 3 NO-INTENT)))))
                      (timed-key (car proof))))
      (set! calls 0)
      (let ((proof (wait rest 0)))
        (assert-equal AIR-PERIOD (cdr proof))
        (assert-equal AIR-PERIOD calls)
        (assert-equal (timed-key rest) (timed-key (car proof))))))
  (test "phase-varying hidden fields keep exact cycle members and reject a free join"
    (let* ((phase-step (lambda (node in)
                         (let ((next (STEP node in)))
                           (timed-node next body:
                             (body (timed-node-body next)
                                   lock: (modulo (body-tau (timed-node-body next)) 3))))))
           (wait (timed-waiter FLOOR F phase-step)))
      (for-each
        (lambda (tau)
          (let* ((node (timed-node NODE body:
                         (body (timed-node-body NODE) tau: tau lock: 999)))
                 (proof (wait node 1))
                 (fresh (timed-run phase-step node (make-list (cdr proof) NO-INTENT))))
            (assert-true (> (cdr proof) 0))
            (assert-equal 1 (body-lock (timed-node-body (car proof))))
            (assert-equal (timed-key (car (reverse fresh))) (timed-key (car proof)))))
        '(299 479 0 240 389))))
  (test "an invariant certificate preserves a different arrival's facing"
    (let* ((wait (timed-waiter FLOOR F STEP))
           (rest (car (wait NODE 0)))
           (other (timed-node rest body: (body (timed-node-body rest) facing: -1)))
           (proof (wait other 3)))
      (assert-equal -1 (body-facing (timed-node-body (car proof)))))))

(test-group "timed reach: physical waiting and state"
  (test "a full cycle of genuine still ground is a shelter"
    (assert-true (timed-shelter? FLOOR F STEP NODE)))
  (test "a wait advances the actual clock without resetting it"
    (let ((trace (timed-run STEP NODE (list NO-INTENT NO-INTENT))))
      (assert-equal '(299 300 301) (map (lambda (n) (body-tau (timed-node-body n))) trace))))
  (test "force overlapping a wait rejects the shelter, even during calm"
    (let ((tm (tilemap FLOOR air: (list (air-field x: 64 y: 144 w: 32 h: 32 east: 0.8 pulsed: #t)))))
      (assert-false (timed-shelter? tm F (stepper tm) NODE))))
  (test "missing support rejects the wait"
    (let ((tm (tilemap-set FLOOR 4 11 'air)))
      (assert-false (timed-shelter? tm F (stepper tm) NODE))))
  (test "clock, ability, field changes all invalidate memo identity"
    (assert-false (equal? (timed-memo-key FLOOR F NODE)
                         (timed-memo-key FLOOR F (timed-node NODE body: (body (timed-node-body NODE) tau: 300)))))
    (assert-false (equal? (timed-memo-key FLOOR F NODE)
                         (timed-memo-key FLOOR F (timed-node NODE body: (body (timed-node-body NODE) down: #f)))))
    (assert-false (equal? (timed-memo-key FLOOR F NODE)
                         (timed-memo-key (tilemap FLOOR air: (list (air-field east: 0.8))) F NODE)))))

(test-group "timed reach: broad windows and sabotage reds"
  (test "a safe one-tick family replays at every calm and gust departure"
    (let ((family (lambda (node) (list NO-INTENT))))
      (assert-equal '() (timed-window STEP NODE family (lambda (n) #t) 300 389 120))
      (assert-equal '() (timed-window STEP NODE family (lambda (n) #t) 0 239 120))))
  (test "sabotage: an edge valid at only one tick fails the gust margin"
    (let ((failed (timed-window STEP NODE (lambda (node) (list NO-INTENT))
                               (lambda (node) (= (body-tau (timed-node-body node)) 301))
                               300 389 120)))
      (assert-equal 89 (length failed))
      (assert-false (memv 300 failed))))
  (test "a family longer than two seconds cannot pass by eventually landing"
    (assert-equal 90 (length (timed-window STEP NODE
                               (lambda (node) (make-list 121 NO-INTENT))
                               (lambda (node) #t) 300 389 120))))
  (test "a bounded unfinished search is explicitly incomplete"
    (let ((g (timed-search (list NODE) STEP (lambda (n) '())
                          (lambda (n) #t) (lambda (n) #t) 2)))
      (assert-false (timed-graph-complete g))))
  (test "sabotage: a surviving mistimed landing without escape is a trap"
    (let* ((home (timed-node NODE body: (body (timed-node-body NODE) tau: 0)))
           (g (timed-search (list home) STEP
                            (lambda (n) (if (= (body-tau (timed-node-body n)) 0)
                                            (list (list (intent h: 1) NO-INTENT)) '()))
                            (lambda (n) #f)
                            (lambda (n) (= (body-tau (timed-node-body n)) 0)) 10)))
      (assert-true (timed-graph-complete g))
      (assert-equal 1 (length (timed-graph-traps g))))))

(define CT (load-content (read-world-source "world")))
(define RM (content-room CT 11 3))
(define CELL (local->global CT RM 14 8))
(define SEEDS (cloudstair-entry-phases CT CELL '(2) #f))
(define ADVANCE (cloudstair-stepper CT))
(define CONTACT (ADVANCE (list-ref SEEDS 299) NO-INTENT))

(define LIFT (probe-lift-map #t))
(define LIFT-START (probe-lift-start LIFT 300 #t))
(define LIFT-STEP (probe-step LIFT))

(define AUTHORED-F-START
  (list-ref (cloudstair-entry-phases CT
              (local->global CT (content-room CT 8 0) 10 7) '(2 4) #t) 300))
(define AUTHORED-OFF
  (let ((tm (tiles-carrying CT '(2 4))))
    (tilemap tm air: (map (lambda (field)
                           (air-field field lift: 0 east: 0 pulsed: #f))
                         (tilemap-air tm)))))
(define (authored-lift-arrives? node)
  (let* ((b (timed-node-body node)) (c (body-center b F))
         (bank (local->global CT (content-room CT 8 -1) 14 9)))
    (and (eq? (body-mode b) 'ground) (= (body-vx b) 0)
         (>= (car c) (* 16 (car bank)))
         (= (+ (body-y b) (feel-box-h F)) (* 16 (+ 1 (cdr bank)))))))

(test-group "timed reach: authored F/L control"
  (test "a full-length calm return finishes by the gust onset"
    (assert-equal '()
      (cloudstair-window CT ADVANCE AUTHORED-F-START
        (lambda (node) (make-list 120 NO-INTENT))
        (lambda (node) (<= (body-tau (timed-node-body node)) AIR-GUST))
        'calm)))
  (test "the actual authored lower wait reaches L at all 90 gust starts"
    (assert-equal '() (timed-window ADVANCE AUTHORED-F-START probe-lift-script
                                   authored-lift-arrives? 300 389 120)))
  (test "cutting the actual force after 367 leaves one lucky start and 89 reds"
    (let* ((short (lambda (node in)
                    (if (<= (body-tau (timed-node-body node)) 367)
                        (ADVANCE node in)
                        (let ((b (body-step (timed-node-body node) in AUTHORED-OFF F)))
                          (and (not (memq 'hazard (body-events b)))
                               (timed-node node body: b))))))
           (failed (timed-window short AUTHORED-F-START probe-lift-script
                                 authored-lift-arrives? 300 389 120)))
      (assert-equal 89 (length failed))
      (assert-false (memv 300 failed))
      (assert-true (memv 301 failed)))))

(test-group "timed reach: measured pulsed lift"
  (test "144 px ascent settles at all 90 required gust departures"
    (assert-equal '() (timed-window LIFT-STEP LIFT-START probe-lift-script
                                   probe-lift-arrives? 300 389 120)))
  (test "sabotage: a shortened real pulse has one lucky launch and fails the margin"
    (let* ((off (probe-step (tilemap LIFT air: '())))
           (short (lambda (node in)
                    ((if (<= (body-tau (timed-node-body node)) 367) LIFT-STEP off)
                     node in)))
           (failed (timed-window short LIFT-START probe-lift-script
                                 probe-lift-arrives? 300 389 120)))
      (assert-equal 89 (length failed))
      (assert-false (memv 300 failed))
      (assert-true (memv 301 failed))))
  (test "no down and calm physics cannot substitute for the lift"
    (let* ((bare (probe-lift-start LIFT 300 #f))
           (calm (probe-lift-start LIFT 0 #t))
           (end (lambda (start)
                  (car (reverse (timed-run LIFT-STEP start (probe-lift-script start)))))))
      (assert-false (probe-lift-arrives? (end bare)))
      (assert-false (probe-lift-arrives? (end calm)))))
  (test "all 480 late/early departures settle at the catch or upper bank"
    (for-each
      (lambda (tau)
        (let* ((start (probe-lift-start LIFT tau #t))
               (trace (timed-run LIFT-STEP start (append (probe-lift-script start) (make-list 180 NO-INTENT))))
               (end (and trace (timed-node-body (car (reverse trace))))))
          (assert-true end)
          (assert-equal 'ground (body-mode end))
          (assert-true (or (= (+ (body-y end) (feel-box-h F)) 192)
                           (= (+ (body-y end) (feel-box-h F)) 336)))))
      (iota 480))))

(test-group "timed reach: actual acquisition"
  (test "diagnostics cover all sixteen subsets, with and without down"
    (let ((profiles (cloudstair-diagnostic-profiles)))
      (assert-equal 32 (length profiles))
      (assert-equal 16 (length (filter cdr profiles)))
      (assert-true (member (cons '(2 3 4 5) #t) profiles))
      (assert-true (member (cons '() #f) profiles))))
  (test "diagnostics include all 480 entry phases"
    (assert-equal 480 (length SEEDS)))
  (test "Behind the Stone grant retains the arrival phase and does not alter harmonics"
    (assert-true (body-down (timed-node-body CONTACT)))
    (assert-equal 300 (body-tau (timed-node-body CONTACT)))
    (assert-equal '(2) (timed-node-data CONTACT)))
  (test "no H2 means no down, even at the gift"
    (let ((n (ADVANCE (timed-node (car SEEDS) data: '()) NO-INTENT)))
      (assert-false (body-down (timed-node-body n))))))

(test-group "timed reach: authored H5 and shelter certificates"
  (test "H5 contact retains the physical body and wrapped arrival phase"
    (let* ((rm (content-room CT 12 -2))
           (cell (local->global CT rm 16 5))
           (entry (list-ref (cloudstair-entry-phases CT cell '(2 4) #t) 479))
           (next (ADVANCE entry NO-INTENT)))
      (assert-equal '(2 4 5) (timed-node-data next))
      (assert-equal 0 (body-tau (timed-node-body next)))
      (assert-equal (body-x (timed-node-body entry)) (body-x (timed-node-body next)))
      (assert-true (body-down (timed-node-body next)))))
  (test "a bypassed H5 stays absent"
    (let* ((cell (local->global CT (content-room CT 12 -2) 14 5))
           (entry (list-ref (cloudstair-entry-phases CT cell '(2 4) #t) 389))
           (next (ADVANCE entry NO-INTENT)))
      (assert-equal '(2 4) (timed-node-data next))
      (assert-equal 390 (body-tau (timed-node-body next)))))
  (test "a full-cycle certificate agrees with fresh rotated validation"
    (let* ((cell (local->global CT (content-room CT 8 0) 10 7))
           (entries (cloudstair-entry-phases CT cell '(2 4) #t))
           (certified? (cloudstair-shelter-checker CT ADVANCE)))
      (for-each (lambda (tau)
                  (let ((node (list-ref entries tau)))
                    (assert-true (certified? node))
                    (assert-equal (cloudstair-shelter? CT ADVANCE node) (certified? node))))
                '(0 239 240 299 300 389 479)))))

(define CACHE-START (timed-node NODE body: (body (timed-node-body NODE) tau: 0)))
(define (cache-policies node)
  (let ((tau (body-tau (timed-node-body node))))
    (cond ((= tau 0) (list (list NO-INTENT)))
          ((= tau 1) (list (make-list 479 NO-INTENT)))
          (else '()))))
(define (cache-home? node) (= (body-tau (timed-node-body node)) 0))
(define (cache-key node) (timed-memo-key FLOOR F node))
(define FRESH
  (timed-search (list CACHE-START) STEP cache-policies (lambda (n) #t) cache-home? 2000
                '() cache-key))
(define REUSED
  (timed-search (list CACHE-START) STEP cache-policies (lambda (n) #t) cache-home? 2000
                (timed-graph-memo FRESH) cache-key))

(test-group "timed reach: memo replay and differential controls"
  (test "reuse and fresh search have the same actual edges and traps"
    (assert-true (timed-graph-complete FRESH))
    (assert-true (> (timed-graph-reused REUSED) 0))
    (assert-equal (timed-graph-edges FRESH) (timed-graph-edges REUSED))
    (assert-equal (map timed-key (timed-graph-traps FRESH))
                  (map timed-key (timed-graph-traps REUSED))))
  (test "changed force footprints discard all matching phase candidates"
    (let* ((changed (tilemap FLOOR air: (list (air-field x: 160 y: 0 w: 16 h: 16 east: 0.8))))
           (g (timed-search (list CACHE-START) (stepper changed) cache-policies
                            (lambda (n) #t) cache-home? 2000
                            (timed-graph-memo FRESH)
                            (lambda (node) (timed-memo-key changed F node)))))
      (assert-equal 0 (timed-graph-reused g))))
  (test "sabotage: freezing the warning instead of advancing changes physics"
    (let* ((tm (tilemap FLOOR air: (list (air-field x: 64 y: 0 w: 32 h: 176 lift: 2.4 pulsed: #t))))
           (start (timed-node NODE body: (body (timed-node-body NODE) mode: 'air y: 120 vy: 1 tau: 299)))
           (step (stepper tm))
           (frozen (lambda (node in)
                     (let ((n (step node in)))
                       (and n (timed-node n body: (body (timed-node-body n) tau: 299))))))
           (script (make-list 20 (intent jump: #t)))
           (actual (car (reverse (timed-run step start script))))
           (false (car (reverse (timed-run frozen start script)))))
      (assert-false (= (body-y (timed-node-body actual)) (body-y (timed-node-body false)))))))
