;;; A ring-stone's glyph sits centred in the stone (David's D50 playtest:
;;; the notches drifted right with their count, the H5's last one landing
;;; on the stone's shaded right edge). The body is centred on x 8 of its
;;; 16-pixel cell (columns 1-14, the same for the pipes' local body), and
;;; so is the ring (columns 5-10). The notch row is n-1 marks a pixel wide
;;; with a pixel between: an odd number of pixels, so it cannot sit exactly
;;; on x 8. It must sit half a pixel off it, the same half pixel for every
;;; harmonic (no drift), and clear of the body's shading.

(import (sigil test)
        (sigil list)
        (harkfell sprites))

(define (ring-rects n) (filter (lambda (r) (< (cadr r) 11)) (stone-glyph-rects n)))
(define (notch-rects n) (filter (lambda (r) (= (cadr r) 11)) (stone-glyph-rects n)))
(define (left r) (car r))
(define (right r) (+ (car r) (caddr r)))
;; Twice the centre of a set of rects' horizontal extent (in half-pixels from
;; the cell's left, so a half-pixel offset is a whole number).
(define (centre2 rs)
  (+ (apply min (map left rs)) (apply max (map right rs))))
(define AXIS 8)
(define HARMONICS '(2 3 4 5))

(test-group "stone glyph: centred in the stone for every harmonic"
  (test "the ring is centred on the stone's axis"
    (for-each (lambda (n) (assert-equal (list n (* 2 AXIS)) (list n (centre2 (ring-rects n))))) HARMONICS))
  (test "a notch per step above the fundamental, a pixel wide, two apart"
    (for-each (lambda (n)
                (let ((xs (map left (notch-rects n))))
                  (assert-equal (list n (- n 1)) (list n (length xs)))
                  (assert-equal (list n #t) (list n (every (lambda (r) (= 1 (caddr r))) (notch-rects n))))
                  (assert-equal (list n (map (lambda (k) (+ (car xs) (* 2 k))) (iota (length xs))))
                                (list n xs))))
              HARMONICS))
  (test "the notch row is within half a pixel of the axis, the same for every harmonic"
    ;; in half-pixels; the drift David saw was -1, 1, 3, 5 for H2..H5
    (assert-equal '((2 -1) (3 -1) (4 -1) (5 -1))
                  (map (lambda (n) (list n (- (centre2 (notch-rects n)) (* 2 AXIS)))) HARMONICS)))
  (test "every notch sits inside the stone, clear of its shading (columns 2 and 12-13)"
    (for-each (lambda (n)
                (assert-equal (list n #t)
                              (list n (every (lambda (r) (and (>= (left r) 3) (<= (right r) 12)))
                                             (notch-rects n)))))
              HARMONICS)))
