;;; The adapter from the running world to the sound director's PLACE
;;; ((harkfell audio) world-place), on the real world (world/): the place's
;;; px py are ABSOLUTE world pixels, room (rx, ry) spanning x 400*rx ..
;;; 400*(rx+1) and y 176*ry .. 176*(ry+1), which is the frame the director's
;;; tone and spot-sound maths use. The world map's own pixels start at its
;;; westmost and northmost room (worldmap-x0/y0: Reedfen's (8 3)), not at
;;; room (0 0); the first build passed those through and put H2's tone eight
;;; rooms away from every room (the adversarial review's H1, 2026-09-24).
;;; Checked in two rooms, so a constant offset cannot pass by luck.

(import (sigil test)
        (sigil list)
        (engine worldmap)
        (harkfell world)
        (harkfell content)
        (harkfell source)
        (harkfell check)
        (harkfell feel)
        (engine mixer)
        (harkfell sound)
        (harkfell gates)
        (harkfell audio))

(define CT (load-content (read-world-source "world")))

;; The body standing in room (x, y) at its start cell, as a world with its
;; gates (the pickups, the stones), as the shell makes it.
(define (world-in x y)
  (let* ((rm (content-room CT x y))
         (cell (room-start-cell CT rm)))
    (world-populate
      (world-at (content-map CT)
                (cell-body (worldmap-tiles (content-map CT)) HARKFELL-FEEL (car cell) (cdr cell)))
      (content-stones CT) (content-pickups CT) '())))

(define (inside? pl)
  (and (<= (* 400 (place-rx pl)) (place-px pl) (* 400 (+ 1 (place-rx pl))))
       (<= (* 176 (place-ry pl)) (place-py pl) (* 176 (+ 1 (place-ry pl))))))

(test-group "place: absolute world pixels"
  (test "the world loads clean (the control)"
    (assert-equal '() (content-problems CT)))
  (test "Fen Edge (8 3): the body's place is inside room (8 3)'s absolute span"
    (let ((pl (world-place (world-in 8 3) CT)))
      (assert-equal 8 (place-rx pl))
      (assert-true (inside? pl))))
  (test "Climb Back (10 4): inside room (10 4)'s absolute span"
    (let ((pl (world-place (world-in 10 4) CT)))
      (assert-equal 10 (place-rx pl))
      (assert-equal 4 (place-ry pl))
      (assert-true (inside? pl))))
  (test "Reed Bridge carries its moment and its frogs, in room pixels"
    (let ((pl (world-place (world-in 9 3) CT)))
      (assert-equal "first-open-water" (place-moment pl))
      (assert-equal 2 (length (place-frogs pl)))
      (assert-true (every (lambda (x) (< 0 x 400)) (place-frogs pl))))))

;; Listening, end to end on the real world: the director given the adapter's
;; place, standing still for 3 s. H2's tone is where the world's pickup lies:
;; the Far Mound (17 3), cell (22 3), since A4 (A3 had it in the Drowned
;; Channel). From the Heron's Water (16 3) it is east, next door; from the
;; Cattails (15 3), east and two rooms off; from the Mound's Roots (17 4),
;; above. The tone must sound in all three, fainter in the Cattails than next
;; door, and the ears must lean east, east, and up.
(define (listen-in x y)
  (mixer-open-headless! 32000 (lambda (id buf n gain) #f))
  (sound-reset!)
  (let* ((w (world-in x y))
         (base (world-place w CT))
         (pl (place base still: #t)))
    (let loop ((f 0))
      (let ((now (/ f 30.0)))
        (when (<= now 3.0)
          (sound-frame! now (if (= f 0) 0.0 (/ 1 30.0)) pl)
          (mixer-pump! now)
          (loop (+ f 1)))))
    (let ((s (sound-voice-source TONE-ID)))
      (list (sound-ears) (and s (source-gain s 3.0))))))

(define NEXT-DOOR (listen-in 16 3))
(define TWO-OFF (listen-in 15 3))
(define BELOW (listen-in 17 4))

(test-group "place: listening on the real world"
  (test "in the Heron's Water, still: the ears lean east and the tone sounds"
    (assert-equal 'right (car NEXT-DOOR))
    (assert-true (> (cadr NEXT-DOOR) 0.2)))
  (test "in the Cattails, further: the ears lean east, fainter, but there"
    (assert-equal 'right (car TWO-OFF))
    (assert-true (< 0.0 (cadr TWO-OFF) (cadr NEXT-DOOR))))
  (test "in the Mound's Roots, below it: the ears point up"
    (assert-equal 'up (car BELOW))
    (assert-true (> (cadr BELOW) 0.0))))

;; The ears' flick (David, 2026-09-24): down and back twice in the first
;; 0.36 s after they rise (0.09 s steps), again every 4 s, and up otherwise.
(test-group "place: the ears flick"
  (test "down, up, down, up in the first 0.36 s"
    (assert-true (ears-flick? 0.0))
    (assert-false (ears-flick? 0.1))
    (assert-true (ears-flick? 0.2))
    (assert-false (ears-flick? 0.3)))
  (test "then up, until the next flick 4 s after they rose"
    (assert-false (ears-flick? 0.4))
    (assert-false (ears-flick? 2.0))
    (assert-false (ears-flick? 3.95))
    (assert-true (ears-flick? 4.05))))

;; The mute stone's hum survives leaving its range and coming straight back
;; (the review's finding 2: the first fade's pending remove deleted the
;; reopened hum's source, and it stayed silent for good).
(define (hum-after steps)
  (mixer-open-headless! 32000 (lambda (id buf n gain) #f))
  (sound-reset!)
  (let* ((w (world-in 10 3))
         (base (world-place w CT))
         (st (car (place-stones base)))
         (near (place base px: (- (caddr st) 50.0) py: (cadddr st)))
         (far (place base px: (- (caddr st) 150.0) py: (cadddr st))))
    (let loop ((ps steps) (f 0))
      (if (null? ps)
          (let ((s (sound-voice-source HUM-ID)))
            (and s (source-gain s (/ f 30.0))))
          (begin
            (sound-frame! (/ f 30.0) (/ 1 30.0) (if (eq? (car ps) 'near) near far))
            (mixer-pump! (/ f 30.0))
            (loop (cdr ps) (+ f 1)))))))

(define (times n x) (if (= n 0) '() (cons x (times (- n 1) x))))

(test-group "place: the stone's hum"
  (test "near a mute stone, it hums"
    (assert-true (> (or (hum-after (times 60 'near)) 0.0) 0.05)))
  (test "out of range for one frame and straight back: it still hums 3 s later"
    (assert-true (> (or (hum-after (append (times 30 'near) (list 'far) (times 90 'near))) 0.0) 0.05)))
  (test "far from it: silent"
    (assert-false (let ((g (hum-after (times 60 'far)))) (and g (> g 0.01))))))
