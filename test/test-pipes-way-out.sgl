;;; D48: a player who goes down into the Pipes without H3 can find the way
;;; back up. Every Pipes room has a lit way out (a ceiling shaft or a side
;;; spill) on an opening that leads toward the way in, Wind Throat's north
;;; edge under the Old Cut. The distances here are worked out by this file
;;; from the room edges alone, not by the code under test; that each edge
;;; can be crossed both ways is the reach check's to prove (scripts/room-check).
(import (sigil test)
        (sigil list)
        (harkfell source)
        (harkfell content)
        (harkfell cues)
        (harkfell pipes look))

(define CT (load-content (read-world-source "world")))
(define PIPES (region-rooms CT 'pipes))

(define (key rm) (cons (room-x rm) (room-y rm)))
(define (across rm side)
  (case side
    ((west) (content-room CT (- (room-x rm) 1) (room-y rm)))
    ((east) (content-room CT (+ (room-x rm) 1) (room-y rm)))
    ((north) (content-room CT (room-x rm) (- (room-y rm) 1)))
    (else (content-room CT (room-x rm) (+ (room-y rm) 1)))))

;; ((x . y) . d): rooms from Wind Throat (2,4) by open edges inside the Pipes.
(define DIST
  (let loop ((frontier (list (content-room CT 2 4))) (d 0) (seen (list (cons (cons 2 4) 0))))
    (if (null? frontier)
        seen
        (let ((new '()))
          (for-each
            (lambda (rm)
              (for-each
                (lambda (e)
                  (let ((n (across rm (car e))))
                    (when (and n (eq? (room-region n) 'pipes)
                               (not (assoc (key n) seen))
                               (not (assoc (key n) (map (lambda (r) (cons (key r) #t)) new))))
                      (set! new (cons n new)))))
                (room-exits rm)))
            frontier)
          (loop new (+ d 1)
                (append seen (map (lambda (n) (cons (key n) (+ d 1))) new)))))))

(define (dist rm) (let ((e (assoc (key rm) DIST))) (and e (cdr e))))

(define (leads-out? rm span)
  (or (and (= (room-x rm) 2) (= (room-y rm) 4) (eq? (car span) 'north))
      (let ((n (across rm (car span))))
        (and n (eq? (room-region n) 'pipes) (< (dist n) (dist rm))))))

(define (label rm) (string-append (number->string (room-x rm)) "," (number->string (room-y rm))))

(test-group "Pipes: the way back up without H3 (D48)"
  (test "the room graph matches the approved map's distances from Wind Throat"
    (assert-equal 24 (length PIPES))
    (assert-equal 24 (length DIST))
    ;; A 0; B C E 1; the far corner X is eight rooms down
    (assert-equal 0 (dist (content-room CT 2 4)))
    (assert-equal 1 (dist (content-room CT 1 4)))
    (assert-equal 1 (dist (content-room CT 2 5)))
    (assert-equal 7 (dist (content-room CT 1 8)))
    (assert-equal 8 (dist (content-room CT 6 8))))
  (test "every Pipes room has a lit way out on an opening toward the way in"
    (let ((ds (region-distances CT 'pipes)))
      (for-each
        (lambda (rm)
          (let ((ways (room-ways-out CT rm ds)))
            (unless (pair? ways)
              (assert-equal (list 'no-way-out (label rm)) '()))
            (for-each
              (lambda (span)
                (unless (leads-out? rm span)
                  (assert-equal (list 'way-out-leads-away (label rm) span) '())))
              ways)))
        PIPES)))
  (test "a lit way out is a real opening, and every opening toward the way in is lit"
    (let ((ds (region-distances CT 'pipes)))
      (for-each
        (lambda (rm)
          (let ((ways (room-ways-out CT rm ds))
                (toward (filter (lambda (s) (leads-out? rm s)) (room-exit-spans rm))))
            (assert-equal (length toward) (length ways))
            (for-each (lambda (s) (assert-true (member s (room-exit-spans rm)))) ways)))
        PIPES)))
  (test "a ceiling shaft falls into its room, at least a cell before it lands"
    (let ((ds (region-distances CT 'pipes)) (shafts 0))
      (for-each
        (lambda (rm)
          (for-each
            (lambda (span)
              (when (eq? (car span) 'north)
                (set! shafts (+ shafts 1))
                (for-each (lambda (col)
                            (unless (>= (caddr col) 16)
                              (assert-equal (list 'shaft-blocked (label rm) col) '())))
                          (way-light-columns rm span))))
            (room-ways-out CT rm ds)))
        PIPES)
      ;; A (the Old Cut) and the thirteen rooms whose way up is a shaft
      (assert-equal 14 shafts)))
  (test "regions with no way in get no way-out lights"
    (assert-equal '() (region-distances CT 'glasswood))
    (assert-equal '() (room-ways-out CT (content-room CT 0 5) (region-distances CT 'pipes)))))
