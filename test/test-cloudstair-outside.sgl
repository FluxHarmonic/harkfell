(import (sigil test)
        (sigil list)
        (engine worldmap)
        (harkfell content)
        (harkfell source)
        (harkfell cli))

(define SOURCE (load-content (read-world-source "world")))

(define (source-placement x y)
  (find (lambda (p) (and (= (placed-x p) x) (= (placed-y p) y)))
        (content-rooms SOURCE)))

(define BOWL (source-placement 4 3))

(define (source-with-bowl p)
  (content SOURCE rooms:
    (map (lambda (old) (if (eq? old BOWL) p old)) (content-rooms SOURCE))))

(test-group "outside Cloudstair: the H5 pocket belongs to its timed gate"
  (test "the no-H5 view adds exactly one cell and preserves every other outside room"
    (let* ((outside (cloudstair-outside-rooms SOURCE '(2 3 4)))
           (added '()))
      ;; The shipped 82 outside rooms plus 13 Underhum and 12 Wrongwater.
      (assert-equal 107 (length outside))
      (for-each
        (lambda (p)
          (let* ((rm (placed-data p))
                 (original (source-placement (room-x rm) (room-y rm)))
                 (old (placed-data original)))
            (assert-eq (placed-tiles original) (placed-tiles p))
            (for-each (lambda (cell)
                        (unless (member cell (room-unreached old))
                          (set! added (cons (list (room-region rm) (room-x rm)
                                                  (room-y rm) cell) added))))
                      (room-unreached rm))
            (for-each (lambda (cell) (assert-true (member cell (room-unreached rm))))
                      (room-unreached old))
            (unless (eq? original BOWL)
              (assert-eq original p))))
        outside)
      (assert-equal '((hollow 4 3 (20 . 6))) added)
      (assert-equal '() (room-unreached (placed-data BOWL)))))
  (test "a view carrying H5 adds no exclusion, including in the bowl"
    (for-each
      (lambda (p)
        (let ((rm (placed-data p)))
          (assert-eq (source-placement (room-x rm) (room-y rm)) p)))
      (cloudstair-outside-rooms SOURCE '(2 3 4 5))))
  (test "a different authored bowl declaration is retained alongside the timed pocket"
    (let* ((p (placed BOWL data: (room (placed-data BOWL) unreached: '((18 . 8)))))
           (outside (cloudstair-outside-rooms (source-with-bowl p) '(2 4)))
           (bowl (find (lambda (p) (and (= (placed-x p) 4) (= (placed-y p) 3))) outside)))
      (assert-equal '((20 . 6) (18 . 8)) (room-unreached (placed-data bowl)))
      (assert-equal '((18 . 8)) (room-unreached (placed-data p)))))
  (test "without the H5 door the room receives no exception"
    (let* ((rm (placed-data BOWL))
           (p (placed BOWL data:
                (room rm things:
                  (filter (lambda (t) (not (equal? (thing-kw t "overtone") 5)))
                          (room-things rm)))))
           (outside (cloudstair-outside-rooms (source-with-bowl p) '(2 4))))
      (assert-true (memq p outside))
      (assert-equal '() (room-unreached (placed-data p)))))
  (test "a no-H5 view refuses an outside H5 pickup that would broaden its carry sets"
    (let ((p (placed BOWL data:
               (room (placed-data BOWL) things:
                 (cons '(harmonic at: (12 8) overtone: 5)
                       (room-things (placed-data BOWL)))))))
      (assert-error (cloudstair-outside-rooms (source-with-bowl p) '(2 4))))))

(define LEDGE (source-placement 7 2))

(define (source-with-ledge p)
  (content SOURCE rooms:
    (map (lambda (old) (if (eq? old LEDGE) p old)) (content-rooms SOURCE))))

;; x7y2's unreached declaration in the outside view after the timed
;; exclusions, with its one KIND thing replaced by NEW (two things still).
(define (ledge-unreached-with kind new)
  (let* ((rm (placed-data LEDGE))
         (things (map (lambda (t) (if (eq? (car t) kind) new t)) (room-things rm)))
         (p (placed LEDGE data: (room rm things: things)))
         (out (outside-timed-exclusions (cloudstair-outside-rooms (source-with-ledge p) '())))
         (ledge (find (lambda (p) (and (= (placed-x p) 7) (= (placed-y p) 2))) out)))
    (assert-equal 2 (length things))
    (assert-true (member new things))
    (room-unreached (placed-data ledge))))

(test-group "outside Cloudstair: x7y2's lift ledge (7,1), reached by timed exp-31"
  (test "the timed exclusions add exactly x7y2's (7,1) and leave every other room as it was"
    (let* ((rooms (cloudstair-outside-rooms SOURCE '(2 3 4)))
           (out (outside-timed-exclusions rooms))
           (added '()))
      (assert-equal (length rooms) (length out))
      (for-each
        (lambda (before after)
          (let ((old (placed-data before)) (rm (placed-data after)))
            (assert-eq (placed-tiles before) (placed-tiles after))
            (for-each (lambda (cell)
                        (unless (member cell (room-unreached old))
                          (set! added (cons (list (room-region rm) (room-x rm) (room-y rm) cell) added))))
                      (room-unreached rm))
            (for-each (lambda (cell) (assert-true (member cell (room-unreached rm))))
                      (room-unreached old))
            ;; (the no-H5 view passes x7y2 through as the source's own placement)
            (unless (eq? before LEDGE)
              (assert-eq before after))))
        rooms out)
      (assert-equal '((hollow 7 2 (7 . 1))) added)
      (assert-equal '() (room-unreached (placed-data LEDGE)))))
  (test "an authored x7y2 declaration is kept, and (7,1) is listed once"
    (let* ((p (placed LEDGE data: (room (placed-data LEDGE) unreached: '((7 . 1) (20 . 3)))))
           (out (outside-timed-exclusions (cloudstair-outside-rooms (source-with-ledge p) '())))
           (ledge (find (lambda (p) (and (= (placed-x p) 7) (= (placed-y p) 2))) out)))
      (assert-equal '((7 . 1) (20 . 3)) (room-unreached (placed-data ledge)))))
  (test "without the steady lift at (8,0) the room receives no exception"
    (let* ((rm (placed-data LEDGE))
           (p (placed LEDGE data:
                (room rm things:
                  (filter (lambda (t) (not (eq? (car t) 'air-field))) (room-things rm)))))
           (out (outside-timed-exclusions (cloudstair-outside-rooms (source-with-ledge p) '())))
           (ledge (find (lambda (p) (and (= (placed-x p) 7) (= (placed-y p) 2))) out)))
      (assert-equal '() (room-unreached (placed-data ledge)))))
  (test "any edit to x7y2's grid revokes the exception (exp-31 ran the room as it is now)"
    (let* ((rm (placed-data LEDGE))
           (grid (let loop ((rows (room-grid rm)) (i 0) (acc '()))
                   (if (null? rows)
                       (reverse acc)
                       (loop (cdr rows) (+ i 1)
                             (cons (if (= i 9) "####### ^^^            ##" (car rows)) acc)))))
           (p (placed LEDGE data: (room rm grid: grid)))
           (out (outside-timed-exclusions (cloudstair-outside-rooms (source-with-ledge p) '())))
           (ledge (find (lambda (p) (and (= (placed-x p) 7) (= (placed-y p) 2))) out)))
      (assert-equal 11 (length grid))
      (assert-false (equal? grid (room-grid rm)))
      (assert-equal '() (room-unreached (placed-data ledge)))))
  (test "an extra thing in x7y2 revokes the exception"
    (let* ((rm (placed-data LEDGE))
           (p (placed LEDGE data:
                (room rm things: (cons '(firefly at: (15 5) count: 3 drawn: 2) (room-things rm)))))
           (out (outside-timed-exclusions (cloudstair-outside-rooms (source-with-ledge p) '())))
           (ledge (find (lambda (p) (and (= (placed-x p) 7) (= (placed-y p) 2))) out)))
      (assert-equal '() (room-unreached (placed-data ledge)))))
  ;; Each of these keeps exactly two things and changes one field of one.
  (test "a different lift (size (3 7)) revokes the exception"
    (assert-equal '() (ledge-unreached-with 'air-field '(air-field at: (8 0) size: (3 7) kind: steady-lift))))
  (test "a different stone (overtone 3) revokes the exception"
    (assert-equal '() (ledge-unreached-with 'ring-stone '(ring-stone at: (6 3) overtone: 3))))
  (test "an extra field on the stone (keys:) revokes the exception"
    (assert-equal '() (ledge-unreached-with 'ring-stone '(ring-stone at: (6 3) overtone: 4 keys: (4))))))
