#!/bin/sh
# Harkfell's text-authored art (harkfell-design section 7, "How the art gets
# made"): every tile, sprite frame and creature frame is a block of text,
# one character per pixel, in assets/art/*.txt (CC BY 4.0). This turns them
# into the data module the game bakes its atlas from.
#
#   scripts/art/cells            assets/art/*.txt -> src/harkfell/art/cells.sgl
#   scripts/art/cells --check    exit 1 if the module is not what the text makes
#
# A sheet file holds cells, each opened by "= NAME" (kebab-case, digits
# allowed) and followed by its rows; every row of a cell has the same
# width. Lines starting with # are comments; blank lines end nothing and
# are skipped. A cell's name in the game is FILE/NAME (the file's stem), so
# assets/art/reedfen.txt's "= rock-fill-a" is "reedfen/rock-fill-a".
#
# The characters (the one key, the same in every sheet; (harkfell atlas)
# holds it too, and test/test-art.sgl holds the two to each other):
#   .        nothing (transparent)
#   _        erase: in an overlay, clears what is under it (autotile corners)
#   a b c d  sky-1..4          1 2 3 4  ground-1..4
#   5 6 7    leaf-1..3         w  water        x  accent
#   F f k    fur-1 fur-2 ink   (the player's; the same in every region)
#   h        the harmonic's colour (baked once per harmonic where used)
#   0        black
#
# The module carries names and rows as strings built with `list`, no
# quoted literals and no characters (the wasm literal hazard Crash's
# pipeline notes: a quoted literal can come out of the web build's module
# load corrupted).
set -eu
export LC_ALL=C
cd "$(dirname "$0")/../.." || exit 1
mod="src/harkfell/art/cells.sgl"
CHECK=0
[ "${1:-}" = "--check" ] && CHECK=1
mkdir -p src/harkfell/art
tmp="$(mktemp)"
trap 'rm -f "$tmp" "$tmp.rows"' EXIT
set -- assets/art/*.txt
[ -f "$1" ] || { echo "cells: no assets/art/*.txt"; exit 1; }
# 1. parse every sheet; refuse anything malformed, naming the file and line
for f in "$@"; do
  stem="$(basename "$f" .txt)"
  case "$stem" in *[!a-z0-9-]*) echo "cells: $f: the file name must be kebab-case"; exit 1 ;; esac
  awk -v stem="$stem" -v file="$f" '
    function fail(msg) { print "cells: " file ":" NR ": " msg > "/dev/stderr"; bad = 1; exit 1 }
    function close_cell() {
      if (name != "") {
        if (nrows == 0) fail("cell " name " has no rows")
        printf "%s/%s", stem, name
        for (i = 1; i <= nrows; i++) printf " %s", row[i]
        printf "\n"
      }
    }
    /^#/ { next }
    /^[ \t]*$/ { next }
    /^= / {
      close_cell()
      n = substr($0, 3)
      if (n !~ /^[a-z0-9][a-z0-9-]*$/) fail("bad cell name (kebab-case): " n)
      if (n in seen) fail("cell " n " given twice")
      seen[n] = 1; name = n; nrows = 0; width = -1; next
    }
    {
      if (name == "") fail("rows before the first = NAME")
      if ($0 !~ /^[._abcd1234567wxFfkh0]+$/) fail("cell " name ": a character outside the key in: " $0)
      if (width < 0) width = length($0)
      else if (length($0) != width) fail("cell " name " row " nrows + 1 " is " length($0) " wide, the cell is " width)
      if (width > 400) fail("cell " name " is wider than 400")
      row[++nrows] = $0
      if (nrows > 176) fail("cell " name " is taller than 176")
    }
    END { if (!bad) close_cell() }
  ' "$f" >> "$tmp.rows" || exit 1
done
n="$(wc -l < "$tmp.rows")"
[ "$n" -gt 0 ] || { echo "cells: no cells"; exit 1; }
# 2. the module
{
  echo ";;; (harkfell art cells) - GENERATED by scripts/art/cells from assets/art/*.txt;"
  echo ";;; edit the text, not this file. The art is CC BY 4.0 (the text files"
  echo ";;; are the source). CELLS: (list (list NAME ROW ...) ...), NAME \"file/cell\","
  echo ";;; each ROW one character per pixel in the key scripts/art/cells documents."
  echo ""
  echo "(define-library (harkfell art cells)"
  echo "  (export CELLS CELL-COUNT)"
  echo ""
  echo "  (begin"
  echo "    (define CELL-COUNT $n)"
  echo "    (define CELLS"
  printf "      (list"
  awk '{ printf "\n        (list"; for (i = 1; i <= NF; i++) printf " \"%s\"", $i; printf ")" }' "$tmp.rows"
  echo "))))"
} > "$tmp"
# 3. the plant-landed check: one entry per cell, every cell name present
got="$(grep -c '^        (list "' "$tmp" || true)"
[ "$got" -eq "$n" ] || { echo "cells: wrote $got entries for $n cells; refusing"; exit 1; }
if [ "$CHECK" = 1 ]; then
  cmp -s "$tmp" "$mod" || { echo "cells: $mod is not what assets/art makes; run scripts/art/cells"; exit 1; }
  echo "cells: $mod is current ($n cells)"
  exit 0
fi
cp "$tmp" "$mod"
echo "cells: $n cells -> $mod"
