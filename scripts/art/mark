#!/bin/sh
# The Flux Harmonic mark for the card (ruling D33), at the window's own
# resolution: one image per whole scale K (1..8), drawn 1:1 over the pixel
# view like the words (David, 2026-09-24: the mark through the pixel view
# stair-stepped its brush strokes beside the crisp IM Fell), still in
# Harkfell's palette. No image generation on this path: David's own mark.
#
#   scripts/art/mark        refs/mark/flux-harmonic.png -> assets/mark/mark@K.png
#
# The mark is RESERVED (assets/RESERVED.md), not CC BY. The raw lives in
# refs/mark/, outside assets/, so it never ships; only these images do.
#
# Each image is the raw scaled to W x K px wide (W view px), its coverage
# kept as alpha (smooth edges), and every pixel's colour snapped to one of
# three palette colours: the lettering (bright, unsaturated) the creature's
# cream (fur-1), the ring's darker orange the Hollow's accent (hol-bracken)
# and its yellow H2's amber (h2). The colours are the palette's, so the card
# needs no tint.
set -eu
export LC_ALL=C
cd "$(dirname "$0")/../.." || exit 1
RAW=refs/mark/flux-harmonic.png
W="${W:-190}"
[ -f "$RAW" ] || { echo "mark: no $RAW"; exit 1; }
want="$(awk '/^sha256:/ { print $2 }' refs/mark/flux-harmonic.txt)"
got="$(sha256sum "$RAW" | cut -d' ' -f1)"
[ "$want" = "$got" ] || { echo "mark: $RAW does not hash to its note's sha256"; exit 1; }
hex() { awk -v role="$1" '$0 ~ "^ *\\(" role " \"#" { l = $0; sub(/^[^"]*"#/, "", l); print substr(l, 1, 6); exit }' world/world.sgl; }
comp() { printf '%d' "0x$(echo "$1" | cut -c"$2")"; }
CREAM="$(hex fur-1)"; ACC="$(hex hol-bracken)"; AMBER="$(hex h2)"
for h in "$CREAM" "$ACC" "$AMBER"; do [ -n "$h" ] || { echo "mark: a palette role has no colour in world/world.sgl"; exit 1; }; done
ch() {  # channel expression: cls 0 cream, 0.5 accent, 1 amber, for hex chars $1 (1-2 r, 3-4 g, 5-6 b)
  c=$(comp "$CREAM" "$1"); a=$(comp "$ACC" "$1"); h=$(comp "$AMBER" "$1")
  echo "($c + ($a - $c)*(u >= 0.25) + ($h - $a)*(u >= 0.75))/255"
}
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
n=0
for k in 1 2 3 4 5 6 7 8; do
  w=$((W * k))
  convert "$RAW" -filter Lanczos -resize "${w}x" "PNG32:$tmp/base.png"
  # the class of each pixel, from its colour alone: 0 lettering, 0.5 the dark
  # orange, 1 the yellow
  convert "$tmp/base.png" -alpha off -colorspace sRGB \
    -fx '((max(max(r,g),b)-min(min(r,g),b))/(max(max(r,g),b)+0.0001) > 0.45) * (0.5 + 0.5*(g/(r+0.0001) >= 0.72))' \
    -colorspace Gray "PNG:$tmp/cls.png"
  convert "$tmp/cls.png" -colorspace sRGB -type TrueColor \
    -channel R -fx "$(ch 1-2)" -channel G -fx "$(ch 3-4)" -channel B -fx "$(ch 5-6)" +channel \
    "PNG24:$tmp/col.png"
  convert "$tmp/col.png" \( "$tmp/base.png" -alpha extract \) -alpha off -compose CopyOpacity -composite \
    +set date:create +set date:modify -define png:exclude-chunks=date,time,tIME,tEXt,zTXt "PNG32:$tmp/mark@$k.png"
  [ -s "$tmp/mark@$k.png" ] || { echo "mark: mark@$k.png was not made"; exit 1; }
  n=$((n + 1))
done
# the plant-landed checks: every size made, and the largest shows all three
# colours (a classification that fell through would paint it one colour)
[ "$n" -eq 8 ] || { echo "mark: made $n images, want 8"; exit 1; }
colours="$(convert "$tmp/mark@8.png" -alpha off -unique-colors txt:- | awk 'NR > 1 { print toupper(substr($3, 2, 6)) }')"
for h in "$CREAM" "$ACC" "$AMBER"; do
  echo "$colours" | grep -qx "$(echo "$h" | tr a-z A-Z)" || { echo "mark: #$h is missing from the mark; refusing"; exit 1; }
done
mkdir -p assets/mark
cp "$tmp"/mark@*.png assets/mark/
echo "mark: 8 images, ${W} view px wide, in #$CREAM #$ACC #$AMBER -> assets/mark/"
