#!/bin/sh
# The Flux Harmonic mark as a text cell in Harkfell's slots (ruling D33: the
# mark "drawn in Harkfell's own palette and dither"). No image generation on
# this path: David's own mark, area-downscaled and snapped.
#
#   scripts/art/mark        refs/mark/flux-harmonic.png -> assets/art/mark.txt
#
# The mark is RESERVED (assets/RESERVED.md), not CC BY: mark.txt says so.
#
# The raw is flattened on black and area-averaged to W px wide (box filter,
# as Crash's dither stage does for a rendered picture). Each pixel is then
# classified: lettering (bright, unsaturated) is fur-1 (F); the ring's
# darker orange is the region's accent (x) and its yellow the harmonic's
# colour (h, H2's amber); anything else is black (0). A pixel partly covered
# (its brightness between the ground and the ink) is dithered by a Bayer 4x4
# threshold against its coverage, so the edges stay soft inside the palette.
set -eu
export LC_ALL=C
cd "$(dirname "$0")/../.." || exit 1
RAW=refs/mark/flux-harmonic.png
OUT=assets/art/mark.txt
W="${W:-176}"
[ -f "$RAW" ] || { echo "mark: no $RAW"; exit 1; }
want="$(awk '/^sha256:/ { print $2 }' refs/mark/flux-harmonic.txt)"
got="$(sha256sum "$RAW" | cut -d' ' -f1)"
[ "$want" = "$got" ] || { echo "mark: $RAW does not hash to its note's sha256"; exit 1; }
tmp="$(mktemp)"
trap 'rm -f "$tmp" "$tmp.txt"' EXIT
convert "$RAW" -background black -alpha remove -alpha off -filter box -resize "${W}x" -compress none "ppm:$tmp"
{
  echo "# The Flux Harmonic mark, GENERATED by scripts/art/mark from"
  echo "# refs/mark/flux-harmonic.png (David's, 2021). RESERVED, not CC BY"
  echo "# (assets/RESERVED.md). Edit the script, not this file."
  echo "# F lettering (fur-1), x and h the ring (accent, H2's amber), 0 black."
  echo ""
  echo "= flux-harmonic"
  awk '
    BEGIN { split("0 8 2 10 12 4 14 6 3 11 1 9 15 7 13 5", B, " ") }
    function th(x, y) { return (B[(y % 4) * 4 + (x % 4) + 1] + 0.5) / 16.0 }
    NR == 1 { next }                       # P3
    NR == 2 { w = $1; h = $2; next }
    NR == 3 { next }                       # maxval
    { for (i = 1; i <= NF; i++) v[n++] = $i }
    END {
      for (y = 0; y < h; y++) {
        line = ""
        for (x = 0; x < w; x++) {
          k = 3 * (y * w + x); r = v[k] / 255; g = v[k + 1] / 255; b = v[k + 2] / 255
          mx = r; if (g > mx) mx = g; if (b > mx) mx = b
          mn = r; if (g < mn) mn = g; if (b < mn) mn = b
          sat = (mx > 0) ? (mx - mn) / mx : 0
          c = "0"
          if (sat > 0.45) {                 # the ring: orange or yellow, by green
            cov = mx
            ch = (g / (r + 0.001) < 0.72) ? "x" : "h"
            if (cov > th(x, y) * 0.9) c = ch
          } else {
            cov = (r + g + b) / 3           # the lettering: white on black
            if (cov > 0.12 + th(x, y) * 0.76) c = "F"
          }
          line = line c
        }
        print line
      }
    }' "$tmp"
} > "$tmp.txt"
rows="$(awk '/^= flux-harmonic/ { on = 1; next } on && /^[0Fxh]+$/ { n++ } END { print n + 0 }' "$tmp.txt")"
[ "$rows" -gt 20 ] || { echo "mark: only $rows rows came out; refusing"; exit 1; }
grep -q 'F' "$tmp.txt" || { echo "mark: no lettering came out; refusing"; exit 1; }
grep -q 'h' "$tmp.txt" || { echo "mark: no ring came out; refusing"; exit 1; }
cp "$tmp.txt" "$OUT"
echo "mark: $W x $rows -> $OUT"
