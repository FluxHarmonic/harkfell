#!/usr/bin/env bash
# Build the web config of HEAD on an azoth runner, optionally run arms there
# against that build, and fetch the served tree back.
#
#   scripts/build-remote                             build HEAD, fetch the tree
#   scripts/build-remote --arm verify.mjs            ... and run that arm on the
#                                                    runner against the build
#   scripts/build-remote --no-fetch --arm verify.mjs arms only, keep nothing
#
# Crash The Stack's scripts/build-remote (master 262a0e0), changed for
# Harkfell in three places: the wasm is harkfell.wasm and there is no
# tracker; the sigil version is the one package.sgl pins (`sigil: "X.Y.Z"`),
# not this box's `sigil --version` (the box's CLI is shared by every worker
# and moves under you: topics/sigil-deps-links-are-per-worktree-state); and
# there is no OPTIMIZE switch (the web config sets optimize: 2 itself).
#
# WHAT IS BUILT IS EXACTLY HEAD, AND THE RESULT SAYS SO OR IS REFUSED.
#   - a tree with tracked changes is refused before anything is leased;
#   - the source travels as a git bundle of HEAD, so the runner's checkout is a
#     real repository at that commit and package.sgl's web-version stamps the
#     page from it exactly as it does here;
#   - `sigil deps install` on the runner must leave sigil.lock untouched: a
#     rewritten lock stamps the page <sha>-dirty-<time> and the stamp check
#     below refuses it, printing the diff;
#   - after the build the page's stamp must equal HEAD's 12-character sha, on
#     the runner AND again here on the fetched tree; either mismatch refuses
#     (exit 125) and the fetched tree is deleted;
#   - wasm-opt must have run: without binaryen the build exits 0 and skips
#     asyncify (manifest.scm's comment), so the runner checks the wasm for
#     the asyncify_start_unwind export that pass adds;
#   - the fetched tree lands in build/remote-web-<sha>/ (refused if it already
#     exists), never in build/web; BUILD-SHA inside it names the full sha and
#     BUILD-SIGIL the compiler that built it.
#
# Exit: 0 build and every arm green; 1 an arm failed (the build succeeded);
# 2 the build failed; 125 refused or SETUP-FAILED; 126/127 from azoth-remote
# (results incomplete / runner not released); 124/255 timeout / connection lost.
# Each arm's own rc is on its "=== ARM-RESULT rc=" line.
#
# Environment: AZOTH_REMOTE (path to azoth.works bin/azoth-remote), BUILD_TIMEOUT
# (seconds, default 10800).
set -euo pipefail
cd "$(dirname "$0")/.."
say() { printf 'build-remote: %s\n' "$*" >&2; }

ARMS=()
FETCH=1
while [ $# -gt 0 ]; do
  case "$1" in
    --arm)      [ $# -ge 2 ] || { say "--arm needs an argument"; exit 125; }; ARMS+=("$2"); shift 2 ;;
    --no-fetch) FETCH=0; shift ;;
    *) say "unknown argument '$1'"; exit 125 ;;
  esac
done
for a in "${ARMS[@]+"${ARMS[@]}"}"; do
  f=${a%% *}
  case "$f" in *.mjs) ;; *) say "--arm '$a' does not start with an arm file"; exit 125 ;; esac
  [ -f "$f" ] || { say "--arm '$a': no $f at HEAD's checkout"; exit 125; }
  git ls-files --error-unmatch "$f" >/dev/null 2>&1 || { say "--arm '$a': $f is not tracked, so it is not in the bundle"; exit 125; }
done

REMOTE=${AZOTH_REMOTE:-$HOME/Projects/Sites/azoth.works/bin/azoth-remote}
[ -x "$REMOTE" ] || { say "azoth-remote not found at $REMOTE (set AZOTH_REMOTE)"; exit 125; }

dirty=$(git status --porcelain --untracked-files=no)
if [ -n "$dirty" ]; then
  say "REFUSED: the tree has tracked changes; the build would not be HEAD's. Commit first."
  printf '%s\n' "$dirty" | head -5 >&2
  exit 125
fi
SHA=$(git rev-parse --short=12 HEAD)
FULL=$(git rev-parse HEAD)
DEST="build/remote-web-$SHA"
if [ "$FETCH" = 1 ] && [ -e "$DEST" ]; then
  say "REFUSED: $DEST already exists; remove it to rebuild this sha"
  exit 125
fi
# The compiler is the one HEAD's package.sgl pins, read from the committed
# file (the tree is clean, so the working copy is HEAD's).
SIGIL_V=$(git show HEAD:package.sgl | sed -n 's/^ *sigil: *"\([0-9][0-9.]*\)".*/\1/p' | head -1)
case "$SIGIL_V" in [0-9]*.[0-9]*.[0-9]*) ;; *) say "cannot read the sigil pin from package.sgl ('$SIGIL_V')"; exit 125 ;; esac
say "HEAD $SHA ($FULL), sigil $SIGIL_V (package.sgl's pin), arms: ${ARMS[*]:-none}"

STAGE=$(mktemp -d "${TMPDIR:-/tmp}/harkfell-build-remote.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT
git bundle create "$STAGE/src.bundle" HEAD 2>/dev/null
: > "$STAGE/arms"
for a in "${ARMS[@]+"${ARMS[@]}"}"; do printf '%s\n' "$a" >> "$STAGE/arms"; done

cat > "$STAGE/remote.sh" <<'EOF'
#!/usr/bin/env bash
# Runs ON THE RUNNER, in ~/work. Args: <full sha> <short sha> <sigil version>
set -uo pipefail
cd "$HOME/work"
FULL=$1; SHA=$2; SIGIL_V=$3
mkdir -p out
t() { date +%s; }
T0=$(t)
echo "remote: runner $(ip -4 -br addr show eth0 | awk '{print $3}') nproc=$(nproc) load=$(cut -d' ' -f1-3 /proc/loadavg)"
git clone --quiet src.bundle checkout || { echo "SETUP-FAILED: clone"; exit 125; }
git -C checkout checkout --quiet "$FULL" || { echo "SETUP-FAILED: checkout $FULL"; exit 125; }
[ "$(git -C checkout rev-parse HEAD)" = "$FULL" ] || { echo "SETUP-FAILED: checkout is not $FULL"; exit 125; }
"$HOME/.sigil/bin/sigil" cli use "$SIGIL_V" >/dev/null 2>&1 || { echo "SETUP-FAILED: sigil cli use $SIGIL_V"; exit 125; }
export PATH="$HOME/.sigil/bin:$PATH"
GOT_V=$(sigil --version 2>&1 | sed 's/\x1b\[[0-9;]*m//g')
echo "remote: sigil $GOT_V"
case "$GOT_V" in "sigil $SIGIL_V "*) ;; *) echo "SETUP-FAILED: sigil reports '$GOT_V', not $SIGIL_V"; exit 125 ;; esac
cd checkout
T1=$(t); sigil deps install > ../out/deps.log 2>&1 || { echo "BUILD-FAILED: deps install (out/deps.log)"; tail -20 ../out/deps.log; exit 2; }
T2=$(t); echo "remote: deps install $((T2-T1))s"
guix shell -m manifest.scm -- true > ../out/guix.log 2>&1 || { echo "SETUP-FAILED: guix shell -m manifest.scm (out/guix.log)"; tail -20 ../out/guix.log; exit 125; }
T3=$(t); echo "remote: guix environment $((T3-T2))s"
scripts/dev sigil build --config web > ../out/build.log 2>&1; brc=$?
T4=$(t); echo "remote: build rc=$brc $((T4-T3))s"
[ $brc -eq 0 ] || { echo "BUILD-FAILED rc=$brc (out/build.log)"; tail -30 ../out/build.log; exit 2; }
STAMP=$(grep -o 'version: "[^"]*"' build/web/index.html | head -1 | cut -d'"' -f2)
if [ "$STAMP" != "$SHA" ]; then
  echo "REFUSED: the page is stamped '$STAMP', not $SHA"
  echo "REFUSED: tracked changes in the runner's checkout:"; git status --porcelain --untracked-files=no | sed 's/^/  /'
  git diff | head -40 | sed 's/^/  | /'
  exit 125
fi
[ -f build/web/harkfell.wasm ] || { echo "BUILD-FAILED: build/web/harkfell.wasm missing"; exit 2; }
# wasm-opt's asyncify pass adds the asyncify_* exports; a build without
# binaryen exits 0 without them and the wasm cannot yield to the browser
grep -q -a asyncify_start_unwind build/web/harkfell.wasm || { echo "BUILD-FAILED: harkfell.wasm has no asyncify_start_unwind export; wasm-opt did not run (binaryen?)"; exit 2; }
echo "remote: stamp $STAMP ok; wasm $(stat -c %s build/web/harkfell.wasm) bytes sha256 $(sha256sum build/web/harkfell.wasm | cut -c1-16)"
ARC=0
if [ -s ../arms ]; then
  mkdir -p ../shim
  CHROME=$(command -v chromium) || { echo "SETUP-FAILED: no chromium"; exit 125; }
  printf '#!/bin/sh\nexec %s "$@"\n' "$CHROME" > ../shim/google-chrome; chmod +x ../shim/google-chrome
  export PATH="$HOME/work/shim:$PATH"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    read -r -a A <<<"$line"
    arm=${A[0]}; rest=("${A[@]:1}")
    Ta=$(t)
    echo "=== ARM $line"
    node "$arm" build/web "${rest[@]+"${rest[@]}"}" < /dev/null; r=$?
    echo "=== ARM-RESULT rc=$r $((($(t))-Ta))s $line"
    [ $r -eq 0 ] || ARC=1
  done < ../arms
fi
mkdir -p ../out/web
# The completion marker is written ONLY after a checked copy.
if tar -C build/web --exclude=./native --exclude=./bin --exclude=./.sigil-package-cache -cf - . | tar -C ../out/web -xf -; then
  printf '%s\n' "$FULL" > ../out/web.complete
else
  echo "STAGING-FAILED: could not copy build/web to out/web"; ARC=2
fi
echo "remote: total $(( $(t) - T0 ))s"
exit $ARC
EOF

GETS=(--get "out:$STAGE/fetched")
T0=$(date +%s)
set +e
"$REMOTE" --label "harkfell build $SHA" --timeout "${BUILD_TIMEOUT:-10800}" --detach \
  --put "$STAGE/src.bundle:src.bundle" --put "$STAGE/remote.sh:remote.sh" --put "$STAGE/arms:arms" \
  "${GETS[@]}" -- bash remote.sh "$FULL" "$SHA" "$SIGIL_V"
rc=$?
set -e
say "remote cycle rc=$rc in $(( $(date +%s) - T0 ))s"

if [ "$FETCH" = 1 ] && [ -f "$STAGE/fetched/web/index.html" ] \
   && ! { { [ "$rc" = 0 ] || [ "$rc" = 1 ]; } && [ "$(cat "$STAGE/fetched/web.complete" 2>/dev/null)" = "$FULL" ] && [ -f "$STAGE/fetched/web/harkfell.wasm" ]; }; then
  say "NOT filing the fetched tree as a build of $SHA: cycle rc=$rc, completion marker '$(cat "$STAGE/fetched/web.complete" 2>/dev/null)', wasm $([ -f "$STAGE/fetched/web/harkfell.wasm" ] && echo present || echo missing)"
elif [ "$FETCH" = 1 ] && [ -f "$STAGE/fetched/web/index.html" ]; then
  STAMP=$(grep -o 'version: "[^"]*"' "$STAGE/fetched/web/index.html" | head -1 | cut -d'"' -f2)
  if [ "$STAMP" != "$SHA" ]; then
    say "REFUSED: the fetched page is stamped '$STAMP', not $SHA; deleting it"
    exit 125
  fi
  mkdir -p build
  mv "$STAGE/fetched/web" "$DEST"
  printf '%s\n' "$FULL" > "$DEST/BUILD-SHA"
  printf '%s\n' "$SIGIL_V" > "$DEST/BUILD-SIGIL"
  say "fetched the build of $SHA to $DEST (stamp verified here)"
fi
if [ -d "$STAGE/fetched" ]; then
  LOGS="build/remote-web-$SHA.logs"
  rm -rf "$LOGS"; mkdir -p "$LOGS"
  for l in build.log deps.log guix.log; do
    [ -f "$STAGE/fetched/$l" ] && cp "$STAGE/fetched/$l" "$LOGS/$l"
  done
  say "runner logs in $LOGS"
fi
# a cycle that "succeeded" but filed no tree is not a build of $SHA
if [ "$FETCH" = 1 ] && [ "$rc" = 0 ] && [ ! -f "$DEST/index.html" ]; then
  say "SETUP-FAILED: the cycle ended 0 but no tree was filed at $DEST"
  exit 125
fi
exit $rc
