#!/bin/sh
# The look track's gate (A4): the art as data and the frame as drawn.
#
#   scripts/gate-look              green: every leg must pass
#   scripts/gate-look --sabotage   each plant must turn its leg red, and the
#                                  tree is restored to its pre-plant hash
#
# Legs:
#   art       test/test-art.sgl (the key, the palettes, the lookups, the
#             autotile shapes, the player, the type, the mark)
#   cells     scripts/art/cells --check: the generated module is the text's
#   palette   native frames of every Reedfen room and the look fixture's two
#             Hollow rooms, each shot on the worker's
#             own Xvfb; every colour in each frame must be one of its
#             region's palette colours (the palette pass's promise: water,
#             light, the focus pull and fades never leave the palette), and
#             in Reed Bridge the sky and the peat sit where they belong (a
#             flipped or shifted resolve stays in the palette but not there)
# Needs: build/dev (scripts/dev sigil build) for the palette leg.
#
# Exit 0 green, 1 red, 2 SETUP-FAILED.
set -u
cd "$(dirname "$0")/.." || exit 2
HERE="$(pwd)"
S="${GATE_TMP:-$(mktemp -d)}"
MODE="${1:-}"
DISPLAYN="${GATE_DISPLAY:-75}"

say() { echo "gate-look: $*"; }

# --- legs ------------------------------------------------------------------

leg_art() {
  env -u DISPLAY -u WAYLAND_DISPLAY scripts/dev sigil test test/test-art.sgl > "$S/art.log" 2>&1
  rc=$?
  line="$(grep -o 'Tests:.*' "$S/art.log" | sed 's/\x1b\[[0-9;]*m//g' | tail -1)"
  passed="$(echo "$line" | sed -n 's/.* \([0-9][0-9]*\) passed.*/\1/p')"
  total="$(echo "$line" | sed -n 's/.*(\([0-9][0-9]*\) total).*/\1/p')"
  [ -n "$total" ] || { say "art: SETUP-FAILED (no Tests: line)"; return 2; }
  if [ "$rc" -eq 0 ] && [ "$passed" = "$total" ]; then say "art: GREEN $passed/$total"; return 0; fi
  say "art: RED $passed/$total"; grep -A1 '✗' "$S/art.log" | sed 's/\x1b\[[0-9;]*m//g' | head -12; return 1
}

leg_cells() {
  if scripts/art/cells --check > "$S/cells.log" 2>&1; then say "cells: GREEN ($(cat "$S/cells.log"))"; return 0; fi
  say "cells: RED ($(cat "$S/cells.log"))"; return 1
}

# The hexes a region may show: its palette: roles and the world-wide ones.
region_hexes() {
  world="$1"; region="$2"
  roles="$(awk -v r="$region" '
    $0 ~ "^\\(region " r "$" || $0 ~ "^\\(region " r " " { inr = 1 }
    inr && /palette: \(/ { grab = 1; sub(/.*palette: \(/, "") }
    grab { line = line " " $0; if ($0 ~ /\)/) { sub(/\).*/, "", line); print line; exit } }' "$world/world.sgl")"
  for role in $roles h2 h3 h4 h5 h7 black; do
    awk -v role="$role" '$0 ~ "^ *\\(" role " \"#" { l = $0; sub(/^[^"]*"#/, "", l); print toupper(substr(l, 1, 6)); exit }' "$world/world.sgl"
  done | sort -u
}

xvfb_up() {
  [ -S "/tmp/.X11-unix/X$DISPLAYN" ] && return 0
  setsid guix shell xorg-server -- Xvfb ":$DISPLAYN" -screen 0 1700x900x24 +extension GLX -nolisten tcp > "$S/xvfb.log" 2>&1 &
  n=0; until [ -S "/tmp/.X11-unix/X$DISPLAYN" ] || [ $n -ge 60 ]; do sleep 0.5; n=$((n+1)); done
  [ -S "/tmp/.X11-unix/X$DISPLAYN" ]
}

# One native frame: args to the game; the capture of the root window.
shoot() {
  out="$1"; shift
  mkdir -p "$S/xdg/harkfell"
  # D37: the native window opens at the stored scale; the leg reads 3x frames
  printf "x3" > "$S/xdg/harkfell/scale.sgl"
  env -u WAYLAND_DISPLAY -u WAYLAND_SOCKET DISPLAY=":$DISPLAYN" PULSE_SINK=worker-null XDG_DATA_HOME="$S/xdg" \
    setsid scripts/dev ./build/dev/bin/harkfell "$@" > "$S/game.log" 2>&1 &
  pid=""; n=0
  while [ -z "$pid" ] && [ $n -lt 60 ]; do
    for p in /proc/[0-9]*; do
      [ "${p#/proc/}" = "$$" ] && continue
      e="$(readlink "$p/exe" 2>/dev/null || true)"; c="$(readlink "$p/cwd" 2>/dev/null || true)"
      case "$e" in */build/dev/bin/harkfell|*/bin/sigil)
        [ "$c" = "$HERE" ] && tr '\0' ' ' < "$p/cmdline" 2>/dev/null | grep -q 'build/dev/bin/harkfell' && pid="${p#/proc/}" ;;
      esac
    done
    [ -n "$pid" ] || { sleep 0.25; n=$((n+1)); }
  done
  [ -n "$pid" ] || { say "SETUP-FAILED: the game did not start ($*)"; cat "$S/game.log"; return 2; }
  sleep 5
  if [ ! -d "/proc/$pid" ]; then say "SETUP-FAILED: the game died ($*)"; tail -3 "$S/game.log"; return 2; fi
  DISPLAY=":$DISPLAYN" guix shell imagemagick -- import -window root "$out" 2>/dev/null
  kill "$pid" 2>/dev/null
  sleep 0.3
  [ -s "$out" ] || { say "SETUP-FAILED: no capture ($*)"; return 2; }
  return 0
}

# Every colour of the frame (the game window's area, the Xvfb ground
# excluded) must be in the allowed list; prints the strays.
check_colours() {
  shot="$1"; allowed="$2"; crop="$3"
  convert "$shot" -crop "$crop" +repage -unique-colors txt:- 2>/dev/null \
    | awk 'NR > 1 { h = $3; sub(/^#/, "", h); print toupper(substr(h, 1, 6)) }' | sort -u > "$S/colours"
  n="$(wc -l < "$S/colours")"
  [ "$n" -gt 3 ] || { say "palette: SETUP-FAILED ($shot has $n colours: a blank frame is not a frame)"; return 2; }
  stray="$(grep -vxF -f "$allowed" "$S/colours" || true)"
  if [ -n "$stray" ]; then echo "$stray" | head -5 | sed 's/^/    stray #/'; return 1; fi
  return 0
}

leg_palette() {
  [ -x build/dev/bin/harkfell ] || { say "palette: SETUP-FAILED (no build/dev/bin/harkfell)"; return 2; }
  pactl list short sinks 2>/dev/null | grep -q worker-null || pactl load-module module-null-sink sink_name=worker-null > /dev/null 2>&1
  xvfb_up || { say "palette: SETUP-FAILED (no Xvfb :$DISPLAYN)"; return 2; }
  bad=0; frames=0
  region_hexes world reedfen > "$S/allowed-reedfen"
  region_hexes test/fixtures/worlds/look hollow > "$S/allowed-hollow"
  # the Xvfb root is black outside the window: black is in every palette
  for r in 8,3 9,3 10,3 11,3 8,4 9,4 10,4; do
    shoot "$S/shot-$r.png" --room "reedfen:$r" || return 2
    frames=$((frames + 1))
    if check_colours "$S/shot-$r.png" "$S/allowed-reedfen" 1200x528+0+0; then :; else say "palette: RED reedfen:$r"; bad=1; fi
  done
  for r in 0,0 1,0; do
    shoot "$S/shot-h$r.png" --world test/fixtures/worlds/look --room "hollow:$r" || return 2
    frames=$((frames + 1))
    if check_colours "$S/shot-h$r.png" "$S/allowed-hollow" 1200x528+0+0; then :; else say "palette: RED hollow:$r"; bad=1; fi
  done
  # the RIGHT colours in the right places, not only palette ones (a resolve
  # flipped, shifted or reading the wrong strip row stays inside the
  # palette): Reed Bridge at 3x, the top-left view pixel is the high sky
  # (fen-sky-1) and the bottom-left is peat (fen-peat-2, the banks' body)
  sky="$(awk '$0 ~ /^ *\(fen-sky-1 "#/ { l = $0; sub(/^[^"]*"#/, "", l); print toupper(substr(l, 1, 6)); exit }' world/world.sgl)"
  peat="$(awk '$0 ~ /^ *\(fen-peat-2 "#/ { l = $0; sub(/^[^"]*"#/, "", l); print toupper(substr(l, 1, 6)); exit }' world/world.sgl)"
  at() { convert "$S/shot-9,3.png" -crop "1x1+$1+$2" +repage -format '%[hex:u.p{0,0}]' info:- 2>/dev/null | cut -c1-6 | tr a-z A-Z; }
  top="$(at 16 16)"; bottom="$(at 16 518)"
  if [ "$top" = "$sky" ] && [ "$bottom" = "$peat" ]; then :; else
    say "palette: RED placement: reedfen:9,3 top-left #$top (want #$sky), bottom-left #$bottom (want #$peat)"; bad=1
  fi
  [ "$bad" -eq 0 ] && { say "palette: GREEN ($frames frames, every colour a palette colour, sky and peat where they belong)"; return 0; }
  return 1
}

run_green() {
  GR_RC=0
  leg_art; GR_A=$?; leg_cells; GR_C=$?; leg_palette; GR_P=$?
  for GR_X in $GR_A $GR_C $GR_P; do [ "$GR_X" -eq 2 ] && return 2; [ "$GR_X" -ne 0 ] && GR_RC=1; done
  return $GR_RC
}

# --- sabotage ------------------------------------------------------------------

# plant NAME FILE AWK-PROGRAM LEG EXPECT: the plant must change FILE (hash
# moves), the leg must go RED naming EXPECT (the failure the plant is for: a
# red for another reason is a gate that caught the wrong thing), and FILE
# must come back to its pre-plant hash.
plant() {
  name="$1"; file="$2"; prog="$3"; leg="$4"; expect="$5"
  git diff --quiet HEAD -- "$file" || { say "sabotage $name: SETUP-FAILED ($file has uncommitted changes)"; return 2; }
  before="$(sha256sum "$file" | cut -d' ' -f1)"
  cp "$file" "$S/restore"
  awk "$prog" "$S/restore" > "$file"
  after="$(sha256sum "$file" | cut -d' ' -f1)"
  if [ "$before" = "$after" ]; then say "sabotage $name: SETUP-FAILED (the plant did not land)"; cp "$S/restore" "$file"; return 2; fi
  $leg > "$S/leg.log" 2>&1; rc=$?
  cp "$S/restore" "$file"
  case "$file" in assets/art/*) scripts/art/cells > /dev/null 2>&1 ;; esac
  back="$(sha256sum "$file" | cut -d' ' -f1)"
  [ "$back" = "$before" ] || { say "sabotage $name: NOT RESTORED ($file)"; exit 2; }
  if [ "$rc" -eq 1 ] && grep -qF -- "$expect" "$S/leg.log"; then say "sabotage $name: RED on its own test (good) :: $expect"; return 0; fi
  if [ "$rc" -eq 1 ]; then say "sabotage $name: RED, but not naming: $expect"; sed "s/^/    /" "$S/leg.log" | head -8; return 1; fi
  say "sabotage $name: NOT RED (rc $rc)"; cat "$S/leg.log" | head -5; return 1
}

# a leg after regenerating the module (for plants in the art text)
leg_art_regen() { scripts/art/cells > /dev/null 2>&1 || { say "art: RED (cells refused the text)"; return 1; }; leg_art; }

run_sabotage() {
  fail=0
  plant fifteen-roles world/world.sgl '{ sub(/ fen-water fen-brack fur-1 fur-2 ink\)/, " fen-water fur-1 fur-2 ink)"); print }' leg_art "every region lists sixteen roles" || fail=1
  plant smooth-holds assets/art/reedfen.txt '/^= rough-fill-/ { on = 1 } /^= rough-top/ { on = 0 } on && /^[0-9]+$/ { gsub(/1/, "3") } { print }' leg_art_regen "climbable rock has holds" || fail=1
  plant lost-frame assets/art/player.txt '/^= run-c$/ { print "= run-cc"; next } { print }' leg_art_regen "every frame player-frame can name exists" || fail=1
  plant player-in-peat assets/art/player.txt '/^= idle-a$/ { on = 1 } on && /^\.FFFFFFkFF$/ && !d { print ".FFFF2FkFF"; d = 1; next } { print }' leg_art_regen "slots only" || fail=1
  plant lookup-off-palette src/harkfell/palette.sgl "{ sub(/\\(cons 'sky-4 'sky-1\\)/, \"(cons 'sky-4 'sky-9)\"); print }" leg_art "a lookup names only slots" || fail=1
  plant ragged-cell assets/art/creatures.txt '/^= moth-up$/ { print; getline; print $0 "."; next } { print }' leg_cells_regen "row 2 is 5 wide" || fail=1
  plant stale-module src/harkfell/art/cells.sgl '/^    \(define CELL-COUNT/ { print "    ;; planted"; } { print }' leg_cells "is not what assets/art makes" || fail=1
  # the product layer: the resolve lets a colour off the palette
  plant resolve-tint src/harkfell/render.sgl '{ sub(/"    fragColor = vec4\(c, 1.0\);\\n"/, "\"    fragColor = vec4(mix(c, vec3(1.0, 0.0, 1.0), 0.03), 1.0);\\n\""); print }' leg_palette_rebuilt "palette: RED" || fail=1
  # stays inside the palette, so only the placement probe can see it
  plant strip-row-shift src/harkfell/render.sgl '{ sub(/\(int\(u_view_h\) \+ row\)/, "(int(u_view_h) + row + 1)"); print }' leg_palette_rebuilt "RED placement" || fail=1
  return $fail
}

leg_cells_regen() {
  if scripts/art/cells > "$S/cells.log" 2>&1; then say "cells: GREEN"; return 0; fi
  say "cells: RED ($(cat "$S/cells.log"))"; return 1
}

# the palette leg on a build of the planted tree (restored and rebuilt after)
leg_palette_rebuilt() {
  env -u DISPLAY -u WAYLAND_DISPLAY scripts/dev sigil build > "$S/build.log" 2>&1 || { say "palette: SETUP-FAILED (the planted tree did not build)"; return 2; }
  leg_palette; rc=$?
  return $rc
}

if [ "$MODE" = "--sabotage" ]; then
  run_sabotage; rc=$?
  env -u DISPLAY -u WAYLAND_DISPLAY scripts/dev sigil build > "$S/rebuild.log" 2>&1 || { say "SETUP-FAILED: the restored tree did not rebuild"; exit 2; }
  git diff --quiet HEAD || { say "the tree differs from HEAD after the sabotage run"; git diff --stat; exit 2; }
  [ "$rc" -eq 0 ] && say "SABOTAGE: every plant RED, every file restored" || say "SABOTAGE: a plant stayed green"
  exit $rc
fi
run_green; rc=$?
case $rc in 0) say "GREEN" ;; 1) say "RED" ;; *) say "SETUP-FAILED" ;; esac
exit $rc
